\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Dal\u353?\u237? kl\u225?vesov\u233? zkratky\cf2\f0\lang1033\par

\cf3\fs20\par

Ctrl+F6\tab\tab\cf0\b0 Ozna\u269?it m\u237?sto pro intern\u237? odkaz KeyNote\par

\cf3\b Shift+F6\tab\tab\cf0\b0 Vlo\u382?it intern\u237? odkaz KeyNote\par

\cf3\b\par

Shift+Alt+0\cf0\b0  a\u382? \cf3\b 9\tab\cf0\b0 Nastavit \u269?\u237?slo z\u225?lo\u382?ky 0 a\u382? 9\par

\cf3\b Alt+0\cf0\b0  a\u382? \cf3\b Alt+9\tab\cf0\b0 P\u345?ej\u237?t na z\u225?lo\u382?ku \u269?\u237?slo 0 a\u382? 9 (z\u225?lo\u382?ka mus\u237? b\u253?t nastavena)\par


\pard\sb160\cf3\b Shift+F5\tab\tab\cf0\b0 Spustit vybran\u233? makro (pokud je viditeln\u253? panel prost\u345?edk\u367?)\par


\pard\cf3\b Ctrl+F5\tab\tab\cf0\b0 Spustit naposledy spu\u353?t\u283?n\u233? makro\par


\pard\sb120\cf3\b Shift+F12\tab\tab\cf0\b0 Spustit vybran\u253? plugin (pokud je viditeln\u253? panel prost\u345?edk\u367?)\par


\pard\cf3\b Ctrl+F12\tab\tab\cf0\b0 Spustit naposledy spu\u353?t\u283?n\u253? plugin\par

\par

\par

\b\v\fs22\'11B1\'12\v0 Alternativn\u237? p\u345?\u237?kazy s Shift, Alt nebo Ctrl\b0\par

\fs20\par

N\u225?sleduj\u237?c\u237? p\u345?\u237?kazy se chovaj\u237? odli\u353?n\u283?, pokud je p\u345?i prov\u225?d\u283?n\u237? p\u345?\u237?kazu stisknuta kl\u225?vesa \cf3\b Shift\cf0\b0 , \cf3\b Ctrl\cf0\b0  nebo \cf3\b Alt\cf0\b0 , a\u357? u\u382? p\u345?\u237?kaz spust\u237?te tla\u269?\u237?tkem na panelu n\u225?stroj\u367?, kliknut\u237?m na polo\u382?ku nab\u237?dky nebo jinou akc\u237? my\u353?\u237? (p\u345?eta\u382?en\u237?, dvojklik atd.).\par

\par

\b\fs22 Ulo\u382?it\fs20  \b0 (nab\u237?dka Soubor nebo tla\u269?\u237?tko na panelu n\u225?stroj\u367?)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se m\u237?sto toho provede p\u345?\u237?kaz \cf3\b Ulo\u382?it jako\cf0\b0 \par


\pard\par

\b\fs22 Vlo\u382?it\b0\fs20  (nab\u237?dka \u218?pravy nebo tla\u269?\u237?tko na panelu n\u225?stroj\u367?)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se text vlo\u382?\u237? jako prost\u253? text\par

{\pntext\f2\'B7\tab}s \cf3\b Alt\cf0\b0  se m\u237?sto toho provede p\u345?\u237?kaz \cf3\b Vlo\u382?it jinak\cf0\b0 .\par

{\pntext\f2\'B7\tab}s \cf3\b Ctrl\cf0\b0  se m\u237?sto toho provede p\u345?\u237?kaz \cf3\b Vlo\u382?it do nov\u233?ho\cf0\b0 .\par


\pard\b\par

\fs22 Vlo\u382?it jako webov\u253? v\u253?st\u345?i\u382?ek\b0\fs20  (nab\u237?dka \u218?pravy)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se text vlo\u382?\u237? jako {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<33|2492|0|3"}}{\fldrslt{Vlo\u382?en\u237? \u8222?Vlastn\u237? prost\u253? text\u8220?}}}}}\f0\fs20\par


\pard\b\par

\fs22 Vlo\u382?it do nov\u233?ho\fs20  \b0 (nab\u237?dka \u218?pravy)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se text vlo\u382?\u237? do nov\u233? slo\u382?ky (nebo uzlu) jako prost\u253? text\par


\pard\par

\b\fs22 Pluginy\fs20  \b0 (nab\u237?dka N\u225?stroje)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  KeyNote znovu inicializuje seznam nainstalovan\u253?ch plugin\u367?. To je u\u382?ite\u269?n\u233?, pokud jste p\u345?idali nebo odebrali plugin v dob\u283?, kdy KeyNote b\u283?\u382?\u237?.\par


\pard\b\par

\fs22 P\u345?i dvojkliku na kartu slo\u382?ky:\b0\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se otev\u345?e dialogov\u233? okno Vlastnosti slo\u382?ky (obvykle se otev\u345?e jednodu\u353?\u353?\u237? dialogov\u233? okno P\u345?ejmenovat slo\u382?ku)\par


\pard\par

\b\fs22 P\u345?i kliknut\u237? na URL v editoru:\b0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\fs20 s \cf3\b Ctrl\cf0\b0  se provede jin\u225? nakonfigurovan\u225? akce\par


\pard\par

\b\fs22 Barva pozad\u237?\fs20  \b0 (nab\u237?dka Form\u225?t)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se nov\u225? barva pozad\u237? pou\u382?ije na V\u352?ECHNY UZLY ve stromu (obvykle se p\u345?\u237?kaz t\u253?k\u225? pouze aktu\u225?ln\u283? zobrazen\u233?ho uzlu). Po v\u253?b\u283?ru barvy se zobraz\u237? potvrzovac\u237? dialogov\u233? okno.\par


\pard\par

\b\fs22 P\u345?i za\u353?krtnut\u237? uzlu stromu, nastaven\u237? tu\u269?n\u233?ho p\u237?sma nebo nastaven\u237? jeho barvy:\b0\par

\fs20 s \cf3\b Shift\cf0\b0  se p\u345?\u237?kaz provede tak\u233? pro v\u353?echny potomky uzlu (poduzly)\par

\par

\b\fs22 Zv\u283?t\u353?it odsazen\u237?, Zmen\u353?it odsazen\u237?\fs20  \b0 (tla\u269?\u237?tka na panelu n\u225?stroj\u367?)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se zv\u283?t\u353?uje nebo zmen\u353?uje PRAV\u201? odsazen\u237? m\u237?sto lev\u233?ho.\par


\pard\par

\b\fs22 Vyhled\u225?n\u237? ve WordWeb\b0\fs20  (nab\u237?dka Vlo\u382?it, m\u237?stn\u237? nab\u237?dka editoru, tla\u269?\u237?tko na panelu n\u225?stroj\u367?)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  budete vyzv\u225?ni k zad\u225?n\u237? slova, kter\u233? se m\u225? vyhledat v tezauru WordWeb. (Obvykle KeyNote automaticky p\u345?evezme aktu\u225?ln\u237? slovo v editoru a vyhled\u225? je.)\par


\pard\par

\b\fs22 P\u345?i p\u345?eta\u382?en\u237? uzlu stromu na jin\u253? uzel ve stromu:\b0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\fs20 s \cf3\b Shift\cf0\b0  se pro p\u345?etahovan\u253? uzel provede p\u345?\u237?kaz Vlo\u382?it, co\u382? znamen\u225?, \u382?e uzel bude vlo\u382?en p\u345?ed uzel, na kter\u253? byl p\u345?eta\u382?en. Obvykle se p\u345?etahovan\u253? uzel p\u345?id\u225? jako potomek uzlu, na kter\u253? byl p\u345?eta\u382?en.\par

{\pntext\f2\'B7\tab}s \cf3\b Ctrl\cf0\b0  se p\u345?etahovan\u253? uzel vlo\u382?\u237? jako PRVN\u205? uzel ve stromu (stane se nejvy\u353?\u353?\u237?m, tedy ko\u345?enov\u253?m, uzlem).\par


\pard\par

\b\fs22 P\u345?i p\u345?eta\u382?en\u237? uzlu nebo podstromu na jinou pozn\u225?mku:\b0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\fs20 s \cf3\b Shift\cf0\b0  se uzel nebo podstrom m\u237?sto zkop\u237?rov\u225?n\u237? p\u345?esune. Zdrojov\u233? uzly budou odstran\u283?ny ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|6952|0|8"}}{\fldrslt{V\u237?ce}}}}}\f0\fs20 )\par


\pard\par

\b\fs22 Kop\u237?rovat n\u225?zev uzlu\fs20  \b0 (m\u237?stn\u237? nab\u237?dka panelu stromu)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 s \cf3\b Shift\cf0\b0  se do schr\u225?nky krom\u283? n\u225?zvu uzlu zkop\u237?ruje i cel\u253? text aktu\u225?ln\u237?ho uzlu. Text se zkop\u237?ruje bez form\u225?tov\u225?n\u237?.\par

{\pntext\f2\'B7\tab}Za\u353?krtnout/odzna\u269?it uzel stromu, nastavit tu\u269?n\u233? p\u237?smo uzlu nebo vybrat barvu uzlu:\par

{\pntext\f2\'B7\tab}s \cf3\b Shift\cf0\b0  se stejn\u253? p\u345?\u237?kaz pou\u382?ije tak\u233? na v\u353?echny potomky vybran\u233?ho uzlu (tj. v\u353?echny pod\u345?\u237?zen\u233? uzly z\u237?skaj\u237? stejn\u253? form\u225?t nebo stav jako aktu\u225?ln\u237? uzel).\par


\pard\par

\b\fs22 Zobrazit obr\u225?zky \b0\fs20 (nab\u237?dka Zobrazit, tla\u269?\u237?tko na panelu n\u225?stroj\u367?)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 S \cf3\b Ctrl\cf0\b0  lze znovu na\u269?\u237?st vybran\u233? obr\u225?zky nebo je znovu skr\u253?t, v z\u225?vislosti na aktu\u225?ln\u237?m stavu viditelnosti\par

{\pntext\f2\'B7\tab}S \cf3\b Alt\cf0\b0  obnov\u237? proporce obr\u225?zk\u367?.\par


\pard\sb80 V\u237?ce informac\u237? naleznete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|17096|0|9"}}{\fldrslt{Viditelnost obr\u225?zk\u367?}}}}}\f0\fs20 \par


\pard\par

\par

}
