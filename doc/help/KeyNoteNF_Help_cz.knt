\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 K \u269?emu je KeyNote \f0\lang3082 NF \f1\lang1045 u\u382?ite\u269?n\u253??\cf0\b0\par

\fs26\par

\fs20 Obecn\u283? \b\f0 jak\u225?koli strukturovan\u225? nebo voln\u283? formovan\u225? informace,\b0\f1  zejm\u233?na ten druh informac\u237?, kter\u253? se hod\u237? pro \b\f0 hierarchick\u233? zobrazen\u237?, jako jsou seznamy nebo osnovy.\b0\f1  V\u253?konn\u225? funkce \b\f0 vyhled\u225?v\u225?n\u237?\b0\f1  v KeyNote rychle najde informace, kter\u233? hled\u225?te.\par

\par

\f0\lang3082 Mo\u382?nost \b vkl\u225?dat obr\u225?zky v r\u367?zn\u253?ch form\u225?tech\b0 , propojen\u233? nebo vlo\u382?en\u233?, kter\u233? lze ulo\u382?it bin\u225?rn\u283?, jak v souboru .knt, tak v extern\u237?ch souborech, usnad\u328?uje jeho pou\u382?it\u237? jako \b n\u225?stroje pro dokumentaci\b0  nebo alternativy k form\u225?tu \cf2 .\b chm\cf0\b0 .\par

\f1\lang1045\par

Mo\u382?nost \b\f0 ulo\u382?it mnoho pozn\u225?mek do jedin\u233?ho souboru \b0\f1 znamen\u225?, \u382?e u\u382? nemus\u237?te hledat soubory roztrou\u353?en\u233? po cel\u233?m po\u269?\u237?ta\u269?i. Mnoha u\u382?ivatel\u367?m bude sta\u269?it vytvo\u345?it jedin\u253? soubor KeyNote a p\u345?idat do n\u283?j \b\f0\lang3082 slo\u382?ky\b0\f1\lang1045 , p\u345?i\u269?em\u382? ka\u382?d\u225? \f0\lang3082 slo\u382?ka\f1\lang1045  pokr\u253?v\u225? samostatn\u233? t\u233?ma (nap\u345?. \u8222?\u218?koly\u8220?, \u8222?Adresy\u8220?, \u8222?Z\u225?lo\u382?ky\u8220?, \u8222?Finance\u8220? atd.)\par

\par

Vestav\u283?n\u233? \b\f0 siln\u233? \u353?ifrov\u225?n\u237? \b0\f1 v\u225?m umo\u382?\u328?uje zabezpe\u269?it soubory proti neopr\u225?vn\u283?n\u233?mu p\u345?\u237?stupu nebo \u250?prav\u225?m.\par

\par

\f0 Funkce \u8222?\b virtu\u225?ln\u237? uzel\b0 "\b \u8220? \b0\f1 nav\u237?c umo\u382?\u328?uje shrom\u225?\u382?dit mnoho soubor\u367? a upravovat je v\u353?echny v jedin\u233?m souboru KeyNote, p\u345?i\u269?em\u382? p\u367?vodn\u237? soubory z\u367?st\u225?vaj\u237? na disku (tak\u382?e nen\u237? nutn\u233? prov\u225?d\u283?t \u382?\u225?dnou konverzi).\par

\par

\f0\lang3082 Viz tak\u233?: {\f1{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<15|0|0"}}{\fldrslt{Soubory KeyNote}}}}}\f0\fs20  (KeyNote nen\u237? \u8222?norm\u225?ln\u237?\u8220? editor textov\u253?ch soubor\u367? ani soubor\u367? ve form\u225?tu RTF.)\par

\f1\lang1045\par

\par

\cf1\b\fs26 P\u345?\u237?klady pou\u382?it\u237?:\cf0\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\f0\lang3082 \f1\lang1045 Osobn\u237? \b\f0 spr\u225?va informac\u237?\b0\f1\par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 Osobn\u237? \b\f0 den\u237?k \b0\f1 nebo \u382?urn\u225?l \par

{\pntext\f2\'B7\tab}\b\f0 Zaznamen\u225?v\u225?n\u237? pozn\u225?mek na \u353?kolen\u237?ch\b0 , se snadn\u253?m vkl\u225?d\u225?n\u237?m obr\u225?zk\u367? b\u283?hem nich.\par

{\pntext\f2\'B7\tab}\b Dokumentace\b0  instala\u269?n\u237?ch proces\u367?, mo\u382?n\u225? s automatick\u253?m vkl\u225?d\u225?n\u237?m obr\u225?zk\u367?.\par

{\pntext\f2\'B7\tab}\b Soubor n\u225?pov\u283?dy\b0  pou\u382?\u237?van\u253? z jin\u253?ch aplikac\u237? jako alternativa ke kompilovan\u233?mu form\u225?tu \b .chm\b0  ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<77|0|0"}}{\fldrslt{V\u237?ce}}}}}\f0\fs20 )\lang1033\par

{\pntext\f2\'B7\tab}\lang3082 \f1\lang1045 Dokumentace projektu \par

{\pntext\f2\'B7\tab}\b\f0 \b0\f1 Polo\u382?ky \u250?kol\u367? \par

{\pntext\f2\'B7\tab}\b\f0 Pozn\u225?mkov\u253? blok \b0\f1 pro rychl\u233? pozn\u225?mky a n\u225?pady \par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 Psan\u237? a strukturov\u225?n\u237? mal\u253?ch \u269?l\u225?nk\u367? nebo v\u283?t\u353?\u237?ch dokument\u367? \par

{\pntext\f2\'B7\tab}Vytv\u225?\u345?en\u237? a ukl\u225?d\u225?n\u237? \b\f0 elektronick\u253?ch text\u367? \b0\f1 (snadn\u233? strukturov\u225?n\u237? kapitol nebo odd\u237?l\u367?) \par

{\pntext\f2\'B7\tab}\b\f0 Osnovy\b0\f1 , projekty\par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 Zpr\u225?vy \par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 Recepty \par

{\pntext\f2\'B7\tab}\b\f0 Osobn\u237? kontakty \b0\f1 (adresy, telefonn\u237? \u269?\u237?sla) \par

{\pntext\f2\'B7\tab}\b\f0 \u218?\u269?ty, hesla,\b0\f1  PIN k\u243?dy (nezapome\u328?te soubor za\u353?ifrovat!) \par

{\pntext\f2\'B7\tab}Internetov\u233? z\u225?lo\u382?ky (klikateln\u233? hypertextov\u233? odkazy) \par

{\pntext\f2\'B7\tab}\b\f0 V\u353?echny druhy seznam\u367?! \b0\f1 A\u357? u\u382? sb\u237?r\u225?te knihy, CD, DVD nebo jen obl\u237?ben\u233? cit\u225?ty \u269?i vtipy, KeyNote v\u225?m umo\u382?n\u237? snadno je ulo\u382?it na jednom m\u237?st\u283? a rychle v nich vyhled\u225?vat. \par

{\pntext\f2\'B7\tab}\b\f0 Archivy e-mail\u367? \b0\f1 (k importu archiv\u367? e-mail\u367? do souboru KeyNote m\u367?\u382?ete pou\u382?\u237?t samostatn\u253? bezplatn\u253? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<73|0|0"}}{\fldrslt{KNTConvert}}}}}\f1\fs20  n\u225?stroj) \par

{\pntext\f2\'B7\tab}\b\f0 \u352?ablony \b0\f1 pro vytv\u225?\u345?en\u237? dokument\u367? se standardn\u237?m form\u225?tem \par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 V\u253?pisy adres\u225?\u345?\u367? (nap\u345?. archivy CDR) \par

{\pntext\f2\'B7\tab}\f0\lang3082 \f1\lang1045 Prohl\u237?\u382?en\u237? \b\f0 soubor\u367? protokol\u367? \b0\f1 (pomoc\u237? virtu\u225?ln\u237?ch uzl\u367? m\u367?\u382?ete prohl\u237?\u382?et soubory protokol\u367?, ani\u382? byste museli ka\u382?d\u253? soubor otev\u237?rat zvl\u225?\u353?\u357?) \par

{\pntext\f2\'B7\tab}\b\f0 Pro u\u269?itele: \b0\f1 pozn\u225?mky z v\u253?uky, pozn\u225?mky o doch\u225?zce a hodnocen\u237? student\u367? \par

{\pntext\f2\'B7\tab}\b\f0 Pro program\u225?tory: \b0\f1 KeyNote je skv\u283?l\u253? pro ukl\u225?d\u225?n\u237? a prohled\u225?v\u225?n\u237? archiv\u367? zdrojov\u233?ho k\u243?du \par


\pard\par

}
