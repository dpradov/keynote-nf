\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Spr\u225?va upozorn\u283?n\u237?\cf2\lang1033\par

\cf0\b0\fs20\par

KeyNote umo\u382?\u328?uje nastavit upozorn\u283?n\u237? v souboru .KNT. \f1\lang3082 K uzlu je mo\u382?n\u233? p\u345?i\u345?adit \b v\u237?ce upozorn\u283?n\u237?\b0  \super 1\nosupersub , nebo dokonce p\u345?\u237?mo ke \b slo\u382?ce\b0 . \par

\par

Ka\u382?d\u233? upozorn\u283?n\u237? m\u367?\u382?e m\u237?t n\u225?sleduj\u237?c\u237? informace:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Slo\u382?ka a voliteln\u283? pozn\u225?mka (uzel) jako kontext\par

{\pntext\f2\'B7\tab}P\u345?edm\u283?t (v\u237?ce\u345?\u225?dkov\u253?)\par

{\pntext\f2\'B7\tab}Datum a \u269?as vypr\u353?en\u237?/zah\u225?jen\u237?\par

{\pntext\f2\'B7\tab}Datum a \u269?as p\u345?ipomenut\u237?\par

{\pntext\f2\'B7\tab}Form\u225?t: lze zv\u253?raznit zm\u283?nou barvy textu, barvy pozad\u237? nebo nastaven\u237?m tu\u269?n\u233?ho p\u237?sma.\par


\pard\sb160\sa100\super 1\nosupersub  Kdy\u382? je uzel p\u345?esunut do jin\u233? slo\u382?ky, upozorn\u283?n\u237? se p\u345?esune tak\u233?\line M\u367?\u382?ete zapnout nebo vypnout \b vyskakovac\u237? okna upozorn\u283?n\u237?\b0  a tak\u233? zapnout nebo vypnout \b zvuk\b0  p\u345?i spu\u353?t\u283?n\u237? upozorn\u283?n\u237?.\par


\pard\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<76|670|0|1"}}{\fldrslt{Jak p\u345?idat nov\u233? alarmy}}}}}\f1\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<76|1632|0|2"}}{\fldrslt{Okno alarm\u367?}}}}}\f1\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<76|3218|0|3"}}{\fldrslt{P\u345?id\u225?n\u237? nebo \u250?prava alarmu}}}}}\f1\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<76|5304|0|4"}}{\fldrslt{Ozn\u225?men\u237? p\u345?ipom\u237?nky}}}}}\f1\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<76|6922|0|5"}}{\fldrslt{Zru\u353?en\u237? alarm\u367? / p\u345?ipom\u237?nek}}}}}\f1\fs20\par

\par

\par

\b\v\f0\fs24\lang1033\'11B1\'12\v0 Jak p\u345?idat nov\u225? upozorn\u283?n\u237?\b0\par

\fs20\par

Upozorn\u283?n\u237? m\u367?\u382?ete p\u345?idat n\u283?kolika zp\u367?soby:\par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360\f1\lang3082 Pomoc\u237? polo\u382?ek nab\u237?dky Tools | Alarms...:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li720\b Set alarm...\b0   P\u345?id\u225? nebo uprav\u237? upozorn\u283?n\u237? u uzlu nebo p\u345?\u237?mo u slo\u382?ky\par


\pard\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360 Pomoc\u237? polo\u382?ky m\u237?stn\u237? nab\u237?dky panelu stromu:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li720\b Set alarm on node...\b0   P\u345?id\u225? nebo uprav\u237? upozorn\u283?n\u237? u uzlu stromu\par


\pard  \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360 Pomoc\u237? tla\u269?\u237?tka na panelu n\u225?stroj\u367? \v\'11I51\'12\v0\f0\lang1033{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:51,19,19"}}{\fldrslt {51_Main_51.png}}}}\f1\lang3082  odpov\u237?daj\u237?c\u237?ho polo\u382?ce \ul Tools|Alarms...|Set alarm...\ulnone\par


\pard\li720\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360 Pomoc\u237? tla\u269?\u237?tka \b New\b0  v okn\u283? upozorn\u283?n\u237?\par


\pard\li360 Nov\u233? upozorn\u283?n\u237? bude p\u345?i\u345?azeno ke stejn\u233? polo\u382?ce (uzlu nebo slo\u382?ce) jako d\u345?\u237?ve vybran\u233? upozorn\u283?n\u237?. Pokud nebylo vybr\u225?no \u382?\u225?dn\u233? upozorn\u283?n\u237?, bude p\u345?i\u345?azeno k aktivn\u237? slo\u382?ce.\par


\pard\f0\lang1033\par

\f1\lang3082 Pozn\u225?mka\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360 Tla\u269?\u237?tka (a odpov\u237?daj\u237?c\u237? polo\u382?ky nab\u237?dky) \u8222?Set alarm...\u8220?  a \u8222?Set alarm on node...\u8220? up\u345?ednost\u328?uj\u237? akci \u250?pravy: pokud je \b upozorn\u283?n\u237? definov\u225?no \b0 ji\u382?\b , kliknut\u237?m toto upozorn\u283?n\u237? uprav\u237?te\b0 .\par

{\pntext\f2\'B7\tab}Pomoc\u237? \cf3\b\f0\fs18\lang1033 Shift\cf0\b0\f1\fs20\lang3082  p\u345?idejte nebo upravte upozorn\u283?n\u237? p\u345?\u237?mo u \b slo\u382?ky\b0 .\par

{\pntext\f2\'B7\tab}Pomoc\u237? \cf3\b\f0\fs18\lang1033 Ctrl \cf0\b0\f1\fs20\lang3082 zajist\u283?te, \u382?e \b p\u345?id\u225?te\b0  \b nov\u233? upozorn\u283?n\u237?\b0\par


\pard\par

\par

\par

\f0\lang1033\par


\pard\sb100\sa100\b\v\f1\fs24\lang3082\'11B2\'12\v0 Okno upozorn\u283?n\u237?\par


\pard\b0\fs20 Okno spr\u225?vy upozorn\u283?n\u237? umo\u382?\u328?uje zobrazit a upravovat v\u353?echna upozorn\u283?n\u237?. Je to okno, jeho\u382? velikost lze m\u283?nit a kter\u233? je nemod\u225?ln\u237?, tak\u382?e z programu KeyNote m\u367?\u382?ete do n\u283?j kop\u237?rovat a vkl\u225?dat.\par

\par


\pard\li240\v\'11I118\'12\v0\f0\lang1033{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:118,864,513"}}{\fldrslt {118_Clipb_05ene.png}}}}\f1\lang3082\par


\pard\par

V\u353?echny informace o upozorn\u283?n\u237?ch jsou zobrazeny v \b tabulce\b0  \cf4 [3]\cf0 . Seznam upozorn\u283?n\u237? m\u367?\u382?ete \u345?adit kliknut\u237?m na z\u225?hlav\u237? jednotliv\u253?ch sloupc\u367?: slo\u382?ka (n\u225?zev), pozn\u225?mka (n\u225?zev), datum vypr\u353?en\u237?/zah\u225?jen\u237? - \u269?as, p\u345?edm\u283?t, datum p\u345?ipomenut\u237? - \u269?as.\par


\pard\sb80 M\u367?\u382?ete tak\u233? \b zkop\u237?rovat do schr\u225?nky\b0  tabulku se seznamem vybran\u253?ch upozorn\u283?n\u237?, v\u269?etn\u283? v\u353?ech pol\u237? viditeln\u253?ch v tabulce a dal\u353?\u237?ho sloupce s odkazem na uzly nebo pozn\u225?mky. \cf4 [13]\cf0\par


\pard\par


\pard\sa100 M\u367?\u382?ete zobrazit v\u353?echna upozorn\u283?n\u237? nebo v\u253?b\u283?r na z\u225?klad\u283? jejich stavu: \cf4 [1]\cf0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\b All\b0  \tab\tab Zobraz\u237? v\u353?echna nastaven\u225? upozorn\u283?n\u237? (nezru\u353?en\u225?)\par

{\pntext\f2\'B7\tab}\b Overdue\b0\tab Zobraz\u237? v\u353?echny ud\u225?losti po term\u237?nu (nezru\u353?en\u233?)\par

{\pntext\f2\'B7\tab}\b Pending\b0   \tab Zobraz\u237? v\u353?echna \u269?ekaj\u237?c\u237? p\u345?ipomenut\u237?: spu\u353?t\u283?n\u225? a ignorovan\u225?, nikoli odlo\u382?en\u225? ani zru\u353?en\u225?\par

{\pntext\f2\'B7\tab}\b Discarded\b0  \tab Zobraz\u237? v\u353?echna zru\u353?en\u225? / ignorovan\u225? upozorn\u283?n\u237?\par

{\pntext\f2\'B7\tab}\b All, with discarded\b0\par


\pard\par


\pard\sa100 Seznam lze tak\u233? \b filtrovat\b0  podle textu obsa\u382?en\u233?ho v n\u225?zvu p\u345?edm\u283?tu, uzlu nebo slo\u382?ky. \cf4 [2]\cf0\par


\pard\sb100\sa100 Sou\u269?\u225?st\u237? je ovl\u225?dac\u237? prvek \b kalend\u225?\u345?e\b0 , kter\u253? umo\u382?\u328?uje filtrovat podle data vypr\u353?en\u237? nebo ud\u225?losti: vybran\u233? dny / vybran\u253? t\u253?den / vybran\u253? m\u283?s\u237?c \cf4 [12]\cf0\par


\pard\sb140\sa100 Do tohoto okna se \b dostanete\b0  p\u345?i \u250?prav\u283? nebo p\u345?id\u225?v\u225?n\u237? nov\u253?ch upozorn\u283?n\u237?, p\u345?i spu\u353?t\u283?n\u237? p\u345?ipomenut\u237?, z nab\u237?dky Tools | Alarms | \ul Show Alarms\ulnone ... nebo kliknut\u237?m na n\u225?sleduj\u237?c\u237? tla\u269?\u237?tko:\par


\pard\f0\lang1033  \v\'11I52\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:52,19,19"}}{\fldrslt {52_Main_52.png}}}}\f1\lang3082   (nebo \f0\lang1033  \v\'11I53\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:53,20,20"}}{\fldrslt {53_Main_53.png}}}}, pokud existuje n\u283?jak\u233? \u269?ekaj\u237?c\u237? p\u345?ipomenut\u237? nebo ud\u225?lost po term\u237?nu) \par


\pard\li360\sb100 P\u345?i p\u345?\u237?stupu pomoc\u237? t\u283?chto tla\u269?\u237?tek uvid\u237?te pouze \u269?ekaj\u237?c\u237? upozorn\u283?n\u237? (pokud n\u283?jak\u225? jsou), nebo v\u353?echna. Pomoc\u237? polo\u382?ky nab\u237?dky Show Alarms uvid\u237?te v\u353?echna upozorn\u283?n\u237? (nezru\u353?en\u225?).\par


\pard  \f1\lang3082\par


\pard\sb100\sa100\b Tip:\b0  Okno m\u367?\u382?ete zav\u345?\u237?t stisknut\u237?m kl\u225?vesy \cf3\b\f0\lang1033 Esc\cf0\b0\f1\lang3082 .\par


\pard\sa100\b Tip:\b0  \cf3\b\f0\lang1033 Ctrl+Click\cf0\b0\f1\lang3082  na upozorn\u283?n\u237? v tabulce vybere odpov\u237?daj\u237?c\u237? slo\u382?ku a uzel a z\u225?rove\u328? zachov\u225? fokus v okn\u283? upozorn\u283?n\u237?.\par


\pard\sb100\sa100\par


\pard\sa100\b\v\fs24\'11B3\'12\v0 P\u345?id\u225?n\u237? nebo \u250?prava upozorn\u283?n\u237?\b0\par


\pard\fs20 Je nutn\u233? uv\u233?st \b p\u345?edm\u283?t\b0  a \b \u269?as p\u345?ipomenut\u237?\b0 . Voliteln\u283? m\u367?\u382?ete definovat \b \u269?as ud\u225?losti nebo vypr\u353?en\u237?\b0 .\par

\b\f0\lang1033 Slo\u382?ka\b0  a (voliteln\u283?) \b uzel\b0  jsou tak\u233? povinn\u233?, ale nastavuj\u237? se implicitn\u283?.\par

\par

Na uk\u225?zkov\u233?m sn\u237?mku obrazovky oblast zv\u253?razn\u283?n\u225? \cf2 modr\u253?m \u269?tvercem\cf0  umo\u382?\u328?uje zobrazit a upravit informace o vybran\u233?m upozorn\u283?n\u237? v tabulce, pokud n\u283?jak\u233? je.\par

\ul Slo\u382?ka (a uzel)\ulnone  \cf4\f1\lang3082 [6] \cf0\f0\lang1033 jsou zobrazeny nad textov\u253?m polem \ul p\u345?edm\u283?tu\ulnone  \cf4\f1\lang3082 [7] \cf0\f0\lang1033 .\cf4\f1\lang3082\par

\cf0\f0\lang1033\par

\par

\b\f1\lang3082 Okam\u382?ik p\u345?ipomenut\u237?\b0  se nastavuje \b relativn\u237?m zp\u367?sobem\b0 , a to dv\u283?ma zp\u367?soby:  \cf4 [9]\cf0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Zad\u225?n\u237?m \u269?asov\u233?ho intervalu \b p\u345?ed\b0  datem \ul ud\u225?losti nebo vypr\u353?en\u237?\ulnone , \par

{\pntext\f2\'B7\tab}Pomoc\u237? \u269?asov\u233?ho intervalu \b od\b0  \ul aktu\u225?ln\u237?ho okam\u382?iku\ulnone .\f0\lang1033\par


\pard\sb100\f1\lang3082 Pro zad\u225?n\u237? t\u283?chto \b interval\u367?\b0  byl p\u345?id\u225?n rozev\u237?rac\u237? seznam, kter\u253? obsahuje polo\u382?ky, je\u382? m\u367?\u382?ete \ul vybrat\ulnone , nap\u345?\u237?klad \u8222?5 minut\u8220?, \u8222?4 hodiny\u8220? nebo \u8222?2 dny\u8220?.\par


\pard\sb80 Intervaly m\u367?\u382?ete tak\u233? \ul zapisovat\ulnone  jako \u8222?5m\u8220?, \u8222?5 min\u8220?, \u8222?4.5 h\u8220? atd. Pokud nen\u237? jednotka \u269?asu uvedena, p\u345?edpokl\u225?daj\u237? se \u8222?minuty\u8220? \par


\pard\sb100\sa100\ul \u268?asov\u225? tla\u269?\u237?tka\ulnone  (\u8222?5 min\u8220?, \u8222?10 min\u8220?, \u8222?Dnes v: 15:00\u8220?, \u8230?) st\u225?le nab\u237?zej\u237? pomoc \ul p\u345?i nastaven\u237?\ulnone  okam\u382?iku p\u345?ipomenut\u237? a \b rychl\u233? odlo\u382?en\u237?\b0  p\u345?ipomenut\u237?.\par


\pard\f0\lang1033\par

\b * \ul\b0 Pozn\u225?mka\ulnone : \u268?as p\u345?ipomenut\u237? bude ve v\u253?choz\u237?m nastaven\u237? nastaven na \i 5 minut od te\u271?\i0 .\par

\par

Po definov\u225?n\u237? se zobraz\u237? v \b Dal\u353?\u237?m p\u345?ipomenut\u237?\b0  \cf4\f1\lang3082 [10] \cf0\f0\lang1033 jako absolutn\u237? okam\u382?ik. N\u237?\u382?e m\u367?\u382?ete vid\u283?t zb\u253?vaj\u237?c\u237? \u269?as (nebo zpo\u382?d\u283?n\u237?), p\u345?i\u269?em\u382? jako reference slou\u382?\u237? aktu\u225?ln\u237? \u269?as.\par

\par

\par

\f1\lang3082 Chcete-li definovat \b \u269?as ud\u225?losti nebo vypr\u353?en\u237?\b0 , je nejprve nutn\u233? povolit p\u345?idru\u382?en\u233? rozev\u237?rac\u237? seznamy data a \u269?asu za\u353?krtnut\u237?m pol\u237?\u269?ka \cf4 [8]\cf0\par

Pro zad\u225?n\u237? \u269?asu v\u225?m rozev\u237?rac\u237? seznam umo\u382?\u328?uje vybrat polo\u382?ku ze seznamu a tak\u233? p\u345?\u237?mo zapisovat hodiny r\u367?zn\u253?mi zp\u367?soby, jako \u8222?12:23\u8220? \u8222?1223\u8220? \u8222?12-23\u8220? \u8222?0531\u8220? \u8222?531\u8220? a podobn\u283?.\f0\lang1033\par

\par

Pod rozev\u237?rac\u237?m seznamem \f1\lang3082 \u269?asu\f0\lang1033  m\u367?\u382?ete vid\u283?t zb\u253?vaj\u237?c\u237? \u269?as (nebo zpo\u382?d\u283?n\u237?).\par

\par

\par

\cf2\b Zm\u283?ny\cf0  je t\u345?eba potvrdit\b0  tla\u269?\u237?tkem \b Pou\u382?\u237?t\b0  nebo za\u353?krtnut\u237?m pol\u237?\u269?ka \b Pou\u382?\u237?t automaticky\b0  \cf4\f1\lang3082 [8]\cf0\f0\lang1033 .\par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360\f1\lang3082 P\u345?i v\u253?b\u283?ru jin\u233?ho bud\u237?ku (jin\u253?ch bud\u237?k\u367?) nebo zav\u345?en\u237? okna (nap\u345?. pomoc\u237? \cf3\b\f0\lang1033 Esc\cf0\b0\f1\lang3082 ) se zm\u283?ny automaticky pou\u382?ij\u237?, pokud je povoleno \ul Pou\u382?\u237?t automaticky\ulnone . V opa\u269?n\u233?m p\u345?\u237?pad\u283? bude pro pou\u382?it\u237? t\u283?chto zm\u283?n vy\u382?adov\u225?no potvrzen\u237?.\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360\sb80 M\u367?\u382?ete pracovat s \b n\u283?kolika bud\u237?ky sou\u269?asn\u283?\b0 . Nap\u345?\u237?klad pro zm\u283?nu jejich barvy najednou.\par


\pard\li360 Bude vy\u382?adov\u225?no \b potvrzen\u237?\b0 , i kdy\u382? je za\u353?krtnuto \ul Pou\u382?\u237?t automaticky\ulnone .\par


\pard\f0\lang1033\par

\par


\pard\sa100\b\v\f1\fs24\lang3082\'11B4\'12\v0 Ozn\u225?men\u237? p\u345?ipomenut\u237?\b0\par


\pard\f0\fs20\lang1033 Kdy\u382? se ozve n\u283?jak\u233? \b p\u345?ipomenut\u237?\b0 , p\u345?ehraje se \b zvuk\b0  a okno Bud\u237?ky \b vysko\u269?\u237?\b0  ve zmen\u353?en\u233? velikosti a zobraz\u237? pouze odpov\u237?daj\u237?c\u237? bud\u237?k(y). \par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Chcete-li p\u345?ipomenut\u237? \b odlo\u382?it\b0  v\u253?b\u283?rem nov\u233?ho intervalu:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720 Jednodu\u353?e klikn\u283?te na \ul \u269?asov\u233? tla\u269?\u237?tko\ulnone  a stiskn\u283?te \cf3\b Esc\cf0\b0\f1\lang3082   (ve v\u253?choz\u237?m nastaven\u237? je vybr\u225?no \u8222?Od te\u271?\u8220?)\f0\lang1033\par

{\pntext\f2\'B7\tab}\f1\lang3082 Nastavte nov\u253? \u269?as p\u345?ipomenut\u237? stejn\u253?m zp\u367?sobem, jak\u253?m jste postupovali p\u345?i vytv\u225?\u345?en\u237? bud\u237?ku\f0\lang1033\par


\pard\li360\sb100\b\f1\lang3082 Tip\b0 : Pouh\u253?m stisknut\u237?m \cf3\b\f0\lang1033 Esc\cf0\b0\f1\lang3082  se okno zav\u345?e a \u269?as p\u345?ipomenut\u237? z\u367?stane nezm\u283?n\u283?n; bud\u237?k(y) z\u367?stane(ou) ve stavu \u269?ek\u225?n\u237?. KeyNote tyto p\u345?ipomenut\u237? znovu spust\u237? po 5 minut\u225?ch.\par

\b Tip\b0 : M\u367?\u382?ete upravit jak\u253?koli jin\u253? bud\u237?k. Sta\u269?\u237? vybrat re\u382?im \cf4 [1] \cf0 , kter\u253? pot\u345?ebujete pro zobrazen\u237? dal\u353?\u237?ch bud\u237?k\u367?.\f0\lang1033\par


\pard\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\f1\lang3082 M\u367?\u382?ete povolit nebo zak\u225?zat \b zvuk\b0  p\u345?i spu\u353?t\u283?n\u237? bud\u237?ku  \cf4 [13]\cf0\f0\lang1033\par


\pard\li360\sa100\b Tip\b0 : Zvuk lze p\u345?izp\u367?sobit nahrazen\u237?m souboru \u8222?alert.wav\u8220?.\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\f1\lang3082 M\u367?\u382?ete povolit nebo zak\u225?zat \b vyskakovac\u237? okna bud\u237?k\u367?\b0 , pokud nechcete b\u253?t bud\u237?ky p\u345?eru\u353?ov\u225?ni :\f0\lang1033\par


\pard\li360 Kdy\u382? je tla\u269?\u237?tko \v\'11I52\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:52,19,19"}}{\fldrslt {52_Main_52.png}}}}\f1\lang3082   (nebo \f0\lang1033  \v\'11I53\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:53,20,20"}}{\fldrslt {53_Main_53.png}}}} ) stisknut\u233?, vyskakovac\u237? okna bud\u237?k\u367? jsou povolena. Jinak jsou zak\u225?z\u225?na.\par

M\u367?\u382?ete to tak\u233? zm\u283?nit v \ul N\u225?stroje | Bud\u237?ky... | Vyskakovac\u237? okna p\u345?ipomenut\u237?\ulnone\par

\par


\pard\li720 Povoleno:\par


\pard\li840  \v\'11I116\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:116,74,35"}}{\fldrslt {116_Clipboard_05ene.png}}}}\par


\pard\li720  \par

 Zak\u225?z\u225?no:\par


\pard\li840  \v\'11I117\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:117,181,51"}}{\fldrslt {117_Clipboard_05ene.png}}}}\par


\pard\li720  \par

 Jak vid\u237?te, n\u225?pov\u283?da tohoto tla\u269?\u237?tka zobraz\u237? po\u269?et \u269?ekaj\u237?c\u237?ch p\u345?ipomenut\u237? a ud\u225?lost\u237? po term\u237?nu\par

 \par


\pard Pozn\u225?mka:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Kdy\u382? se p\u345?ipomenut\u237? spust\u237?, obr\u225?zek tla\u269?\u237?tka blik\u225? (st\u345?\u237?dav\u283? mezi obr\u225?zky \v\'11I52\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:52,19,19"}}{\fldrslt {52_Main_52.png}}}}\f1\lang3082  a  \v\'11I53\'12\v0\f0\lang1033{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:53,20,20"}}{\fldrslt {53_Main_53.png}}}}\f1\lang3082 )\f0\lang1033\par

{\pntext\f2\'B7\tab}\f1\lang3082 Pokud tla\u269?\u237?tko z\u367?stane pevn\u283? na \v\'11I53\'12\v0\f0\lang1033{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:53,20,20"}}{\fldrslt {53_Main_53.png}}}}, znamen\u225? to, \u382?e existuj\u237? \u269?ekaj\u237?c\u237? p\u345?ipomenut\u237? a/nebo ud\u225?losti po term\u237?nu.\par

{\pntext\f2\'B7\tab}Pokud jsou \b vyskakovac\u237? okna zak\u225?z\u225?na\b0 , budou nov\u233? spu\u353?t\u283?n\u233? bud\u237?ky ozn\u225?meny ve stavov\u233?m \u345?\u225?dku po dobu p\u345?ibli\u382?n\u283? jedn\u233? sekundy za ka\u382?d\u253? nov\u253? bud\u237?k. Bude tak\u233? blikat neomezen\u283?, dokud na tla\u269?\u237?tko nep\u345?ejede kurzorem, kter\u253? zobraz\u237? n\u225?pov\u283?du s po\u269?tem \u269?ekaj\u237?c\u237?ch bud\u237?k\u367?.\par


\pard\li360  \par

 \par


\pard\sa100\b\v\fs24\'11B5\'12\v0 Zahozen\u237? bud\u237?k\u367? / p\u345?ipomenut\u237?\b0\par


\pard\fs20 Jakmile p\u345?ipomenut\u237? ji\u382? nen\u237? pot\u345?eba (ud\u225?lost nebo \u250?kol skon\u269?il \u269?i byl opu\u353?t\u283?n), m\u367?\u382?ete bud\u237?k \cf4\f1\lang3082 [4]\cf0\f0\lang1033  zahodit. Zahozen\u233? bud\u237?ky nespust\u237? \u382?\u225?dn\u253? podn\u283?t.\par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360\b\f1\lang3082 Zahozen\u233? bud\u237?ky \ul nejsou\ulnone  smaz\u225?ny\b0 . Jednodu\u353?e se ignoruj\u237?. Kdykoli je m\u367?\u382?ete \b obnovit\b0  \cf4 [5]\cf0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent360{\pntxtb\'B7}}\fi-360\li360\sb80 Smazat lze pouze zahozen\u233? bud\u237?ky, a to tla\u269?\u237?tkem \b Odebrat\b0  \cf4 [5]\cf0 . Budou trvale smaz\u225?ny.\par


\pard\li360\sb60 Pozn\u225?mka: \b Odebr\u225?n\u237?\b0  jak\u233?hokoli bud\u237?ku \b v\u382?dy vy\u382?aduje potvrzen\u237?\b0 .\par


\pard\f0\lang1033\par

}
%*
GI=77
ND=Soubor .KNT jako nápověda z jiných aplikací
%.
%:
{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red0\green0\blue128;\red32\green32\blue32;\red64\green64\blue64;\red128\green0\blue0;}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Pou\u382?\u237?v\u225?n\u237? soubor\u367? .knt aplikace KeyNote NF jako soubor\u367? n\u225?pov\u283?dy\cf2\lang1033\par

\cf0\b0\fs20\par

\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<77|215|0|1"}}{\fldrslt{\u218?vod}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<77|1219|0|2"}}{\fldrslt{Jak aktivovat soubor n\u225?pov\u283?dy zobrazuj\u237?c\u237? konkr\u233?tn\u237? pozice}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<77|2860|0|3"}}{\fldrslt{Ur\u269?en\u237? ID, ze kter\u253?ch se vytv\u225?\u345?ej\u237? c\u237?lov\u233? pozice pro skok}}}}}\f0\fs20\par

\par

\par


\pard\sa80\cf3\b\v\fs24\'11B1\'12\v0 \u218?vod\cf0\b0\fs20\par


\pard KeyNote lze pou\u382?\u237?t k vytv\u225?\u345?en\u237? \b soubor\u367? n\u225?pov\u283?dy pro jin\u233? aplikace\b0  jako alternativu k soubor\u367?m \b .chm\b0 .\par

\par

Podle pot\u345?eby m\u367?\u382?e m\u237?t soubor n\u225?pov\u283?dy .knt distribuovan\u253? s va\u353?\u237? aplikac\u237? \b obr\u225?zky vlo\u382?en\u233?\b0 , nebo je m\u367?\u382?e m\u237?t mimo, ve slo\u382?ce \u269?i v extern\u237?m archivu ZIP. V ka\u382?d\u233?m p\u345?\u237?pad\u283? je mo\u382?n\u233? (a obvykle vhodn\u233?) pracovat se souborem n\u225?pov\u283?dy s obr\u225?zky mimo soubor .knt a na konci je do distribuovan\u233?ho souboru zahrnout, \u269?\u237?m\u382? vznikne kopie s vlo\u382?en\u253?mi obr\u225?zky. Tuto kopii lze vytvo\u345?it jednodu\u353?e pomoc\u237? \ul Soubor|Kop\u237?rovat do...\ulnone  nebo \ul Soubor|Exportovat...\ulnone , p\u345?i\u269?em\u382? zajist\u283?te, \u382?e m\u225?te v mo\u382?nostech konfigurace nastaveno, \u382?e se obr\u225?zky p\u345?i exportu vkl\u225?daj\u237?. Viz {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|0|0"}}{\fldrslt{Spr\u225?va obr\u225?zk\u367? v KeyNote NF}}}}}\f0\fs20\par

\par

Pozn\u225?mka: Pr\u225?v\u283? tento soubor, kter\u253? \u269?tete, je soubor .knt vytvo\u345?en\u253? v KeyNote NF. P\u367?vodn\u237?, \u8222?pracovn\u237?\u8220? soubor pou\u382?\u237?v\u225? re\u382?im ukl\u225?d\u225?n\u237? \u8222?External\u8220? s typem \u8222?Folder\u8220?. Tento soubor n\u225?pov\u283?dy, p\u345?ilo\u382?en\u253? k distribuci KeyNote NF, byl vytvo\u345?en pomoc\u237? Soubor|Kop\u237?rovat do.\par

\par

\par


\pard\sa80\cf3\b\v\fs24\'11B2\'12\v0 Jak aktivovat soubor n\u225?pov\u283?dy zobrazuj\u237?c\u237? konkr\u233?tn\u237? pozice (uzly, zna\u269?ky)\cf0\b0\fs20\par


\pard Distribuce KeyNote NF obsahuje dopl\u328?kov\u253? n\u225?stroj \b KntLauncher.exe\b0 . Jeho funkc\u237? je zajistit, aby ur\u269?it\u253? soubor .knt byl otev\u345?en v samostatn\u233? instanci, p\u345?i\u269?em\u382? se vyu\u382?ije instance, kter\u225? tento soubor ji\u382? m\u367?\u382?e m\u237?t otev\u345?en\u253?.\par

  \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\ul kntLauncher.exe\ulnone  mus\u237? b\u253?t ve stejn\u233? slo\u382?ce, kde se nach\u225?z\u237? \ul keynote.exe\ulnone \par


\pard\par

Jak to funguje?\par

Tento n\u225?stroj p\u345?ij\u237?m\u225? stejn\u233? parametry jako keynote.exe. Za\u269?ne t\u237?m, \u382?e se pokus\u237? naj\u237?t instanci KeyNote, kter\u225? ji\u382? m\u225? otev\u345?en\u253? stejn\u253? soubor, jak\u253? byl p\u345?ed\u225?n jako argument.\par


\pard\sb80 
Pokud byl mezi vstupn\u237?mi parametry p\u345?ed\u225?n argument \b -title\b0  (doporu\u269?eno), bude tento dopln\u283?k hledat existuj\u237?c\u237? instanci KeyNote podle n\u225?zvu okna \f1\emdash\f0 a tak\u233? ClassName aplikace KeyNote. (Pou\u382?ije funkci API FindWindow). Pokud ji najde, po\u382?\u225?d\u225? tuto instanci o zpracov\u225?n\u237? p\u345?\u237?kazov\u233?ho \u345?\u225?dku, co\u382? instance provede pouze tehdy, m\u225?-li otev\u345?en\u253? soubor .knt uveden\u253? na p\u345?\u237?kazov\u233?m \u345?\u225?dku.\par

Pokud \cf4\b -\cf5 title\b0  \cf0  nebyl p\u345?ed\u225?n, dopln\u283?k projde v\u353?echna okna (pomoc\u237? EnumWindows) a bude hledat spr\u225?vnou instanci Keynote.\par


\pard\sb120 Pokud instance p\u345?ijme proveden\u237? p\u345?\u237?kazov\u233?ho \u345?\u225?dku, bude p\u345?inejmen\u353?\u237?m aktivov\u225?na, obnovena a stane se oknem v pop\u345?ed\u237?, ale p\u345?\u237?kazov\u253? \u345?\u225?dek bude obvykle obsahovat tak\u233? parametr \b -jmp\b0  pro zobrazen\u237? ur\u269?it\u233?ho um\u237?st\u283?n\u237?. M\u367?\u382?e tak\u233? obsahovat dodate\u269?n\u233? spu\u353?t\u283?n\u237? makra a/nebo pluginu.\par


\pard\par


\pard\sb120 Pokud nenajde \u382?\u225?dnou instanci, kter\u225? ji\u382? m\u225? soubor otev\u345?en\u253?, spust\u237? otev\u345?en\u237? \b nov\u233? instance\b0  s p\u345?ed\u225?n\u237?m p\u345?ijat\u233?ho p\u345?\u237?kazov\u233?ho \u345?\u225?dku, ke kter\u233?mu p\u345?id\u225? volby \b -ignSI\b0  a \b -dnd\b0 .  \par

\par

\b Tip:\b0  Doporu\u269?uje se p\u345?edat n\u225?stroji kntLauncher tak\u233? soubor \b .ini\b0 , abyste zajistili, \u382?e se soubor n\u225?pov\u283?dy .knt otev\u345?e ve spr\u225?vn\u283? nakonfigurovan\u233?m profilu.\par


\pard  \par

P\u345?\u237?klady pou\u382?it\u237?:\par


\pard\li360\b kntLauncher\b0  myHelp.knt myHelp.ini -jmp"{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///*3|2|0|0"}}{\fldrslt{file:///*3|2}}}}}\f0\fs20 " -title"MyHelp Topics"\par

\b kntLauncher\b0  myHelp.knt -jmp"{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///*3|16|5|0|1"}}{\fldrslt{file:///*3|16|5|0|1}}}}}\f0\fs20 "\par

\b kntLauncher\b0  -jmp"{{\cf0\ul{\field{\*\fldinst{HYPERLINK file:///..\\\\Doc\\\\myFile.knt*3|2 }}{\fldrslt{file:///..\\Doc\\myFile.knt*3|2}}}}}\f0\fs20 "\par

\b kntLauncher\b0  myHelp.knt myMacro.knm myPlugin.knl\par


\pard\par

Pamatujte, \u382?e obecn\u253? form\u225?t odkazu KNT je:\par


\pard\sb40   {{\cf0\ul{\field{\*\fldinst{HYPERLINK file:///PathToKntFile.knt*FolderID|NoteID|CaretPosition|SelectionLength|MarkID }}{\fldrslt{file:///PathToKntFile.knt*FolderID|NoteID|CaretPosition|SelectionLength|MarkID}}}}}\f0\fs20\par


\pard\par

V\u237?ce informac\u237? v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|19244|0|4"}}{\fldrslt{Form\u225?t intern\u237?ho odkazu KNT}}}}}\f0\fs20\par

\par

\par


\pard\sa80\cf3\b\v\fs24\'11B3\'12\v0 Identifikace ID, pomoc\u237? kter\u253?ch lze sestavit um\u237?st\u283?n\u237? pro p\u345?echod\cf0\b0\fs20\par


\pard Soubor n\u225?pov\u283?dy .knt m\u367?\u382?ete otev\u345?\u237?t tak, aby zobrazoval jak\u233?koli konkr\u233?tn\u237? um\u237?st\u283?n\u237? ur\u269?en\u233? v\u253?\u353?e uveden\u253?m form\u225?tem. Obvykle budete odkazovat pouze na slo\u382?ky a pozn\u225?mky a p\u345?\u237?padn\u283? na zna\u269?ky uvnit\u345? pozn\u225?mky.\par


\pard\sb80 Pro usnadn\u283?n\u237? identifikace ID, kter\u225? se maj\u237? pou\u382?\u237?t, umo\u382?\u328?uje KeyNote NF exportovat tyto informace:\par


\pard\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Strukturu slo\u382?ky m\u367?\u382?ete ulo\u382?it do textov\u233?ho souboru, kter\u253? pro ka\u382?dou pozn\u225?mku (uzel) zobraz\u237? jej\u237? n\u225?zev a intern\u237? ID\par


\pard\li360\sb80 Mus\u237?te \cf6\b Ctrl\cf0\b0  kliknout v Tree|{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7607|0|29"}}{\fldrslt{Ulo\u382?it strom do souboru...}}}}}\f0\fs20  ID jsou zobrazena v \u8222?[\u8220? a \u8222?]\u8220?\par


\pard\sb80\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Slo\u382?ky m\u367?\u382?ete exportovat do prost\u233?ho textu pomoc\u237? volby \ul Zobrazit skryt\u233? zna\u269?ky a ID\ulnone \par


\pard\li360\sb80 Tato volba zviditeln\u237? skryt\u233? zna\u269?ky pou\u382?\u237?van\u233? u intern\u237?ch odkaz\u367? KNT, z\u225?lo\u382?ek a obr\u225?zk\u367?. Rovn\u283?\u382? zviditeln\u237? skrytou \u269?\u225?st hypertextov\u253?ch odkaz\u367? a zobraz\u237? intern\u237? ID slo\u382?ek a uzl\u367?.\par

Viz tak\u233? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<57|15769|0|11"}}{\fldrslt{Dal\u353?\u237? nastaven\u237? p\u345?i exportu do prost\u233?ho textu}}}}}\f0\fs20\par


\pard\par

\par

}
%*
GI=78
ND=Přehled klávesových zkratek
%.
%:
{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red128\green0\blue0;\red255\green255\blue0;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 P\u345?ehled kl\u225?vesov\u253?ch zkratek\cf2\f0\lang1033\par

\cf0\b0\fs26\par

\fs20 Toto t\u233?ma obsahuje seznam kl\u225?vesov\u253?ch zkratek pou\u382?\u237?van\u253?ch v KeyNote. V\u283?t\u353?ina zkratek je viditeln\u225? a lze je snadno objevit prozkoum\u225?n\u237?m polo\u382?ek nab\u237?dky; n\u283?kolik dal\u353?\u237?ch kombinac\u237? kl\u225?ves nen\u237? v rozhran\u237? programu viditeln\u253?ch. V\u353?echny tyto zkratky jsou zde uvedeny.\par

\par

N\u283?kter\u233? p\u345?\u237?kazy nab\u237?dky nebo tla\u269?\u237?tka panelu n\u225?stroj\u367? se chovaj\u237? odli\u353?n\u283?, pokud p\u345?i kliknut\u237? na p\u345?\u237?kaz nebo tla\u269?\u237?tko podr\u382?\u237?te kl\u225?vesu \cf3\b Shift\cf0\b0  nebo \cf3\b Ctrl\cf0\b0 . Seznam t\u283?chto zvl\u225?\u353?tn\u237?ch p\u345?\u237?pad\u367? naleznete na konci tohoto souboru.\par

\par

Od verze 1.5 jsou kl\u225?vesov\u233? zkratky konfigurovateln\u233?. N\u237?\u382?e uveden\u225? t\u233?mata ukazuj\u237? v\u253?choz\u237? p\u345?i\u345?azen\u237? kl\u225?ves.\par

\par

\par

S v\u253?jimkou \cf3\b Ctrl+C\cf0\b0 , \cf3\b Ctrl+V \cf0\b0 a \cf3\b Ctrl+X\cf0\b0  bude jak\u225?koli definovan\u225? zkratka, kter\u225? nem\u225? p\u345?idru\u382?en\u253? p\u345?\u237?kaz nab\u237?dky (nap\u345?. \cf3\b Ctrl+\\\cf0\b0 ), ignorov\u225?na, pokud je stejn\u225? zkratka p\u345?idru\u382?ena k jin\u233?mu p\u345?\u237?kazu\par

\par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<79|0|0"}}{\fldrslt{Obecn\u233? kl\u225?vesov\u233? zkratky}}}}}\f0\fs20\par

{\pntext\f2\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<80|0|0"}}{\fldrslt{Kl\u225?vesov\u233? zkratky editoru}}}}}\f0\fs20\par

{\pntext\f2\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<81|0|0"}}{\fldrslt{Kl\u225?vesov\u233? zkratky stromu}}}}}\f0\fs20\par

{\pntext\f2\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<82|0|0"}}{\fldrslt{Dal\u353?\u237? kl\u225?vesov\u233? zkratky}}}}}\f0\fs20\par


\pard\par

Viz tak\u233? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<105|0|0"}}{\fldrslt{P\u345?izp\u367?soben\u237? kl\u225?vesov\u253?ch zkratek}}}}}\f0\fs20\par

\highlight4\par

}
