{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue255;\red0\green0\blue160;\red128\green0\blue0;}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\cf1\b\f0\fs20\lang1033\par

\cf2\f1\fs36\lang1045 Obecn\u233? kl\u225?vesov\u233? zkratky\cf1\f0\lang1033\par

\cf0\b0\fs26\par


