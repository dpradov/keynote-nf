{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red255\green255\blue0;\red255\green0\blue0;\red128\green0\blue0;}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 P\u345?izp\u367?soben\u237? \f1\lang1045 kl\u225?vesov\u253?ch zkratek\cf2\f0\lang1033\par

\fs20\par

\fs26\par

\cf0\b0\fs20 P\u345?\u237?kaz \b N\u225?stroje | P\u345?izp\u367?sobit kl\u225?vesnici...\b0  umo\u382?\u328?uje m\u283?nit, p\u345?id\u225?vat nebo odeb\u237?rat kl\u225?vesov\u233? zkratky pou\u382?\u237?van\u233? k vyvol\u225?n\u237? p\u345?\u237?kaz\u367? KeyNote. Kl\u225?vesov\u233? zkratky m\u367?\u382?ete upravit pro v\u353?echny \b p\u345?\u237?kazy\b0  uveden\u233? v \b hlavn\u237? nab\u237?dce\b0  KeyNote a v m\u237?stn\u237? nab\u237?dce \b panelu stromu.\b0 . \par

\par

Od verze 1.9.0 m\u367?\u382?ete libovolnou zkratku p\u345?i\u345?adit tak\u233? \b maker\u367?m, z\u225?suvn\u253?m modul\u367?m, \u353?ablon\u225?m, styl\u367?m a p\u237?sm\u367?m\b0 . Nyn\u237? nen\u237? nutn\u233? pou\u382?\u237?vat star\u253? z\u225?suvn\u253? modul \b funckey.knl\b0  a m\u367?\u382?ete pou\u382?\u237?t jakoukoli zkratku (nejen Alt+<Fx>, Shift+Alt+<Fx> nebo Ctrl+Alt+<Fx>.)\par


\pard\li360\sb40\ul Z\u225?suvn\u253? modul Funckey\ulnone  nyn\u237? nen\u237? pot\u345?eba a je \ul opu\u353?t\u283?n\u253?\ulnone . Tento modul vy\u382?adoval, aby KeyNote po proveden\u237? zm\u283?ny naslouchal ur\u269?it\u233? zpr\u225?v\u283?, znovu na\u269?etl zkratky a pou\u382?\u237?val specifick\u253? konfigura\u269?n\u237? soubor (keyboard.key) s omezenou sadou mo\u382?n\u253?ch zkratek.\par


\pard\par

Viz tak\u233?:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<78|0|0"}}{\fldrslt{P\u345?ehled kl\u225?vesov\u253?ch zkratek}}}}}\cf2\f0\fs20\par

  {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<105|4485|0|1"}}{\fldrslt{Pou\u382?\u237?v\u225?n\u237? zkratek Ctrl-C, CTRL-V, Ctrl-X}}}}}\cf0\f0\fs20\par

\par


\pard\li360\v\'11I169\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:169,488,533"}}{\fldrslt {169_Clipb_21feb.png}}}}\lang1033\par


\pard\par

\par

\highlight3\lang3082\par

\highlight0\b\lang1033 P\u345?\u237?kazy\b0  \cf4 [2]\cf0  se zobrazuj\u237? s celou svou cestou (p\u345?\u237?klad: \u218?pravy\\Zm\u283?nit velikost p\u237?smen\\Invertovat velikost p\u237?smen) a seznam se zobrazuje odd\u283?len\u283? podle \b typu p\u345?\u237?kazu\b0  \cf4 [1]\cf0 :\par

Hlavn\u237? nab\u237?dka, Kontextov\u225? nab\u237?dka stromu, Spustit makro, Spustit z\u225?suvn\u253? modul, Vlo\u382?it \u353?ablonu, Pou\u382?\u237?t styl a Pou\u382?\u237?t p\u237?smo.\par

\par

P\u345?\u237?kazy jsou uvedeny abecedn\u283? podle cel\u233? cesty a lze je filtrovat textem \cf4 [3]\cf0 , kter\u253? se hled\u225? v cest\u283? a voliteln\u283? i v popisu p\u345?\u237?kazu (Kliknut\u237?m prav\u253?m tla\u269?\u237?tkem na seznam p\u345?\u237?kaz\u367? m\u367?\u382?ete zm\u283?nit volbu \ul Zohlednit popis p\u345?i filtrov\u225?n\u237?\ulnone .)\par

\par

Popis aktu\u225?ln\u283? vybran\u233?ho p\u345?\u237?kazu a jeho p\u345?i\u345?azen\u225? zkratka \cf4 [4] \cf0 se zobrazuj\u237? v oblastech pod seznamem.\par


\pard\li360\par


\pard\par

\par

\b\fs22 P\u345?id\u225?n\u237? nebo zm\u283?na existuj\u237?c\u237?ho p\u345?i\u345?azen\u237? kl\u225?ves\par

\b0\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Vyberte p\u345?\u237?kaz v seznamu \b P\u345?\u237?kazy\b0 .\par

{\pntext\f2\'B7\tab}Klikn\u283?te na pole \b Nov\u225? kl\u225?vesov\u225? zkratka\b0  \cf4 [5]\cf0  a stiskn\u283?te novou kombinaci kl\u225?ves. Pokud je kombinace kl\u225?ves platn\u225?, zobraz\u237? se, a tak\u233? se zobraz\u237? p\u345?\u237?kaz, kter\u233?mu je tato zkratka skute\u269?n\u283? p\u345?i\u345?azena.\par

{\pntext\f2\'B7\tab}Kliknut\u237?m na tla\u269?\u237?tko \b P\u345?i\u345?adit\b0  p\u345?ijmete novou kl\u225?vesovou zkratku.\par


\pard\sb80\sa100 Pozn\u225?mka:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Pokud je nov\u225? kl\u225?vesov\u225? zkratka p\u345?i\u345?azena jin\u233?mu p\u345?\u237?kazu, kliknut\u237?m na P\u345?i\u345?adit ji tomuto p\u345?\u237?kazu nejprve odeberete, pokud ov\u353?em nepat\u345?\u237? do jin\u233? \b skupiny p\u345?\u237?kaz\u367?\b0 ; berou se v \u250?vahu tyto t\u345?i skupiny: Hlavn\u237? nab\u237?dka, Kontextov\u225? nab\u237?dka stromu, Ostatn\u237? p\u345?\u237?kazy\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Stejnou zkratku m\u367?\u382?ete p\u345?i\u345?adit p\u345?\u237?kaz\u367?m hlavn\u237? nab\u237?dky, kontextov\u233? nab\u237?dky stromu i \u8222?ostatn\u237?m\u8220? p\u345?\u237?kaz\u367?m (sem pat\u345?\u237? Spustit makro, Spustit modul plug-in, Vlo\u382?it \u353?ablonu, Pou\u382?\u237?t styl a Pou\u382?\u237?t p\u237?smo), ale m\u283?jte na pam\u283?ti, \u382?e:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720 Zkratky t\u253?kaj\u237?c\u237? se nab\u237?dky panelu stromu budou rozpozn\u225?ny, kdy\u382? je fokus na panelu stromu, a maj\u237? p\u345?ednost p\u345?ed ostatn\u237?mi zkratkami\par

{\pntext\f2\'B7\tab}\u8222?Ostatn\u237?\u8220? p\u345?\u237?kazy sd\u237?lej\u237? zkratky: pokud p\u345?i\u345?ad\u237?te zkratku nap\u345?\u237?klad makeru, bude odebr\u225?na v\u353?em \u8222?ostatn\u237?m\u8220? p\u345?\u237?kaz\u367?m (nap\u345?\u237?klad modulu plug-in)\par

{\pntext\f2\'B7\tab}Zkratky p\u345?i\u345?azen\u233? nab\u237?dk\u225?m (hlavn\u237? nebo stromu) maj\u237? p\u345?ednost p\u345?ed zkratkami ostatn\u237?ch p\u345?\u237?kaz\u367? (makry, ...)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 P\u345?esto\u382?e m\u367?\u382?ete stejnou zkratku p\u345?i\u345?adit \u8222?jin\u233?mu\u8220? p\u345?\u237?kazu i n\u283?kter\u233?mu p\u345?\u237?kazu nab\u237?dky (hlavn\u237? nebo stromu), KeyNote v\u225?s upozorn\u237?, pokud je zkratka, kterou chcete p\u345?i\u345?adit, p\u345?i\u345?azena n\u283?kter\u233?mu p\u345?\u237?kazu nab\u237?dky. Tato zkratka \u8222?ostatn\u237?ho\u8220? p\u345?\u237?kazu bude nakonec zohledn\u283?na podle fokusu (editor, strom nebo panel) a podle toho, k jak\u233?mu typu polo\u382?ky nab\u237?dky je zkratka p\u345?i\u345?azena.\par


\pard\par

\par

\b\fs22 Odebr\u225?n\u237? existuj\u237?c\u237?ho p\u345?i\u345?azen\u237? kl\u225?vesy\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Vyberte p\u345?\u237?kaz v seznamu P\u345?\u237?kazy a pot\u233? klikn\u283?te na tla\u269?\u237?tko Odebrat \cf4 [4]\cf0 .\par


\pard\li360\sb100\ul\par


\pard\sb100\b Tip\ulnone : \b0 Zm\u283?ny m\u367?\u382?ete kdykoli zru\u353?it kliknut\u237?m na tla\u269?\u237?tko Storno.\par


\pard\par

\par

\par

\b\fs22 Zobrazen\u237? seznamu v\u353?ech p\u345?i\u345?azen\u237? kl\u225?ves\b0\par

\fs20\par

V dialogov\u233?m okn\u283? klikn\u283?te na tla\u269?\u237?tko \b Seznam\b0 . T\u237?m se vygeneruje dokument HTML se seznamem v\u353?ech aktu\u225?ln\u283? p\u345?i\u345?azen\u253?ch kl\u225?vesov\u253?ch zkratek a dokument se otev\u345?e ve va\u353?em v\u253?choz\u237?m webov\u233?m prohl\u237?\u382?e\u269?i. (Soubor se jmenuje \b keyboard.html\b0  a je ulo\u382?en ve stejn\u233?m adres\u225?\u345?i jako \b keynote.ini\b0 . Tento soubor si m\u367?\u382?ete prohl\u233?dnout i mimo KeyNote.) Rozvr\u382?en\u237? souboru je pevn\u233?, ale vzhled ovl\u225?daj\u237? styly definovan\u233? v souboru \b keyboard.css\b0 . \u218?pravou souboru CSS m\u367?\u382?ete zm\u283?nit vzhled seznamu kl\u225?ves.\par

\par

\par

\b\fs22 Obnoven\u237? kl\u225?vesov\u253?ch zkratek na v\u253?choz\u237? hodnoty:\b0\par

\fs20\par

V dialogov\u233?m okn\u283? klikn\u283?te na tla\u269?\u237?tko \b Obnovit v\u353?e\b0  a pot\u233? potvr\u271?te kliknut\u237?m na \b OK\b0 . Nebo ukon\u269?ete KeyNote a odstra\u328?te soubor \b keyboard.ini\b0  (nach\u225?z\u237? se ve stejn\u233?m adres\u225?\u345?i jako keynote.ini) (Viz tak\u233? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<86|0|0"}}{\fldrslt{Pou\u382?it\u237? profil\u367?}}}}}\f0\fs20 )\par

\par

\par

\b\fs22 Omezen\u237?\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Ka\u382?d\u233?mu p\u345?\u237?kazu lze p\u345?i\u345?adit pouze jednu kl\u225?vesovou zkratku.\par

{\pntext\f2\'B7\tab}Kombinace kl\u225?ves zahrnuj\u237?c\u237? kl\u225?vesy \cf5\b Enter\cf0\b0 , \cf5\b Space\cf0\b0 , \cf5\b Tab\cf0\b0  nebo \cf5\b Esc\cf0\b0  nelze p\u345?i\u345?adit.\par

{\pntext\f2\'B7\tab}N\u283?kter\u233? kombinace kl\u225?ves jsou vyhrazeny syst\u233?mem Windows a nelze je p\u345?i\u345?adit. Pat\u345?\u237? mezi n\u283? nap\u345?\u237?klad \cf5\b Alt+F4\cf0\b0 .\par

{\pntext\f2\'B7\tab}N\u283?kter\u233? standardn\u237? kl\u225?vesov\u233? zkratky Windows jsou zabudov\u225?ny v editoru RTF a v ovl\u225?dac\u237?m prvku stromu. Nap\u345?\u237?klad v editoru stisknut\u237? \b \u353?ipky vpravo \b0 posune kurzor o jednu pozici doprava; stisknut\u237? kl\u225?vesy \cf5\b Delete\cf0\b0  sma\u382?e aktu\u225?ln\u237? znak; stisknut\u237? \cf5\b Ctrl+\u353?ipka\cf0\b0  sko\u269?\u237? na dal\u353?\u237? nebo p\u345?edchoz\u237? slovo. Tyto zkratky nelze zm\u283?nit.\par


\pard\par

\par

\b\v\fs22\'11B1\'12\v0 Pou\u382?\u237?v\u225?n\u237? zkratek Ctrl-C, CTRL-V, Ctrl-X\b0\fs20\par

\par

\lang3082 Obvykl\u233? kl\u225?vesy \cf5\b\lang1033 Ctrl+C\cf0\b0 , \cf5\b Ctrl+X\cf0\b0 , \cf5\b Ctrl+V\cf0\b0\lang3082  jsou \b vyhrazeny\b0  pro kop\u237?rov\u225?n\u237?, vkl\u225?d\u225?n\u237? a vyjmut\u237?. \lang1033 P\u345?i\u345?azen\u237? proveden\u233? jin\u253?m funkc\u237?m v dialogu \u8222?P\u345?izp\u367?sobit kl\u225?vesnici\u8220? bude ignorov\u225?no.\lang3082\par

\lang1033\par

Aby tyto kombinace fungovaly podle o\u269?ek\u225?v\u225?n\u237? v panelu stromu, v panelu prost\u345?edk\u367? nebo na jin\u253?ch m\u237?stech, je nutn\u233?, aby nebyly p\u345?i\u345?azeny zkratk\u225?m. Tyto kombinace proto nejsou spravov\u225?ny jako zkratky polo\u382?ek nab\u237?dky. M\u237?sto toho jsou zachyceny a interpretov\u225?ny d\u345?\u237?ve. Text n\u225?pov\u283?dy u t\u283?chto polo\u382?ek byl upraven tak, aby zobrazoval platn\u233? kombinace.\par

\par

Pokud n\u283?kter\u233? z t\u283?chto t\u345?\u237? funkc\u237? (Kop\u237?rovat, Vlo\u382?it, Vyjmout) p\u345?i\u345?ad\u237?te kombinaci kl\u225?ves, bude tak\u233? rozpozn\u225?na. Mohou tak m\u237?t t\u345?i platn\u233? kombinace. T\u345?et\u237? kombinace (nestandardn\u237?) v\u353?ak nebude rozpozn\u225?na p\u345?i \u250?prav\u283? n\u225?zvu uzlu stromu.\par

\par

N\u225?sleduj\u237?c\u237? zkratky, p\u345?\u237?tomn\u233? v ran\u253?ch verz\u237?ch KeyNote, byly z v\u253?choz\u237?ho nastaven\u237? odstran\u283?ny (v\u353?echny souvisely s polo\u382?kami kontextov\u233? nab\u237?dky stromu):\par

  TVCopyNodeName  \tab (\u8222?Kop\u237?rovat / n\u225?zev uzlu\u8220?) Ctrl+C\par

  TVVirtualNode    \tab (\u8222?Virtu\u225?ln\u237? uzel / Vytvo\u345?it virtu\u225?ln\u237?..\u8220?) Ctrl+V\par

  TVExport         \tab (\u8222?Export..\u8220?) Ctrl+X\par

\par

\b Alternativn\u237? kl\u225?vesy\b0 , \cf5\b Ctrl+Ins\cf0\b0 , \cf5\b Shift+Ins\cf0\b0 , \cf5\b Shift+Delete\cf0\b0  se tak\u233? interpretuj\u237? jako Kop\u237?rovat, Vlo\u382?it a Vyjmout, ale na rozd\u237?l od p\u345?edchoz\u237?ch nejsou vyhrazeny. Pokud je tedy p\u345?i\u345?ad\u237?te n\u283?kter\u233? polo\u382?ce nab\u237?dky, m\u367?\u382?ete v ur\u269?it\u253?ch p\u345?\u237?padech zabr\u225?nit jejich interpretaci jako Kop\u237?rovat, Vyjmout a Vlo\u382?it. Proto byly odebr\u225?ny n\u225?sleduj\u237?c\u237? zkratky aktu\u225?ln\u283? nastaven\u233? jako v\u253?choz\u237? (pokud jste kl\u225?vesnici nep\u345?izp\u367?sobili vygenerov\u225?n\u237?m souboru Keyboard.ini):\par

  Vlo\u382?it n\u225?zev:       Shift+Insert\par

  Odstranit potomky:  Shift+Delete\par

\par

Pou\u382?\u237?v\u225?n\u237? Kop\u237?rovat, Vyjmout a Vlo\u382?it (z kl\u225?vesnice) je takto obecn\u283?j\u353?\u237?: lze je pou\u382?\u237?t tak\u233? k \u250?prav\u283? n\u225?zvu uzlu nebo v panelu prost\u345?edk\u367?, nap\u345?\u237?klad v panelu Scratch nebo ve vyhled\u225?vac\u237?m poli.\par

\par

Lze je tak\u233? pou\u382?\u237?t ke kop\u237?rov\u225?n\u237?, vyjmut\u237? a vkl\u225?d\u225?n\u237? uzl\u367? a podstrom\u367?. Je tak mo\u382?n\u233? kop\u237?rovat a vkl\u225?dat podstromy zp\u367?sobem odpov\u237?daj\u237?c\u237?m p\u345?\u237?kaz\u367?m P\u345?enos podstromu.\par

Je tak\u233? mo\u382?n\u233? vyjmout a vlo\u382?it uzly, tak\u382?e lze p\u345?esouvat uzly a podstromy v r\u225?mci souboru, ne nutn\u283? ve stejn\u233? slo\u382?ce.\par

}
