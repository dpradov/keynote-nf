\pard\sb200\cf3\b Enter\cf0\b0\tab\tab\tab P\u345?idat nov\u253? uzel (posledn\u237? sourozenec)\par


\pard\cf3\b Ctrl+Enter\cf0\b0\tab\tab P\u345?idat nov\u253? uzel hned za aktu\u225?ln\u237? uzel (dal\u353?\u237? ni\u382?\u353?\u237? sourozenec)\par

\cf3\b Insert\cf0\b0\tab\tab\tab Vlo\u382?it nov\u253? uzel p\u345?ed aktu\u225?ln\u237? (sourozenec)\par

\cf3\b Shift+Enter\cf0\b0\tab\tab P\u345?idat nov\u253? uzel jako potomka aktu\u225?ln\u237?ho uzlu \par


\pard\sb120\cf3\b Space \cf0\b0 nebo \cf3\b F2\cf0\b0\tab\tab P\u345?ejmenovat vybran\u253? uzel \par


\pard\sb160\cf3\b Shift+Down\cf0\b0\tab\tab P\u345?esunout vybran\u233? uzly dol\u367? \par


\pard\cf3\b Shift+Left\cf0\b0\tab\tab P\u345?esunout vybran\u233? uzly doleva  \i (posunout v hierarchii nahoru) \i0\par

\cf3\b Shift+Right\cf0\b0\tab\tab P\u345?esunout vybran\u233? uzly doprava \i (posunout v hierarchii dol\u367?) \i0\par

\cf3\b Shift+Up\cf0\b0\tab\tab P\u345?esunout vybran\u233? uzly nahoru \par


\pard\sb160\cf3\b Delete\cf0\b0\tab\tab\tab Odstranit vybran\u233? uzly \i (voliteln\u283? odstranit i v\u353?echny potomky) \i0\par


\pard\sa160\cf3\b Shift+Delete\cf0\b0\tab\tab Odstranit v\u353?echny potomky vybran\u253?ch uzl\u367? \par


\pard\cf3\b \u352?ipka vlevo    \cf0\b0 nebo \cf3\b Numpad -\cf0\b0\tab Sbalit vybran\u253? uzel/v\u283?tev\par

\cf3\b \u352?ipka vpravo \cf0\b0 nebo \cf3\b Numpad + \cf0\b0  \tab Rozbalit vybran\u253? uzel/v\u283?tev (tak\u233? \cf3\b Numpad *\cf0\b0 )\par


\pard\sb80\cf3\b Shift+Numpad -\tab\cf0\b0\tab Sbalit v\u353?echny uzly ve stromu \par


\pard\cf3\b Shift+Numpad +\tab\cf0\b0\tab Rozbalit v\u353?echny uzly ve stromu \par


\pard\sb120\par


\pard\cf3\b Ctrl+C\cf0\b0\tab\tab\tab Kop\u237?rovat vybran\u233? uzly nebo podstromy\par

\cf3\b Ctrl+X\cf0\b0  \tab\tab\tab Vyjmout vybran\u233? uzly nebo podstromy\par

\cf3\b Ctrl+V\cf0\b0  \tab\tab\tab Vlo\u382?it uzly nebo podstromy\par

\cf3\b Ctrl+Shift+V\cf0\b0\tab\tab Vlo\u382?it uzly nebo podstromy jako propojen\u233? uzly\cf3\b\par

\par


\pard\sb120 Alt+F11\cf0\b0\tab\tab Vytvo\u345?it nov\u253? uzel stromu z textu vybran\u233?ho v aktu\u225?ln\u237?m uzlu\par


\pard\sb160\cf3\b Ctrl+B\cf0\b0\tab\tab\tab Ozna\u269?it vybran\u233? uzly tu\u269?n\u283? \par


\pard\cf3\b Ctrl+D\cf0\b0\tab\tab\tab Obnovit v\u253?choz\u237? barvy vybran\u253?ch uzl\u367? (p\u237?sma a pozad\u237?) \par


\pard\sb160\cf3\b Shift+Insert\cf0\b0\tab\tab P\u345?ejmenovat uzel vlo\u382?en\u237?m textu ze schr\u225?nky \par


\pard\cf3\b Alt+D\cf0\b0\tab\tab\tab P\u345?ejmenovat uzel podle aktu\u225?ln\u237?ho data \par

\cf3\b Alt+T\cf0\b0\tab\tab\tab P\u345?ejmenovat uzel podle aktu\u225?ln\u237?ho \u269?asu \par

\cf3\b Shift+Alt+D\cf0\b0\tab\tab P\u345?ejmenovat uzel podle aktu\u225?ln\u237?ho data a \u269?asu \par


\pard\sb160\cf3\b Ctrl+P\cf0\b0\tab\tab\tab Kop\u237?rovat cestu vybran\u233?ho uzlu do schr\u225?nky \par


\pard\cf3\b Ctrl+T\cf0\b0\tab\tab\tab Kop\u237?rovat cel\u253? text vybran\u233?ho uzlu do schr\u225?nky \par

\cf3\b Ctrl+E\cf0\b0\tab\tab\tab Vlo\u382?it \u250?plnou cestu vybran\u233?ho uzlu do editoru \par


\pard\sb160\cf3\b Ctrl+V\cf0\b0\tab\tab\tab Nastavit vybran\u253? uzel jako virtu\u225?ln\u237? \par


\pard\cf3\b Ctrl+R\cf0\b0\tab\tab\tab Obnovit virtu\u225?ln\u237? uzel \i (znovu na\u269?\u237?st soubor z disku)\i0  \par


\pard\sb160\cf3\b Ctrl+Shift+S\cf0\b0\tab\tab Se\u345?adit cel\u253? strom \par


\pard\cf3\b Ctrl+Shift+U\cf0\b0\tab\tab Se\u345?adit vybran\u253? podstrom \par


\pard\sb120\cf3\b Ctrl+`\cf0\b0\tab (nebo \cf3\b +\u241?\cf0\b0 )\super [*]\nosupersub\tab Za\u353?krtnout/odzna\u269?it vybran\u253? uzel \par


\pard\cf3\b Ctrl+X\cf0\b0\tab\tab\tab Exportovat vybran\u253? uzel \par

\par

\super\b [*]\b0  \nosupersub Z\u225?vis\u237? na rozlo\u382?en\u237? kl\u225?vesnice\par

 \par

\b Pozn\u225?mka:\par

\b0 Dal\u353?\u237?m zp\u367?sobem p\u345?esouv\u225?n\u237? uzl\u367? je jejich p\u345?eta\u382?en\u237? na nov\u233? m\u237?sto. Dal\u353?\u237? p\u345?\u237?kazy pro strom najdete v m\u237?stn\u237? nab\u237?dce stromu.\par


