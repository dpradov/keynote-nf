\pard\f0\fs20\lang1033\par

\cf1\b\fs36 Mo\u382?nosti: Obecn\u225? nastaven\u237?\par

\cf0\b0\fs26\par


\pard\li360\v\'11I219\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:219,528,455"}}{\fldrslt {219_Clipb_13abr.png}}}}\par


\pard\par


\pard\sa80\cf1\b\fs22 Minimalizovat do oznamovac\u237? oblasti\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li tato volba povolena, KeyNote p\u345?i minimalizaci um\u237?st\u237? svou ikonu do oznamovac\u237? oblasti (vedle hodin v prav\u233?m doln\u237?m rohu obrazovky).\par

{\pntext\f1\'B7\tab}Nen\u237?-li tato volba povolena, KeyNote se minimalizuje na b\u283?\u382?n\u233? tla\u269?\u237?tko na hlavn\u237?m panelu.\par


\pard\li240\b\par


\pard\li360\ul\b0 Pozn\u225?mka\ulnone\b :  \b0 Kdy\u382? je KeyNote minimalizov\u225?n, m\u367?\u382?ete jej rychle vyvolat kliknut\u237?m na ikonu v oznamovac\u237? oblasti nebo stisknut\u237?m kombinace aktiva\u269?n\u237? hork\u233? kl\u225?vesy (ve v\u253?choz\u237?m nastaven\u237? \cf2\b Ctrl+Shift+F12 \cf0\b0 )\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Spustit program minimalizovan\u253?\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: NE\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li tato volba povolena, KeyNote se p\u345?i spu\u353?t\u283?n\u237? automaticky minimalizuje.\par

{\pntext\f1\'B7\tab}Nen\u237?-li tato volba povolena, KeyNote se spust\u237? v norm\u225?ln\u237?m okn\u283?.\par


\pard\li240\ul\par


\pard\li360 Pozn\u225?mka\ulnone\b :  \b0 KeyNote m\u367?\u382?ete p\u345?inutit k minimalizaci p\u345?i spu\u353?t\u283?n\u237? tak\u233? p\u345?id\u225?n\u237?m p\u345?ep\u237?na\u269?e \ldblquote\cf2\b -min\cf0\b0\rdblquote  na p\u345?\u237?kazov\u253? \u345?\u225?dek ve zkratce, kterou k spu\u353?t\u283?n\u237? KeyNote pou\u382?\u237?v\u225?te.\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Nezav\u237?rat; m\u237?sto toho minimalizovat\cf0\fs20\tab\tab\b0 V\u253?choz\u237?: NE\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li tato volba povolena, KeyNote se p\u345?i kliknut\u237? na tla\u269?\u237?tko [x] v prav\u233?m horn\u237?m rohu okna minimalizuje m\u237?sto ukon\u269?en\u237?.\par

{\pntext\f1\'B7\tab}Nen\u237?-li tato volba povolena, kliknut\u237? na [x] zp\u367?sob\u237? ukon\u269?en\u237? KeyNote (toto je standardn\u237? chov\u225?n\u237?)\par


\pard\li240\b\par

\ul\b0 Pozn\u225?mka\ulnone\b :  \b0 Pokud je toto pole za\u353?krtnuto, m\u367?\u382?ete KeyNote st\u225?le norm\u225?ln\u283? ukon\u269?it volbou \b Soubor|Ukon\u269?it \b0 nebo kliknut\u237?m prav\u253?m tla\u269?\u237?tkem na ikonu v oznamovac\u237? oblasti a volbou \b Ukon\u269?it\b0 .\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Zobrazovat bublinovou n\u225?pov\u283?du\cf0\fs20\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li tato volba povolena, budou se p\u345?i p\u345?ejet\u237? kurzoru my\u353?i nad r\u367?zn\u253?mi prvky rozhran\u237? KeyNote zobrazovat stru\u269?n\u233? informa\u269?n\u237? zpr\u225?vy.\par

{\pntext\f1\'B7\tab}Nen\u237?-li tato volba povolena, bublinov\u225? n\u225?pov\u283?da se nezobraz\u237?. Stejn\u233? informace se v\u353?ak st\u225?le zobrazuj\u237? na stavov\u233?m \u345?\u225?dku (i kdy\u382? je otev\u345?eno jin\u233? dialogov\u233? okno)\par


\pard\par

\cf3\b\lang3082 Tip\b0 : Pro nevidom\u233? a zrakov\u283? posti\u382?en\u233? u\u382?ivatele, kte\u345?\u237? pou\u382?\u237?vaj\u237? n\u225?stroje jako NVDA (Non-Visual Desktop Access), existuje volba v .INI, {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<104|13315|0|12"}}{\fldrslt{HintsAccesible}}}}}\f0\fs20 , kter\u225? usnad\u328?uje \u269?ten\u237? n\u225?pov\u283?dy ze stavov\u233?ho \u345?\u225?dku.\cf0\lang1033\par

\par


\pard\sa100\cf1\b\fs22 Povolit pouze jednu instanci\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li tato volba povolena, budete moci KeyNote spustit pouze jednou. Pokud KeyNote spust\u237?te, kdy\u382? ji\u382? b\u283?\u382?\u237?, aktivuje se ji\u382? b\u283?\u382?\u237?c\u237? instance.\par

{\pntext\f1\'B7\tab}Nen\u237?-li tato volba povolena, budete moci spustit mnoho instanc\u237? KeyNote vedle sebe.\par


\pard\par

\b Pozn\u225?mka\b0 : Tato volba bude ignorov\u225?na, pokud je instance otev\u345?ena s volbou argumentu {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<16|4758|0|1"}}{\fldrslt{-jmp}}}}}\f0\fs20 \par

\par


\pard\sb80\cf5 Upozorn\u283?n\u237?: Pokud spou\u353?t\u237?te n\u283?kolik instanc\u237? KeyNote, nezapome\u328?te, \u382?e byste nem\u283?li upravovat stejn\u253? soubor ve v\u237?ce ne\u382? jedn\u233? instanci. KeyNote m\u225? proti tomu ur\u269?itou vestav\u283?nou ochranu, ale i tak to nemus\u237? b\u253?t bezpe\u269?n\u233?.\cf0\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Jazyk\cf0\fs20\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: angli\u269?tina (intern\u237?)\par


\pard Umo\u382?\u328?uje zobrazit nab\u237?dky rozhran\u237? a dialogov\u225? okna v jin\u233?m jazyce, ne\u382? je jazyk definovan\u253? intern\u283? (angli\u269?tina). Vy\u382?aduje existenci soubor\u367? ve tvaru "Keynote.<language>.lng" a "Keynote.<language>.tip" ve slo\u382?ce "Lang".\par


\pard\sb80 Dal\u353?\u237? informace najdete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<107|0|0"}}{\fldrslt{Konfigurace jazyka u\u382?ivatelsk\u233?ho rozhran\u237?}}}}}\f0\fs20\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 P\u345?i stisku kl\u225?vesy Escape\cf0\fs20\tab\tab\tab\tab\b0 V\u253?choz\u237?: Minimalizovat hlavn\u237? okno\par


\pard Zvolte, co se m\u225? st\u225?t p\u345?i stisku kl\u225?vesy \cf2\b Esc\cf0\b0 . Dostupn\u233? mo\u382?nosti jsou: \par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Nic ned\u283?lat\par

{\pntext\f1\'B7\tab}Minimalizovat hlavn\u237? okno\par

{\pntext\f1\'B7\tab}Ukon\u269?it Keynote\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Pou\u382?\u237?t aktiva\u269?n\u237? horkou kl\u225?vesu\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: \cf2\b Ctrl+Shift+F12\cf0\b0\par


\pard Klikn\u283?te na toto pole a stiskn\u283?te \cf2\b Backspace\cf0\b0  pro smaz\u225?n\u237? st\u225?vaj\u237?c\u237? hork\u233? kl\u225?vesy. Pot\u233? stiskn\u283?te novou horkou kl\u225?vesu, kterou chcete pou\u382?\u237?t k p\u345?iveden\u237? aplikace KeyNote do pop\u345?ed\u237?, kdy\u382? je minimalizovan\u225? nebo skryt\u225? za jin\u253?mi okny aplikac\u237?.\par

\par


\pard\li240\ul Pozn\u225?mka\ulnone\b :  \b0 Hork\u225? kl\u225?vesa, kterou zde zad\u225?te, plat\u237? v cel\u233?m syst\u233?mu. To znamen\u225?, \u382?e \u382?\u225?dn\u225? jin\u225? aplikace nebude moci tuto kombinaci kl\u225?ves pou\u382?\u237?t (p\u345?ep\u237?\u353?e ji aplikace KeyNote). Pokud nav\u237?c spust\u237?te v\u237?ce instanc\u237? aplikace KeyNote, bude moci tuto horkou kl\u225?vesu pou\u382?\u237?t pouze prvn\u237? instance.\par


\pard\li240\sb80\b Tip\b0 : Pro r\u367?zn\u233? instance aplikace KeyNote m\u367?\u382?ete definovat r\u367?zn\u233? hork\u233? kl\u225?vesy, p\u345?i\u269?em\u382? ka\u382?dou z nich otev\u345?ete z jin\u233?ho profilu s jinou konfigurac\u237? v souboru .INI (Viz {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<86|0|0"}}{\fldrslt{Profily}}}}}\f0\fs20 )\par


\pard\li240\par


\pard Pokud nechcete pou\u382?\u237?vat \u382?\u225?dnou horkou kl\u225?vesu, ponechte toto pole pr\u225?zdn\u233?.\par

\par

\par


\pard\sa80\cf1\b\fs22 Upozornit, kdy\u382? nelze p\u345?i\u345?adit aktiva\u269?n\u237? horkou kl\u225?vesu\tab\cf0\fs20\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Pokud je povoleno, aplikace KeyNote zobraz\u237? varovnou zpr\u225?vu, kdy\u382? nebude moci horkou kl\u225?vesu p\u345?i\u345?adit. P\u345?i\u345?azen\u237? hork\u233? kl\u225?vesy m\u367?\u382?e selhat, pokud byla p\u345?ed aplikac\u237? KeyNote spu\u353?t\u283?na jin\u225? aplikace, kter\u225? pou\u382?\u237?v\u225? stejnou horkou kl\u225?vesu. Upozorn\u283?n\u237? se nezobraz\u237?, kdy\u382? spust\u237?te v\u237?ce ne\u382? jednu instanci aplikace KeyNote, proto\u382?e horkou kl\u225?vesu si samoz\u345?ejm\u283? bude moci zaregistrovat pouze prvn\u237? instance\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Pokud je zak\u225?z\u225?no, aplikace KeyNote nikdy nezobraz\u237? upozorn\u283?n\u237? na ne\u250?sp\u283?\u353?nou registraci hork\u233? kl\u225?vesy.\par


\pard\par

}
