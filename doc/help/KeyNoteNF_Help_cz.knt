\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40\f1\lang3082 V \b\f2\fs22 [1]\b0\f1\fs20 , nap\u345?\u237?klad 26. dne, jeliko\u382? dosud neexistuje m\u283?s\u237?\u269?n\u237? z\u225?loha, se vytvo\u345?\u237? kopie aktu\u225?ln\u237?ho souboru.\par

{\pntext\f4\'B7\tab}P\u345?i ukl\u225?d\u225?n\u237? v \b\f2\fs22 [2]\b0\f1\fs20  nen\u237? nov\u253? z\u225?lo\u382?n\u237? soubor nutn\u253?, proto\u382?e byl vytvo\u345?en s \u8222?file_BAK2016_01.knt\u8220?.\par

{\pntext\f4\'B7\tab}\b\f2\fs22 [5]\b0\f1\fs20 : Soubor ukl\u225?d\u225?me poprv\u233? v nov\u233?m t\u253?dnu t\u233?ho\u382? m\u283?s\u237?ce. Proto se vytvo\u345?\u237? kopie nov\u233?ho souboru.\par

{\pntext\f4\'B7\tab}\b\f2\fs22 [5,8,15]\b0\f1\fs20 : P\u345?i prvn\u237?m ulo\u382?en\u237? v nov\u233?m dni se vytvo\u345?\u237? z\u225?loha souboru p\u345?ed ulo\u382?en\u237?m jako \u8222?file_BAK_Day.knt\u8220?. Tak\u233?, pokud jde o prvn\u237? ulo\u382?en\u237? v t\u253?dnu nebo m\u283?s\u237?ci, vytvo\u345?\u237? se i kopie nov\u233?ho souboru (file_BAK_W3.knt pro 3. t\u253?den). N\u225?sledn\u233? z\u225?lohy v dan\u233?m dni ji nenahrad\u237?. Ale bude existovat jen jeden \u8222?file_BAK_Day.knt\u8220?.\par

{\pntext\f4\'B7\tab}\b\f2\fs22 [21]\b0\f1\fs20 : Operace ulo\u382?en\u237? v nov\u233?m dni. Nen\u237? nutn\u233? vytv\u225?\u345?et \u8222?file_BAK_Day.knt\u8220?, proto\u382?e je k dispozici \u8222?file_BAK_W4.knt\u8220?, kter\u253? vydr\u382?\u237? v\u237?ce ne\u382? jeden den.\par

{\pntext\f4\'B7\tab}\b\f2\fs22 [30]\b0\f1\fs20 : Kopie v nov\u233?m m\u283?s\u237?ci (kdy\u382? jsou ulo\u382?eny zm\u283?ny). V tomto p\u345?\u237?pad\u283? se p\u345?edpokl\u225?d\u225?, \u382?e jde o prvn\u237? t\u253?den m\u283?s\u237?ce (W1), tak\u382?e dal\u353?\u237?m t\u253?denn\u237?m souborem v tomto p\u345?\u237?kladu bude W2.\par


\pard\sa40\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360\f0 Pozn\u225?mka: Pokud je \ul mo\u382?nost\f3  \f0  maxim\u225?ln\u237?\f3  \f0  \u250?rovn\u283?\f3  \f0  denn\u237?\ulnone\f3  \f0  z\u225?lohy\f3  \f0  nastavena mezi 2 a 7, nam\u237?sto vytvo\u345?en\u237? souboru \f2 file_BAK_Day.knt\f0  se vytvo\u345?\u237? soubor ve tvaru \f2 file_BAK_@D1.knt\f0  a ty ji\u382? vytvo\u345?en\u233? se automaticky p\u345?esunou na ..\f2 @D2, \f0 ..\f2 @D3\f0  atd., p\u345?i\u269?em\u382? se automaticky sma\u382?ou nejstar\u353?\u237?, kter\u233? p\u345?ekro\u269?\u237? nastavenou maxim\u225?ln\u237? \u250?rove\u328?.\lang1033\par


\pard\li360\sb80\lang3082 Bez t\u233?to mo\u382?nosti (nebo pokud je jej\u237? \u250?rove\u328? nastavena na 1) je kopie pro dan\u253? den, \f2 file_BAK_Day.knt\f0 , nahrazena kopi\u237? odpov\u237?daj\u237?c\u237? nov\u233?mu dni. To znamen\u225?, \u382?e krom\u283? b\u283?\u382?n\u253?ch kopi\u237?, kter\u233? mohou b\u253?t uchov\u225?v\u225?ny (.bak, .bak2 atd.) a kter\u233? mohou b\u253?t p\u345?i \u269?ast\u233?m ukl\u225?d\u225?n\u237? p\u345?eps\u225?ny, m\u367?\u382?e b\u253?t nejnov\u283?j\u353?\u237? bezpe\u269?nou kopi\u237?, krom\u283? kopie z aktu\u225?ln\u237?ho dne, v nejhor\u353?\u237?m p\u345?\u237?pad\u283? kopie z po\u269?\u225?tku t\u253?dne. To znamen\u225?, \u382?e @W1 (nebo ekvivalent pro m\u283?s\u237?c) m\u367?\u382?e b\u253?t a\u382? \u353?est dn\u237? star\u225?. Pokud jsme kr\u225?tce pot\u233? p\u345?idali informace a ud\u283?lali chybu (nespr\u225?vn\u283? jsme smazali nebo zm\u283?nili ur\u269?it\u233? pozn\u225?mky), kterou si uv\u283?dom\u237?me a\u382? o n\u283?kolik dn\u237? pozd\u283?ji, nemus\u237?me m\u237?t \u382?\u225?dnou kopii, ze kter\u233? bychom tyto informace obnovili.\par


\pard\li360\sb40 Tato mo\u382?nost se sna\u382?\u237? minimalizovat riziko ztr\u225?ty informac\u237? z t\u283?chto d\u367?vod\u367?.\lang1033\par


\pard\sa40\f1\lang3082\par


\pard\sb180\sa100 Tuto novou funkci z\u225?lohov\u225?n\u237? lze pou\u382?\u237?t s cyklick\u253?m z\u225?lohov\u225?n\u237?m nebo bez n\u283?j (jak se to dosud d\u283?l\u225?).\par


\pard\f0\lang1033\par


\pard\sb100\sa100\f1\lang3082 P\u345?\u237?klad z\u225?lo\u382?n\u237?ch soubor\u367? vytvo\u345?en\u253?ch ze souboru \u8222?Testfile.knt\u8220?:\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa80\cf3 Testfile_BAK@2016_02.knt\cf0  \tab : m\u283?s\u237?\u269?n\u237? z\u225?loha\par

{\pntext\f4\'B7\tab}\cf3 Testfile_BAK@W1.knt\cf0  \tab : t\u253?denn\u237? z\u225?loha (a\u382? 4 soubory, cyklick\u225?)\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf3 Testfile_BAK_Day.knt.TXT\cf0  \tab : ozna\u269?uje, kde se nach\u225?z\u237? z\u225?loha po\u345?\u237?zen\u225? na za\u269?\u225?tku dne, t\u283?sn\u283? p\u345?ed prvn\u237? operac\u237? ulo\u382?en\u237?. \par


\pard\li360\sa80 Nap\u345?\u237?klad m\u367?\u382?e obsahovat n\u283?co jako: \u8222?Z\u225?loha 24/02/2016 p\u345?ed jakoukoli zm\u283?nou v \u8218?Testfile_BAK@2016_02.knt\u8216? \u8220?, nebo obvykleji n\u283?co jako \u8222?Z\u225?loha 24/02/2016 p\u345?ed jakoukoli zm\u283?nou v \u8218?Testfile_BAK_Day.knt\u8216? \u8220?\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa80\cf3 Testfile_BAK_Day.knt\cf0  \tab : z\u225?loha na za\u269?\u225?tku dne, pokud pro aktu\u225?ln\u237? soubor .knt neexistovala m\u283?s\u237?\u269?n\u237? nebo t\u253?denn\u237? z\u225?loha a bylo nutn\u233? p\u345?ed ulo\u382?en\u237?m vytvo\u345?it novou. Ka\u382?d\u225? denn\u237? z\u225?loha nahrad\u237? tu star\u353?\u237?.\par


\pard\par

\b Pozn\u225?mka\b0 : \par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360 M\u283?s\u237?\u269?n\u237? a t\u253?denn\u237? z\u225?lohy se vytv\u225?\u345?ej\u237? po norm\u225?ln\u237? operaci ulo\u382?en\u237? (pokud je to pot\u345?eba). Denn\u237? z\u225?lohy se vytv\u225?\u345?ej\u237? p\u345?ed ulo\u382?en\u237?m.\par

{\pntext\f4\'B7\tab}Pokud je aktivn\u237?, \u8222?klasick\u233?\u8220? z\u225?lohov\u225?n\u237? (\cf3 Testfile.knt.bak\cf0 , \cf3 Testfile.knt.bak2\cf0 , ... ) nevytvo\u345?\u237? novou z\u225?lo\u382?n\u237? kopii souboru, pokud je n\u283?jak\u225? k dispozici d\u237?ky z\u225?lohov\u225?n\u237? v intervalech.\par


\pard\f0\lang1033\par

