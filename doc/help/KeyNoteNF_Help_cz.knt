\pard\sa80 Hled\u225?n\u237? m\u367?\u382?eme omezit na textov\u233? fragmenty S ur\u269?it\u253?mi \u353?t\u237?tky a/nebo BEZ jin\u253?ch \u353?t\u237?tk\u367?\par


\pard\sb80 {\ul\protect\fs24{\field{\*\fldinst{HYPERLINK "FOLD:"}}{\fldrslt{\f4\u10133?\f0  \f4 }}}}\protect\f0\fs20 N\u283?kolik dal\u353?\u237?ch p\u345?\u237?klad\u367? pro pochopen\u237? mo\u382?nost\u237?; hled\u225?me \u8222?task\u8220?; \ul S\ulnone  \u353?t\u237?tky: \u8222?[x]\u8220? a \u8222?E0\u8220? a \ul Bez\ulnone  \u353?t\u237?tky: \v  "BB"\par

