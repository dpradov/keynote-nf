\pard\sa200\fs24 Organizace / struktura\par


\pard{\pntext\f3\'B7\tab}{\*\pn\pnlvlblt\pnf3\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100\b\fs20 Ulo\u382?en\u237? mnoha samostatn\u253?ch slo\u382?ek (karet) v jednom souboru\b0 ; ka\u382?d\u225? slo\u382?ka se zobrazuje na vlastn\u237? snadno dostupn\u233? kart\u283?. To je mnohem pohodln\u283?j\u353?\u237? \u345?e\u353?en\u237? ne\u382? otev\u237?r\u225?n\u237? n\u283?kolika soubor\u367? na disku. Ka\u382?d\u225? slo\u382?ka (karta) m\u225? nez\u225?visl\u233? nastaven\u237? p\u237?sma, barev a editoru.\par

{\pntext\f3\'B7\tab}Pou\u382?it\u237? \b slo\u382?ek stromov\u233?ho typu, v\u237?ce\u250?rov\u328?ov\u233? hierarchie \u8222?v\u283?tv\u237?\b0 \u8220?, z nich\u382? ka\u382?d\u225? m\u225? vlastn\u237? nez\u225?vislou pozn\u225?mku. Viz {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|0|0"}}{\fldrslt{Slo\u382?ky jako stromy pozn\u225?mek}}}}\f0\fs20 .\par

{\pntext\f3\'B7\tab}\b Neomezen\u253? po\u269?et pozn\u225?mek\b0 , kter\u233? lze ulo\u382?it do jedin\u233? slo\u382?ky\par

{\pntext\f3\'B7\tab}\b \u352?t\u237?tky\b0  lze p\u345?i\u345?azovat pozn\u225?mk\u225?m i textu samotn\u233?mu, co\u382? umo\u382?\u328?uje ozna\u269?ovat odstavce nebo textov\u233? fragmenty metadaty ({\ul{\field{\*\fldinst{HYPERLINK "file:///<122|0|0"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}Mo\u382?nost vytv\u225?\u345?et ve stromu \u8222?\b virtu\u225?ln\u237? uzly\b0 \u8220? (uzly, kter\u233? jsou dynamicky propojeny s extern\u237?mi textov\u253?mi soubory nebo soubory RTF) ({\ul{\field{\*\fldinst{HYPERLINK "file:///<28|0|0"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}\f2\lang3082 "\b \u8222?Propojen\u233? uzly\b0 \u8220?: uzly, kter\u233? sd\u237?lej\u237? pozn\u225?mku, na ni\u382? ukazuj\u237? ({\ul{\field{\*\fldinst{HYPERLINK "file:///<29|0|0"}}{\fldrslt{V\u237?ce}}}}\f2\fs20 )\f0\lang1033\par

{\pntext\f3\'B7\tab}\f2\lang3082 V\u353?echny pozn\u225?mky lze \b prohled\u225?vat a filtrovat\b0  podle v\u237?ce krit\u233?ri\u237? (Viz {\ul\f0\lang1033{\field{\*\fldinst{HYPERLINK "file:///<27|23654|0|15"}}{\fldrslt{Filtrov\u225?n\u237? stromu}}}}\f2\fs20  a {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|7583|0|1"}}{\fldrslt{Filtrov\u225?n\u237? Naj\u237?t v\u353?e}}}}\f2\fs20 )\f0\lang1033\par

