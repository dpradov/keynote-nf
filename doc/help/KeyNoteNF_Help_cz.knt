\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Pou\u382?it\u237? funkc\u237? Naj\u237?t a Naj\u237?t v\u353?e\cf2\lang1033\par

\cf0\b0\fs26\par

{\ul\f1\fs20\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|319|0|2"}}{\fldrslt{Naj\u237?t}}}}\f1\fs20\lang3082\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|1409|0|3"}}{\fldrslt{Prohled\u225?v\u225?n\u237? uzl\u367?}}}}\f1\fs20\par


\pard\sb80 {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|2226|0|4"}}{\fldrslt{Nahradit}}}}\f1\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<40|3096|0|5"}}{\fldrslt{Naj\u237?t v\u353?e}}}}\f1\fs20\par


\pard    {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|10113|0|13"}}{\fldrslt{Sbalen\u233? bloky}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|10051|0|12"}}{\fldrslt{Pou\u382?\u237?v\u225?n\u237? zna\u269?ek p\u345?i Naj\u237?t v\u353?e}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9159|0|6"}}{\fldrslt{Syntaxe pro dopl\u328?kov\u233?/pokro\u269?il\u233? hled\u225?n\u237?}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9385|0|7"}}{\fldrslt{Hled\u225?n\u237? podle data posledn\u237? zm\u283?ny}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|17398|0|16"}}{\fldrslt{Hled\u225?n\u237? podle chr\u225?n\u283?n\u233?ho stavu}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9852|0|8"}}{\fldrslt{Slova ve stejn\u233?m odstavci nebo v\u283?t\u283?}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|11754|0|9"}}{\fldrslt{Zv\u253?razn\u283?n\u225? slova}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|20992|0|15"}}{\fldrslt{Kombinov\u225?n\u237? token\u367? pokro\u269?il\u233?ho hled\u225?n\u237? (a typu hled\u225?n\u237?)}}}}\f1\fs20\par


\pard\sb40    {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|7583|0|1"}}{\fldrslt{Filtrov\u225?n\u237? uzl\u367? stromu}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|15353|0|10"}}{\fldrslt{Zm\u283?n\u283?no fungov\u225?n\u237? typu hled\u225?n\u237? 'v\u353?echna slova'}}}}\f1\fs20\par


\pard\par

\par


\pard\sb100\sa100 KeyNote nab\u237?z\u237? dva zp\u367?soby hled\u225?n\u237? textu:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent360{\pntxtb\'B7}}\fi-360\li360 Inkrement\u225?ln\u237? hled\u225?n\u237? pomoc\u237? \b Naj\u237?t\b0  (p\u345?\u237?kaz Hledat | Naj\u237?t...) a \b Naj\u237?t uzel\b0  (Hledat | Naj\u237?t uzel...). \fs24\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent360{\pntxtb\'B7}}\fi-360\li360\sb20\fs20 \u218?pln\u233? hled\u225?n\u237?, kter\u233? zobraz\u237? seznam v\u253?sledk\u367?, pomoc\u237? \b Naj\u237?t v\u353?e\b0  (karta Naj\u237?t v\u353?e v panelu zdroj\u367?)\fs24\par


\pard\highlight3\f0\fs20\lang1033\par


\pard\sb100\sa100\cf4\highlight0\b\v\f1\fs24\lang3082\'11B2\'12\v0 Naj\u237?t\par


\pard\cf0\b0\fs20 Dialogov\u233? okno Naj\u237?t m\u367?\u382?ete otev\u345?\u237?t pro inkrement\u225?ln\u237? hled\u225?n\u237? pomoc\u237? \cf5\b\f0\lang1033 Ctrl+F\cf0\b0\f1\lang3082  (nebo p\u345?\u237?kazu Hledat | \b Naj\u237?t... \b0 ). Poka\u382?d\u233?, kdy\u382? stisknete tla\u269?\u237?tko \u8222?Naj\u237?t dal\u353?\u237?\u8220?, vyhled\u225? se nov\u253? v\u253?sledek a pokud se najde, bude zv\u253?razn\u283?n.\par


\pard\sb120\f0\lang1033 Dal\u353?\u237? v\u253?skyt textu m\u367?\u382?ete naj\u237?t a vybrat pomoc\u237? \cf5\b F3 \cf0\b0  (nebo v\u253?b\u283?rem Hledat | \b Naj\u237?t dal\u353?\u237?\b0 ). Pokud je\u353?t\u283? nebyl zad\u225?n \u382?\u225?dn\u253? hledan\u253? text, zobraz\u237? se dialogov\u233? okno, stejn\u283? jako u \b Ctrl+F\b0 .\f1\lang3082\par


\pard\sb100\sa100\par


\pard\li360\sb100\sa100\v\'11I148\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:148,510,262"}}{\fldrslt {148_Clipb_20ene.png}}}}\f1\par


\pard\sb100\sa100\f0\lang1033 M\u367?\u382?ete ur\u269?it, \u382?e se m\u225? hledat od prvn\u237?ho znaku uzlu/pozn\u225?mky (pokud je zapnuta volba \b Od za\u269?\u225?tku textu \b0 ). Jinak se shody hledaj\u237? od pozice kurzoru.\par

Hled\u225?n\u237? lze omezit na aktu\u225?ln\u237? editor nebo zahrnout v\u353?echny uzly (\b Prohledat v\u353?echny uzly stromu\b0 ) \u269?i dokonce v\u353?echny slo\u382?ky (\b Prohledat v\u353?echny slo\u382?ky\b0 ). P\u345?i hled\u225?n\u237? ve v\u353?ech uzlech stromu m\u367?\u382?ete skryt\u233? uzly ignorovat nebo je zahrnout (\b Prohled\u225?vat skryt\u233? uzly\b0 ).\par

\f1\lang3082 S volbou \b Zalamovat ve slo\u382?ce\b0  bude KeyNote hledat od za\u269?\u225?tku, kdy\u382? dos\u225?hne posledn\u237? shody.\par

\b Rozli\u353?ovat velikost p\u237?smen\b0  a \b Pouze cel\u225? slova\b0  umo\u382?\u328?uj\u237? ur\u269?it, zda m\u225? hled\u225?n\u237? rozli\u353?ovat velikost p\u237?smen a br\u225?t v \u250?vahu pouze cel\u225? slova, ohrani\u269?en\u225? mezerami, tabul\u225?tory a podobn\u253?mi znaky.\par

\par

\cf4\b\v\'11B3\'12\v0 Hled\u225?n\u237? uzl\u367?\par


\pard\cf0\b0 Uzly m\u367?\u382?ete hledat inkrement\u225?ln\u283? podle ur\u269?it\u233?ho textu v n\u225?zvu pomoc\u237? \cf5\b\f0\lang1033 Shift+Ctrl+F\cf0\b0\f1\lang3082  (nebo p\u345?\u237?kazu Hledat | \b Naj\u237?t uzel...\b0 ). Zobraz\u237? se dialogov\u233? okno s n\u225?zvem \u8222?Naj\u237?t uzel stromu\u8220?, kter\u233? se pt\u225? \u8222?Naj\u237?t uzel obsahuj\u237?c\u237? text.\u8220?\par


\pard\sb80 M\u367?\u382?ete tak\u233? pou\u382?\u237?t Hledat | \b Naj\u237?t dal\u353?\u237? uzel...\b0  k v\u253?b\u283?ru dal\u353?\u237?ho uzlu, kter\u253? obsahuje hledan\u253? text. Pokud je\u353?t\u283? nebyl zad\u225?n \u382?\u225?dn\u253? text, zobraz\u237? se dialogov\u233? okno, stejn\u283? jako u \b\f0\lang1033 Shift+Ctrl+F\cf5 .\cf0\b0\f1\lang3082\par


\pard\par

Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Pokud m\u225?te \ul fokus na panelu stromu\ulnone , m\u367?\u382?ete pro b\u283?\u382?n\u233? hled\u225?n\u237? pou\u382?\u237?t stejn\u233? kl\u225?vesov\u233? zkratky: \cf5\b\f0\lang1033 Ctrl+F \cf0\b0\f1\lang3082 a \cf5\b\f0\lang1033 F3\cf0\b0\f1\lang3082  (nebo aktu\u225?ln\u237? p\u345?izp\u367?soben\u233? kl\u225?vesov\u233? zkratky).\par

{\pntext\f5\'B7\tab}P\u345?\u237?kaz \b Naj\u237?t dal\u353?\u237? uzel\b0  bude prohled\u225?vat v\u353?echny slo\u382?ky a/nebo v\u353?echny skryt\u233? uzly podle voleb vybran\u253?ch na kart\u283? Naj\u237?t v\u353?e v panelu zdroj\u367? (\ul Prohledat v\u353?echny slo\u382?ky\ulnone  a \ul Prohled\u225?vat skryt\u233? uzly\ulnone )\par


\pard\sb100\sa100\par

\cf4\b\v\fs24\'11B4\'12\v0 Nahradit\par

\cf0\b0\fs20 Pomoc\u237? stejn\u233?ho mechanismu popsan\u233?ho v dialogov\u233?m okn\u283? {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|258|0|2"}}{\fldrslt{Naj\u237?t}}}}\f1\fs20  m\u367?\u382?ete nahradit ka\u382?d\u253? nalezen\u253? v\u253?skyt nov\u253?m textem.\par


\pard\sa100 P\u345?\u237?kaz Hledat | \b Nahradit\b0  (tak\u233? \cf5\b\f0\lang1033 Ctrl+F3 \cf0\b0\f1\lang3082 )\b  \b0 se nejprve pokus\u237? nahradit text na pozici kurzoru, a pokud kurzor nen\u237? um\u237?st\u283?n v textu, kter\u253? m\u225? b\u253?t nahrazen, p\u345?esune se na dal\u353?\u237? odpov\u237?daj\u237?c\u237? text a po\u269?k\u225?, a\u382? potvrd\u237?me nahrazen\u237? kliknut\u237?m na tla\u269?\u237?tko \ul Nahradit\ulnone .\par


\pard\par


\pard\li360\sb100\sa100\v\'11I149\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:149,510,263"}}{\fldrslt {149_Clipb_20ene.png}}}}\f1\par


\pard\sb100\sa100 Text m\u367?\u382?ete nahradit po jedn\u233? polo\u382?ce, nebo najednou pomoc\u237? tla\u269?\u237?tka \ul Nahradit v\u353?e\ulnone . P\u345?i nahrazov\u225?n\u237? v\u353?eho najednou m\u367?\u382?ete omezit na \b Vybran\u253? text\b0  (neaktivn\u237?, pokud nen\u237? vybr\u225?n \u382?\u225?dn\u253? text) nebo p\u345?inutit KeyNote, aby u v\u353?ech nalezen\u253?ch shod po\u382?adoval potvrzen\u237? (\b Potvrdit nahrazen\u237?\b0 ).\par

Krom\u283? tla\u269?\u237?tek ve v\u253?\u353?e uveden\u233?m dialogu m\u367?\u382?ete pou\u382?\u237?t Hledat|\b Nahradit dal\u353?\u237? \b0 k opakov\u225?n\u237? posledn\u237?ho p\u345?\u237?kazu nahrazen\u237? a vyhled\u225?n\u237? dal\u353?\u237?ho textu k nahrazen\u237?.\par

\par


\pard\b Tip:\b0\par


\pard\li360 Zva\u382?te mo\u382?nost \u8222?Obnovit Hledat dal\u353?\u237? po\u8220? (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<103|0|0"}}{\fldrslt{Pokro\u269?il\u233? | Ostatn\u237?}}}}\f1\fs20 ). Kdy\u382? tuto mo\u382?nost nastav\u237?te, m\u367?\u382?ete b\u283?\u382?n\u283? pou\u382?\u237?vat \ul Hledat dal\u353?\u237?\ulnone  (\cf5\b\f0\lang1033 F3\cf0\b0\f1\lang3082 ) m\u237?sto \ul Hledat...\ulnone , co\u382? umo\u382?n\u237? p\u345?i\u345?adit obvyklou zkratku \cf5\b\f0\lang1033 Ctrl+F\cf0\b0\f1\lang3082  p\u345?\u237?kazu \ul Hledat v\u353?e...\ulnone  \par


\pard\par


\pard\sb100\sa100\par

\cf4\b\v\fs24\'11B5\'12\v0 Hledat v\u353?e\cf0\par


\pard\b0\fs20 M\u367?\u382?ete naj\u237?t a zobrazit v\u353?echny shody zadan\u233?ho textu ve v\u353?ech slo\u382?k\u225?ch nebo ve v\u353?ech uzlech aktu\u225?ln\u237? slo\u382?ky. M\u237?sto hled\u225?n\u237? m\u367?\u382?ete tak\u233? z\u250?\u382?it pomoc\u237? dal\u353?\u237?ch mo\u382?nost\u237?.\par

Ve v\u353?ech p\u345?\u237?padech se zobraz\u237? \b\f0\lang1033 v\u253?\u328?atky\b0  z pozn\u225?mky \b nalezen\u253?ch shod\b0 , kde jsou \b hledan\u225? slova\b0  \b zv\u253?razn\u283?na\b0 .\par

\par

Shody v panelu V\u253?sledky jsou seskupeny (^) podle pozn\u225?mky (uzlu), ve kter\u233? se nach\u225?zej\u237?. V panelu v\u253?sledk\u367? hled\u225?n\u237? m\u367?\u382?ete zobrazit n\u225?zev uzlu nebo jeho \u250?plnou cestu v z\u225?vislosti na glob\u225?ln\u237? mo\u382?nosti \b Zobrazit \u250?plnou cestu uzlu ve v\u253?sledc\u237?ch hled\u225?n\u237? \b0 (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<91|0|0"}}{\fldrslt{Mo\u382?nosti: panel stromu}}}}\f0\fs20 ). N\u225?zev uzlu je v cest\u283? zv\u253?razn\u283?n.\par


\pard\li360\sb80\f1\lang3082 Glob\u225?ln\u237? mo\u382?nost \b Obr\u225?cen\u233? po\u345?ad\u237?\b0  (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<91|0|0"}}{\fldrslt{Mo\u382?nosti: panel stromu}}}}\f1\fs20 ) se pou\u382?\u237?v\u225? pouze s mo\u382?nost\u237? \ul Zobrazit \u250?plnou cestu uzlu ve stavov\u233?m \u345?\u225?dku\ulnone . Cesta uzlu ve v\u253?sledc\u237?ch hled\u225?n\u237? se v\u382?dy zobrazuje shora dol\u367?.\par

\f0\lang1033 (^) Pokud nen\u237? vy\u382?adov\u225?no hled\u225?n\u237? v obsahu pozn\u225?mek a v\u253?sledky budou obsahovat pouze n\u225?zvy/cesty uzl\u367?, zobraz\u237? se pouze jeden \u345?\u225?dek na v\u253?sledek (uzel), bez dal\u353?\u237?ch seskupovac\u237?ch \u345?\u225?dk\u367?.\par


\pard\sb200 Velikost p\u237?sma pou\u382?it\u233?ho na kart\u283? V\u253?sledky lze tak\u233? zm\u283?nit pomoc\u237? glob\u225?ln\u237? mo\u382?nosti: \b Velikost p\u237?sma ve v\u253?sledc\u237?ch Hledat v\u353?e \b0 (na kart\u283? {\ul{\field{\*\fldinst{HYPERLINK "file:///<103|0|0"}}{\fldrslt{Pokro\u269?il\u233? | Ostatn\u237?}}}}\f0\fs20  )\par


\pard\par

V tomto panelu karty Hledat budete moci {\ul\f1\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|5597|0|1"}}{\fldrslt{filtrovat uzly stromu}}}}\f1\fs20\lang3082  na z\u225?klad\u283? v\u253?sledku hled\u225?n\u237? skr\u253?t nebo zobrazit uzly.\par

\par

Upozor\u328?ujeme, \u382?e stisknut\u237?m \cf5\b\f0\lang1033 Esc\cf0\b0\f1\lang3082  na kter\u233?koli kart\u283? panelu Zdroj\u367? (*) p\u345?esunete fokus do panelu Editor (nebo panelu Strom). Pokud je fokus v ovl\u225?dac\u237?m prvku \u8222?Hledan\u253? text\u8220?, prvn\u237? \cf5\b\f0\lang1033 Esc\cf0\b0\f1\lang3082  vyma\u382?e hledan\u253? vzor a dal\u353?\u237? p\u345?esune fokus do Editoru.\par


\pard\li360\sb80 (*) Pokud je fokus nastaven na Scratch editor a mo\u382?nost \u8222?P\u345?i stisku kl\u225?vesy Escape\u8220? je nastavena na \u8222?Minimalizovat KeyNote\u8220?, Esc aplikaci minimalizuje; jinak p\u345?esune fokus do editoru.\par


\pard\par

\b Tip\b0 : Ve v\u253?sledc\u237?ch hled\u225?n\u237? se m\u367?\u382?ete pohybovat pomoc\u237? kl\u225?ves \cf5\b\f0 Nahoru \cf0\b0\f1 a \cf5\b\f0 Dol\u367?\cf0\b0\f1  (tak\u233? \cf5\b\f0 Home\cf0\b0\f1 , \cf5\b\f0 End\cf0\b0\f1 , \cf5\b\f0 Prior\cf0\b0\f1  a \cf5\b\f0 Next\cf0\b0\f1 ) a \cf5\b\f0 Enter\cf0\b0\f1 . V\u253?b\u283?rem v\u253?sledku jej vyhled\u225?te a zobraz\u237?te v kontextu, ale okno v\u253?sledk\u367? hled\u225?n\u237? z\u367?stane aktivn\u237?. Chcete-li fokus p\u345?esunout do editoru, m\u367?\u382?ete stisknout \cf5\f0 Enter\cf0\f1 .\par

\par

\b Tip\b0 : Klik\u225?n\u237?m na v\u253?sledek hled\u225?n\u237? postupn\u283? proch\u225?z\u237?te jednotliv\u225? slova shody. S ka\u382?d\u253?m dal\u353?\u237?m kliknut\u237?m se vybere jedno ze slov, kter\u225? byla zohledn\u283?na p\u345?i p\u345?id\u225?n\u237? shody do seznamu v\u253?sledk\u367?.\par

\b   \par

Tip\b0 : \f0\lang1033 : Po pou\u382?it\u237? p\u345?\u237?kazu \u8222?Hledat v\u353?e\u8220? klikn\u283?te prav\u253?m tla\u269?\u237?tkem na seznam v\u253?sledk\u367? hled\u225?n\u237? a otev\u345?e se kontextov\u225? nab\u237?dka. Nab\u237?dka obsahuje p\u345?\u237?kazy pro vlo\u382?en\u237? v\u253?sledk\u367? hled\u225?n\u237? do aktu\u225?ln\u237? pozn\u225?mky jako klikateln\u233? hypertextov\u233? odkazy.\par

\par

\b\f1\lang3082 Tip\b0 : Hled\u225?n\u237? m\u367?\u382?ete d\u225?le z\u250?\u382?it pomoc\u237? {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9159|0|6"}}{\fldrslt{syntaxe pro dopl\u328?kov\u233?/pokro\u269?il\u233? hled\u225?n\u237?}}}}\f0\fs20\lang1033 .\par

\f1\lang3082\par

\par


\pard\li360\v\'11I217\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:217,203,734"}}{\fldrslt {217_Clipb_13abr.png}}}}\lang1033      \v\'11I216\'12\v0\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:216,312,600"}}{\fldrslt {216_Clipb_20ene.png}}}}\f1\par


\pard\f0\lang1033\par

\par

Hled\u225?n\u237? m\u367?\u382?ete \ul z\u250?\u382?it\ulnone  kombinac\u237? n\u225?sleduj\u237?c\u237?ch dostupn\u253?ch \b mo\u382?nost\u237?\b0 :\par

\par

\b Rozli\u353?ovat velikost p\u237?smen\b0\par

Hled\u225?n\u237? bude rozli\u353?ovat velikost p\u237?smen. Nap\u345?\u237?klad \u8222?KeyNote\u8220? je n\u283?co jin\u233?ho ne\u382? \u8222?keynote\u8220?.\par

\par


\pard\sb80\b Pouze cel\u225? slova\par


\pard\b0 Pokud je povoleno a hled\u225?te nap\u345?\u237?klad \u8222?Note\u8220?, \u8222?KeyNote\u8220? nebude pova\u382?ov\u225?no za shodu.\par

\par


\pard\sb80\b Prohledat v\u353?echny slo\u382?ky\par


\pard\b0 Pokud je povoleno, bude text hled\u225?n ve v\u353?ech slo\u382?k\u225?ch [keynote]. Jinak bude zohledn\u283?na pouze aktu\u225?ln\u237? aktivn\u237? slo\u382?ka.\par


\pard\li360\sb80 Pozn\u225?mka: Za\u353?krt\u225?vac\u237? pol\u237?\u269?ka \ul Prohledat v\u353?echny slo\u382?ky\ulnone  v dialogu Hledat a v panelu Hledat v\u353?e jsou odd\u283?len\u225?. KeyNote si tyto mo\u382?nosti pamatuje nez\u225?visle.\par


\pard\par


\pard\sb80\b Aktu\u225?ln\u237? uzel a podstrom\b0\par


\pard Pokud je tato mo\u382?nost vybr\u225?na, KeyNote bude prohled\u225?vat pouze vybran\u253? uzel a jeho pod\u345?\u237?zen\u233? uzly.\par

\ul Pozn\u225?mka\ulnone : Vybran\u253? uzel bude zohledn\u283?n p\u345?i prov\u225?d\u283?n\u237? p\u345?\u237?kazu \u8222?Hledat v\u353?e\u8220?.\par

\par

\par

\b Prohledat skryt\u233? uzly\b0\par

Jak je uvedeno {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|18325|0|11"}}{\fldrslt{zde}}}}\f0\fs20 , uzly stromu lze skr\u253?t n\u283?kolika zp\u367?soby (nap\u345?\u237?klad v d\u367?sledku hled\u225?n\u237? Hledat v\u353?e s povolenou mo\u382?nost\u237? \ul Filtrovat slo\u382?ku\ulnone , viz n\u237?\u382?e). Pokud je tato mo\u382?nost povolena, KeyNote bude p\u345?i hled\u225?n\u237? zohled\u328?ovat i skryt\u233? uzly.\par


\pard\sb80\par


\pard\b\v\'11B14\'12\v0 Typ hled\u225?n\u237?\b0\par


\pard\sb80 P\u345?\u237?kaz \u8222?Hledat v\u353?e\u8220? lze pou\u382?\u237?t k prov\u225?d\u283?n\u237? jednoduch\u253?ch booleovsk\u253?ch hled\u225?n\u237? (AND / OR):\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b P\u345?esn\u225? fr\u225?ze\b0\par


\pard\li360\sb80 KeyNote bude hledat p\u345?esn\u283? zadan\u253? text.\par

\ul Pozn\u225?mka\ulnone : Vn\u283?j\u353?\u237? mezery budou ignorov\u225?ny (o\u345?\u237?znuty). Proto bude hled\u225?n\u237? \u8222?text entered\u8220? shodn\u233? s hled\u225?n\u237?m \u8222? text entered \u8220?. Av\u353?ak \u8222?text entered\u8220? bude odli\u353?n\u233? od \u8222?text  entered\u8220?.\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b V\u353?echna slova  \b0\fs18 (AND)\fs20\par


\pard\li360\sb80 KeyNote bude hledat zadan\u225? slova a jako odd\u283?lova\u269? slov pou\u382?ije mezeru (mezery).\par

P\u345?i t\u233?to vybran\u233? mo\u382?nosti KeyNote zahrne do v\u253?sledk\u367? v\u353?echny souvisl\u233? shody, ve kter\u253?ch jsou p\u345?\u237?tomna \ul v\u353?echna\ulnone  slova.\par

Zv\u253?razn\u237? se prvn\u237? nalezen\u233? slovo z poskytnut\u233?ho seznamu i dal\u353?\u237? slova, kter\u225? se objev\u237? ve v\u253?\u328?atku napravo od n\u283?j. Pokud posledn\u237? slovo nalezen\u233? v identifikovan\u233? shod\u283? nen\u237? zobrazeno ve v\u253?\u328?atku z\u237?skan\u233?m pro prvn\u237? nalezen\u233? slovo, p\u345?id\u225? se dal\u353?\u237? v\u253?\u328?atek pro posledn\u237? slovo (odd\u283?len\u253? pomoc\u237? \u8222?\cf6\b\f2 . . //. .\cf0\b0\f0 \u8220?), kde jsou zv\u253?razn\u283?na v\u353?echna hledan\u225? slova.\par

\ul Pozn\u225?mka\ulnone : Od verze 2.0 byl revidov\u225?n zp\u367?sob fungov\u225?n\u237? typu hled\u225?n\u237? 'V\u353?echna slova'. Viz {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|15353|0|10"}}{\fldrslt{v\u237?ce}}}}\f0\fs20 .\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Kter\u233?koli ze slov  \b0\fs18 (OR)\fs20\par


\pard\li360\sb80 KeyNote bude hledat zadan\u225? slova a jako odd\u283?lova\u269? slov pou\u382?ije mezeru (mezery).\par

P\u345?i t\u233?to vybran\u233? mo\u382?nosti KeyNote zahrne do v\u253?sledk\u367? v\u353?echny souvisl\u233? shody, ve kter\u253?ch je p\u345?\u237?tomno \ul kter\u233?koli\ulnone  ze slov.\par

Vytvo\u345?\u237? se v\u253?sledky, kter\u233? zahrnuj\u237? a zv\u253?raz\u328?uj\u237? v\u353?echny v\u253?skyty ka\u382?d\u233?ho ze slov hledan\u233?ho v\u253?razu. Nov\u233? v\u253?sledky se p\u345?id\u225?vaj\u237? pouze pro slova, kter\u225? nejsou viditeln\u225? v p\u345?edchoz\u237?m v\u253?\u328?atku.\par


\pard\par


\pard\sb80 Pozn\u225?mka. S \ul V\u353?echna slova\ulnone  nebo \ul Kter\u233?koli ze slov\ulnone :\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Na jednu pozn\u225?mku (uzel) m\u367?\u382?e p\u345?ipadat v\u237?ce ne\u382? jeden v\u253?sledek/shoda\par

{\pntext\f5\'B7\tab}Po\u345?ad\u237? v\u253?skytu slov nen\u237? podstatn\u233?.\par

{\pntext\f5\'B7\tab}V\u253?b\u283?r\f3  \f0 \u8222?V\u353?echna\f3  \f0 ta\f3  \f0 slova\u8220?\f3  \f0 nebo\f3  \f0 \u8222?Kter\u233?koli\f3  \f0 z\f3  \f0 t\u283?ch\f3  \f0 slov\u8220?\f3  \f0 p\u345?i\f3  \f0 hled\u225?n\u237?\f3  \f0 pouze\f3  \f0 jednoho\f3  \f0 jedin\u233?ho\f3  \f0 slova\f3  \f0 je\f3  \f0 ekvivalentn\u237?\f3  \f0 pou\u382?it\u237?\f3  \f0 \u8222?P\u345?esn\u233?\f3  \f0 fr\u225?ze\u8220?.\par

{\pntext\f5\'B7\tab}Viz tak\u233? {\ul\f1\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|20992|0|15"}}{\fldrslt{Kombinov\u225?n\u237? token\u367? pokro\u269?il\u233?ho hled\u225?n\u237? (a typu hled\u225?n\u237?)}}}}\f0\fs20\par


\pard\par

\par


\pard\sb80\b Datum vytvo\u345?en\u237?. Datum posledn\u237? zm\u283?ny   (Od / Do)\b0\par

KeyNote bude zohled\u328?ovat pouze uzly vytvo\u345?en\u233? a/nebo upraven\u233? v uveden\u253?ch intervalech.\par


\pard Uzly s chyb\u283?j\u237?c\u237?m datem vytvo\u345?en\u237? nebo posledn\u237? zm\u283?ny budou ignorov\u225?ny. Upozor\u328?ujeme, \u382?e KeyNote dok\u225?\u382?e odvodit data z n\u225?zvu a obsahu existuj\u237?c\u237?ch pozn\u225?mek vytvo\u345?en\u253?ch star\u353?\u237?mi verzemi. Viz {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|31373|0|20"}}{\fldrslt{Odvozen\u237? chyb\u283?j\u237?c\u237?ch informac\u237? o datu}}}}\f0\fs20\par


\pard\sb160\b Tip\b0 : Spu\u353?t\u283?n\u237? Hledat v\u353?e bez zad\u225?n\u237? textu je povoleno, pokud je nastaveno n\u283?jak\u233? krit\u233?rium data\par


\pard\par

\par

\b Rozsah hled\u225?n\u237?\b0\par


\pard\sb80 Pomoc\u237? t\u233?to mo\u382?nosti m\u367?\u382?ete omezit hled\u225?n\u237? na n\u225?zvy uzl\u367? nebo obsah pozn\u225?mek, s ohledem na:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\sa40\b Pouze n\u225?zvy uzl\u367?\b0\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40\b Pouze obsah pozn\u225?mek\b0\par

{\pntext\f5\'B7\tab}\b V\u353?e\b0\par


\pard\sb160 Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Dal\u353?\u237? vybran\u233? mo\u382?nosti, jako \ul Typ hled\u225?n\u237?\ulnone  (P\u345?esn\u225? fr\u225?ze, V\u353?echna slova, Kter\u233?koli ze slov) nebo \ul Pouze cel\u225? slova\ulnone , budou p\u345?i hled\u225?n\u237? v n\u225?zvech uzl\u367? tak\u233? zohledn\u283?ny.\par

{\pntext\f5\'B7\tab}Shody v n\u225?zvech uzl\u367? jsou v seznamu v\u253?sledk\u367? \cf6\highlight7 zv\u253?razn\u283?ny\cf0\highlight0  barvou pozad\u237? \highlight7\lang3082 sv\u283?tle \u382?lutou\highlight8\lang1033  \highlight0 \par


\pard\par

\par

\b Pou\u382?\u237?t cestu uzlu\b0\par


\pard\sb80 Ve v\u253?choz\u237?m nastaven\u237? se p\u345?i hled\u225?n\u237? v n\u225?zvu uzl\u367? zohled\u328?uje pouze samotn\u253? uzel. Pokud je povolena mo\u382?nost 'Pou\u382?\u237?t cestu uzl\u367?', m\u283?la by se pou\u382?\u237?t \u250?pln\u225? cesta, tj. v\u269?etn\u283? n\u225?zv\u367? nad\u345?azen\u253?ch uzl\u367?.\par

Vysv\u283?tlen\u237? a p\u345?\u237?klad jeho mo\u382?n\u233?ho pou\u382?it\u237? najdete v \u269?\u225?sti Slo\u382?ky jako stromy pozn\u225?mek / Filtrov\u225?n\u237? stromu / {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|26525|0|18"}}{\fldrslt{Filtrov\u225?n\u237? podle n\u225?zvu}}}}\f0\fs20\par


\pard\par

\par

\b Za\u353?krtnut\u233? uzly\b0\par


\pard\sb80\f1\lang3082 Tato mo\u382?nost umo\u382?\u328?uje omezit hled\u225?n\u237? v z\u225?vislosti na stavu za\u353?krtnut\u237? uzl\u367?, s ohledem na:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\sa40\b\f0\lang1033 Pouze neza\u353?krtnut\u233? uzly\b0\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40\b Pouze za\u353?krtnut\u233? uzly\b0\par

{\pntext\f5\'B7\tab}\b V\u353?e\b0\par


\pard\par

\par

\cf4\b\v\f1\fs24\'11B13\'12\v0 Sbalen\u233? bloky\par

\cf0\b0\f0\fs20\par

Pokud do pozn\u225?mek zahrnujete sbalen\u253? text, m\u367?\u382?ete pou\u382?\u237?t rozbalovac\u237? seznam \u8222?\b Re\u382?im sbalen\u237?\b0 \u8220? s n\u283?kterou z t\u283?chto mo\u382?nost\u237?:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 V\u353?e\par

{\pntext\f5\'B7\tab}Vylou\u269?it sbalen\u233?\par

{\pntext\f5\'B7\tab}Vylou\u269?it ozna\u269?en\u233? sbalen\u233?\par

{\pntext\f5\'B7\tab}Pouze sbalen\u233?\par


\pard\par

Prvn\u237? mo\u382?nost, ve v\u253?choz\u237?m nastaven\u237? vybran\u225?, nerozli\u353?uje podle stavu textu a umo\u382?\u328?uje vyhled\u225?vat slova bez ohledu na to, zda se nach\u225?zej\u237? ve sbalen\u253?ch (skryt\u253?ch) bloc\u237?ch nebo ne.\par


\pard\sb40 Posledn\u237? mo\u382?nost omez\u237? hled\u225?n\u237? v\u253?hradn\u283? na sbalen\u233? bloky. V kombinaci s krit\u233?riem \u353?t\u237?tku je mo\u382?n\u233? d\u225?le omezit, kter\u233? bloky se maj\u237? zohlednit.\par


\pard\par

Dv\u283? prost\u345?edn\u237? mo\u382?nosti umo\u382?\u328?uj\u237? ignorovat sbalen\u253? text, p\u345?i\u269?em\u382? t\u345?et\u237? je restriktivn\u283?j\u353?\u237? a vylu\u269?uje pouze ty sbalen\u233? bloky, kter\u233? za\u269?\u237?naj\u237? \u353?t\u237?tkem. \par


\pard\sb40 Tato mo\u382?nost ({\ul{\field{\*\fldinst{HYPERLINK "file:///<122|23127|0|11"}}{\fldrslt{"ozna\u269?en\u253?" sbalen\u253? blok}}}}\f0\fs20 ) je k dispozici s ohledem na mo\u382?nost kombinovan\u233?ho pou\u382?it\u237? \u353?t\u237?tk\u367? a sbalov\u225?n\u237?, kter\u233? m\u367?\u382?ete vyu\u382?\u237?t k snadn\u233?mu ozna\u269?en\u237? textu, jen\u382? m\u225? b\u253?t p\u345?i hled\u225?n\u237? ignorov\u225?n, jako jsou archivovan\u233? informace, pomocn\u253? obsah, dokon\u269?en\u233? \u250?koly, kter\u233? nechcete zohled\u328?ovat atd. Naopak jin\u233? sbalen\u233? bloky mohou obsahovat text, kter\u253? prost\u283? chcete m\u237?t skryt\u253? kv\u367?li \u269?itelnosti nebo p\u345?ehlednosti, proto\u382?e jde o podrobnosti, kter\u233? chcete zobrazit jen v p\u345?\u237?pad\u283? pot\u345?eby.\par


\pard\sb80 Skl\u225?dan\u233? bloky m\u367?\u382?e samoz\u345?ejm\u283? ka\u382?d\u253? u\u382?ivatel pou\u382?\u237?vat jinak.\par


\pard\par

\b Pozn\u225?mka\b0 :\par

Kdy\u382? kliknete na v\u253?sledek hled\u225?n\u237? um\u237?st\u283?n\u253? uvnit\u345? skl\u225?dan\u233?ho textov\u233?ho bloku, p\u345?esko\u269?\u237? na tento blok a vybere \u8222?+\u8220? odpov\u237?daj\u237?c\u237? za\u269?\u225?tku bloku.\par

\par

\par

\cf4\b\v\f1\fs24\'11B12\'12\v0 Pou\u382?it\u237? \u353?t\u237?tk\u367? s funkc\u237? Naj\u237?t v\u353?e\par

\cf0\b0\f0\fs20\par

Pomoc\u237? krit\u233?ri\u237? hled\u225?n\u237? zalo\u382?en\u253?ch na \u353?t\u237?tc\u237?ch lze tak\u233? ur\u269?it, kter\u233? uzly se maj\u237? zohlednit.\par


\pard\sb40 Je v\u353?ak tak\u233? mo\u382?n\u233? vyu\u382?\u237?t ozna\u269?kov\u225?n\u237? obsa\u382?en\u233? p\u345?\u237?mo v textu a omezit v\u253?sledky hled\u225?n\u237? na ty odstavce nebo textov\u233? fragmenty, kter\u233? spl\u328?uj\u237? ur\u269?it\u225? krit\u233?ria ozna\u269?kov\u225?n\u237?.\par


\pard\par

\ul Zohled\u328?ovan\u233? uzly\ulnone  lze omezit na z\u225?klad\u283? v\u253?b\u283?ru \u353?t\u237?tk\u367?:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40\b S\b0  [V\u352?ECHNY nebo N\u282?KTER\u201?] uveden\u253?mi \u353?t\u237?tky \par


\pard\li360 (lze pou\u382?\u237?t jednotliv\u233? \u353?t\u237?tky nebo v\u237?ce \u353?t\u237?tk\u367? \u8211? nap\u345?. Err*)\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80\b Bez\b0  \u382?\u225?dn\u233?ho z uveden\u253?ch \u353?t\u237?tk\u367?\par


\pard\par

Souvisej\u237?c\u237? kontroly:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Zohlednit metadata pozn\u225?mek\b0\par

{\pntext\f5\'B7\tab}\b Zohlednit text pozn\u225?mek\b0\par

{\pntext\f5\'B7\tab}\b Zd\u283?d\u283?n\u233? \u353?t\u237?tky (metadata)\b0\par


\pard\par

\u352?t\u237?tky, kter\u233? se maj\u237? pou\u382?\u237?t v pol\u237?ch S a Bez, se zad\u225?vaj\u237? pomoc\u237? v\u253?b\u283?ru \u353?t\u237?tk\u367? (viz {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|7939|0|5"}}{\fldrslt{Pou\u382?\u237?v\u225?n\u237? v\u253?b\u283?ru zna\u269?ek}}}}\f0\fs20 ) \par


\pard\li360\sb80\b Tip\b0 : Obsah ovl\u225?dac\u237?ch prvk\u367? S nebo Bez m\u367?\u382?ete vymazat pomoc\u237? \cf5 Ctrl+kliknut\u237?\cf0  v jejich textu.\par


\pard\par

\b Pozn\u225?mka\b0 : \u352?t\u237?tky zadan\u233? v ovl\u225?dac\u237?ch prvc\u237?ch S a/nebo Bez budou ignorov\u225?ny, pokud nejsou za\u353?krtnuty ob\u283? mo\u382?nosti \u8222?Zohlednit metadata pozn\u225?mek\u8220? a \u8222?Zohlednit text pozn\u225?mek\u8220?\par

\par

Hled\u225?n\u237? m\u367?\u382?eme \ul omezit na textov\u233? fragmenty\ulnone , kter\u233? neobsahuj\u237? \u382?\u225?dn\u253? z ur\u269?it\u253?ch vybran\u253?ch \u353?t\u237?tk\u367?:\par


\pard\sb80 Mus\u237? b\u253?t za\u353?krtnuta mo\u382?nost \u8222?Zohlednit text pozn\u225?mek\u8220?.\par


\pard Mo\u382?nost \u8222?Zohlednit metadata pozn\u225?mek\u8220? m\u367?\u382?e b\u253?t za\u353?krtnuta. Pokud je za\u353?krtnuta, budou se \u353?t\u237?tky pou\u382?it\u233? na celou pozn\u225?mku jako metadata zohled\u328?ovat spole\u269?n\u283? se \u353?t\u237?tky zadan\u253?mi uvnit\u345? textu\par


\pard\li360 Pokud uvedeme \u353?t\u237?tky v klauzuli S a m\u225?me za\u353?krtnutou mo\u382?nost \u8222?Zohlednit metadata pozn\u225?mek\u8220?, bude KeyNote p\u345?i hled\u225?n\u237? v textu ignorovat ty \u353?t\u237?tky, kter\u233? se nach\u225?zej\u237? v metadatech pozn\u225?mky.\par


\pard\par

\b Pozn\u225?mky\b0 :\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 P\u345?i kontrole, zda textov\u253? fragment spl\u328?uje podm\u237?nky \u353?t\u237?tk\u367?, je d\u367?le\u382?it\u233? m\u237?t na pam\u283?ti, \u382?e ka\u382?d\u253? \u353?t\u237?tek definuje rozsah (interval s doln\u237? a horn\u237? hranic\u237? textu, na kter\u253? p\u367?sob\u237?), a \u382?e to bude z\u225?viset tak\u233? na tom, zda byl \u353?t\u237?tek definov\u225?n \u8222?otev\u345?en\u283?\u8220? (nap\u345?. #Critical: ), nebo ne; v druh\u233?m p\u345?\u237?pad\u283? ovliv\u328?uje pouze odstavec, ve kter\u233?m se nach\u225?z\u237? (viz {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|4425|0|3"}}{\fldrslt{Rozsah nebo oblast pou\u382?it\u237? zna\u269?ek}}}}\f0\fs20 )\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Hled\u225?n\u237? je mo\u382?n\u233? omezit pomoc\u237? {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|6396|0|4"}}{\fldrslt{neregistrovan\u233? zna\u269?ky}}}}\f0\fs20\par

{\pntext\f5\'B7\tab}Pokud hled\u225?me obsah pomoc\u237? \u353?t\u237?tk\u367? a hledan\u253? text je \u8222?\u8220?, vrac\u237? se shoda pro ka\u382?d\u253? kus textu, kter\u253? spl\u328?uje krit\u233?ria\par


\pard\par

{\ul\protect\fs24{\field{\*\fldinst{HYPERLINK "FOLD:"}}{\fldrslt{\f4\u10133?\f0  \f4 }}}}\protect\f0\fs20 N\u283?kter\u233? \b p\u345?\u237?klady\b0 ; hled\u225?me \u8222?task\u8220? a chceme \ul vylou\u269?it\ulnone  text s n\u283?kter\u253?m z vybran\u253?ch \u353?t\u237?tk\u367?: \ul Bez\ulnone  = \u8222?[x]\u8220?\v\par
