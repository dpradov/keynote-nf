\pard\f0\fs20\lang1033\par

\cf1\b\fs36 Mo\u382?nosti: Mo\u382?nosti z\u225?lohov\u225?n\u237?\par

\cf0\b0\fs28\par


\pard\li360\v\'11I247\'12\v0\fs20\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:247,379,365"}}{\fldrslt {247_Clipb_05mar.png}}}}\lang1033\par


\pard\sa100\par

\cf1\b\fs22 Z\u225?lohovat v pravideln\u253?ch intervalech\cf0\fs20\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard Je-li povoleno, KeyNote p\u345?i ukl\u225?d\u225?n\u237? vytv\u225?\u345?\u237? z\u225?lohy va\u353?eho souboru podle z\u225?sady, kter\u225? uchov\u225?v\u225? kopie, je\u382? KeyNote nep\u345?ep\u237?\u353?e. Budete m\u237?t kopii za ka\u382?d\u253? m\u283?s\u237?c, jednu za ka\u382?d\u253? z posledn\u237?ch t\u253?dn\u367? atd.\par


\pard\sb40 Podrobn\u253? popis fungov\u225?n\u237? tohoto mechanismu najdete v {\ul{\field{\*\fldinst{HYPERLINK "file:///<53|0|0"}}{\fldrslt{Z\u225?lohov\u225?n\u237? v pravideln\u253?ch intervalech}}}}\f0\fs20\par


\pard\sa100\par


\pard\sa80\cf1\b\fs22 Maxim\u225?ln\u237? \u250?rove\u328? denn\u237?ch z\u225?loh\cf0\fs20\tab\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: 5\par


\pard P\u345?i prvn\u237?m ulo\u382?en\u237? v nov\u233?m dni se vytvo\u345?\u237? z\u225?loha souboru \i p\u345?ed\i0  ulo\u382?en\u237?m (pokud nen\u237? k dispozici jako t\u253?denn\u237? nebo m\u283?s\u237?\u269?n\u237? z\u225?loha) jako samostatn\u253? soubor. \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\lang3082 Je-li tato volba nastavena na 1, kopie pro dan\u253? den \f1 file_BAK_Day.knt\f0  bude nahrazena kopi\u237? odpov\u237?daj\u237?c\u237? nov\u233?mu dni. \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Je-li tato volba nastavena na 2 a\u382? 7, vytvo\u345?\u237? se m\u237?sto souboru \f1 file_BAK_Day.knt\f0  soubor ve tvaru \f1 file_BAK_@D1.knt\f0  a ji\u382? vytvo\u345?en\u233? soubory se automaticky p\u345?esunou na ..\f1 @D2, \f0 ..\f1 @D3\f0  atd., p\u345?i\u269?em\u382? se automaticky sma\u382?ou nejstar\u353?\u237? soubory p\u345?ekra\u269?uj\u237?c\u237? nastavenou maxim\u225?ln\u237? \u250?rove\u328?.\lang1033\par


\pard\sb160 Tato volba souvis\u237? s {\ul{\field{\*\fldinst{HYPERLINK "file:///<53|0|0"}}{\fldrslt{Z\u225?lohov\u225?n\u237? v pravideln\u253?ch intervalech}}}}\f0\fs20 . Neovliv\u328?uje volbu \cf3\b Z\u225?lohovat p\u367?vodn\u237? soubor p\u345?i ukl\u225?d\u225?n\u237? zm\u283?n\cf0\b0 .\par


\pard\sa100\par

\par

\cf1\b\fs22 Z\u225?lohovat p\u367?vodn\u237? soubor p\u345?i ukl\u225?d\u225?n\u237? zm\u283?n\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard Je-li povoleno, KeyNote p\u345?i ukl\u225?d\u225?n\u237? vytv\u225?\u345?\u237? z\u225?lohu va\u353?eho souboru.\par

\par

\par


\pard\sa100\cf1\b\fs22 P\u345?ipojit p\u345?\u237?ponu k p\u367?vodn\u237?mu n\u225?zvu souboru\cf0\fs20\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li povoleno, KeyNote p\u345?id\u225? z\u225?lo\u382?n\u237? p\u345?\u237?ponu (ve v\u253?choz\u237?m nastaven\u237? .BAK) k n\u225?zvu p\u367?vodn\u237?ho souboru (myfile.knt se zm\u283?n\u237? na myfile.knt.bak).\par

{\pntext\f2\'B7\tab}Je-li zak\u225?z\u225?no, z\u225?lo\u382?n\u237? p\u345?\u237?pona nahrad\u237? p\u367?vodn\u237? p\u345?\u237?ponu souboru (myfile.knt se zm\u283?n\u237? na myfile.bak).\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 P\u345?\u237?pona z\u225?lo\u382?n\u237?ch soubor\u367?\cf0\fs20\tab\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: .BAK\par


\pard Zadejte p\u345?\u237?ponu, kter\u225? se bude pou\u382?\u237?vat pro vytv\u225?\u345?en\u237? z\u225?lo\u382?n\u237?ch soubor\u367?.\par


\pard\li240\sb100\ul Pozn\u225?mka\ulnone\b :  \b0 N\u283?kolik standardn\u237?ch p\u345?\u237?pon KeyNote je vyhrazeno a nelze je pou\u382?\u237?t pro z\u225?lo\u382?n\u237? soubory. Nap\u345?\u237?klad \u8222?.KNT\u8220?, \u8222?.KNE\u8220? a \u8222?.n_text\u8220? nelze pou\u382?\u237?t jako p\u345?\u237?pony z\u225?lo\u382?n\u237?ch soubor\u367?.\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Z\u225?lohovat tak\u233? soubory virtu\u225?ln\u237?ch uzl\u367?\cf0\fs20\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard\fi-240\li240 Je-li povoleno, KeyNote vytv\u225?\u345?\u237? z\u225?lo\u382?n\u237? kopii tak\u233? pro ka\u382?d\u253? soubor propojen\u253? jako virtu\u225?ln\u237? uzel, a to se stejnou z\u225?lo\u382?n\u237? p\u345?\u237?ponou jako u souboru KeyNote.\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Maxim\u225?ln\u237? \u250?rove\u328? z\u225?loh\cf0\fs20\tab\tab\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: 1\par


\pard Zadejte po\u269?et z\u225?lo\u382?n\u237?ch soubor\u367?, kter\u233? KeyNote uchov\u225?v\u225? pro ka\u382?d\u253? soubor KeyNote.\par


\pard\sb80 Tato volba ovliv\u328?uje po\u269?et soubor\u367? vytv\u225?\u345?en\u253?ch cyklick\u253?m mechanismem aktivovan\u253?m volbou \cf3\b Z\u225?lohovat p\u367?vodn\u237? soubor p\u345?i ukl\u225?d\u225?n\u237? zm\u283?n\cf0\b0 . Neovliv\u328?uje volbu \cf3\b Z\u225?lohovat v pravideln\u253?ch intervalech\cf0\b0\par


\pard\par


\pard\li360\b Pozn\u225?mka\b0 : U ur\u269?it\u253?ch soubor\u367? je mo\u382?n\u233? tuto volbu ignorovat povolen\u237?m volby \b Nechovat v\u237?ce z\u225?loh tohoto souboru\b0  (v nab\u237?dce {\ul{\field{\*\fldinst{HYPERLINK "file:///<47|0|0"}}{\fldrslt{Soubor | Vlastnosti}}}}\f0\fs20 , karta Nastaven\u237?)\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Adres\u225?\u345? pro z\u225?lo\u382?n\u237? soubory\cf0\b0\fs20\par


\pard Vyberte bu\u271? \b adres\u225?\u345? p\u367?vodn\u237?ho souboru\rquote \b0 , nebo \b samostatn\u253? adres\u225?\u345?\b0  (a zvolte adres\u225?\u345?) pro ukl\u225?d\u225?n\u237? z\u225?lo\u382?n\u237?ch soubor\u367? KeyNote.\par


\pard\li240\sb100\ul Pozn\u225?mka\ulnone\b : "\b0 Mus\u237? b\u253?t povolena volba \u8222?Z\u225?lohovat p\u367?vodn\u237? soubor p\u345?i ukl\u225?d\u225?n\u237? zm\u283?n\u8220?.\par


\pard\par

\par

}
