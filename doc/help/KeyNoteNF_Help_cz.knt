\pard\sb80\cf3\b Ctrl+Shift+I\cf0\b0\tab\tab Invertuje \b velikost p\u237?smen\b0  vybran\u233?ho textu (Toto -> tOTO) \par


\pard\cf3\b Ctrl+Shift+L\cf0\b0\tab\tab Zm\u283?n\u237? vybran\u253? text na mal\u225? p\u237?smena \par

\cf3\b Ctrl+Shift+M\cf0\b0\tab\tab Zm\u283?n\u237? vybran\u253? text na Sm\u237?\u353?enou velikost p\u237?smen \par

\cf3\b Ctrl+Shift+U\cf0\b0\tab\tab Zm\u283?n\u237? vybran\u253? text na VELK\u193? P\u205?SMENA \par


\pard\sb120\cf3\b Ctrl+Shift+Y\cf0\b0\tab\tab Vlo\u382?\u237? hypertextov\u253? odkaz \par


\pard\sb40\cf3\b F7\cf0\b0\tab\tab\tab Rozvine term\u237?n podle \b definice slovn\u237?ku\b0   \par


\pard\cf3\b Shift+F7\cf0\b0\tab\tab P\u345?id\u225? nov\u253? term\u237?n do slovn\u237?ku  \par


\pard\sb160\cf3\b Ctrl+Shift+3\cf0\b0\tab\tab Pou\u382?ije Rot-13 na vybran\u253? text \par


\pard\cf3\b Ctrl+Shift+4\cf0\b0\tab\tab Obr\u225?t\u237? vybran\u253? text \par

\par

\cf3\b Alt+Down\cf0\b0\tab\tab\b P\u345?epne na\b0  DAL\u352?\u205? uzel ve stromu\par

\cf3\b Alt+Up\cf0\b0\tab\tab\tab P\u345?epne na P\u344?EDCHOZ\u205? uzel ve stromu\par

\cf3\b Shift+Alt+Left\cf0\b0\tab P\u345?esune VLEVO ve stromu \par

\cf3\b Shift+Alt+Right\cf0\b0\tab P\u345?esune VPRAVO ve stromu \par


\pard\fi-2160\li2160\sb100\cf3\b Ctrl+Numpad /\cf0\b0\tab P\u345?esune fokus do kombinovan\u233?ho pole Makro. (Vyberte makro, potom stiskn\u283?te Enter pro jeho spu\u353?t\u283?n\u237? nebo Esc pro zru\u353?en\u237?.)\par


\pard\fi-2160\li2160\tab Panel n\u225?stroj\u367? Makro mus\u237? b\u253?t viditeln\u253?.\par


\pard\fi-2160\li2160\sb100\cf3\b Ctrl+Up\cf0\b0  / \cf3\b Down\cf0\b0\tab Posune cel\u253? dokument o jeden \u345?\u225?dek dol\u367? nebo nahoru. Kurzor z\u367?stane na stejn\u233?m m\u237?st\u283?.\par

\cf3\b Ctrl+Shift+Up\cf0\b0  / \cf3\b Down\cf0\b0\tab Plynule posune posuvn\u237?k svisle. Kurzor se nezm\u283?n\u237?.\par


\pard\fi-2160\li2160\par

\par

\tab\par


\pard\b Navrhovan\u233? alternativy, kter\u233? m\u367?\u382?ete vyzkou\u353?et m\u237?sto st\u225?vaj\u237?c\u237?ch v\u253?choz\u237?ch.\b0\par


\pard\sb80 M\u367?\u382?ete pou\u382?\u237?t v\u253?choz\u237? zkratky nebo upravit kteroukoli, kter\u225? se v\u225?m zd\u225? obt\u237?\u382?n\u225? na pou\u382?\u237?v\u225?n\u237? nebo na zapamatov\u225?n\u237?. Z\u225?le\u382?\u237? tak\u233? na tom, kter\u253? p\u345?\u237?kaz pou\u382?\u237?v\u225?te \u269?ast\u283?ji. \par

Nap\u345?\u237?klad hodn\u283? pou\u382?\u237?v\u225?m p\u345?\u237?kazy \i Zv\u283?t\u353?it \i0 a \i zmen\u353?it lev\u233? odsazen\u237?\i0 . Proto rad\u283?ji pou\u382?\u237?v\u225?m:\par


\pard\par

  Zv\u283?t\u353?it lev\u233? odsazen\u237?:   \tab\tab\tab\cf2 Ctrl+Alt+Right\cf0\par

  Zmen\u353?it lev\u233? odsazen\u237?:  \tab\tab\tab\cf2 Ctrl+Alt+Left\cf0\par

\par

}
