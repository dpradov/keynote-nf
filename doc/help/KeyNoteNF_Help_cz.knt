   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|6204|0|13"}}{\fldrslt{Zm\u283?na re\u382?imu ukl\u225?d\u225?n\u237?}}}}}\f0\fs18\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|8067|0|14"}}{\fldrslt{Pr\u225?ce s nedostupn\u253?m extern\u237?m \u250?lo\u382?i\u353?t\u283?m}}}}}\f0\fs18\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|9684|0|15"}}{\fldrslt{Export a import. P\u345?evody}}}}}\f0\fs18\par


\pard\sb80 {\fs20{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|10885|0|4"}}{\fldrslt{Vkl\u225?d\u225?n\u237? obr\u225?zk\u367?}}}}}\f0\fs20\par


\pard {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|17096|0|9"}}{\fldrslt{Viditelnost obr\u225?zk\u367?}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|19631|0|1"}}{\fldrslt{Rozm\u283?ry a proporce}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|23459|0|2"}}{\fldrslt{Jak pou\u382?\u237?vat prohl\u237?\u382?e\u269? obr\u225?zk\u367?}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|27611|0|3"}}{\fldrslt{Ukl\u225?d\u225?n\u237? obr\u225?zk\u367? do podslo\u382?ek}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|32297|0|10"}}{\fldrslt{Optimalizace}}}}}\f0\fs20\par

