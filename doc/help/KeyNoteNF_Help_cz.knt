\lang3082\par

\cf1\b\v\fs26\lang1033\'11B9\'12\v0 P\u345?idat term\u237?n glos\u225?\u345?e\cf3\fs20\par

\cf0\b0 P\u345?id\u225? \cf6\ul term\u237?n\cf0\ulnone  do glos\u225?\u345?e.\par


\pard\sb80 Dal\u353?\u237? informace naleznete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<24|0|0"}}{\fldrslt{Glos\u225?\u345? rozbalov\u225?n\u237? slov}}}}}\f0\fs20 .\par


\pard\par

