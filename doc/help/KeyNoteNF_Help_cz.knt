{\pntext\f3\'B7\tab}"\b Funkce \u8222?zachyt\u225?v\u225?n\u237? schr\u225?nky\b0 \u8220? umo\u382?\u328?uje automaticky zachytit a ulo\u382?it ve\u353?ker\u253? text a obr\u225?zky zkop\u237?rovan\u233? do schr\u225?nky z jak\u233?koli jin\u233? aplikace nebo i z KeyNote ({\ul{\field{\*\fldinst{HYPERLINK "file:///<35|0|0"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}"\b Funkce \u8222?web clip\b0 \u8220? umo\u382?\u328?uje vkl\u225?dat text a obr\u225?zky z extern\u237?ch program\u367? (v\u269?etn\u283? webov\u253?ch prohl\u237?\u382?e\u269?\u367?) konfigurovateln\u253?m zp\u367?sobem ({\ul{\field{\*\fldinst{HYPERLINK "file:///<34|0|0"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}\b Skl\u225?d\u225?n\u237? a rozbalov\u225?n\u237?\b0 : text lze slo\u382?it a skr\u253?t jeho obsah krom\u283? mal\u233?ho fragmentu slou\u382?\u237?c\u237?ho jako viditeln\u253? v\u253?\u328?atek. Vno\u345?ov\u225?n\u237? slo\u382?en\u253?ch blok\u367? je mo\u382?n\u233? a tyto bloky mohou obsahovat obr\u225?zky, odkazy, tabulky atd. ({\ul{\field{\*\fldinst{HYPERLINK "file:///<123|0|0"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}Jednoduch\u233? \b z\u225?lo\u382?ky\b0  ({\ul{\field{\*\fldinst{HYPERLINK "file:///<20|23704|0|13"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}Z\u225?kladn\u237? podpora \b tabulek\b0  RTF ({\ul{\field{\*\fldinst{HYPERLINK "file:///<20|17466|0|2"}}{\fldrslt{V\u237?ce}}}}\f0\fs20 )\par

{\pntext\f3\'B7\tab}\b Funkce \b0 glos\u225?\u345?e pro automatick\u233? nahrazen\u237? \u269?\u225?sti textu jin\u253?m textem ({\ul{\field{\*\fldinst{HYPERLINK "file:///<24|0|0"}}{\fldrslt{Rozbalit text}}}}\f0\fs20 )\par


\pard{\pntext\f3\'B7\tab}{\*\pn\pnlvlblt\pnf3\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80\sa100 Statistika textu\par


