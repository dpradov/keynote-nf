GI=93
ND=Možnosti souborů
%.
%:
{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green128\blue128;\red0\green0\blue255;}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\fs36 Mo\u382?nosti: Mo\u382?nosti soubor\u367?\par

\cf0\b0\fs26\par


\pard\li360\v\'11I132\'12\v0\fs20{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:132,358,342"}}{\fldrslt {132_Clipb_17ene.png}}}}\fs26\par


\pard\par


\pard\sa100\cf1\b\fs22 Pamatovat si naposledy pou\u382?it\u233? soubory\cf0\fs20\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard Je-li povoleno, KeyNote si pamatuje naposledy pou\u382?it\u233? soubory a zobrazuje jejich seznam v nab\u237?dce \b Soubor|Naposledy pou\u382?it\u233? soubory\b0 . Tak\u233? ur\u269?ete po\u269?et soubor\u367?, kter\u233? si m\u225? KeyNote pamatovat.\par


\pard\sb100\ul\b Tip\ulnone : \b0 K seznamu naposledy pou\u382?it\u253?ch soubor\u367? se dostanete je\u353?t\u283? rychleji kliknut\u237?m na \u353?ipku dol\u367? vedle tla\u269?\u237?tka \b Otev\u345?\u237?t\b0  na hlavn\u237?m panelu n\u225?stroj\u367?.\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Zobrazit jako podnab\u237?dku\cf0\fs20\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li povoleno, seznam naposledy pou\u382?it\u253?ch soubor\u367? se zobraz\u237? jako podnab\u237?dka v nab\u237?dce \b Soubor\b0 .\par

{\pntext\f1\'B7\tab}Je-li zak\u225?z\u225?no, seznam naposledy pou\u382?it\u253?ch soubor\u367? se zobraz\u237? p\u345?\u237?mo v nab\u237?dce \b Soubor\b0 .\par


\pard\li360\sb100\i Mus\u237? b\u253?t povolena volba Pamatovat si naposledy pou\u382?it\u233? soubory.\i0\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Zobrazovat \u250?plnou cestu v nab\u237?dce naposledy pou\u382?it\u253?ch\cf0\fs20\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard Je-li povoleno, nab\u237?dka naposledy pou\u382?it\u253?ch soubor\u367? zobrazuje \u250?pln\u233? n\u225?zvy soubor\u367? (s cestami). Jinak zobrazuje pouze n\u225?zvy soubor\u367?.\par


\pard\li240\sb100\i Mus\u237? b\u253?t povolena volba Pamatovat si naposledy pou\u382?it\u233? soubory.\i0\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Otev\u237?rat v re\u382?imu jen pro \u269?ten\u237?\cf0\fs20\tab\tab\tab\tab\tab\b0 V\u253?choz\u237?: NE\par


\pard Pokud jsou povoleny volby \b Soubory na disket\u225?ch\b0  a/nebo \b Soubory na s\u237?\u357?ov\u253?ch disc\u237?ch\b0 , KeyNote otev\u237?r\u225? takov\u233? soubory pouze pro prohl\u237?\u382?en\u237?.\par


\pard\sb80 Soubory otev\u345?en\u233? v re\u382?imu jen pro \u269?ten\u237? lze upravovat, ale budete je muset ulo\u382?it pod jin\u253?m n\u225?zvem (pomoc\u237? p\u345?\u237?kazu Soubor | \b Ulo\u382?it jako\b0 ) nebo je zav\u345?\u237?t bez ulo\u382?en\u237? zm\u283?n.\par


\pard\li240\sb100\ul Pozn\u225?mka\ulnone\b :  \b0 V n\u283?kter\u253?ch dal\u353?\u237?ch p\u345?\u237?padech se soubory otev\u345?ou automaticky jen pro \u269?ten\u237?. Nap\u345?\u237?klad soubory, kter\u233? ji\u382? maj\u237? nastaven atribut jen pro \u269?ten\u237?, nebo soubory na disc\u237?ch CD-ROM se v tomto re\u382?imu otev\u345?ou v\u382?dy.\par


\pard\sb100\b Tip\b0 : KeyNote m\u367?\u382?ete p\u345?inutit otev\u345?\u237?t ur\u269?it\u253? soubor .knt jen pro \u269?ten\u237? pomoc\u237? volby \u8222?Otev\u345?\u237?t '<current file>' jen pro \u269?ten\u237?\u8220? v dialogu \cf2\ul Vlastnosti souboru\cf0\ulnone .\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Upozornit p\u345?i otev\u345?en\u237? souboru v re\u382?imu jen pro \u269?ten\u237?\cf0\fs20\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard Je-li povoleno, KeyNote zobraz\u237? zpr\u225?vu p\u345?i otev\u345?en\u237? souboru v re\u382?imu jen pro \u269?ten\u237?.\par


\pard\sb100\ul Pozn\u225?mka\ulnone\b : \b0 U soubor\u367? otev\u345?en\u253?ch v re\u382?imu jen pro \u269?ten\u237? zobrazuje KeyNote ve stavov\u233?m \u345?\u225?dku jasn\u283? \u269?erven\u253? k\u345?\u237?\u382?ek p\u345?es ikonu odpov\u237?daj\u237?c\u237? form\u225?tu souboru. Nap\u345?\u237?klad u nativn\u237?ho form\u225?tu zobraz\u237?: \v\'11I141\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:141,21,19"}}{\fldrslt {141_Clipb_18ene.png}}}}. V dialogu \cf2\ul Vlastnosti souboru\cf0\ulnone  (karta Nastaven\u237?) se tak\u233? zobraz\u237? zpr\u225?va \u8222?Soubor byl otev\u345?en jen pro \u269?ten\u237?\u8220?.\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Automaticky registrovat typ souboru (p\u345?idru\u382?it soubory .KNT ke KeyNote)\cf0\fs20\tab\b0 V\u253?choz\u237?: NE\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li povoleno, KeyNote se pokus\u237? zaregistrovat sv\u367?j typ souboru (.KNT) v syst\u233?mu Windows, abyste mohli soubory KeyNote otev\u237?rat dvojklikem v Pr\u367?zkumn\u237?ku Windows.\par

{\pntext\f1\'B7\tab}Je-li zak\u225?z\u225?no, KeyNote se p\u345?i spu\u353?t\u283?n\u237? nepokou\u353?\u237? registrovat sv\u367?j typ souboru. P\u345?\u237?ponu .KNT m\u367?\u382?ete st\u225?le zaregistrovat ru\u269?n\u283? v Pr\u367?zkumn\u237?ku Windows (kliknut\u237?m prav\u253?m tla\u269?\u237?tkem na soubor a volbou Otev\u345?\u237?t v...).\par


\pard\li240\sb100\ul Pozn\u225?mky:\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li600\sb40\ulnone Kontrola registrace m\u237?rn\u283? zpo\u382?\u271?uje spu\u353?t\u283?n\u237? programu.\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li600 Instala\u269?n\u237? program KeyNote tak\u233? umo\u382?\u328?uje tuto asociaci zaregistrovat, co\u382? je doporu\u269?en\u253? zp\u367?sob.\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Zeptat se p\u345?ed vytvo\u345?en\u237?m asociace soubor\u367?\cf0\fs20\tab\tab\tab\tab\b0 V\u253?choz\u237?: ANO\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li povoleno, KeyNote se p\u345?ed registrac\u237? sv\u233?ho typu souboru (.KNT) zept\u225?.\par

{\pntext\f1\'B7\tab}Je-li zak\u225?z\u225?no, KeyNote zaregistruje sv\u367?j typ souboru automaticky bez dotazu.\par


\pard\li240\sb100\b\i Mus\u237? b\u253?t povolena volba Automaticky registrovat typ souboru\b0 .\par


\pard\i0\par

\par


\pard\sa100\cf1\b\fs22 Pou\u382?\u237?vat alternativn\u237? p\u345?\u237?ponu (.KNE) pro \u353?ifrovan\u233? soubory\tab\cf0\fs20\tab\b0 V\u253?choz\u237?: NE\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Je-li povoleno, KeyNote ukl\u225?d\u225? \u353?ifrovan\u233? soubory s jinou p\u345?\u237?ponou (KNE).\par

{\pntext\f1\'B7\tab}Je-li zak\u225?z\u225?no, KeyNote pou\u382?\u237?v\u225? stejnou p\u345?\u237?ponu (KNT) pro \u353?ifrovan\u233? i ne\u353?ifrovan\u233? soubory.\par


\pard\par

}
