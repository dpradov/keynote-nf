\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B10\'12\v0 Upravit glos\u225?\u345?\cf3\fs20\par

\cf0\b0 Uprav\u237? \cf6\ul term\u237?n\cf0\ulnone  v glos\u225?\u345?i.\par


\pard\sb80 Dal\u353?\u237? informace naleznete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<24|0|0"}}{\fldrslt{Glos\u225?\u345? rozbalov\u225?n\u237? slov}}}}}\f0\fs20 .\par


