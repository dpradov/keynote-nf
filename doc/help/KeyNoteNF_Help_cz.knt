{\ul{\field{\*\fldinst{HYPERLINK "file:///<51|15347|0|6"}}{\fldrslt{Jak zm\u283?nit p\u345?\u237?stupov\u233? heslo u ji\u382? za\u353?ifrovan\u233?ho souboru}}}}\f0\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<51|16340|0|7"}}{\fldrslt{Jak p\u345?estat \u353?ifrovat soubor KeyNote}}}}\f0\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<51|17143|0|8"}}{\fldrslt{Pozn\u225?mka k \u353?ifrovac\u237?m algoritm\u367?m BLOWFISH a IDEA}}}}\f0\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<51|17809|0|9"}}{\fldrslt{Bezpe\u269?nostn\u237? pozn\u225?mky}}}}\f0\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<51|20592|0|10"}}{\fldrslt{R\u367?zn\u233? pozn\u225?mky}}}}\f0\fs20\par

