\pard\cf1\ul\b\v\fs26\'11B1\'12\v0 P\u345?idat uzel stromu\cf3\ulnone\fs20\par

\cf0\b0 Zobraz\u237? podnab\u237?dku s p\u345?\u237?kazy pro p\u345?id\u225?n\u237? uzlu do stromu aktivn\u237? slo\u382?ky.\par

\par

\cf1\b\v\fs26\'11B2\'12\v0 Vlo\u382?it uzel\cf3\fs20\par

\cf0\b0 P\u345?id\u225? nov\u253? \cf4 uzel\cf0  nad vybran\u253? uzel.\par

\par


