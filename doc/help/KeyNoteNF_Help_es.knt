{\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<91|0|0"}}{\fldrslt{Panel del \u225?rbol}}}}}\f0\fs20\par

\par


\pard {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<92|0|0"}}{\fldrslt{Archivos de KeyNote}}}}}\f0\fs20\par


\pard\li240 {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<93|0|0"}}{\fldrslt{Opciones de archivo}}}}}\f0\fs20\par

{\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<94|0|0"}}{\fldrslt{Opciones de copia de seguridad}}}}}\f0\fs20\par

\par


\pard {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<95|0|0"}}{\fldrslt{Acciones}}}}}\f0\fs20\par


\pard\li240 {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<96|0|0"}}{\fldrslt{Confirmaciones}}}}}\f0\fs20\par

\par


\pard {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<97|0|0"}}{\fldrslt{Chrome}}}}}\f0\fs20\par


\pard\li240 {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<98|0|0"}}{\fldrslt{Iconos de pesta\u241?a}}}}}\f0\fs20\par

\par


\pard {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<99|0|0"}}{\fldrslt{Avanzado}}}}}\f0\fs20\par


\pard\li240 {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<100|0|0"}}{\fldrslt{Formatos}}}}}\f0\fs20\par

{\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<101|0|0"}}{\fldrslt{Portapapeles}}}}}\f0\fs20\par

{\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<102|0|0"}}{\fldrslt{Tipos de archivo}}}}}\f0\fs20\par

{\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<103|0|0"}}{\fldrslt{Otros}}}}}\f0\fs20\par


\pard\cf0\par

V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<85|0|0"}}{\fldrslt{Descripci\u243?n general de la configuraci\u243?n de KeyNote}}}}}\f0\fs20\par

\par

Tenga en cuenta que hay algunos ajustes de configuraci\u243?n que no se pueden editar en el cuadro de di\u225?logo Opciones actual. Estos ajustes adicionales se pueden modificar editando el archivo de configuraci\u243?n de KeyNote, keynote.ini. (M\u225?s informaci\u243?n en {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<104|0|0"}}{\fldrslt{Ajustes adicionales de KeyNote.ini}}}}}\f0\fs20 )\par

\par

