\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Men\u250? Buscar\f1\lang1045 \cf2\par

\cf3\f0\fs26\lang1033\par


\pard\fi-2160\li2160\sa100 {\cf0\b0\fs20{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<116|1008|0|1"}}{\fldrslt{Buscar...}}}}}\cf0\b0\f0\fs20\tab Busca una cadena de texto en la \ul nota\ulnone  actual (nodo) o en todos los nodos de una carpeta.\par

