\pard\cf1\b\f0\fs20\lang1033\par

\cf2\f1\fs36\lang1045 Teclas de m\u233?todo abreviado generales\cf1\f0\lang1033\par

\cf0\b0\fs26\par


\pard\sa120\b Comandos relacionados con archivos\par


\pard\cf3\fs20 Ctrl+Shift+N\tab\tab\cf0\b0 Crear un archivo KeyNote nuevo \par

\cf3\b Ctrl+O\cf0\b0\tab\tab\tab Abrir un archivo KeyNote existente \par

\cf3\b Ctrl+S\cf0\b0\tab\tab\tab Guardar el archivo KeyNote actual \par


\pard\sb80\cf3\b Ctrl+Q\cf0\b0\tab\tab\tab Cerrar el archivo KeyNote abierto actualmente \par

\cf3\b F12\tab\tab\tab\cf0\b0 Abrir la ventana {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<50|496|0|1"}}{\fldrslt{Administrador de archivos}}}}}\f0\fs20  \par


\pard\fi-2160\li2160\sb80\cf3\b Alt+Enter\tab\cf0\b0 Editar las propiedades del archivo KeyNote abierto actualmente. \par


\pard\par


\pard\sa120\b\fs26 M\u233?todos abreviados relacionados con carpetas\par


\pard\cf3\fs20 Ctrl+N\tab\tab\tab\cf0\b0 Crear una carpeta nueva \par

\cf3\b F2\tab\tab\tab\cf0\b0 Cambiar el nombre de la carpeta actual (o cambiar el icono) \par


\pard\sb80\cf3\b F4\tab\tab\tab\cf0\b0 Editar todas las propiedades de la carpeta actual \par


\pard\cf3\b F6\cf0\b0\tab\tab\tab Editar las propiedades predeterminadas de las carpetas nuevas  \par


\pard\sb80\cf3\b Ctrl+F\tab\tab\tab\cf0\b0 Buscar texto en la carpeta (cuadro de di\u225?logo Buscar) \par


\pard\cf3\b F3\tab\tab\tab\cf0\b0 Repetir el \u250?ltimo comando Buscar (Buscar siguiente) \par

\cf3\b Ctrl+F3\tab\tab\cf0\b0 Reemplazar texto en la carpeta (cuadro de di\u225?logo Reemplazar)\par

\cf3\b Ctrl+Shift+F\tab\tab\cf0\b0 Buscar un nodo del \u225?rbol por su nombre\par


\pard\sb80\cf3\b Tab\cf0\b0\tab\tab\tab Cambiar el foco del panel de \u225?rbol al editor  \par


\pard\cf3\b Shift+Tab\cf0\b0\tab\tab Cambiar el foco del editor al panel de \u225?rbol \par

\cf3\b Ctrl+\\\cf0\b0\tab\tab\tab Alternar el foco entre el editor y el panel de \u225?rbol   (ver los comentarios a continuaci\u243?n)\par


\pard\sb100\cf3\b Ctrl+Tab\cf0\b0  \tab  o \cf3\b Ctrl+PageDown\cf0\b0\tab Cambiar a la carpeta siguiente (pesta\u241?a)  \par


\pard\cf3\b Ctrl+Shift+Tab\cf0\b0  o \cf3\b Ctrl+PageUp\cf0\b0\tab Cambiar a la carpeta anterior (pesta\u241?a) \par


\pard\sb120\cf3\b F11\cf0\b0\tab\tab\tab Usar la carpeta actual para la captura del portapapeles\par


\pard\sb40\cf3\b Ctrl+Shift+R\cf0\b0\tab\tab Establecer la carpeta actual como de solo lectura  \par


\pard\sb80\cf3\b Ctrl+Shift+P\tab\tab\cf0\b0 Imprimir la carpeta actual  \par


\pard\par

\b Nota\b0\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 KeyNote incluye los tres comandos siguientes en el men\u250? principal: \ul \u193?rbol | Establecer el foco\ulnone\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720 Alternar el foco: Editor / Panel de \u225?rbol\par

{\pntext\f2\'B7\tab}Establecer el foco en el panel del editor\par

{\pntext\f2\'B7\tab}Establecer el foco en el panel de \u225?rbol\par


\pard\li360\sb120 El primero le permite definir una alternativa al m\u233?todo abreviado \cf3\b Ctrl+\\\cf0\b0 . Con los otros dos tambi\u233?n puede crear nuevos m\u233?todos abreviados para establecer expl\u237?citamente el foco en el editor o en el panel de \u225?rbol.\par


\pard\li360 Tenga en cuenta que, aunque asigne un m\u233?todo abreviado distinto al primer comando del men\u250?, el m\u233?todo abreviado de alternancia actual (\cf3 Ctrl+\\\cf0 ) seguir\u225? funcionando si no hay ning\u250?n m\u233?todo abreviado que lo reemplace.\par

\b Sugerencia\b0 : \cf3 Ctrl+\\\cf0  y \cf3 Shift+Tab \cf0 (si no hay nada a lo que quitar la sangr\u237?a) tambi\u233?n cambiar\u225?n el foco del bloc de borrador al editor de notas.\par

\par

* KeyNote recuerda si el \u225?rbol o el editor ten\u237?a el foco la \u250?ltima vez que se guard\u243? el archivo, y el mismo control recibe el foco cuando se vuelve a abrir el archivo. (De forma predeterminada, el editor RTF tiene el foco)\par


\pard  \par

\par


\pard\sa120\b\fs26 Otros m\u233?todos abreviados\par


\pard\cf3\fs20 F5\cf0\b0\tab\tab\tab Editar las opciones de configuraci\u243?n del programa  \par


\pard\sb120\cf3\b F8\cf0\b0\tab\tab\tab Mantener la ventana del programa por encima de todas las dem\u225?s ventanas de aplicaciones  \par


\pard\cf3\b F9\cf0\b0\tab\tab\tab Mostrar u ocultar el panel de recursos (alternativa: hacer doble clic en la barra de estado)\par


\pard\fi-2160\li2160\sb100\cf3\b Esc\cf0\b0\tab Depende de la opci\u243?n \u171?Al pulsar la tecla Escape\u187? (en Opciones de configuraci\u243?n | Configuraci\u243?n general):  Minimizar KeyNote, Salir de KeyNote, no hacer nada. \par


\pard\fi-2160\li2160\sb80\tab Si el comando Buscar est\u225? en curso, la tecla Esc cancela la b\u250?squeda.\par

\tab Si el comando Reemplazar est\u225? en curso, la tecla Esc lo cancela. \par

\tab Si el cuadro combinado del nombre de fuente o el cuadro del tama\u241?o de fuente de la barra de herramientas Formato tienen el foco, la tecla Esc sale de ellos y cambia el foco al editor.\par

\tab Si se est\u225? grabando una macro, detiene la grabaci\u243?n de la macro.\par

\tab Si se est\u225? reproduciendo una macro, detiene la reproducci\u243?n de la macro.\par

\tab Si el foco est\u225? en cualquiera de las pesta\u241?as del panel de recursos (excepto Borrador), Esc cambiar\u225? el foco al editor.\par

\tab Si el foco est\u225? en el editor del bloc de borrador y \u171?Al pulsar la tecla Escape\u187? est\u225? establecido en \u171?Minimizar KeyNote\u187?, Esc minimizar\u225? la aplicaci\u243?n; de lo contrario, cambiar\u225? el foco al editor.\par


\pard\sb160\cf3\b Shift+F10\cf0\b0\tab\tab Abre el men\u250? contextual en el editor RTF, el panel de \u225?rbol y el bloc de borrador\par


\pard\par


\pard\fi-2160\li2160\par

}
