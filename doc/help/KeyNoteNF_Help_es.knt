\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|5580|0|20"}}{\fldrslt{Eliminar nodo}}}}}\f0\fs20\tab Elimina el nodo actual en el \u225?rbol de la carpeta activa\par


\pard\fi-2160\li2160\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|5760|0|21"}}{\fldrslt{Eliminar nodos hijos}}}}}\f0\fs20\tab Elimina todos los nodos hijos del nodo actual de la carpeta activa\par


\pard\fi-2160\li2160\sb40\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|6017|0|22"}}{\fldrslt{Cambiar nombre de nodo}}}}}\f0\fs20\tab Cambia el nombre del nodo actual en el \u225?rbol de la carpeta activa\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|6145|0|23"}}{\fldrslt{Pegar nombre del nodo}}}}}\f0\fs20\tab Submen\u250? con comandos para cambiar el nombre del nodo actual en el \u225?rbol de la carpeta activa\par


\pard\fi-2160\li2160\sa100    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|6276|0|24"}}{\fldrslt{Del portapapeles}}}}}\f0\fs20\tab Cambia el nombre con el contenido del Portapapeles\par

