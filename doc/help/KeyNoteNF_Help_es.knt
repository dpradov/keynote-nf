\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Teclas de m\u233?todo abreviado del editor\cf2\f0\lang1033\par

\cf0\b0\fs26\par

\fs20 Recuerde que la mayor\u237?a de los m\u233?todos abreviados de teclado pueden {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<105|0|0"}}{\fldrslt{personalizado}}}}}\f0\fs20 . Al final hay algunas alternativas sugeridas que podr\u237?a probar en lugar de las predeterminadas actuales.\par

\fs26\par

\b El panel del editor debe estar activo.\b0\par

\fs20\par

\cf3\b Ctrl+A\cf0\b0\tab\tab\tab\b Seleccionar\b0  todo el texto del editor \par

\cf3\b Ctrl+Alt+W\cf0\b0\tab\tab Seleccionar la palabra actual en el editor \par


\pard\sb140\cf3\b Ctrl+C\cf0\b0  o \cf3\b Ctrl+Insert\cf0\b0\tab\tab Copiar el texto seleccionado al \b portapapeles\b0  \par


\pard\sb20\cf3\b Ctrl+V\cf0\b0  o \cf3\b Shift+Insert\cf0\b0\tab Pegar texto o una imagen del portapapeles \par


\pard\sb40\cf3\b Ctrl+X \cf0\b0 o \cf3\b Shift+Delete\cf0\b0\tab Cortar el texto seleccionado al portapapeles \par

\cf3\b Ctrl+Shift+Ins\cf0\b0\tab\tab Pegar como texto (pegar sin ning\u250?n formato) \par


\pard\sb120\cf3\b Ctrl+W \cf0\b0\tab\tab Pegar como recorte web \par


\pard\sb40\cf3\b Shift+ Ctrl+W \cf0\b0\tab Pegar como recorte web (texto)\par


\pard\sb200\cf3\b Ctrl+E\cf0\b0\tab\tab\tab Activar o desactivar el estilo VI\u209?ETAS para los p\u225?rrafos seleccionados \par


\pard\cf3\b Ctrl+Shift+E\cf0\b0\tab\tab Activar o desactivar el estilo N\u218?MEROS para los p\u225?rrafos seleccionados \par


\pard\fi-2160\li2160\sb160\cf3\b Alt+Backspace\cf0\b0\tab\b Deshacer\b0  \i (se admite deshacer varias veces. Los cambios no se pueden deshacer una vez guardado el archivo)\i0  \par


\pard\cf3\b Ctrl+Enter\cf0\b0\tab\tab Rehacer \i (es decir, deshacer la \u250?ltima operaci\u243?n de \ldblquote Deshacer\rdblquote )\i0  \par


\pard\fi-2160\li2160\cf3\b Ctrl+\u199?\cf0\b0\tab Repetir el \u250?ltimo comando \i (el nombre del comando que se repetir\u225? aparece en el men\u250? contextual del editor) \par

\i0\tab\ul Sugerencia\ulnone : consulte su m\u233?todo abreviado actual en la entrada Edici\u243?n|Repetir.., ya que el car\u225?cter depender\u225? de la distribuci\u243?n del teclado.\i\par


\pard\sb120\cf3\b\i0 Alt+Left\cf0\b0\tab\tab Navegar HACIA ATR\u193?S en el \b historial \b0\par


\pard\cf3\b Alt+Right\cf0\b0\tab\tab Navegar HACIA DELANTE en el historial \par


\pard\sb200\cf3\b Ctrl+P\cf0\b0\tab\tab\tab Seleccionar las \b propiedades\b0  de p\u225?rrafo para los p\u225?rrafos seleccionados \par


\pard\cf3\b Ctrl+T\cf0\b0\tab\tab\tab Seleccionar las propiedades de fuente del texto seleccionado \par


\pard\sb120\cf3\b Ctrl+R\cf0\b0\tab\tab\tab Seleccionar el \b color\b0  de fuente del texto seleccionado \par


\pard\cf3\b Ctrl+H\cf0\b0\tab\tab\tab Aplicar el color de resaltado actual al texto seleccionado \par

\cf3\b Ctrl+Shift+H\cf0\b0\tab\tab Quitar el resaltado del texto seleccionado \par

\cf3\b Ctrl+D\cf0\b0\tab\tab\tab Seleccionar el color de fondo\par


\pard\sb160\cf3\b Ctrl+B\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente NEGRITA \par


\pard\cf3\b Ctrl+I\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente CURSIVA \par

\cf3\b Ctrl+K\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente TACHADO \par

\cf3\b Ctrl+L\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente DESHABILITADO \par

\cf3\b Ctrl+U\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente SUBRAYADO \par

\cf3\b Ctrl+-\cf0\b0\tab\tab\tab Activar o desactivar el estilo de fuente SUPER\u205?NDICE \par

\cf3\b Ctrl+Shift+-\cf0\b0\tab\tab Activar o desactivar el estilo de fuente SUB\u205?NDICE \par


\pard\fi-2160\li2160\sb180\cf3\b Ctrl+Numpad *\cf0\b0\tab Cambiar el foco al cuadro combinado \b Estilo\b0 . (Seleccione un estilo y, despu\u233?s, pulse Enter para aplicarlo o Esc para cancelar.\tab\par


\pard\cf3\b Shift+F4\cf0\b0\tab\tab Aplicar el estilo seleccionado al texto (la barra de herramientas Estilo DEBE estar visible) \par


\pard\sb120\cf3\b Ctrl+0\cf0\b0\tab\tab\tab Borrar los atributos de \b fuente\b0  del texto seleccionado \par


\pard\cf3\b Ctrl+F8\cf0\b0\tab\tab Copiar los atributos de fuente actuales \par

\cf3\b Shift+F8\cf0\b0\tab\tab Pegar los atributos de fuente \i (\ldblquote copiar formato\rdblquote )\i0  \par


\pard\sb80\cf3\b Ctrl+Shift+0\cf0\b0\tab\tab Borrar los atributos de \b p\u225?rrafo\b0  \cf3\b\par


\pard Ctrl+F9\cf0\b0\tab\tab Copiar los atributos de p\u225?rrafo actuales \par

\cf3\b Shift+F9\cf0\b0\tab\tab Pegar los atributos de p\u225?rrafo \i (\ldblquote copiar formato\rdblquote )\i0  \par


\pard\sb120\cf3\b Ctrl+[\cf0\b0\tab\tab\tab Reducir (disminuir) el \b tama\u241?o de fuente\b0  del texto seleccionado \par


\pard\cf3\b Ctrl+]\cf0\b0\tab\tab\tab Aumentar (incrementar) el tama\u241?o de fuente del texto seleccionado \par

\cf3\b\par

Alt+`\cf0\b0\tab\tab\tab Aumentar la \b sangr\u237?a izquierda\b0\par

\cf3\b Shift+Alt+`\cf0\b0\tab\tab Disminuir la sangr\u237?a izquierda \par

\cf3\b Ctrl+`\cf0\b0\tab\tab\tab Aumentar la sangr\u237?a de primera l\u237?nea \par

\cf3\b Ctrl+Shift+`\cf0\b0\tab\tab Disminuir la sangr\u237?a de primera l\u237?nea \par

\cf3\b Ctrl+'\cf0\b0\tab\tab\tab Aumentar la sangr\u237?a DERECHA \par

\cf3\b Ctrl+Shift+'\cf0\b0\tab\tab Disminuir la sangr\u237?a DERECHA \par


\pard\sb160\cf3\b Ctrl+Alt+Left\cf0\b0\tab\tab Alinear a la \b izquierda\b0  el texto seleccionado \par


\pard\cf3\b Ctrl+Alt+Right\cf0\b0\tab Alinear a la derecha el texto seleccionado \par

\cf3\b Ctrl+Alt+Up\cf0\b0\tab\tab Centrar el texto seleccionado \par


\pard\sb160\cf3\b Ctrl+,\cf0\b0\tab\tab\tab Aumentar el \b espacio\b0  anterior al p\u225?rrafo \par


\pard\cf3\b Ctrl+.\cf0\b0\tab\tab\tab Aumentar el espacio posterior al p\u225?rrafo \par

\cf3\b Ctrl+Shift+,\cf0\b0\tab\tab Disminuir el espacio anterior al p\u225?rrafo \par

\cf3\b Ctrl+Shift+.\cf0\b0\tab\tab Disminuir el espacio posterior al p\u225?rrafo \par


\pard\sb120\cf3\b Ctrl+1\cf0\b0\tab\tab\tab Seleccionar el \b interlineado\b0  SIMPLE para los p\u225?rrafos seleccionados \par


\pard\cf3\b Ctrl+2\cf0\b0\tab\tab\tab Seleccionar el interlineado DOBLE para los p\u225?rrafos seleccionados \par

\cf3\b Ctrl+5\cf0\b0\tab\tab\tab Seleccionar el interlineado DE UNO Y MEDIO para los p\u225?rrafos seleccionados \par


\pard\sb120\cf3\b Ctrl+Shift+C\cf0\b0\tab\tab\b Insertar\b0  un car\u225?cter especial \par


\pard\cf3\b Ctrl+Shift+D\cf0\b0\tab\tab Insertar la fecha actual \par

\cf3\b Ctrl+Shift+T\cf0\b0\tab\tab Insertar la hora actual \par


\pard\sb120\cf3\b Ctrl+Numpad -\cf0\b0\tab\tab Insertar una \b l\u237?nea\b0\par


\pard\cf3\b Ctrl+Shift+Numpad -\cf0\b0\tab Insertar una l\u237?nea imprimible\par


\pard\sb160\cf3\b Ctrl+Y\cf0\b0\tab\tab\tab Eliminar la \b l\u237?nea seleccionada\b0  \par


\pard\cf3\b Ctrl+J\cf0\b0\tab\tab\tab Unir las l\u237?neas seleccionadas (volver a dar formato a las l\u237?neas en un solo p\u225?rrafo) \tab\tab\tab\par

\cf3\b Ctrl+Shift+S\cf0\b0\tab\tab Ordenar las l\u237?neas seleccionadas \par


\pard\sb120\cf3\b Ctrl+G\cf0\b0\tab\tab\tab\b Ir a\b0  una l\u237?nea concreta del editor \par


\pard\cf3\b Ctrl+M\cf0\b0\tab\tab\tab Saltar al par\u233?ntesis o corchete correspondiente \par


\pard\sb80\cf3\b Insert\cf0\b0\tab\tab\tab Activar o desactivar el modo INSERTAR / SOBRESCRIBIR del editor \par


\pard\cf3\b Alt+W\cf0\b0\tab\tab\tab Activar o desactivar la opci\u243?n \b Ajuste de l\u237?nea\b0  \par


\pard\sb80\cf3\b Ctrl+ +\cf0\b0\tab\tab Evaluar una \b expresi\u243?n \b0\par


\pard\cf3\b Alt+Insert\cf0\b0\tab\tab Pegar el resultado de la \u250?ltima expresi\u243?n evaluada \par


\pard\sb80\cf3\b Ctrl+Shift+I\cf0\b0\tab\tab Invertir las \b may\u250?sculas y min\u250?sculas\b0  del texto seleccionado (Esto -> eSTO) \par


\pard\cf3\b Ctrl+Shift+L\cf0\b0\tab\tab Cambiar el texto seleccionado a min\u250?sculas \par

\cf3\b Ctrl+Shift+M\cf0\b0\tab\tab Cambiar el texto seleccionado a may\u250?sculas y min\u250?sculas alternas \par

\cf3\b Ctrl+Shift+U\cf0\b0\tab\tab Cambiar el texto seleccionado a MAY\u218?SCULAS \par


\pard\sb120\cf3\b Ctrl+Shift+Y\cf0\b0\tab\tab Insertar un hiperv\u237?nculo \par


\pard\sb40\cf3\b F7\cf0\b0\tab\tab\tab Expandir el t\u233?rmino seg\u250?n la definici\u243?n del \b glosario\b0   \par


\pard\cf3\b Shift+F7\cf0\b0\tab\tab A\u241?adir un t\u233?rmino nuevo al glosario  \par


\pard\sb160\cf3\b Ctrl+Shift+3\cf0\b0\tab\tab Aplicar Rot-13 al texto seleccionado \par


\pard\cf3\b Ctrl+Shift+4\cf0\b0\tab\tab Invertir el orden del texto seleccionado \par

\par

\cf3\b Alt+Down\cf0\b0\tab\tab\b Cambiar al nodo SIGUIENTE\b0  del \u225?rbol\par

\cf3\b Alt+Up\cf0\b0\tab\tab\tab Cambiar al nodo ANTERIOR del \u225?rbol\par

\cf3\b Shift+Alt+Left\cf0\b0\tab Mover a la IZQUIERDA en el \u225?rbol \par

\cf3\b Shift+Alt+Right\cf0\b0\tab Mover a la DERECHA en el \u225?rbol \par


\pard\fi-2160\li2160\sb100\cf3\b Ctrl+Numpad /\cf0\b0\tab Cambiar el foco al cuadro combinado Macro. (Seleccione una macro y, despu\u233?s, pulse Enter para ejecutarla o Esc para cancelar.)\par


\pard\fi-2160\li2160\tab La barra de herramientas Macro debe estar visible.\par


\pard\fi-2160\li2160\sb100\cf3\b Ctrl+Up\cf0\b0  / \cf3\b Down\cf0\b0\tab Desplazar todo el documento una l\u237?nea hacia abajo o hacia arriba. El cursor permanecer\u225? en el mismo lugar.\par

\cf3\b Ctrl+Shift+Up\cf0\b0  / \cf3\b Down\cf0\b0\tab Desplazar suavemente la barra de desplazamiento en vertical. El cursor no cambiar\u225?.\par


\pard\fi-2160\li2160\par

\par

\tab\par


\pard\b Alternativas sugeridas que puede probar en lugar de las predeterminadas actuales.\b0\par


\pard\sb80 Puede usar los m\u233?todos abreviados predeterminados o modificar cualquiera que le resulte dif\u237?cil de usar o de recordar. Tambi\u233?n depende de qu\u233? comando use con m\u225?s frecuencia. \par

Por ejemplo, yo uso mucho los comandos \i Aumentar \i0 y \i disminuir la sangr\u237?a izquierda\i0 . Por eso prefiero usar:\par


\pard\par

  Aumentar la sangr\u237?a izquierda:   \tab\tab\tab\cf2 Ctrl+Alt+Right\cf0\par

  Disminuir la sangr\u237?a izquierda:  \tab\tab\tab\cf2 Ctrl+Alt+Left\cf0\par

\par

}
