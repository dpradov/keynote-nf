   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|3986|0|10"}}{\fldrslt{Derecha}}}}}\f0\fs20\tab Mueve el nodo seleccionado a la derecha\par


\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|5124|0|18"}}{\fldrslt{Crear nodo maestro}}}}}\f0\fs20\tab A\u241?ade un nodo nuevo en la parte superior del \u225?rbol de la carpeta activa\par


\pard\fi-2160\li2160\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|5309|0|19"}}{\fldrslt{Nuevo nodo a partir de la selecci\u243?n}}}}}\f0\fs20\tab Crea un nodo hermano nuevo inmediatamente debajo del nodo actual usando el texto seleccionado\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8713|0|34"}}{\fldrslt{Expandir \u225?rbol}}}}}\f0\fs20\tab Expande todas las ramas contra\u237?das del \u225?rbol de la carpeta activa\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8851|0|35"}}{\fldrslt{Contraer \u225?rbol}}}}}\f0\fs20\tab Contrae todo el \u225?rbol\par


\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|4518|0|13"}}{\fldrslt{Navegar}}}}}\f0\fs20\tab Submen\u250? para desplazarse a otro nodo del \u225?rbol de la carpeta activa\par


\pard\fi-2160\li2160\sa100    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|4648|0|14"}}{\fldrslt{Subir}}}}}\f0\fs20\tab Sube un nodo en el \u225?rbol\par

