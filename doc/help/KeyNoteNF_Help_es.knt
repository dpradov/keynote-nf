\pard\f0\fs20\lang1033\par

\cf1\b\fs36 Opciones: panel \u193?rbol\par

\cf0\b0\fs26\par


\pard\li360\v\'11I238\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:238,370,370"}}{\fldrslt {238_Clipb_19oct.png}}}}\par


\pard\par

\fs20 V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<104|0|0"}}{\fldrslt{Ajustes adicionales de Keynote.ini}}}}}\f0\fs20  \par

\fs26\par

\par


\pard\sa80\cf2\b\fs22 Modo de expansi\u243?n inicial del \u225?rbol\cf0\fs20\tab\tab\tab\b0 Predeterminado: restaurar el estado expandido de todos los nodos\cf2\b\fs22\par


\pard\cf0\b0\fs20 Seleccione el estado de los \u225?rboles de las carpetas al iniciar KeyNote:\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Mostrar el \u225?rbol totalmente contra\u237?do\par

{\pntext\f1\'B7\tab}Expandir solo el \u250?ltimo nodo activo\par

{\pntext\f1\'B7\tab}Expandir solo los nodos de nivel superior\par

{\pntext\f1\'B7\tab}Restaurar el estado expandido de todos los nodos\par

{\pntext\f1\'B7\tab}Mostrar el \u225?rbol totalmente expandido\par


\pard\par


\pard\sa80\cf2\b\fs22 Tras crear un nodo nuevo, cambiar al modo de edici\u243?n\cf0\fs20\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, KeyNote selecciona el nombre del nodo nuevo para que pueda escribir un nombre nuevo.\par

{\pntext\f1\'B7\tab}Si se deshabilita, debe pulsar \cf3\b Espacio\cf0\b0  para seleccionar el nombre antes de poder escribir uno nuevo.\par


\pard\par


\pard\sa80\cf2\b\fs22 Editar los nodos \u171?in situ\u187? (sin cuadro de di\u225?logo)\cf0\fs20\tab\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, puede cambiar el nombre de un nodo pulsando \cf3\b Espacio\cf0\b0  y escribiendo despu\u233?s el nombre.\par

{\pntext\f1\'B7\tab}Si se deshabilita, aparece un cuadro de di\u225?logo al cambiar el nombre de un nodo.\par


\pard\par


\pard\sa80\cf2\b\fs22 Nombrar autom\u225?ticamente los nodos cuando sea posible\cf0\fs20\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, se usa el nombre del archivo vinculado al crear un {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<28|0|0"}}{\fldrslt{nodo virtual}}}}}\f0\fs20  arrastrando un archivo al \u225?rbol.\par

{\pntext\f1\'B7\tab}Si se deshabilita, se usa {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<32|0|0"}}{\fldrslt{Nombre predeterminado de los nuevos nodos del \u225?rbol}}}}}\f0\fs20  como nombre del nuevo nodo virtual\par


\pard\par


\pard\sa80\cf2\b\fs22 Heredar las propiedades del nodo activo\cf0\fs20\tab\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, un nodo nuevo usa el mismo estado de marcado, negrita y color que el nodo activo (en el panel \u193?rbol).\par

{\pntext\f1\'B7\tab}Si se deshabilita, el nodo nuevo usa los valores predeterminados de la nota. V\u233?ase {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<30|0|0"}}{\fldrslt{Propiedades y valores predeterminados de la carpeta}}}}}\f0\fs20\par


\pard\par


\pard\sa80\cf2\b\fs22 Seguimiento activo de los nodos del \u225?rbol\cf0\fs20\tab\tab\tab\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard\cf0\b0\fs20 Si se habilita, la selecci\u243?n del panel \u193?rbol sigue al puntero del rat\u243?n.\par

\par


\pard\sa80\cf2\b\fs22 Desplazamiento autom\u225?tico del \u225?rbol al mover el rat\u243?n\cf0\fs20\tab\tab\tab\b0 Predeterminado: NO\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, se desplaza el \u225?rbol cuando el puntero del rat\u243?n llega al borde del panel \u193?rbol.\par

{\pntext\f1\'B7\tab}Si se deshabilita, use las teclas de direcci\u243?n o las barras de desplazamiento para desplazar el \u225?rbol.\par


\pard\par


\pard\sa80\cf2\b\fs22 Mostrar informaci\u243?n emergente en el \u225?rbol\cf0\fs20\tab\tab\tab\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard\cf0\b0\fs20 Si se habilita, al mover el puntero del rat\u243?n sobre un nodo se muestra como informaci\u243?n emergente el nombre del nodo parcialmente oculto.\par

\par


\pard\sa80\cf2\b\fs22 Mostrar la ruta completa del nodo en la barra de estado\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, muestra en la barra de estado la ruta completa al nodo activo al seleccionarlo\par

{\pntext\f1\'B7\tab}Si se deshabilita, muestra solo el nombre del nodo.\par


\pard\par


\pard\sa80\cf2\b\fs22 Orden inverso\cf0\fs20\tab\tab\tab\tab\tab\tab\b0 Predeterminado: NO\cf2\b\fs22\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360\cf0\b0\fs20 Si se habilita, y \b Mostrar la ruta completa del nodo en la barra de estado\b0  tambi\u233?n est\u225? habilitada, se invierte la ruta (primero el nombre del nodo).\par

{\pntext\f1\'B7\tab}Si se deshabilita, el nombre del nodo aparece al final de la ruta.\par


\pard\par


\pard\sa80\cf2\b\fs22 Mostrar la ruta completa del nodo en los resultados de b\u250?squeda\cf0\fs20\tab\tab\tab\b0 Predeterminado: S\u205?\cf2\b\fs22\par


\pard\cf0\b0\fs20 Muestra el nombre o la ruta completa en el panel de resultados de b\u250?squeda. Esta opci\u243?n afecta a la visualizaci\u243?n en la pesta\u241?a Buscar del panel Recursos.\par


\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li360 Si se habilita, muestra la ruta completa, desde el nombre de la carpeta hasta el nombre del nodo.\par

{\pntext\f1\'B7\tab}Si se deshabilita, muestra solo el nombre de la carpeta y de la nota (nodo).\par


\pard\par

}
