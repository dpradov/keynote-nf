\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Men\u250? E\f0\lang3082 ditar\f1\lang1045 \cf2\par

\cf3\f0\fs26\lang1033\par


\pard\fi-2160\li2160\sa100 {\cf0\b0\fs20{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|2873|0|2"}}{\fldrslt{Deshacer}}}}}\cf0\b0\f0\fs20\tab Deshace (cancela) la operaci\u243?n de edici\u243?n m\u225?s reciente realizada\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3323|0|3"}}{\fldrslt{Rehacer}}}}}\f0\fs20\tab Revierte el \u250?ltimo comando Deshacer\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3478|0|4"}}{\fldrslt{Repetir la \u250?ltima}}}}}\f0\fs20\tab Repite el \u250?ltimo comando de edici\u243?n.\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3941|0|5"}}{\fldrslt{Cortar}}}}}\f0\fs20\tab Corta el texto seleccionado y lo coloca en el Portapapeles\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|4125|0|6"}}{\fldrslt{Copiar}}}}}\f0\fs20\tab Copia el texto seleccionado y lo coloca en el Portapapeles\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|4298|0|7"}}{\fldrslt{Pegar}}}}}\f0\fs20\tab Pega los datos del Portapapeles\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|4588|0|8"}}{\fldrslt{Pegar otro}}}}}\f0\fs20\tab Comandos para pegar en KeyNote desde el Portapapeles:\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|4716|0|9"}}{\fldrslt{Pegar como texto}}}}}\f0\fs20\tab Pega el texto del Portapapeles como texto sin formato (sin ning\u250?n formato)\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5986|0|39"}}{\fldrslt{Pegar como clip web}}}}}\f0\fs20\tab Pega texto de programas externos a\u241?adiendo informaci\u243?n de contexto a la captura. Incluye todo el formato del texto de origen\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6307|0|40"}}{\fldrslt{Pegar como clip web (txt)}}}}}\f0\fs20  Pega texto de programas externos a\u241?adiendo informaci\u243?n de contexto a la captura. Permite un pegado \u171?Personalizado sin formato\u187? a partir del texto de origen\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|4893|0|10"}}{\fldrslt{Pegado especial}}}}}\f0\fs20\tab Muestra el cuadro de di\u225?logo est\u225?ndar de Windows \ldblquote Pegado especial\rdblquote , para seleccionar el formato que debe usarse al pegar los datos del Portapapeles\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5135|0|11"}}{\fldrslt{Pegar en una nota nueva}}}}}\f0\fs20\tab Crea una nota est\u225?ndar nueva y pega en ella los datos del Portapapeles\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5306|0|12"}}{\fldrslt{Pegar en un nodo nuevo}}}}}\f0\fs20\tab Crea un nodo nuevo en la nota actual y pega en \u233?l los datos del Portapapeles\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5546|0|13"}}{\fldrslt{Eliminar}}}}}\f0\fs20\tab Elimina el texto seleccionado\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5656|0|14"}}{\fldrslt{L\u237?neas}}}}}\f0\fs20\tab Comandos para trabajar con l\u237?neas de texto:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5769|0|15"}}{\fldrslt{Eliminar l\u237?nea}}}}}\f0\fs20\tab Elimina la l\u237?nea en la que est\u225? el cursor\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|5904|0|16"}}{\fldrslt{Ordenar l\u237?neas}}}}}\f0\fs20\tab Ordena las l\u237?neas seleccionadas actualmente en orden alfanum\u233?rico\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6062|0|17"}}{\fldrslt{Unir l\u237?neas}}}}}\f0\fs20\tab Quita los retornos de carro de las l\u237?neas seleccionadas, uni\u233?ndolas en una sola l\u237?nea\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6238|0|18"}}{\fldrslt{Cambiar may\u250?sculas y min\u250?sculas}}}}}\f0\fs20\tab Comandos para cambiar las may\u250?sculas y min\u250?sculas del texto seleccionado:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6361|0|19"}}{\fldrslt{A MAY\u218?SCULAS}}}}}\f0\fs20\tab Convierte el texto seleccionado a may\u250?sculas\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6516|0|20"}}{\fldrslt{A min\u250?sculas}}}}}\f0\fs20\tab Convierte el texto seleccionado a min\u250?sculas\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6671|0|21"}}{\fldrslt{A may\u250?sculas y min\u250?sculas}}}}}\f0\fs20\tab Convierte el texto seleccionado a may\u250?sculas y min\u250?sculas combinadas (la primera letra de cada palabra en may\u250?scula y las dem\u225?s en min\u250?scula)\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|6916|0|22"}}{\fldrslt{Invertir may\u250?sculas y min\u250?sculas}}}}}\f0\fs20\tab Intercambia las letras may\u250?sculas y min\u250?sculas\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|7084|0|23"}}{\fldrslt{Alternar may\u250?sculas y min\u250?sculas}}}}}\f0\fs20\tab Al seleccionar este comando repetidamente, se alterna entre convertir el texto seleccionado a may\u250?sculas, luego a min\u250?sculas y luego a may\u250?sculas y min\u250?sculas combinadas\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|7305|0|24"}}{\fldrslt{Espacios en blanco}}}}}\f0\fs20\tab Comandos para editar los espacios en blanco (espacios y tabulaciones) de las l\u237?neas seleccionadas, o del nodo completo si no hay texto seleccionado\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|7492|0|25"}}{\fldrslt{Recortar por la izquierda}}}}}\f0\fs20\tab Quita los espacios en blanco a la izquierda de la primera letra de las l\u237?neas seleccionadas (o del nodo completo)\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|7698|0|26"}}{\fldrslt{Recortar por la derecha}}}}}\f0\fs20\tab Quita los espacios en blanco a la derecha de la \u250?ltima letra de las l\u237?neas seleccionadas (o del nodo completo)\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|7906|0|27"}}{\fldrslt{Recortar ambos lados}}}}}\f0\fs20\tab Quita los espacios en blanco a la izquierda de la primera letra y a la derecha de la \u250?ltima letra de las l\u237?neas seleccionadas (o del nodo completo)\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|8147|0|28"}}{\fldrslt{Comprimir espacios en blanco}}}}}\f0\fs20\tab Comprime todos los espacios en blanco en un solo espacio (o tabulaci\u243?n si hay tabulaciones pero no espacios) en las l\u237?neas seleccionadas (o en el nodo completo)\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|8397|0|29"}}{\fldrslt{Transformar}}}}}\f0\fs20\tab Comandos para transformar el texto:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|8504|0|30"}}{\fldrslt{Aplicar Rot-13}}}}}\f0\fs20\tab Transforma el texto con ROT-13 (antigua t\u233?cnica de ofuscaci\u243?n del texto)\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|8959|0|31"}}{\fldrslt{Invertir texto}}}}}\f0\fs20\tab Invierte el orden del texto seleccionado\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|9176|0|32"}}{\fldrslt{Decimal a romano}}}}}\f0\fs20\tab Convierte el n\u250?mero decimal seleccionado a n\u250?meros romanos\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|9436|0|33"}}{\fldrslt{Romano a decimal}}}}}\f0\fs20\tab Convierte los n\u250?meros romanos seleccionados a un n\u250?mero decimal\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|9697|0|34"}}{\fldrslt{Expresi\u243?n}}}}}\f0\fs20\tab Comandos para evaluar expresiones:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|9810|0|35"}}{\fldrslt{Evaluar}}}}}\f0\fs20\tab Eval\u250?a la expresi\u243?n num\u233?rica seleccionada y a\u241?ade el resultado al final del texto seleccionado\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|10103|0|36"}}{\fldrslt{Pegar \u250?ltimo resultado}}}}}\f0\fs20\tab Pega en la posici\u243?n del cursor el resultado de la \u250?ltima evaluaci\u243?n de expresiones\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|10278|0|37"}}{\fldrslt{Seleccionar palabra}}}}}\f0\fs20\tab Selecciona la palabra en la que est\u225? el cursor\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|10460|0|38"}}{\fldrslt{Copiar todo}}}}}\f0\fs20\tab Selecciona todo el texto de la nota activa y lo copia al Portapapeles\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|9291|0|1"}}{\fldrslt{Seleccionar todo}}}}}\f0\fs20\tab Selecciona todo el texto de la nota activa\cf3\par


\pard\cf0\par

\par

\cf3\b\par

\cf1\v\fs26\'11B2\'12\v0 Deshacer\cf3\fs20\par

\cf0\b0 Deshace (cancela) la operaci\u243?n de edici\u243?n m\u225?s reciente que haya realizado. \par

El cuadro de di\u225?logo Opciones permite especificar el \u171?nivel de deshacer\u187?, es decir, el n\u250?mero de operaciones de edici\u243?n que se pueden deshacer (v\u233?ase {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<89|0|0"}}{\fldrslt{Opciones: editor de texto enriquecido}}}}}\f0\fs20 ).\par

\par


\pard\li240\v\'11I7\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:7,16,16"}}{\fldrslt {7_Main_07.png}}}}\lang1033  \cf4\f2\lang3082 TB_EditUndo\tab\tab\cf5\b\f0\fs18\lang1033 Alt+BkSp\f2\fs20  \cf0\b0 / \cf4 MMEditUndo\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B3\'12\v0 Rehacer\cf3\fs20\par

\cf0\b0 Revierte el \u250?ltimo comando Deshacer.\par

\par


\pard\li240\v\'11I14\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:14,16,16"}}{\fldrslt {14_Main_14.png}}}}\lang1033  \cf4\f2\lang3082 TB_EditRedo\tab\tab\cf5\b\f0\fs18\lang1033 Ctrl+Enter\f2\fs20  \cf0\b0 / \cf4 MMEditRedo\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B4\'12\v0 Repetir \u250?ltimo\cf3\fs20\par

\cf0\b0 Repite el \u250?ltimo comando de edici\u243?n. \par

Junto al comando de men\u250?, KeyNote muestra el comando que se repetir\u225?, por ejemplo, \ldblquote Repetir Negrita\rdblquote , \ldblquote Repetir P\u225?rrafo\rdblquote  o \ldblquote Repetir Pegar\rdblquote . Esto resulta especialmente \u250?til cuando el comando que desea repetir est\u225? m\u225?s abajo en la estructura del men\u250?. Tambi\u233?n puede pulsar \cf5\b\fs18 Ctrl+\u199?\cf0\b0\fs20  para repetir el \u250?ltimo comando de edici\u243?n.\par


\pard\li360\sb80\b Sugerencia\b0 : compruebe su atajo actual en la entrada Editar|Repetir.., porque el car\u225?cter depender\u225? de la distribuci\u243?n de su teclado.\par


\pard\par


\pard\li240\v\'11I41\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:41,16,16"}}{\fldrslt {41_Main_41.png}}}}\lang1033  \cf4\f2\lang3082 TB_Repeat\tab\tab\cf5\b\f0\fs18\lang1033 Ctrl+\u199?\f2\fs20  \cf0\b0 / \cf4 MMEditRepeat\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B5\'12\v0 Cortar\cf3\fs20\par

\cf0\b0 Corta el texto seleccionado y lo coloca en el Portapapeles.\par

\par


\pard\li240\v\'11I4\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:4,16,16"}}{\fldrslt {4_Main_04.png}}}}\lang1033  \cf4\f2\lang3082 TB_EditCut\tab\tab\cf5\b\f0\fs18\lang1033 Ctrl+X\cf0\b0  o \cf5\b Shift+Delete\f2\fs20  \cf0\b0 / \cf4 MMEditCut\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B6\'12\v0 Copiar\cf3\fs20\par

\cf0\b0 Copia el texto seleccionado y lo coloca en el Portapapeles.\par

\par


\pard\li240\v\'11I5\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:5,16,16"}}{\fldrslt {5_Main_05.png}}}}\lang1033  \cf4\f2\lang3082 TB_EditCopy\tab\tab\cf5\b\f0\fs18\lang1033 Ctrl+C\f2\fs20  \cf0\b0 / \cf4 MMEditCopy\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B7\'12\v0 Pegar\cf3\fs20\par

\cf0\b0 Pega los datos del Portapapeles. Tenga en cuenta que no solo puede pegar texto, sino tambi\u233?n otros formatos de datos que puede contener el Portapapeles de Windows, por ejemplo, im\u225?genes.\par

\par


\pard\li240\v\'11I6\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:6,16,16"}}{\fldrslt {6_Main_06.png}}}}\lang1033  \cf4\f2\lang3082 TB_EditPaste\tab\tab\cf5\b\f0\fs18\lang1033 Ctrl+V\cf0\b0  o \cf5\b Shift+Insert\f2\fs20  \cf0\b0 / \cf4 MMEditPaste\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B8\'12\v0 Pegar otro\cf3\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos para pegar en KeyNote desde el Portapapeles.\par

 \par

\cf1\b\v\fs26\'11B9\'12\v0 Pegar como texto\cf3\fs20\par

\cf0\b0 Pega el texto del Portapapeles como texto sin formato (sin ning\u250?n formato)\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+Ins\f2\fs20  \cf0\b0 / \cf4 MMEditPasteAsText\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B39\'12\v0 Pegar como captura web\cf3\fs20\par

\cf0\b0 Pega texto de programas externos (por ejemplo, navegadores) de forma configurable, permitiendo a\u241?adir informaci\u243?n de contexto a la captura, como la fecha y hora, la URL o el t\u237?tulo.\par


\pard\sb80 Incluir\u225? todo el formato del texto de origen\par


\pard\par


\pard\sb80 V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<34|0|0"}}{\fldrslt{Uso de Web clip}}}}}\f0\fs20\par


\pard\par


\pard\li240\cf5\b\fs18 Ctrl+W \cf0\b0\f2\fs20 / \cf4 MMEditPasteAsWebClip\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B40\'12\v0 Pegar como captura web (texto)\cf3\fs20\par

\cf0\b0 Pega texto de programas externos (por ejemplo, navegadores) de forma configurable, permitiendo a\u241?adir informaci\u243?n de contexto a la captura, como la fecha y hora, la URL o el t\u237?tulo.\par


\pard\sb80 Permite un {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<33|2492|0|3"}}{\fldrslt{Pegar \u171?texto sin formato personalizado\u187?}}}}}\f0\fs20 , que, seg\u250?n c\u243?mo est\u233? configurado en {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<101|678|0|5"}}{\fldrslt{Modo de texto sin formato}}}}}\f0\fs20 , ofrecer\u225? un pegado completamente sin formato o incluir\u225? ciertos aspectos del formato.\par

V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<34|0|0"}}{\fldrslt{Uso de Web clip}}}}}\f0\fs20\par


\pard\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+W\f2\fs20  \cf0\b0 / \cf4 MMEditPasteAsWebClipText\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B10\'12\v0 Pegado especial\cf3\fs20\par

\cf0\b0 Muestra el cuadro de di\u225?logo est\u225?ndar de Windows \u171?Pegado especial\u187?, que le permite seleccionar el formato que debe usarse al pegar los datos del Portapapeles.\par

\par


\pard\li240\cf4\f2 MMEditPasteSpecial\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B11\'12\v0 Pegar en carpeta nueva\cf3\fs20\par

\cf0\b0 Crea una carpeta nueva y pega en ella los datos del Portapapeles.\par

\par


\pard\li240\cf4\f2 MMEditPasteAsNewNote\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B12\'12\v0 Pegar en nodo nuevo\cf3\fs20\par

\cf0\b0 Crea un nodo nuevo en la carpeta actual y pega en \u233?l los datos del Portapapeles. El t\u237?tulo del nodo nuevo es el mismo que el texto pegado.\par

\par


\pard\li240\cf4\f2 MMEditPasteAsNewNode\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B13\'12\v0 Eliminar\cf3\fs20\par

\cf0\b0 Elimina el texto seleccionado.\par

\par


\pard\li240\cf4\f2 MMEditDelete\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\ul\b\v\fs26\'11B14\'12\v0 L\u237?neas\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con comandos para trabajar con l\u237?neas de texto.\par

 \par

\cf1\b\v\fs26\'11B15\'12\v0 Eliminar l\u237?nea\cf3\fs20\par

\cf0\b0 Elimina la l\u237?nea en la que est\u225? el cursor.\par

\par


\pard\li240\cf5\b\fs18 Ctrl+Y\f2\fs20  \cf0\b0 / \cf4 MMEditDelLine\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B16\'12\v0 Ordenar l\u237?neas\cf3\fs20\par

\cf0\b0 Ordena las l\u237?neas seleccionadas actualmente en orden alfanum\u233?rico.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+S\f2\fs20  \cf0\b0 / \cf4 MMEditSort\cf5\b\par


\pard\li360\sb120\cf0\f0 Sugerencia\b0 : este comando tambi\u233?n se puede usar para ordenar bloques de texto con ayuda del plegado. El bloque de texto plegado se ordenar\u225? teniendo en cuenta el extracto visible (ignorando el car\u225?cter \f3\u10133?\f0 ). El contenido del texto plegado no se modificar\u225? (mientras est\u233? plegado u oculto).\par


\pard\par

\cf1\b\v\fs26\'11B17\'12\v0 Unir l\u237?neas\cf3\fs20\par

\cf0\b0 Quita los retornos de carro de las l\u237?neas seleccionadas, uni\u233?ndolas en una sola l\u237?nea.\par

\par


\pard\li240\cf5\b\fs18 Ctrl+J\f2\fs20  \cf0\b0 / \cf4 MMEditJoin\cf5\b\par


\pard\li360\sb80\cf0\f0 Sugerencia\b0 : este comando puede usar una cadena personalizada para unir, en lugar del espacio predeterminado, permitiendo (por ejemplo): \u171?L1\u187?, \u171?L2\u187?, ...\par


\pard\li720 V\u233?ase {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<20|30336|0|17"}}{\fldrslt{Unir varias l\u237?neas usando una cadena personalizada como separador}}}}}\f0\fs20\par


\pard\sb40\par


\pard\cf1\ul\b\v\fs26\'11B18\'12\v0 Cambiar may\u250?sculas y min\u250?sculas\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con comandos para cambiar las may\u250?sculas y min\u250?sculas del texto seleccionado.\par

\cf3\b\f4\fs26\par

\cf1\v\f0\'11B19\'12\v0 A MAY\u218?SCULAS\cf3\fs20\par

\cf0\b0 Convierte el texto seleccionado a may\u250?sculas.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+U\f2\fs20  \cf0\b0 / \cf4 MMEditUpper\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B20\'12\v0 A min\u250?sculas\cf3\fs20\par

\cf0\b0 Convierte el texto seleccionado a min\u250?sculas.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+L\f2\fs20  \cf0\b0 / \cf4 MMEditLower\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B21\'12\v0 A may\u250?sculas y min\u250?sculas\cf3\fs20\par

\cf0\b0 Convierte el texto seleccionado a may\u250?sculas y min\u250?sculas combinadas (la primera letra de cada palabra en may\u250?scula, las dem\u225?s en min\u250?scula). \par

KeyNote se convierte en Keynote.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+M\f2\fs20  \cf0\b0 / \cf4 MMEditMixed\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B22\'12\v0 Invertir may\u250?sculas y min\u250?sculas\cf3\fs20\par

\cf0\b0 Intercambia las letras may\u250?sculas y min\u250?sculas\par

(KeyNote se convierte en kEYnOTE).\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+I\f2\fs20  \cf0\b0 / \cf4 MMEditInvertCase\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B23\'12\v0 Alternar may\u250?sculas y min\u250?sculas\cf3\fs20\par

\cf0\b0 Al seleccionar este comando repetidamente, se alterna entre convertir el texto seleccionado a may\u250?sculas, luego a min\u250?sculas y luego a may\u250?sculas y min\u250?sculas combinadas.\par

\par


\pard\li240\cf5\b\fs18 Shift+F3\f2\fs20  \cf0\b0 / \cf4 MMEditCycleCase\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\ul\b\v\fs26\'11B24\'12\v0 Espacios en blanco\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con un comando para editar los espacios en blanco (espacios y tabulaciones) de las l\u237?neas seleccionadas o del nodo completo si no hay texto seleccionado.\par

\par

\cf1\b\v\fs26\'11B25\'12\v0 Recortar por la izquierda\cf3\fs20\par

\cf0\b0 Elimina los espacios en blanco a la izquierda de la primera letra de las l\u237?neas seleccionadas o del nodo completo si no hay texto seleccionado.\par

\par


\pard\li240\cf4\f2 MMEditTrimLeft\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B26\'12\v0 Recortar por la derecha\cf3\fs20\par

\cf0\b0 Elimina los espacios en blanco a la derecha de la \u250?ltima letra de las l\u237?neas seleccionadas o del nodo completo si no hay texto seleccionado.\par

\par


\pard\li240\cf4\f2 MMEditTrimRight\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B27\'12\v0 Recortar ambos lados\cf3\fs20\par

\cf0\b0 Elimina los espacios en blanco a la izquierda de la primera letra y a la derecha de la \u250?ltima letra de las l\u237?neas seleccionadas o del nodo completo si no hay texto seleccionado.\par

\par


\pard\li240\cf4\f2 MMEditTrimBoth\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B28\'12\v0 Comprimir espacios en blanco\cf3\fs20\par

\cf0\b0 Comprime todos los espacios en blanco en uno solo (o una tabulaci\u243?n si hay tabulaciones pero no espacios) en las l\u237?neas seleccionadas o en el nodo completo si no hay texto seleccionado.\par

\par


\pard\li240\cf4\f2 MMEditCompress\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\ul\b\v\fs26\'11B29\'12\v0 Transformar\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con comandos para transformar el texto.\par

\par

\cf1\b\v\fs26\'11B30\'12\v0 Aplicar ROT-13\cf3\fs20\par

\cf0\b0 Transforma el texto mediante ROT-13. \par

Se trata de una vieja t\u233?cnica para ofuscar texto que se remonta a los primeros tiempos de Usenet. NO es un cifrado. Puede usarla para disimular el texto de modo que quien lo vea tenga que aplicar de nuevo la transformaci\u243?n ROT-13 para poder leerlo. \par

Consulte {{\cf0\ul{\field{\*\fldinst{HYPERLINK http://catb.org/~esr/jargon/html/entry/rot13.html }}{\fldrslt{http://catb.org/~esr/jargon/html/entry/rot13.html}}}}}\f0\fs20  para obtener m\u225?s informaci\u243?n.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+3\f2\fs20  \cf0\b0 / \cf4 MMEditRot13\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B31\'12\v0 Invertir texto\cf3\fs20\par

\cf0\b0 Invierte el orden del texto seleccionado.\par

Si selecciona varias l\u237?neas, tambi\u233?n se invierte el orden de las l\u237?neas.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+4\f2\fs20  \cf0\b0 / \cf4 MMEditReverse\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B32\'12\v0 Decimal a romano\cf3\fs20\par

\cf0\b0 Convierte el n\u250?mero decimal seleccionado a n\u250?meros romanos. \par

12 se convierte en XII. Si no hay ning\u250?n n\u250?mero seleccionado, aparece un cuadro de di\u225?logo para que introduzca el n\u250?mero decimal.\par

\par


\pard\li240\cf4\f2 MMEditDecimalToRoman\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B33\'12\v0 Romano a decimal\cf3\fs20\par

\cf0\b0 Convierte los n\u250?meros romanos seleccionados en un n\u250?mero decimal.\par

XII se convierte en 12. Si no hay ning\u250?n n\u250?mero seleccionado, aparece un cuadro de di\u225?logo para que introduzca el n\u250?mero decimal.\par

\par


\pard\li240\cf4\f2 MMEditRomanToDecimal\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\ul\b\v\fs26\'11B34\'12\v0 Expresi\u243?n\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con comandos para evaluar expresiones.\par

\par

\cf1\b\v\fs26\'11B35\'12\v0 Evaluar\cf3\fs20\par

\cf0\b0 Eval\u250?a la expresi\u243?n num\u233?rica seleccionada y a\u241?ade el resultado al final del texto seleccionado. Si no hay ninguna expresi\u243?n seleccionada, eval\u250?a la expresi\u243?n de la l\u237?nea donde est\u225? el cursor y a\u241?ade el resultado.\par

\par


\pard\li240\cf5\b\fs18 Ctrl+ +=\f2\fs20  \cf0\b0 / \cf4 MMEditEvaluate\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B36\'12\v0 Pegar \u250?ltimo resultado\cf3\fs20\par

\cf0\b0 Pega en la posici\u243?n del cursor el resultado de la \u250?ltima evaluaci\u243?n de expresi\u243?n.\par

\par


\pard\li240\cf5\b\fs18 Alt+Ins\f2\fs20  \cf0\b0 / \cf4 MMEditPasteEval\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B37\'12\v0 Seleccionar palabra\cf3\fs20\par

\cf0\b0 Selecciona la palabra donde est\u225? el cursor. \par

Puede estar activo el panel \u193?rbol o el panel Editor.\par

\par


