\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Separadores. Ejemplos\cf2\lang1033\par

\cf0\b0\fs20\par

\fs18 Separadores predefinidos:\par

\par


\pard\sa100\b Captura del portapapeles:\par


\pard\li120 {\b0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<37|1695|0|1"}}{\fldrslt{^^^--- %D, %T %| - - -  %S%|^^%%^. . .^}}}}}\b0\f0\fs18\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<37|2498|0|2"}}{\fldrslt{^^-- %D %|-  [ %S ] %|--^%%^- -^}}}}}\f0\fs18\par

