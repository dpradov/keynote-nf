   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7139|0|27"}}{\fldrslt{Como fecha y hora}}}}}\f0\fs20\tab Cambia el nombre con la fecha y la hora actuales\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7436|0|28"}}{\fldrslt{Del texto seleccionado}}}}}\f0\fs20\tab Cambia el nombre con el texto seleccionado en el panel Editor\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7607|0|29"}}{\fldrslt{Guardar \u225?rbol en archivo...}}}}}\f0\fs20\tab Guarda la estructura del \u225?rbol de la carpeta en un archivo de texto\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7865|0|30"}}{\fldrslt{Ordenar}}}}}\f0\fs20\tab Submen\u250? para ordenar los nodos del \u225?rbol de una carpeta\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|7985|0|31"}}{\fldrslt{Ordenar sub\u225?rbol}}}}}\f0\fs20\tab Ordena los nodos hijos del nodo seleccionado (orden alfanum\u233?rico)\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8366|0|32"}}{\fldrslt{Ordenar \u225?rbol completo}}}}}\f0\fs20\tab Ordena todos los nodos del \u225?rbol de la carpeta (orden alfanum\u233?rico)\par


\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8553|0|33"}}{\fldrslt{Numeraci\u243?n de esquema...}}}}}\f0\fs20\tab A\u241?ade o quita numeraci\u243?n de esquema a los nombres de los nodos del \u225?rbol de la carpeta activa\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8303|0|36"}}{\fldrslt{Establecer foco}}}}}\f0\fs20\tab Muestra un submen\u250? de comandos para cambiar el panel con el foco.\par


\pard\fi-2160\li2160\sb40    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8417|0|37"}}{\fldrslt{Alternar foco: editor / panel del \u225?rbol}}}}}\f0\fs20\par


\pard\fi-2160\li2160\sb80    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8492|0|38"}}{\fldrslt{Establecer foco en el panel del editor}}}}}\f0\fs20\par


\pard\fi-2160\li2160\sb80\sa100    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<115|8559|0|39"}}{\fldrslt{Establecer foco en el panel del \u225?rbol}}}}}\f0\fs20\par


\pard\fi-2160\li2160\sa100\par

\par


\pard V\u233?ase tambi\u233?n: {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<13|0|0"}}{\fldrslt{Definiciones}}}}}\f0\fs20\lang3082  \lang1033\par


\pard\fi-2160\li2160\sa100\par

\par

\par


\pard\cf1\ul\b\v\fs26\'11B1\'12\v0 A\u241?adir nodo del \u225?rbol\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con los comandos para a\u241?adir un nodo en el \u225?rbol de la carpeta activa.\par

\par

\cf1\b\v\fs26\'11B2\'12\v0 Insertar nodo\cf3\fs20\par

\cf0\b0 A\u241?ade un \cf4 nodo\cf0  nuevo encima del nodo seleccionado.\par

\par


\pard\li240\cf5\b\fs18 Ins\f2\fs20  \cf0\b0 / \cf6 TVInsertNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B3\'12\v0 A\u241?adir nodo\cf3\fs20\par

\cf0\b0 A\u241?ade un \cf4 nodo\cf0  nuevo en el mismo nivel que el nodo seleccionado, pero debajo de todos los nodos hermanos.\par

\par


\pard\li240\cf5\b\fs18 Enter\f2\fs20  \cf0\b0 / \cf6 TVAddNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B4\'12\v0 A\u241?adir hijo\cf3\fs20\par

\cf0\b0 A\u241?ade un nuevo \cf4 nodo hijo\cf0  debajo del \cf4 nodo seleccionado\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Shift+Enter\f2\fs20  \cf0\b0 / \cf6 TVAddChildNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B5\'12\v0 A\u241?adir hermano\cf3\fs20\par

\cf0\b0 A\u241?ade un nuevo \cf4 nodo hermano\cf0  en el mismo nivel que el nodo seleccionado, inmediatamente debajo del \cf4 nodo seleccionado\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Ctrl+Enter\f2\fs20  \cf0\b0 / \cf6 TVAddSibling\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B6\'12\v0 Mover nodo\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? que permite mover el \cf4 nodo\cf0  seleccionado a otra ubicaci\u243?n del \u225?rbol de la carpeta activa.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B7\'12\v0 Arriba\cf3\fs20\par

\cf0\b0 Mueve el \cf4 nodo\cf0  seleccionado hacia arriba.\par

\par


\pard\li240\cf5\b\fs18 Shift+Up\f2\fs20  \cf0\b0 / \cf6 TVMoveNodeUp\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B8\'12\v0 Abajo\cf3\fs20\par

\cf0\b0 Mueve el \cf4 nodo\cf0  seleccionado hacia abajo.\par

\par


\pard\li240\cf5\b\fs18 Shift+Down\f2\fs20  \cf0\b0 / \cf6 TVMoveNodeDown\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B9\'12\v0 Izquierda\cf3\fs20\par

\cf0\b0 Mueve el \cf4 nodo\cf0  seleccionado a la izquierda.\par

\par


\pard\li240\cf5\b\fs18 Shift+Left\f2\fs20  \cf0\b0 / \cf6 TVMoveNodeLeft\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B10\'12\v0 Derecha\cf3\fs20\par

\cf0\b0 Mueve el \cf4 nodo\cf0  seleccionado a la derecha.\par

\par


\pard\li240\cf5\b\fs18 Shift+Right\f2\fs20  \cf0\b0 / \cf6 TVMoveNodeRight\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B18\'12\v0 Crear nodo maestro\cf3\fs20\par

\cf0\b0 A\u241?ade un \cf4 nodo\cf0  nuevo en la parte superior del \u225?rbol de la carpeta activa.\par

El \u225?rbol existente pasa a ser hijo del nuevo nodo maestro.\par

\par


\pard\li240\cf6\f2 MMTreeMasterNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B19\'12\v0 Nuevo nodo a partir de la selecci\u243?n\cf3\fs20\par

\cf0\b0 Crea un nuevo \cf4 nodo hermano\cf0  inmediatamente debajo del \cf4 nodo actual\cf0 .\par


\pard\sb40 El texto seleccionado en el nodo actual se usa como contenido del nodo nuevo. La primera l\u237?nea del texto seleccionado se usa como nombre del nodo nuevo (considerando un m\u225?ximo de 60 caracteres). Este nodo nuevo ser\u225? el seleccionado.\par


\pard\sb120 Nota: el texto original no se elimina, sino que permanece seleccionado, as\u237? que basta con pulsar DEL para borrarlo (cuando vuelva al nodo original, por ejemplo con \cf5\fs18 Alt+Up\cf0\fs20 .\par


\pard\par


\pard\li240\cf5\b\fs18 Alt+F11\f2\fs20  \cf0\b0 / \cf6 MMTreeNodeFromSel\cf5\b\par


\pard\cf0\b0\f0\par

\par

\cf1\b\v\fs26\'11B34\'12\v0 Expandir \u225?rbol\cf3\fs20\par

\cf0\b0 Expande las ramas contra\u237?das del \u225?rbol de la carpeta activa\par

\par


\pard\li240\cf5\b\fs18 Shift+Numpad +\f2\fs20  \cf0\b0 / \cf6 MMTreeFullExpand\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B35\'12\v0 Contraer \u225?rbol\cf3\fs20\par

\cf0\b0 Contrae todo el \u225?rbol \cf4 \u225?rbol\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Shift+Numpad -\f2\fs20  \cf0\b0 / \cf6 MMTreeFullCollapse\cf5\b\par


\pard\fi-2160\li2160\sa100\cf0\b0\f0\par


\pard\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B13\'12\v0 Navegar\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos para ir a otro \cf4 nodo\cf0  del \u225?rbol de la carpeta activa.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B14\'12\v0 Subir\cf3\fs20\par

\cf0\b0 Sube un \cf4 nodo\cf0  en el \cf4 \u225?rbol\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Alt+Up\f2\fs20  \cf0\b0 / \cf6 MMTreeNavUp\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B15\'12\v0 Bajar\cf3\fs20\par

\cf0\b0 Baja un \cf4 nodo\cf0  en el \cf4 \u225?rbol\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Alt+Down\f2\fs20  \cf0\b0 / \cf6 MMTreeNavDown\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B16\'12\v0 Ir a la izquierda\cf3\fs20\par

\cf0\b0 Despl\u225?zate un \cf4 nodo\cf0  a la izquierda en el \cf4 \u225?rbol\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Shift+Alt+Left\f2\fs20  \cf0\b0 / \cf6 MMTreeNavLeft\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B17\'12\v0 Ir a la derecha\cf3\fs20\par

\cf0\b0 Despl\u225?zate un \cf4 nodo\cf0  a la derecha en el \cf4 \u225?rbol\cf0 .\par

\par


\pard\li240\cf5\b\fs18 Shift+Alt+Right\f2\fs20  \cf0\b0 / \cf6 MMTreeNavRight\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B20\'12\v0 Eliminar nodo\cf3\fs20\par

\cf0\b0 Elimina el \cf4 nodo\cf0  actual del \u225?rbol de la carpeta activa.\par

\par


\pard\li240\cf7 Advertencia: una vez eliminado un nodo, no se puede recuperar.\cf0\par


\pard\par


\pard\li240\cf5\b\fs18 Del\f2\fs20  \cf0\b0 / \cf6 TVDeleteNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B21\'12\v0 Eliminar nodos secundarios\cf3\fs20\par

\cf0\b0 Elimina todos los \cf4 nodos secundarios\cf0  del \cf4 nodo\cf0  actual de la carpeta activa.\par

\par


\pard\li240\cf7 Advertencia: este comando puede eliminar varios nodos. Una vez eliminado un nodo, no se puede recuperar.\cf0\par


\pard\par


\pard\li240\cf5\b\fs18 Shift+Del\f2\fs20  \cf0\b0 / \cf6 TVDeleteChildren\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B22\'12\v0 Cambiar nombre del nodo\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual del \u225?rbol de la carpeta activa.\par

\par


\pard\li240\cf5\b\fs18 Espacio\cf0\b0\fs20  o \cf5\b\fs18 F2\f2\fs20  \cf0\b0 / \cf6 TVRenameNode\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B23\'12\v0 Pegar nombre de nodo\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? con comandos para cambiar el nombre de un \cf4 nodo\cf0  del \u225?rbol de la carpeta activa.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B24\'12\v0 Del portapapeles\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual por el contenido del portapapeles.\par

\par


\pard\li240\cf5\b\fs18 Shift+Ins\f2\fs20  \cf0\b0 / \cf6\lang3082 TVPasteNodeName, \lang1033 MMTreeNodeNamePaste\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B25\'12\v0 Como fecha\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual por la fecha actual.\par

Use el comando \b Herramientas/Opciones de configuraci\u243?n\b0 , ajuste \b Formatos\b0 , para establecer el formato de fecha predeterminado. Consulte el archivo \f3\ldblquote\b\f0 dateformats.txt\b0\f3\rdblquote\f0  para obtener informaci\u243?n sobre c\u243?mo personalizar la fecha.\par

\par


\pard\li240\cf5\b\fs18 Alt+D\f2\fs20  \cf0\b0 / \cf6 TVPasteNodeNameAsDate, MMTreeNodeNameAsDate\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B26\'12\v0 Como hora\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual por la hora actual.\par

Use el comando \b Herramientas/Opciones de configuraci\u243?n\b0 , ajuste \b Formatos\b0 , para establecer el formato de hora predeterminado. Consulte el archivo \f3\ldblquote\b\f0 dateformats.txt\b0\f3\rdblquote\f0  para obtener informaci\u243?n sobre c\u243?mo personalizar la hora.\par

\par


\pard\li240\cf5\b\fs18 Alt+T\f2\fs20  \cf0\b0 / \cf6  TVPasteNodeNameAsTime, MMTreeNodeNameAsTime\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B27\'12\v0 Como fecha y hora\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual por la fecha y la hora actuales.\par

Use el comando \b Herramientas/Opciones de configuraci\u243?n\b0 , ajuste \b Formatos\b0 , para establecer el \b formato de fecha y hora predeterminado\b0 .\par

\par


\pard\li240\cf5\b\fs18 Shift+Alt+D\f2\fs20  \cf0\b0 / \cf6 TVPasteNodeNameAsDateTime, MMTreeNodeNameAsDateTime\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B28\'12\v0 Del texto seleccionado\cf3\fs20\par

\cf0\b0 Cambia el nombre del \cf4 nodo\cf0  actual por el texto seleccionado en el panel Editor.\par


\pard\sb40 (Se aplica al nodo activo, al que pertenece el texto seleccionado)\par


\pard\par


\pard\li240\cf6\f2 MMTreeNodeNameAsSel\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B29\'12\v0 Guardar \u225?rbol en archivo...\cf3\fs20\par

\cf0\b0 Guarda la estructura del \u225?rbol de la carpeta activa en un archivo de texto.\par

El archivo de texto contiene solo los nombres y las posiciones relativas de los \cf4 nodos\cf0 ; no incluye el contenido de los nodos.\par


\pard\sb80\b Sugerencia\b0 : con \cf5\b Ctrl\cf0\b0  se a\u241?adir\u225? el GID de los nodos a los nombres. Los GID se muestran entre \u171?[\u187? y \u171?]\u187?. Primero se muestra el valor GID y despu\u233?s el valor ID (ID: cuando existe, ya que es un nodo creado con una versi\u243?n anterior a la 1.9.3.1)\par

    Ejemplo:\par

       Nombre de mi nodo [5](id:3)        <- GID:5   ID:3\par


\pard\par


\pard\li240\cf6\f2 MMTreeSaveToFile\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B30\'12\v0 Ordenar\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos para ordenar los \cf4 nodos\cf0  del \u225?rbol de la carpeta activa.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B31\'12\v0 Ordenar sub\u225?rbol\cf3\fs20\par

\cf0\b0 Ordena los \cf4 nodos secundarios\cf0  que pertenecen al \cf4 nodo\cf0  seleccionado (orden alfanum\u233?rico).\par

\par


\pard\li240\b Sugerencia: \b0 esto solo ordena el primer nivel de nodos que descienden del nodo seleccionado. No ordena ning\u250?n nodo nieto (nodos que descienden de un nodo secundario).\par

\par

\cf7 Advertencia: no se puede deshacer un comando de ordenaci\u243?n.\par


\pard\cf0\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+U\f2\fs20  \cf0\b0 / \cf6 TVSortSubtree\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B32\'12\v0 Ordenar todo el \u225?rbol\cf3\fs20\par

\cf0\b0 Ordena todos los \cf4 nodos\cf0  del \u225?rbol de la carpeta (orden alfanum\u233?rico).\par

\par


\pard\li240\cf7 Advertencia: no se puede deshacer un comando de ordenaci\u243?n.\cf0\par


\pard\par


\pard\li240\cf5\b\fs18 Shift+Ctrl+S\f2\fs20  \cf0\b0 / \cf6 TVSortTree\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B33\'12\v0 Numeraci\u243?n de esquema...\cf3\fs20\par

\cf0\b0 A\u241?ade o quita la numeraci\u243?n de estilo esquema a los nombres de los \cf4 nodos\cf0  del \u225?rbol de la carpeta activa.\par

\par

Se muestra un cuadro de di\u225?logo con varias opciones. Importante: los nodos NO se renumeran autom\u225?ticamente; si ha a\u241?adido, eliminado o movido nodos, tendr\u225? que volver a usar el comando. Si va a renumerar un \u225?rbol que ya estaba numerado, aseg\u250?rese de elegir la opci\u243?n correcta en el cuadro \u171?Estado de numeraci\u243?n actual\u187?. Si solo algunos nodos tienen n\u250?meros y otros no, DEBE seleccionar la opci\u243?n \u171?Detectar autom\u225?ticamente la numeraci\u243?n de nodos existente\u187?, que est\u225? preseleccionada de forma predeterminada.\par

\par


\pard\li240\cf6\f2 MMTreeOutlineNum\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B36\'12\v0 Establecer foco\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos para cambiar el panel que tiene el foco.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B37\'12\v0 Alternar foco: panel Editor / panel \u193?rbol\cf3\fs20\par


\pard\sb120\cf1\v\fs26\'11B38\'12\v0 Establecer el foco en el panel Editor\cf0\b0\fs20\par

\cf1\b\v\fs26\'11B39\'12\v0 Establecer el foco en el panel \u193?rbol\cf3\fs20\par


\pard\fi-2160\li2160\sa100\cf0\b0\par


\pard Estos comandos de men\u250? se incluyen para que pueda crear atajos personalizados que establezcan el foco.\par

V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|9413|0|2"}}{\fldrslt{Atajos de teclado para los comandos del \u225?rbol}}}}}\f0\fs20\par


\pard\fi-2160\li2160\sa100\par

\par

}
