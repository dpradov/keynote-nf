      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|13152|0|5"}}{\fldrslt{Insertar enlaces internos de KeyNote (enlaces KNT)}}}}}\f0\fs20\par

      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|19620|0|13"}}{\fldrslt{Cambiar el color de los enlaces}}}}}\f0\fs20\par


