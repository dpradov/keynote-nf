\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Teclas de acceso r\u225?pido del \u225?rbol\cf2\f0\lang1033\par

\cf0\b0\fs20\par

V\u233?ase tambi\u233?n {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|4545|0|6"}}{\fldrslt{Usar el panel \u193?rbol}}}}}\f0\fs20  \par

\fs26\par

\b El panel \u193?rbol debe estar activo.\par


\pard\sb120\cf3\fs20 Shift+F11\cf0\b0\tab\tab Ocultar o mostrar el panel del \u225?rbol \par


\pard\cf3\b Ctrl+Shift+F11\cf0\b0\tab Ocultar o mostrar el panel del \u225?rbol (manteniendo el ancho del editor) ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|11464|0|9"}}{\fldrslt{M\u225?s}}}}}\f0\fs20 )\par


\pard\sb200\cf3\b Enter\cf0\b0\tab\tab\tab A\u241?adir un nodo nuevo (\u250?ltimo hermano)\par


\pard\cf3\b Ctrl+Enter\cf0\b0\tab\tab A\u241?adir un nodo nuevo justo despu\u233?s del nodo actual (hermano siguiente)\par

\cf3\b Insert\cf0\b0\tab\tab\tab Insertar un nodo nuevo antes del actual (hermano)\par

\cf3\b Shift+Enter\cf0\b0\tab\tab A\u241?adir un nodo nuevo como hijo del nodo actual \par


\pard\sb120\cf3\b Espacio \cf0\b0 o \cf3\b F2\cf0\b0\tab\tab Cambiar el nombre del nodo seleccionado \par


\pard\sb160\cf3\b Shift+Down\cf0\b0\tab\tab Mover los nodos seleccionados hacia abajo \par


\pard\cf3\b Shift+Left\cf0\b0\tab\tab Mover los nodos seleccionados a la izquierda  \i (ascender en la jerarqu\u237?a) \i0\par

\cf3\b Shift+Right\cf0\b0\tab\tab Mover los nodos seleccionados a la derecha \i (descender en la jerarqu\u237?a) \i0\par

\cf3\b Shift+Up\cf0\b0\tab\tab Mover los nodos seleccionados hacia arriba \par


\pard\sb160\cf3\b Delete\cf0\b0\tab\tab\tab Eliminar los nodos seleccionados \i (opcionalmente, eliminar tambi\u233?n todos los hijos) \i0\par


\pard\sa160\cf3\b Shift+Delete\cf0\b0\tab\tab Eliminar todos los hijos de los nodos seleccionados \par


\pard\cf3\b Flecha izquierda    \cf0\b0 o \cf3\b Teclado num\u233?rico -\cf0\b0\tab Contraer el nodo o la rama seleccionados\par

\cf3\b Flecha derecha \cf0\b0 o \cf3\b Teclado num\u233?rico + \cf0\b0  \tab Expandir el nodo o la rama seleccionados (tambi\u233?n \cf3\b Teclado num\u233?rico *\cf0\b0 )\par


\pard\sb80\cf3\b Shift+Teclado num\u233?rico -\tab\cf0\b0\tab Contraer todos los nodos del \u225?rbol \par


\pard\cf3\b Shift+Teclado num\u233?rico +\tab\cf0\b0\tab Expandir todos los nodos del \u225?rbol \par


\pard\sb120\par


\pard\cf3\b Ctrl+C\cf0\b0\tab\tab\tab Copiar los nodos o sub\u225?rboles seleccionados\par

\cf3\b Ctrl+X\cf0\b0  \tab\tab\tab Cortar los nodos o sub\u225?rboles seleccionados\par

\cf3\b Ctrl+V\cf0\b0  \tab\tab\tab Pegar nodos o sub\u225?rboles\par

\cf3\b Ctrl+Shift+V\cf0\b0\tab\tab Pegar nodos o sub\u225?rboles como nodos vinculados\cf3\b\par

\par


\pard\sb120 Alt+F11\cf0\b0\tab\tab Crear un nodo nuevo del \u225?rbol a partir del texto seleccionado en el nodo actual\par


\pard\sb160\cf3\b Ctrl+B\cf0\b0\tab\tab\tab Marcar los nodos seleccionados en negrita \par


\pard\cf3\b Ctrl+D\cf0\b0\tab\tab\tab Restablecer los colores de los nodos seleccionados (fuente y fondo) a los valores predeterminados \par


\pard\sb160\cf3\b Shift+Insert\cf0\b0\tab\tab Cambiar el nombre del nodo pegando el texto del portapapeles \par


\pard\cf3\b Alt+D\cf0\b0\tab\tab\tab Cambiar el nombre del nodo usando la fecha actual \par

\cf3\b Alt+T\cf0\b0\tab\tab\tab Cambiar el nombre del nodo usando la hora actual \par

\cf3\b Shift+Alt+D\cf0\b0\tab\tab Cambiar el nombre del nodo usando la fecha y la hora actuales \par


\pard\sb160\cf3\b Ctrl+P\cf0\b0\tab\tab\tab Copiar la ruta del nodo seleccionado al portapapeles \par


\pard\cf3\b Ctrl+T\cf0\b0\tab\tab\tab Copiar el texto completo del nodo seleccionado al portapapeles \par

\cf3\b Ctrl+E\cf0\b0\tab\tab\tab Insertar la ruta completa del nodo seleccionado en el editor \par


\pard\sb160\cf3\b Ctrl+V\cf0\b0\tab\tab\tab Hacer virtual el nodo seleccionado \par


\pard\cf3\b Ctrl+R\cf0\b0\tab\tab\tab Actualizar el nodo virtual \i (recargar el archivo del disco)\i0  \par


\pard\sb160\cf3\b Ctrl+Shift+S\cf0\b0\tab\tab Ordenar todo el \u225?rbol \par


\pard\cf3\b Ctrl+Shift+U\cf0\b0\tab\tab Ordenar el sub\u225?rbol seleccionado \par


\pard\sb120\cf3\b Ctrl+`\cf0\b0\tab (o \cf3\b +\u241?\cf0\b0 )\super [*]\nosupersub\tab Marcar o desmarcar el nodo seleccionado \par


\pard\cf3\b Ctrl+X\cf0\b0\tab\tab\tab Exportar el nodo seleccionado \par

\par

\super\b [*]\b0  \nosupersub Depende de la distribuci\u243?n del teclado\par

 \par

\b Nota:\par

\b0 Otra forma de mover nodos es arrastrarlos y soltarlos en un nuevo lugar. El men\u250? contextual del \u225?rbol ofrece m\u225?s comandos del \u225?rbol.\par


\pard\fi-720\li720\par

}
