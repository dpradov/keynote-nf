\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B20\'12\v0 Alejar\cf3\fs20\par

\cf0\b0 Reduce la vista del panel Editor en un 10 %.\par

\par

\b Sugerencia: \b0 puede usar el bot\u243?n Zoom de la barra de herramientas principal para introducir directamente un nivel de zoom.\par

\par


\pard\li240\v\'11I59\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:59,16,16"}}{\fldrslt {59_Main_59.png}}}}\cf4\f3  MMViewZoomOut\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B36\'12\v0 M\u225?rgenes alternativos\cf3\fs20\par

\cf0\b0 Alterna los m\u225?rgenes visibles entre el valor predeterminado (m\u237?nimo) y los valores definidos en el archivo .ini (en p\u237?xeles). ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<20|8881|0|6"}}{\fldrslt{M\u225?s informaci\u243?n}}}}}\f0\fs20 )\par

\par


\pard\li240\cf4\f3 MMAlternativeMargins\cf0\f0\lang3082\par


\pard\par

\par

\cf1\ul\b\v\fs26\lang1033\'11B21\'12\v0 Mostrar formato\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos que le permite elegir la informaci\u243?n de formato que se mostrar\u225? en la barra de estado:\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B22\'12\v0 Mostrar formato de fuente\cf3\fs20\par

\cf0\b0 Muestra informaci\u243?n del estilo de fuente en la barra de estado.\par

\par


\pard\li240\cf4\f3 MMViewFormatFont\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B23\'12\v0 Mostrar formato de p\u225?rrafo\cf3\fs20\par

\cf0\b0 Muestra informaci\u243?n del estilo de p\u225?rrafo en la barra de estado.\par

\par


\pard\li240\cf4\f3 MMViewFormatPara\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B24\'12\v0 Mostrar todo el formato\cf3\fs20\par

\cf0\b0 Muestra informaci\u243?n del estilo de fuente y de p\u225?rrafo en la barra de estado.\par

\par


\pard\li240\cf4\f3 MMViewFormatBoth\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B25\'12\v0 Ocultar formato\cf3\fs20\par

\cf0\b0 No muestra informaci\u243?n de formato en la barra de estado.\par

\par

\b Sugerencia: \b0 es posible que pueda mejorar el rendimiento de KeyNote\rquote  si oculta la visualizaci\u243?n del formato.\par

\par


\pard\li240\cf4\f3 MMViewFormatNone\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B26\'12\v0 Ordenar pesta\u241?as alfab\u233?ticamente\cf3\fs20\par

\cf0\b0 Organiza todas las pesta\u241?as de carpeta alfab\u233?ticamente por nombre.\par

\par


\pard\li240\cf4\f3 MMViewAlphaTabs\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\ul\b\v\fs26\lang1033\'11B27\'12\v0 Mover la pesta\u241?a activa\cf3\ulnone\fs20\par

\cf0\b0 Muestra un submen\u250? de comandos que le permiten mover la pesta\u241?a activa.\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B28\'12\v0 Mover pesta\u241?a a la izquierda\cf3\fs20\par

\cf0\b0 Mueve la pesta\u241?a activa hacia la izquierda.\par

\par


\pard\li240\cf4\f3 MMViewShiftTabLeft\cf5\b\par


\pard\cf0\b0\f0\par

\lang3082\par

\cf1\b\v\fs26\lang1033\'11B29\'12\v0 Mover pesta\u241?a a la derecha\cf3\fs20\par

\cf0\b0 Mueve la pesta\u241?a activa hacia la derecha.\par

\par

\b Sugerencia: \b0 tambi\u233?n puede mover las pesta\u241?as de notas arrastr\u225?ndolas con el rat\u243?n\par

\par


\pard\li240\cf4\f3 MMViewShiftTabRight\cf5\b\par


\pard\cf0\b0\f0\par

\par

\lang3082\par

\par

\par

\par

\par

