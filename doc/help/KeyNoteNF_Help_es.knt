\pard\sb120 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<20|19532|0|10"}}{\fldrslt{Aplicar formato en KeyNote}}}}}\f0\fs20\lang3082 , {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<22|0|0"}}{\fldrslt{Estilos}}}}}\f0\fs20\par


