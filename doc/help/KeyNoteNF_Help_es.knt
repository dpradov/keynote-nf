\par


\pard\li240\cf5\b\v\fs18\'11I84\'12\cf0\b0\v0\fs20{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:84,16,16"}}{\fldrslt {84_Format_23.png}}}}\cf5\b\fs18  \cf4\b0\f2\fs20 TB_CopyFormat\cf5\b\f0\fs18\tab\tab\tab Ctrl+F7\f2\fs20  \cf0\b0 / \cf4 MMFormatCopy\cf5\b\par


