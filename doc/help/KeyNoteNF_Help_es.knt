}

\pard\intbl\cf8\f0\fs18\cell\trowd\trgaph30\trleft770\trrh223\clbrdrl\brdrw15\brdrs\brdrcf11\clbrdrt\brdrw15\brdrs\brdrcf11\clbrdrr\brdrw15\brdrs\brdrcf11\clbrdrb\brdrw15\brdrs\brdrcf11 \cellx3212\clbrdrl\brdrw15\brdrs\brdrcf11\clbrdrt\brdrw15\brdrs\brdrcf11\clbrdrr\brdrw15\brdrs\brdrcf11\clbrdrb\brdrw15\brdrs\brdrcf11 \cellx3457\clbrdrl\brdrw15\brdrs\brdrcf11\clbrdrt\brdrw15\brdrs\brdrcf11\clbrdrr\brdrw15\brdrs\brdrcf11\clbrdrb\brdrw15\brdrs\brdrcf11 \cellx6184\row 
\pard\li360\cf0\fs20\par


\pard\par

\par

\b Informaci\u243?n general y consejos sobre las tablas\par

\b0\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Adem\u225?s de definir plantillas con tablas ya creadas, puedes preparar \ul plantillas\ulnone  que sean \u171?precursoras\u187? de tablas, a\u241?adiendo una (o varias) l\u237?neas con la forma \u171?+----+-----+\u187?. As\u237? podr\u225?s hacer f\u225?cilmente ajustes en la tabla que se va a crear antes de pulsar ENTER.\par


\pard\li360\sb40 Nota:\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li720 Es necesario crear la plantilla seleccionando \u171?Texto con formato\u187? (obteniendo un .RTF)\par

{\pntext\f10\'B7\tab}Conviene crearla sin incluir el car\u225?cter final despu\u233?s del \u250?ltimo \u171?+\u187?, para no a\u241?adir un salto de l\u237?nea y que, tras insertar la plantilla, el cursor quede justo despu\u233?s del \u250?ltimo \u171?+\u187?\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Puedes usar el {\ul{\field{\*\fldinst{HYPERLINK "file:///<24|0|0"}}{\fldrslt{glosario}}}}\f0\fs20  y a\u241?adir uno o varios t\u233?rminos que se puedan sustituir por estas l\u237?neas con la forma \u171?+-+-+\u187?. Ejemplos de uso posible:\par


\pard            \u171?++\u187?  o \u171?+2\u187? o \u171?t2\u187? o ... \tab =>  "+-------------------+-------------------+"\par

            \u171?+8\u187? o \u171?t8\u187? o ...\tab\tab =>  "+-------+-------+-------+-------+-------+- ------+-------+-------+"\par


\pard\sb120            Basta con escribir el t\u233?rmino definido y pulsar \cf3\b F7\cf0\b0 . Puedes hacer algunos ajustes si lo consideras oportuno y despu\u233?s pulsar ENTER\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Una vez incluida la tabla en KeyNote, puedes editarla de forma b\u225?sica. Por ejemplo, si pulsas TAB desde la \u250?ltima celda de una tabla, se a\u241?adir\u225? una nueva fila. Tambi\u233?n puedes eliminar filas seleccionando todas sus celdas (incluido el car\u225?cter oculto de la derecha, como haces al eliminar un p\u225?rrafo)\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40 Puedes incluir una celda dentro de otra celda, o incluso dentro de otra tabla.\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Tambi\u233?n puedes incluir im\u225?genes en las celdas si quieres.\par


\pard\li360\sa120 Ten en cuenta que no es posible cambiar el tama\u241?o de la imagen dentro de una celda. Pero puedes cambiar su tama\u241?o fuera y copiarla o arrastrarla a la celda\cf9\f7\fs24\lang3082\par


\pard\li720\v\'11I162\'12\cf0\v0\f0\fs20{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:162,16,16"}}{\fldrslt {162_Image_23ene.png}}}}\cf9\fs24  \v\f7\'11I162\'12\cf0\v0\f0\fs20{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:162,24,24"}}{\fldrslt {162_Image_23ene.png}}}}\cf9\f7\fs24\par


\pard\li360\par

\trowd\trgaph30\trleft410\trrh200\trpaddl30\trpaddr30\trpaddfl3\trpaddfr3
\cellx4262\cellx4807\cellx5959 
\pard\intbl\qr\cf8\f8\fs18 Celda, con texto \cf7 alineado \cf8 a la derecha \highlight10\f4\lang1033\cell\highlight0\cell\cell\row\trowd\trgaph30\trleft410\trrh223\trpaddl30\trpaddr30\trpaddfl3\trpaddfr3
\cellx4262\cellx4807\cellx5959 
\pard\intbl\qr\highlight10\cell\highlight0\cell\cell\row\trowd\trgaph30\trleft410\trrh1200\trpaddl30\trpaddr30\trpaddfl3\trpaddfr3
\cellx4262\cellx4807\cellx5959 
\pard\intbl\sa120\cf9\f0\fs22\lang3082    Esta es una \cf0\b celda\cf9\b0  con una tabla \highlight10 dentro\highlight0 : \f7\fs24\par


\pard\intbl\itap2\qr\cf8\f8\fs18 X1\f4\lang1033\nestcell\nestcell\nestcell{\*\nesttableprops\trowd\trgaph30\trleft-30\trqc\trrh200\trpaddl30\trpaddr30\trpaddfl3\trpaddfr3
\cellx1122\cellx2274\cellx3381\nestrow}{\nonesttables\par
}

\pard\intbl\itap2\qr\f8\lang3082 X2\f4\lang1033\nestcell 
