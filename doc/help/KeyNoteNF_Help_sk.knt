\pard\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak zad\u225?te znamienko \ldblquote +\rdblquote  a \u269?\u237?slo, kurzor sa posunie o to\u318?ko riadkov nadol v paneli Editora (\ldblquote +3\rdblquote  posunie kurzor o 3 riadky nadol).\par


\pard\par


\pard{\pntext\f4\'B7\tab}{\*\pn\pnlvlblt\pnf4\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak zad\u225?te znamienko \ldblquote -\rdblquote  a \u269?\u237?slo, kurzor sa posunie o to\u318?ko riadkov nahor v paneli Editora (\ldblquote -2\rdblquote  posunie kurzor o 2 riadky nahor).\par


