   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|3598|0|10"}}{\fldrslt{Skry\u357? v\u353?etky panely n\u225?strojov}}}}}\f0\fs20\tab Skryje v\u353?etky panely n\u225?strojov\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|3698|0|11"}}{\fldrslt{Obnovi\u357? konfigur\u225?ciu}}}}}\f0\fs20\tab Obnov\u237? konfigur\u225?ciu panelov n\u225?strojov zo s\u250?boru toolbar.ini\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|3900|0|12"}}{\fldrslt{Ulo\u382?i\u357? konfigur\u225?ciu}}}}}\f0\fs20\tab Ulo\u382?\u237? aktu\u225?lnu konfigur\u225?ciu panelov n\u225?strojov do s\u250?boru toolbar.ini\par


\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|4556|0|13"}}{\fldrslt{Stavov\u253? riadok}}}}}\f0\fs20\tab Zobraz\u237?/skryje stavov\u253? riadok KeyNote\par


\pard\fi-2160\li2160\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|7037|0|33"}}{\fldrslt{Zobrazi\u357? obr\u225?zky}}}}}\f0\fs20\tab Zobraz\u237? alebo skryje obr\u225?zky v editore (\u271?al\u353?ie mo\u382?nosti pri pou\u382?it\u237? s  Ctrl alebo Alt)\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|4660|0|14"}}{\fldrslt{Ikony kariet}}}}}\f0\fs20\tab Zobraz\u237?/skryje ikony na kart\u225?ch pozn\u225?mok\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|4949|0|15"}}{\fldrslt{Panel stromu}}}}}\f0\fs20\tab Zobraz\u237?/skryje panel Strom\par


\pard\fi-2160\li2160\sb40\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|7462|0|32"}}{\fldrslt{Hist\u243?ria}}}}}\f0\fs20\tab Pr\u237?kazy na navig\u225?ciu v lok\u225?lnej alebo glob\u225?lnej hist\u243?rii\par


\pard\fi-2160\li2160\sa100    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|7542|0|30"}}{\fldrslt{Sp\u228?\u357?}}}}}\f0\fs20\tab Naviguje sp\u228?\u357? v hist\u243?rii\par

   {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|7670|0|31"}}{\fldrslt{Prejs\u357? vpred}}}}}\f0\fs20\tab Naviguje vpred v hist\u243?rii\par


\pard\fi-2160\li2160\sb80\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|5190|0|16"}}{\fldrslt{\u352?tandardn\u233? ikony stromu}}}}}\f0\fs20\tab Zobraz\u237?/skryje \u353?tandardn\u233? ikony uzlov na paneli Strom\par


\pard\fi-2160\li2160\sa100 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<111|5327|0|17"}}{\fldrslt{Vlastn\u233? ikony stromu}}}}}\f0\fs20\tab Zobraz\u237?/skryje vlastn\u233? ikony uzlov na paneli Strom\par

