\b V\u353?eobecn\u233? inform\u225?cie a tipy pre tabu\u318?ky\par

\b0\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Okrem definovania \u353?abl\u243?n s u\u382? vytvoren\u253?mi tabu\u318?kami m\u244?\u382?ete pripravi\u357? \ul \u353?abl\u243?ny\ulnone , ktor\u233? s\u250? \u8222?predchodcami\u8220? tabuliek, pridan\u237?m jedn\u233?ho (alebo viacer\u253?ch) riadkov v tvare \u8222?+----+-----+\u8220?. Takto m\u244?\u382?ete pred stla\u269?en\u237?m ENTER jednoducho upravi\u357? tabu\u318?ku, ktor\u225? sa m\u225? vytvori\u357?.\par


\pard\li360\sb40 Pozn\u225?mka:\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li720 \u352?abl\u243?nu je potrebn\u233? vytvori\u357? s v\u253?berom \u8222?Formatted text\u8220? (z\u237?skate .RTF)\par

{\pntext\f10\'B7\tab}Odpor\u250?\u269?a sa vytvori\u357? ju bez z\u225?vere\u269?n\u233?ho znaku za posledn\u253?m \u8222?+\u8220?, aby sa nepridalo zalomenie riadku, tak\u382?e po vlo\u382?en\u237? \u353?abl\u243?ny bude kurzor hne\u271? za posledn\u253?m \u8222?+\u8220?\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 M\u244?\u382?ete pou\u382?i\u357? {\ul{\field{\*\fldinst{HYPERLINK "file:///<24|0|0"}}{\fldrslt{glos\u225?r}}}}\f0\fs20  a prida\u357? jeden alebo viac v\u253?razov, ktor\u233? mo\u382?no nahradi\u357? t\u253?mito riadkami v tvare \u8222?+-+-+\u8220?. Pr\u237?klady mo\u382?n\u233?ho pou\u382?itia:\par


\pard            \u8222?++\u8220?  alebo \u8222?+2\u8220? alebo \u8222?t2\u8220? alebo ... \tab =>  "+-------------------+-------------------+"\par

            \u8222?+8\u8220? alebo \u8222?t8\u8220? alebo ...\tab\tab =>  "+-------+-------+-------+-------+-------+- ------+-------+-------+"\par


\pard\sb120            Sta\u269?\u237? zada\u357? definovan\u253? v\u253?raz a stla\u269?i\u357? \cf3\b F7\cf0\b0 . Ak uzn\u225?te za vhodn\u233?, m\u244?\u382?ete urobi\u357? nejak\u233? \u250?pravy a potom stla\u269?i\u357? ENTER\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ke\u271? je tabu\u318?ka vlo\u382?en\u225? v KeyNote, m\u244?\u382?ete ju z\u225?kladn\u253?m sp\u244?sobom upravi\u357?. Napr\u237?klad ak v tabu\u318?ke stla\u269?\u237?te TAB z poslednej bunky, prid\u225? sa nov\u253? riadok. Riadky m\u244?\u382?ete tie\u382? odstr\u225?ni\u357? tak, \u382?e vyberiete v\u353?etky ich bunky (vr\u225?tane skryt\u233?ho znaku napravo, ako to rob\u237?te pri odstra\u328?ovan\u237? odseku)\par


\pard\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40 Bunku m\u244?\u382?ete vlo\u382?i\u357? do inej bunky alebo dokonca do inej tabu\u318?ky.\par


\pard{\pntext\f10\'B7\tab}{\*\pn\pnlvlblt\pnf10\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak chcete, m\u244?\u382?ete do buniek vlo\u382?i\u357? aj obr\u225?zky.\par


\pard\li360\sa120 V\u353?imnite si, \u382?e obr\u225?zok vo vn\u250?tri bunky nie je mo\u382?n\u233? zmeni\u357? ve\u318?kos\u357?. M\u244?\u382?ete ho v\u353?ak zmeni\u357? mimo bunky a potom ho skop\u237?rova\u357? alebo pretiahnu\u357? do bunky\cf9\f7\fs24\lang3082\par


\pard\li720\v\'11I162\'12\cf0\v0\f0\fs20{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:162,16,16"}}{\fldrslt {162_Image_23ene.png}}}}\cf9\fs24  \v\f7\'11I162\'12\cf0\v0\f0\fs20{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:162,24,24"}}{\fldrslt {162_Image_23ene.png}}}}\cf9\f7\fs24\par


\pard\li360\par

