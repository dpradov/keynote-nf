\pard\sb40    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|3027|0|3"}}{\fldrslt{Pou\u382?\u237?vanie rozpozn\u225?vania URL v editore RTF}}}}}\f0\fs20\par


\pard\sb60    {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|6159|0|2"}}{\fldrslt{Pou\u382?\u237?vanie pr\u237?kazov hyperodkazov}}}}}\f0\fs20\par


\pard       {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|7546|0|8"}}{\fldrslt{Pou\u382?\u237?vanie pr\u237?kazu Vlo\u382?i\u357? URL...}}}}}\f0\fs20\par

      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|11553|0|9"}}{\fldrslt{Vkladanie odkazov na lok\u225?lne s\u250?bory}}}}}\f0\fs20\par

      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|13732|0|12"}}{\fldrslt{Pou\u382?\u237?vanie parametrov s hyperodkazmi}}}}}\f0\fs20\par

      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|13152|0|5"}}{\fldrslt{Vkladanie intern\u253?ch odkazov Keynote (KNT odkazov)}}}}}\f0\fs20\par

      {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|19620|0|13"}}{\fldrslt{Zmena farby odkazov}}}}}\f0\fs20\par


