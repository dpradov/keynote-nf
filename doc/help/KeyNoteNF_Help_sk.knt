{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red255\green255\blue0;\red255\green0\blue0;\red128\green0\blue0;}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Prisp\u244?sobenie \f1\lang1045 kl\u225?vesov\u253?ch skratiek\cf2\f0\lang1033\par

\fs20\par

\fs26\par

\cf0\b0\fs20 Pr\u237?kaz \b N\u225?stroje | Prisp\u244?sobi\u357? kl\u225?vesnicu...\b0  v\u225?m umo\u382?\u328?uje meni\u357?, prid\u225?va\u357? alebo odstra\u328?ova\u357? kl\u225?vesov\u233? skratky pou\u382?\u237?van\u233? na vyvolanie pr\u237?kazov KeyNote. Kl\u225?vesov\u233? skratky m\u244?\u382?ete upravi\u357? pre v\u353?etky \b pr\u237?kazy\b0  uveden\u233? v \b hlavnom menu\b0  KeyNote a v \b kontextovom menu stromov\u233?ho panela\b0 . \par

\par

Od verzie 1.9.0 m\u244?\u382?ete priradi\u357? \u318?ubovo\u318?n\u250? skratku aj \b makr\u225?m, doplnkom, \u353?abl\u243?nam, \u353?t\u253?lom a p\u237?smam\b0 . Teraz u\u382? nie je potrebn\u233? pou\u382?\u237?va\u357? star\u253? doplnok \b funckey.knl\b0  a m\u244?\u382?ete pou\u382?\u237?va\u357? ak\u250?ko\u318?vek skratku (a nielen Alt+<Fx>, Shift+Alt+<Fx> alebo Ctrl+Alt+<Fx>.)\par


\pard\li360\sb40\ul Doplnok Funckey\ulnone  u\u382? teraz nie je potrebn\u253? a je \ul opusten\u253?\ulnone . Tento doplnok vy\u382?adoval, aby KeyNote po vykonan\u237? zmeny po\u269?\u250?val ur\u269?it\u250? spr\u225?vu, aby znovu na\u269?\u237?tal skratky, a aby pou\u382?\u237?val konkr\u233?tny konfigura\u269?n\u253? s\u250?bor (keyboard.key) s obmedzen\u253?m s\u250?borom mo\u382?n\u253?ch skratiek.\par


\pard\par

Pozrite tie\u382?:\par

  {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<78|0|0"}}{\fldrslt{Preh\u318?ad kl\u225?vesnice}}}}}\cf2\f0\fs20\par

  {\cf0{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<105|4485|0|1"}}{\fldrslt{Pou\u382?\u237?vanie skratiek Ctrl-C, CTRL-V, Ctrl-X}}}}}\cf0\f0\fs20\par

\par


\pard\li360\v\'11I169\'12\v0\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:169,488,533"}}{\fldrslt {169_Clipb_21feb.png}}}}\lang1033\par


\pard\par

\par

\highlight3\lang3082\par

\highlight0\b\lang1033 Pr\u237?kazy\b0  \cf4 [2]\cf0  sa zobrazuj\u250? s celou svojou cestou (pr\u237?klad: Upravi\u357?\\Zmeni\u357? ve\u318?kos\u357? p\u237?smen\\Invertova\u357? ve\u318?kos\u357? p\u237?smen) a zoznam sa zobrazuje oddelene pod\u318?a \b typu pr\u237?kazu\b0  \cf4 [1]\cf0 :\par

Hlavn\u233? menu, kontextov\u233? menu stromu, Spusti\u357? makro, Spusti\u357? doplnok, Vlo\u382?i\u357? \u353?abl\u243?nu, Pou\u382?i\u357? \u353?t\u253?l a Pou\u382?i\u357? p\u237?smo.\par

\par

Pr\u237?kazy s\u250? uveden\u233? abecedne pod\u318?a celej cesty a mo\u382?no ich filtrova\u357? pod\u318?a textu \cf4 [3]\cf0 , pri\u269?om sa h\u318?ad\u225? v ceste a volite\u318?ne aj v popise pr\u237?kazu (Ak chcete zmeni\u357? mo\u382?nos\u357? \ul Zoh\u318?ad\u328?ova\u357? popis pri filtrovan\u237?\ulnone , kliknite prav\u253?m tla\u269?idlom na zoznam pr\u237?kazov.)\par

\par

Popis aktu\u225?lne vybran\u233?ho pr\u237?kazu a jeho priraden\u225? skratka \cf4 [4] \cf0 sa zobrazuj\u250? v oblastiach pod zoznamom.\par


\pard\li360\par


\pard\par

\par

\b\fs22 Pridanie alebo zmena existuj\u250?ceho priradenia kl\u225?ves\par

\b0\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Vyberte pr\u237?kaz v zozname \b Pr\u237?kazy\b0 .\par

{\pntext\f2\'B7\tab}Kliknite na pole \b Nov\u225? kl\u225?vesov\u225? skratka\b0  \cf4 [5]\cf0  a stla\u269?te nov\u250? kombin\u225?ciu kl\u225?vesov. Ak je kombin\u225?cia kl\u225?vesov platn\u225?, zobraz\u237? sa a z\u225?rove\u328? sa zobraz\u237? pr\u237?kaz, ktor\u253? m\u225? t\u250?to skratku skuto\u269?ne priraden\u250?.\par

{\pntext\f2\'B7\tab}Kliknut\u237?m na tla\u269?idlo \b Priradi\u357?\b0  prijmete nov\u250? kl\u225?vesov\u250? skratku.\par


\pard\sb80\sa100 Pozn\u225?mka:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Ak je nov\u225? kl\u225?vesov\u225? skratka priraden\u225? in\u233?mu pr\u237?kazu, kliknut\u237?m na Priradi\u357? sa predt\u253?m odstr\u225?ni z dan\u233?ho pr\u237?kazu, pokia\u318? nepatr\u237? do inej \b skupiny pr\u237?kazov\b0 , pri\u269?om sa ber\u250? do \u250?vahy tieto tri skupiny: Hlavn\u233? menu, Kontextov\u233? menu stromu, Ostatn\u233? pr\u237?kazy\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Rovnak\u250? skratku m\u244?\u382?ete priradi\u357? pr\u237?kazom hlavn\u233?ho menu, kontextov\u233?ho menu stromu aj pr\u237?kazom \u8222?Ostatn\u233?\u8220? (zah\u341?\u328?aj\u250?cim Spusti\u357? makro, Spusti\u357? plugin, Vlo\u382?i\u357? \u353?abl\u243?nu, Pou\u382?i\u357? \u353?t\u253?l a Pou\u382?i\u357? p\u237?smo), ale berte do \u250?vahy, \u382?e:\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720 Skratky s\u250?visiace s menu panelu stromu sa rozpoznaj\u250?, ke\u271? je fokus na paneli stromu, a maj\u250? prednos\u357? pred ostatn\u253?mi skratkami\par

{\pntext\f2\'B7\tab}Pr\u237?kazy \u8222?Ostatn\u233?\u8220? bud\u250? zdie\u318?a\u357? skratky: ak prirad\u237?te jednu skratku makru (napr.), odstr\u225?ni sa z ak\u233?hoko\u318?vek \u8222?in\u233?ho\u8220? pr\u237?kazu (napr. pluginu)\par

{\pntext\f2\'B7\tab}Skratky priraden\u233? menu (hlavn\u233?mu alebo stromu) maj\u250? prednos\u357? pred skratkami pr\u237?kazov Ostatn\u233? (makr\u225?, ...)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Hoci m\u244?\u382?ete rovnak\u250? skratku priradi\u357? \u8222?in\u233?mu\u8220? pr\u237?kazu ako ak\u233?muko\u318?vek pr\u237?kazu menu (hlavn\u233?ho alebo stromu), KeyNote v\u225?s upozorn\u237?, ak je skratka, ktor\u250? chcete priradi\u357?, priraden\u225? nejak\u233?mu pr\u237?kazu menu. T\u225?to skratka \u8222?in\u233?ho\u8220? pr\u237?kazu sa napokon zoh\u318?adn\u237? v z\u225?vislosti od fokusu (editor, strom alebo panel) a od toho, ak\u233?mu typu polo\u382?ky menu je skratka priraden\u225?.\par


\pard\par

\par

\b\fs22 Odstr\u225?nenie existuj\u250?ceho priradenia kl\u225?vesovej skratky\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Vyberte pr\u237?kaz v zozname Pr\u237?kazy a potom kliknite na tla\u269?idlo Odstr\u225?ni\u357? \cf4 [4]\cf0 .\par


\pard\li360\sb100\ul\par


\pard\sb100\b Tip\ulnone : \b0 Zmeny m\u244?\u382?ete kedyko\u318?vek zru\u353?i\u357? kliknut\u237?m na tla\u269?idlo Zru\u353?i\u357?.\par


\pard\par

\par

\par

\b\fs22 Zobrazenie zoznamu v\u353?etk\u253?ch priraden\u237? kl\u225?vesov\u253?ch skratiek\b0\par

\fs20\par

V dial\u243?govom okne kliknite na tla\u269?idlo \b Zoznam\b0 . Vygeneruje sa dokument HTML so zoznamom v\u353?etk\u253?ch aktu\u225?lne priraden\u253?ch kl\u225?vesov\u253?ch skratiek, ktor\u253? sa otvor\u237? vo va\u353?om predvolenom webovom prehliada\u269?i. (S\u250?bor sa vol\u225? \b keyboard.html\b0  a uklad\u225? sa do rovnak\u233?ho adres\u225?ra ako \b keynote.ini\b0 . Tento s\u250?bor si m\u244?\u382?ete pozrie\u357? aj mimo KeyNote.) Rozlo\u382?enie s\u250?boru je pevn\u233?, ale vzh\u318?ad riadia \u353?t\u253?ly definovan\u233? v s\u250?bore \b keyboard.css\b0 . \u218?pravou s\u250?boru CSS m\u244?\u382?ete zmeni\u357? vzh\u318?ad zoznamu kl\u225?vesov\u253?ch skratiek.\par

\par

\par

\b\fs22 Obnovenie kl\u225?vesov\u253?ch skratiek na v\u253?robn\u233? predvolen\u233? hodnoty:\b0\par

\fs20\par

V dial\u243?govom okne kliknite na tla\u269?idlo \b Obnovi\u357? v\u353?etko\b0  a potvr\u271?te kliknut\u237?m na \b OK\b0 . Alebo ukon\u269?ite KeyNote a odstr\u225?\u328?te s\u250?bor \b keyboard.ini\b0  (nach\u225?dza sa v rovnakom adres\u225?ri ako keynote.ini) (Pozri tie\u382? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<86|0|0"}}{\fldrslt{Pou\u382?\u237?vanie profilov}}}}}\f0\fs20 )\par

\par

\par

\b\fs22 Obmedzenia\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa100 Ka\u382?d\u233?mu pr\u237?kazu mo\u382?no priradi\u357? len jednu kl\u225?vesov\u250? skratku.\par

{\pntext\f2\'B7\tab}Nemo\u382?no priradi\u357? kombin\u225?cie kl\u225?vesov vr\u225?tane \cf5\b Enter\cf0\b0 , \cf5\b , \cf0\b0 , \cf5\b Space\cf0\b0 , Tab alebo kl\u225?vesu \cf5\b Esc\cf0\b0 .\par

{\pntext\f2\'B7\tab}Niektor\u233? kombin\u225?cie kl\u225?vesov s\u250? vyhraden\u233? syst\u233?mom Windows a nemo\u382?no ich priradi\u357?. Patr\u237? medzi ne napr\u237?klad \cf5\b Alt+F4\cf0\b0 .\par

{\pntext\f2\'B7\tab}Niektor\u233? \u353?tandardn\u233? kl\u225?vesov\u233? skratky syst\u233?mu Windows s\u250? zabudovan\u233? v editore RTF a v ovl\u225?da\u269?i zobrazenia stromu. Napr\u237?klad v editore stla\u269?enie \b pravej \u353?\u237?pky\b0  posunie kurzor o jednu poz\u237?ciu doprava; stla\u269?enie kl\u225?vesu \cf5\b Delete\cf0\b0  vyma\u382?e aktu\u225?lny znak; stla\u269?enie \cf5\b Ctrl+\u353?\u237?pka\cf0\b0  sko\u269?\u237? na nasleduj\u250?ce alebo predch\u225?dzaj\u250?ce slovo. Tieto skratky nemo\u382?no meni\u357?.\par


\pard\par

\par

\b\v\fs22\'11B1\'12\v0 Pou\u382?\u237?vanie skratiek Ctrl-C, CTRL-V, Ctrl-X\b0\fs20\par

\par

\lang3082 Zvy\u269?ajn\u233? kl\u225?vesy \cf5\b\lang1033 Ctrl+C\cf0\b0 , \cf5\b , Ctrl+X \cf0\b0 , \cf5\b Ctrl+V\cf0\b0\lang3082  s\u250? \b vyhraden\u233?\b0  pre kop\u237?rovanie, vkladanie a vystrihnutie. \lang1033 Priradenia uroben\u233? in\u253?m funkci\u225?m cez \u8222?Prisp\u244?sobi\u357? kl\u225?vesnicu\u8220? sa bud\u250? ignorova\u357?.\lang3082\par

\lang1033\par

Aby v paneli stromu, paneli zdrojov alebo na in\u253?ch miestach fungovali pod\u318?a o\u269?ak\u225?vania, je potrebn\u233?, aby tieto kombin\u225?cie neboli priraden\u233? skratk\u225?m. Tieto kombin\u225?cie sa preto nespravuj\u250? ako skratky polo\u382?iek menu. Namiesto toho sa zachyt\u225?vaj\u250? a interpretuj\u250? sk\u244?r. Text n\u225?povedy pri t\u253?chto polo\u382?k\u225?ch bol upraven\u253? tak, aby zobrazoval platn\u233? kombin\u225?cie.\par

\par

Ak je niektorej z t\u253?chto troch funkci\u237? (Kop\u237?rova\u357?, Vlo\u382?i\u357?, Vystrihn\u250?\u357?) priraden\u225? kombin\u225?cia kl\u225?vesov, bude tie\u382? rozpoznan\u225?. M\u244?\u382?u preto ma\u357? tri platn\u233? kombin\u225?cie. Tretia kombin\u225?cia (ne\u353?tandardn\u225?) sa v\u353?ak nebude rozpozn\u225?va\u357? pri \u250?prave n\u225?zvu uzla stromu.\par

\par

Nasleduj\u250?ce skratky, ktor\u233? sa nach\u225?dzali v ran\u253?ch verzi\u225?ch KeyNote, boli odstr\u225?nen\u233? z predvolen\u233?ho nastavenia (v\u353?etky s\u250?viseli s polo\u382?kami kontextov\u233?ho menu stromu):\par

  TVCopyNodeName  \tab (\u8222?Kop\u237?rova\u357? / N\u225?zov uzla\u8220?) Ctrl+C\par

  TVVirtualNode    \tab (\u8222?Virtu\u225?lny uzol / Vytvori\u357? virtu\u225?lny..\u8220?) Ctrl+V\par

  TVExport         \tab (\u8222?Exportova\u357?..\u8220?) Ctrl+X\par

\par

\b Alternat\u237?vne kl\u225?vesy \b0 , \cf5\b Ctrl+Ins\cf0\b0 , \cf5\b , Shift+Ins, \cf0\b0 , \cf5\b Shift+Delete\cf0\b0  sa tie\u382? interpretuj\u250? ako kop\u237?rovanie, vkladanie a vystrihnutie, ale na rozdiel od predch\u225?dzaj\u250?cich nie s\u250? vyhraden\u233?. Ak ich teda prirad\u237?te niektorej polo\u382?ke menu, m\u244?\u382?e to za ur\u269?it\u253?ch okolnost\u237? zabr\u225?ni\u357? ich interpret\u225?cii ako kop\u237?rovanie, vystrihnutie a vkladanie. Urobilo sa to tak, \u382?e boli odstr\u225?nen\u233? nasleduj\u250?ce skratky aktu\u225?lne nastaven\u233? ako predvolen\u233? (ak ste kl\u225?vesnicu neprisp\u244?sobovali vygenerovan\u237?m s\u250?boru Keyboard.ini):\par

  Vlo\u382?i\u357? n\u225?zov:       Shift+Insert\par

  Odstr\u225?ni\u357? podraden\u233?:  Shift+Delete\par

\par

Pou\u382?\u237?vanie funkci\u237? Kop\u237?rova\u357?, Vystrihn\u250?\u357? a Vlo\u382?i\u357? (z kl\u225?vesnice) je takto v\u353?eobecnej\u353?ie: mo\u382?no ho pou\u382?i\u357? aj na \u250?pravu n\u225?zvu uzla alebo v paneli zdrojov, napr\u237?klad v paneli Scratch alebo v rozba\u318?ovacom poli vyh\u318?ad\u225?vania.\par

\par

Mo\u382?no ich pou\u382?i\u357? aj na kop\u237?rovanie, vystrihnutie a vkladanie uzlov a podstromov. Je tak mo\u382?n\u233? kop\u237?rova\u357? a vklada\u357? podstromy sp\u244?sobom ekvivalentn\u253?m pr\u237?kazom Prenos podstromu.\par

Je tie\u382? mo\u382?n\u233? vystrihova\u357? a vklada\u357? uzly, \u269?o umo\u382?\u328?uje pres\u250?va\u357? uzly a podstromy v r\u225?mci s\u250?boru, nie nevyhnutne v tom istom prie\u269?inku.\par

}
