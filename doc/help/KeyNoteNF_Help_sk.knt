\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Otv\u225?ranie a ukladanie s\u250?borov KeyNote\cf2\lang1033\par

\cf0\b0\fs26\par

\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<50|107|0|2"}}{\fldrslt{Otvorenie s\u250?boru KeyNote}}}}\f0\fs20\par


\pard\sb40    {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|6489|0|6"}}{\fldrslt{Uzamknutie pri otvoren\u237?}}}}\f0\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|496|0|1"}}{\fldrslt{Spr\u225?vca s\u250?borov}}}}\f0\fs20\par


\pard    {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|2804|0|4"}}{\fldrslt{Nieko\u318?ko \u250?vah}}}}\f0\fs20\par


\pard\sb80 {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|3404|0|3"}}{\fldrslt{Ulo\u382?enie s\u250?boru KeyNote}}}}\f0\fs20\par


\pard\par

Pozri tie\u382?:\par

  {\ul{\field{\*\fldinst{HYPERLINK "file:///<52|0|0"}}{\fldrslt{Odpor\u250?\u269?ania, kedy uklada\u357? a ako vytv\u225?ra\u357? z\u225?lo\u382?n\u233? k\u243?pie}}}}\f0\fs20\par

  {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|6704|0|5"}}{\fldrslt{Dodato\u269?n\u233? pozn\u225?mky}}}}\f0\fs20\par

\par

\par

\par

\cf3\b\v\fs24\'11B2\'12\v0 Otv\u225?ranie s\u250?boru KeyNote\b0\par

\cf0\fs20\par

S\u250?bor KeyNote m\u244?\u382?ete \b otvori\u357? \b0 mnoh\u253?mi sp\u244?sobmi:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 S\u250?bor KeyNote (.knt alebo .kne) m\u244?\u382?ete otvori\u357? pomocou {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|593|0|2"}}{\fldrslt{S\u250?bor | Otvori\u357?...}}}}\f0\fs20 , tla\u269?idla na paneli n\u225?strojov \v\'11I2\'12\v0\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:2,19,19"}}{\fldrslt {2_Main_02.png}}}}\lang1033  alebo stla\u269?en\u237?m \cf4\b\fs18 Ctrl+O\cf0\b0\fs20 .\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Ve\u318?mi pohodln\u253? sp\u244?sob, ako otv\u225?ra\u357? s\u250?bory .knt, je pou\u382?i\u357? dial\u243?gov\u233? okno {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|496|0|1"}}{\fldrslt{Spr\u225?vca s\u250?borov}}}}\f0\fs20  cez ponuku S\u250?bor, tla\u269?idlo na paneli n\u225?strojov \cf5\v\f1\lang3082\'11I13\'12\cf0\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:13,18,18"}}{\fldrslt {13_Main_13.png}}}}\lang1033  alebo pomocou \cf4\b F12 \cf0\b0 skratky.\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120 S\u250?bor KeyNote m\u244?\u382?ete tie\u382? \b pretiahnu\u357?\b0  z Prieskumn\u237?ka Windows (alebo in\u253?ch programov, napr. Everything) a \b pusti\u357?\b0  ho na \u318?ubovo\u318?n\u250? oblas\u357? hlavn\u233?ho okna KeyNote vr\u225?tane panela Editor.\par

{\pntext\f5\'B7\tab}S\u250?bor m\u244?\u382?ete priamo \b otvori\u357?\b0  (dvojklikom alebo Enter) v \b Prieskumn\u237?kovi Windows\b0 , ak ste pr\u237?ponu (.knd a/alebo .knt) priradili programu KeyNote NF. Otvor\u237? sa \b nov\u225? in\u353?tancia\b0  KeyNote, v ktorej sa na\u269?\u237?ta s\u250?bor knt.\par

{\pntext\f5\'B7\tab}Rovnak\u253? v\u253?sledok ako vy\u353?\u353?ie mo\u382?no dosiahnu\u357? pridan\u237?m s\u250?boru KeyNote ako \u8222?\b Extern\u253?...\b0 " \b ob\u318?\u250?ben\u253?\b0 \u8220?. KeyNote spust\u237? \u271?al\u353?iu in\u353?tanciu a potom s\u250?bor na\u269?\u237?ta.\par

{\pntext\f5\'B7\tab}Aktu\u225?lnu \u8222?\b Polohu\b0 \u8220? m\u244?\u382?ete tie\u382? prida\u357? do otvoren\u233?ho s\u250?boru .knt ako \b ob\u318?\u250?ben\u250? polo\u382?ku\b0 . Zaka\u382?d\u253?m, ke\u271? na t\u250?to polohu prejdete, ak zodpoved\u225? in\u233?mu s\u250?boru, KeyNote zavrie aktu\u225?lny s\u250?bor, na\u269?\u237?ta s\u250?bor, na ktor\u253? poloha ukazuje, a vyberie kone\u269?n\u233? miesto ur\u269?enia (prie\u269?inok, uzol a poz\u237?ciu kurzora), pokia\u318?:\par


\pard\li720\sb80 Ak je zapnut\u225? mo\u382?nos\u357? \u8222?Otvori\u357? extern\u233? odkazy KNT v inej in\u353?tancii\u8220? {\ul{\field{\*\fldinst{HYPERLINK "file:///<95|0|0"}}{\fldrslt{mo\u382?nos\u357?}}}}\f0\fs20  alebo sa akcia \u8222?Prejs\u357? na polohu\u8220? vykon\u225? so stla\u269?en\u253?m \cf4\b Ctrl\cf0\b0  (\cf4 Ctrl+Enter\cf0  alebo \cf4 Ctrl+Dbl click\cf0 ), otvor\u237? sa v inej in\u353?tancii.\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Podobne ako pri predch\u225?dzaj\u250?com sp\u244?sobe m\u244?\u382?ete ozna\u269?i\u357? polohu v aktu\u225?lnom s\u250?bore KeyNote a vlo\u382?i\u357? t\u250?to polohu ako \b hypertextov\u253? odkaz\b0  do in\u233?ho s\u250?boru. Tento odkaz (text RTF) m\u244?\u382?ete tie\u382? skop\u237?rova\u357? a vlo\u382?i\u357? do \u318?ubovo\u318?n\u233?ho in\u233?ho s\u250?boru KeyNote alebo dokonca do panela \ul Scratch\ulnone  (pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<12|448|0|1"}}{\fldrslt{Panel zdrojov}}}}\f0\fs20 ). Tu tie\u382? m\u244?\u382?ete rozhodn\u250?\u357?, \u269?i sa odkazy na extern\u233? s\u250?bory maj\u250? otv\u225?ra\u357? v aktu\u225?lnej alebo v novej in\u353?tancii Keynote.\par


\pard\li360\sb80 Pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<38|13152|0|5"}}{\fldrslt{Vkladanie intern\u253?ch KNT odkazov}}}}\f0\fs20  a {\ul{\field{\*\fldinst{HYPERLINK "file:///<38|16878|0|10"}}{\fldrslt{Aktiv\u225?cia odkazov}}}}\f0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160\lang1035 \u268?asto sa budete spolieha\u357? na mo\u382?nos\u357? \b Na\u269?\u237?ta\u357? naposledy pou\u382?it\u253? s\u250?bor\b0  (alebo dokonca \lang1033 Na\u269?\u237?ta\u357? konkr\u233?tny s\u250?bor) (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<92|0|0"}}{\fldrslt{S\u250?bory KeyNote}}}}\f0\fs20 ), ktor\u225? umo\u382?\u328?uje KeyNote na\u269?\u237?ta\u357? naposledy otvoren\u253? s\u250?bor. M\u244?\u382?ete spusti\u357? \f2\fs18 keynote.exe\f0\fs20  alebo skratku Windows na \f2\fs18 keynote.exe\f0\fs20  a ako parameter zada\u357? s\u250?bor .ini profilu. V tomto s\u250?bore .ini (konfigura\u269?n\u253? s\u250?bor) bude zaregistrovan\u253? naposledy pou\u382?it\u253? s\u250?bor na na\u269?\u237?tanie.\lang1035\par


\pard\li360\sb40\lang1033 Pr\u237?klad:\lang1035\par


\pard\li360\sb120\f2\fs18\lang1033 "<PathToKeyNote NF>\\keynote.exe" "<PathToINIfile>\\mykeynoteINI.ini"\f0\fs20\lang1035\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\lang1033 M\u244?\u382?ete tie\u382? vyvola\u357? \f2\fs18 keynote.exe \f0\fs20 odovzdan\u237?m \b cesty \b0 k\b  s\u250?boru .knt\b0  ako \b parametra\b0 . Pr\u237?klad:\lang1035\par


\pard\li360\sb120\f2\fs18\lang1033 "<PathToKeyNote NF>\\keynote.exe" "<PathToKntFile>\\myFile.knt"\f0\fs20\par


\pard\li360\sb160  \u270?al\u353?ie parametre, ktor\u233? treba zv\u225?\u382?i\u357?, n\u225?jdete v {\ul{\field{\*\fldinst{HYPERLINK "file:///<86|0|0"}}{\fldrslt{Pou\u382?\u237?vanie profilov}}}}\f0\fs20\lang1035  a {\ul\lang1033{\field{\*\fldinst{HYPERLINK "file:///<16|0|0"}}{\fldrslt{Preh\u318?ad pr\u237?kazov\u233?ho riadka}}}}\f0\fs20 .\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Pr\u237?kaz File | \b Ned\u225?vne s\u250?bory\b0  obsahuje n\u225?zvy nieko\u318?k\u253?ch \b\lang1033 s\u250?borov \b0 pozn\u225?mok, ktor\u233? ste \b otvorili \b0 alebo\b  ned\u225?vno ulo\u382?ili\b0\lang1035 . Sta\u269?\u237? klikn\u250?\u357? na polo\u382?ku ponuky a otvor\u237? sa s\u250?bor, ktor\u253? chcete.\par


\pard\li360\sb40 \b\lang1033 Zoznam \b0 naposledy \b pou\u382?it\u253?ch s\u250?borov \b0\lang1035 je k dispoz\u237?cii aj ako rozba\u318?ovacia ponuka priamo ved\u318?a tla\u269?idla \b Otvori\u357?\b0  na paneli n\u225?strojov.\par


\pard\lang1033\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 M\u244?\u382?ete tie\u382? pou\u382?i\u357? doplnkov\u253? n\u225?stroj \b KntLauncher.exe \b0 . Umo\u382?n\u237? v\u225?m otvori\u357? konkr\u233?tny s\u250?bor v novej nez\u225?vislej in\u353?tancii KeyNote NF, pri\u269?om sa spust\u237? nov\u225? in\u353?tancia alebo sa aktivuje t\u225?, ktor\u225? ho u\u382? m\u244?\u382?e ma\u357? otvoren\u253?). (Pozrite {\ul{\field{\*\fldinst{HYPERLINK "file:///<77|0|0"}}{\fldrslt{Pou\u382?\u237?vanie .knt s\u250?borov KeyNote NF ako s\u250?borov n\u225?povedy}}}}\f0\fs20 )\par


\pard\li360\sb80\b Tip\b0 : Pomocou kntLauncher.exe m\u244?\u382?ete z\u237?ska\u357? funkciu \u8222?\b viacero in\u353?tanci\u237?, ale len jedna na s\u250?bor\b0 \u8220?: dvojkliknutie na s\u250?bor knt by malo aktivova\u357? pr\u237?slu\u353?n\u233? okno, ak je s\u250?bor u\u382? otvoren\u253?, alebo spusti\u357? \u271?al\u353?iu in\u353?tanciu Keynote, ak s\u250?bor e\u353?te otvoren\u253? nie je.\par

\b Tip\b0 : Pozrite tie\u382? {\ul{\field{\*\fldinst{HYPERLINK "file:///<50|6489|0|6"}}{\fldrslt{Uzamknutie pri otvoren\u237?}}}}\f0\fs20\par

Aby ste to dosiahli, m\u244?\u382?ete priradi\u357? pr\u237?ponu .knt k s\u250?boru .bat. Napr\u237?klad m\u244?\u382?ete vytvori\u357? s\u250?bor \u8222?kntLauncher.bat\u8220?, ktor\u253? obsahuje:\par


\pard\li720\sb120\f2\fs18 "<PathToKeyNote NF>\\kntLauncher.exe" %1 -ignSI -dnd -title%1\f0\fs20\par


\pard\par

\par

\b Tip\b0 : Mo\u382?n\u253?m pr\u237?kladom \ul otv\u225?rania s\u250?borov .knt pomocou r\u244?znych profilov\ulnone  m\u244?\u382?e by\u357? nasleduj\u250?ci postup:\par


\pard\li360\sb80 Definujte dva nov\u233? profily kop\u237?rovan\u237?m a premenovan\u237?m \f2\fs18 "<PathToKeyNote NF>\\Profiles\\Default"\f0\fs20   prie\u269?inka. M\u244?\u382?ete ich nazva\u357? napr. \u8222?F9\u8220? a \u8222?F12\u8220?, pri\u269?om ka\u382?d\u253? z nich bude nakonfigurovan\u253? na pou\u382?\u237?vanie kl\u225?vesovej skratky nazna\u269?enej n\u225?zvom (napr.: F12 => Ctrl+Shift+F12). Predvolen\u233?mu profilu by ste mali priradi\u357? in\u250? kl\u225?vesov\u250? skratku, napr. Ctrl+Shift+F8\par


\pard\li360\par

- Profil \u8222?F9\u8220? m\u244?\u382?ete pou\u382?\u237?va\u357? na be\u382?n\u233? otvorenie a pr\u225?cu so s\u250?borom .knt v\u353?eobecn\u233?ho pou\u382?itia s u\u382?ito\u269?n\u253?mi inform\u225?ciami, ktor\u233? m\u225?te v\u382?dy po ruke (\u8222?r\u244?zne pozn\u225?mky\u8220?). Tento s\u250?bor m\u244?\u382?e obsahova\u357? alarmy, ktor\u233? bud\u250? v\u382?dy pripraven\u233? na spustenie (ak je s\u250?bor v\u382?dy otvoren\u253?)\par


\pard\li360\sb80 - Profil \u8222?F12\u8220? m\u244?\u382?ete pou\u382?\u237?va\u357? na otv\u225?ranie konkr\u233?tnych s\u250?borov s\u250?visiacich s \u8222?projektmi\u8220?, na ktor\u253?ch pr\u225?ve pracujete.\par

Tieto profily (\u8222?F9\u8220? a \u8222?F12\u8220?) mo\u382?no nakonfigurova\u357? tak, aby sa in\u353?tancie Keynote sp\u250?\u353?\u357?ali minimalizovan\u233? (pozrite {\ul{\field{\*\fldinst{HYPERLINK "file:///<88|0|0"}}{\fldrslt{Mo\u382?nosti: V\u353?eobecn\u233? nastavenia}}}}\f0\fs20 ), a m\u244?\u382?ete vytvori\u357? odkazy, ktor\u233? ich otvoria pri \u353?tarte Windows:\par


\pard\li720\sb120\fs18 Ak chcete n\u225?js\u357? prie\u269?inok Po spusten\u237? aktu\u225?lneho pou\u382?\u237?vate\u318?a v syst\u233?me Windows:\par


\pard\li720\sb80 "C:\\Users\\<\i YourUser\i0 >\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"\par


\pard\li720\sb120 Pr\u237?padne m\u244?\u382?ete prie\u269?inok Po spusten\u237? otvori\u357? pomocou dial\u243?gu Spusti\u357?:\par


\pard\li1080\sb80 1. Stla\u269?en\u237?m kl\u225?vesov \u8222?Windows + R\u8220? otvor\u237?te dial\u243?gov\u233? okno Spusti\u357?.\par

2. Nap\u237?\u353?te \u8222?shell:startup\u8220? a stla\u269?te Enter.\par


\pard\li720\sb120 Ka\u382?d\u253? odkaz, ktor\u253? do tohto prie\u269?inka umiestnite, sa automaticky spust\u237? pri prihl\u225?sen\u237? do v\u225?\u353?ho pou\u382?\u237?vate\u318?sk\u233?ho \u250?\u269?tu.\par


\pard\li720\sb80 Upozor\u328?ujeme, \u382?e ak chcete, aby sa program sp\u250?\u353?\u357?al automaticky pre v\u353?etk\u253?ch pou\u382?\u237?vate\u318?ov, ktor\u237? sa prihlasuj\u250? do v\u225?\u353?ho po\u269?\u237?ta\u269?a, mali by ste odkaz programu\rquote  umiestni\u357? do prie\u269?inka Po spusten\u237? pre v\u353?etk\u253?ch pou\u382?\u237?vate\u318?ov. Ak chcete tento prie\u269?inok otvori\u357?, m\u244?\u382?ete v dial\u243?gu Spusti\u357? nap\u237?sa\u357? \u8222?shell:common\u8220? startup.\par


\pard\li360\fs20\par

- Predvolen\u253? profil by mal by\u357? nakonfigurovan\u253? tak, aby sa nesp\u250?\u353?\u357?al minimalizovan\u253?. V\u382?dy, ke\u271? otvor\u237?te s\u250?bor .knt dvojit\u253?m kliknut\u237?m, pomocou panela Ob\u318?\u250?ben\u233? alebo kliknut\u237?m na odkaz v akomko\u318?vek s\u250?bore Keynote, otvor\u237? sa s t\u253?mto predvolen\u253?m profilom.\par


\pard\li360\sb40 T\u253?mto sp\u244?sobom bude spusten\u253? s\u250?bor .knt vidite\u318?n\u253? a pripraven\u253? na pou\u382?itie v tretej, samostatnej in\u353?tancii.\par


\pard\li360\par


\pard\par

\b Pozn\u225?mka: \b0 Ak m\u225?te v po\u269?\u237?ta\u269?i viacero verzi\u237? Keynote.exe, uistite sa, \u382?e otvorenie aplik\u225?cie dvojit\u253?m kliknut\u237?m na s\u250?bor .knt otvor\u237? spr\u225?vnu verziu. Ak ste najnov\u353?iu verziu KeyNote NF nain\u353?talovali pomocou in\u353?tal\u225?tora, mali ste mo\u382?nos\u357? zaregistrova\u357? pr\u237?pony .knt, .kne, .knl a .knm pre t\u250?to verziu.\par

\par

\par

\cf3\b\v\f3\fs22\'11B6\'12\v0 Uzamknutie pri otv\u225?ran\u237?\cf0\b0\f0\par

\fs20\par

KeyNote obsahuje mo\u382?nos\u357? (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<92|0|0"}}{\fldrslt{S\u250?bory KeyNote}}}}\f0\fs20 ) s n\u225?zvom \u8222?Uzamknutie pri otv\u225?ran\u237?\u8220?. Ak je povolen\u225?, pri otvoren\u237? sa pok\u250?si uzamkn\u250?\u357? s\u250?bor, \u269?\u237?m zabr\u225?ni in\u253?m pou\u382?\u237?vate\u318?om (alebo procesom patriacim tomu ist\u233?mu pou\u382?\u237?vate\u318?ovi) upravova\u357? s\u250?bor s\u250?\u269?asne. T\u225?to mo\u382?nos\u357? umo\u382?\u328?uje bezpe\u269?nej\u353?iu t\u237?mov\u250? pr\u225?cu.\par


\pard\sb80 Pri otv\u225?ran\u237? s\u250?boru uzamknut\u233?ho in\u253?m pou\u382?\u237?vate\u318?om/procesom sa zobraz\u237? upozornenie, ktor\u233? v\u225?m umo\u382?n\u237? pokra\u269?ova\u357? v re\u382?ime len na \u269?\u237?tanie. Ka\u382?d\u253? pokus o ulo\u382?enie do uzamknut\u233?ho s\u250?boru bude ohl\u225?sen\u253? a automaticky sa prepne na re\u382?im len na \u269?\u237?tanie (pou\u382?ite \u8222?Ulo\u382?i\u357? ako\u8220?).\par


\pard\par

KeyNote sleduje zmeny s\u250?borov a uvo\u318?nenie uzamknutia prostredn\u237?ctvom syst\u233?mu (pomocou Advanced/Folder Monitor). \u270?al\u353?ia mo\u382?nos\u357? \u8222?Kontrolova\u357? uvo\u318?nenie/zmenu s\u250?boru\u8220? zais\u357?uje, \u382?e tieto zmeny bud\u250? zisten\u233? aspo\u328? ka\u382?d\u253?ch nieko\u318?ko min\u250?t, ak ich syst\u233?m neohl\u225?si.\par

\par

Pozrite tie\u382? {\ul{\field{\*\fldinst{HYPERLINK "file:///<83|0|0"}}{\fldrslt{Zdie\u318?anie KeyNote vo viacpou\u382?\u237?vate\u318?skom syst\u233?me}}}}\f0\fs20\par

\par

\par

\cf3\b\v\f3\fs22\'11B1\'12\v0 Spr\u225?vca s\u250?borov\cf0\b0\f0\par

\fs20\par

KeyNote m\u225? jednoduch\u233?ho spr\u225?vcu s\u250?borov, ktor\u253? v\u225?m umo\u382?n\u237? r\u253?chlo otvori\u357? s\u250?bor, ktor\u253? ste u\u382? predt\u253?m pou\u382?ili. Stla\u269?en\u237?m \cf4\b\lang1035 F12\cf0\b0\lang1033  otvor\u237?te okno spr\u225?vcu s\u250?borov.\par

\par

Dial\u243?gov\u233? okno Spr\u225?vca s\u250?borov zobrazuje zoznam v\u353?etk\u253?ch \b s\u250?borov\b0  KeyNote, ktor\u233? ste \b pou\u382?ili\b0 , pri\u269?om \b ch\u253?baj\u250?ce s\u250?bory\b0  sa automaticky \b odstr\u225?nia\b0 , ako s\u250? evidovan\u233? v pridru\u382?enom s\u250?bore (.MGR). Pozrite tie\u382? {\ul{\field{\*\fldinst{HYPERLINK "file:///<18|0|0"}}{\fldrslt{Pomocn\u233? s\u250?bory}}}}\f0\fs20\par

Pre ka\u382?d\u253? s\u250?bor sa zobrazuje jeho popis, koment\u225?re a \u271?al\u353?ie metad\u225?ta, tak\u382?e ich m\u244?\u382?ete \u318?ahko identifikova\u357?:\par

\par


\pard\li360\v\'11I160\'12\v0\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:160,442,246"}}{\fldrslt {160_Clipb_22ene.png}}}}\lang1033\par


\pard\par

Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ve\u318?kos\u357? dial\u243?gov\u233?ho okna m\u244?\u382?ete zmeni\u357?\par

{\pntext\f5\'B7\tab}M\u244?\u382?ete zobrazi\u357? iba n\u225?zvy s\u250?borov alebo ich \u250?pln\u250? cestu.\par

{\pntext\f5\'B7\tab}Zobrazen\u233?  s\u250?bory Inform\u225?cie pou\u382?it\u233? na \par


\pard\par

\b Tip\b0 : S\u250?bor m\u244?\u382?ete vybra\u357? nap\u237?san\u237?m prv\u253?ch nieko\u318?k\u253?ch p\u237?smen jeho n\u225?zvu.\par

\par

\par

\cf3\b\f3\fs22 Nieko\u318?ko \v\'11B4\'12\v0 pozn\u225?mok\cf0\b0\f0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80 Upozor\u328?ujeme, \u382?e ak nevid\u237?te pr\u225?ve otvoren\u253? s\u250?bor, m\u244?\u382?e to by\u357? sp\u244?soben\u233? t\u253?m, \u382?e je povolen\u225? mo\u382?nos\u357? \b Spusti\u357? program minimalizovan\u253?\b0  (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<88|0|0"}}{\fldrslt{Mo\u382?nosti: V\u353?eobecn\u233? nastavenia}}}}\f0\fs20 ).\par

{\pntext\f5\'B7\tab}Niektor\u233? z vy\u353?\u353?ie op\u237?san\u253?ch sp\u244?sobov zatvoria aktu\u225?lny s\u250?bor pred otvoren\u237?m nov\u233?ho s\u250?boru. V tak\u253?ch pr\u237?padoch, ak \b aktu\u225?lny s\u250?bor obsahuje zmeny\b0 , KeyNote s\u250?bor automaticky ulo\u382?\u237? alebo vyzve na ulo\u382?enie zmien v z\u225?vislosti od {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|3021|0|9"}}{\fldrslt{Automatick\u233? ukladanie}}}}\f0\fs20 mo\u382?nosti.\par

{\pntext\f5\'B7\tab}Pr\u237?padne niektor\u233? z vy\u353?\u353?ie op\u237?san\u253?ch sp\u244?sobov nezatvoria aktu\u225?lny s\u250?bor pred otvoren\u237?m nov\u233?ho s\u250?boru. Len spustia \b \u271?al\u353?iu in\u353?tanciu\b0  programu Keynote, v ktorej sa na\u269?\u237?ta vybran\u253? s\u250?bor .knt. Upozor\u328?ujeme, \u382?e to vy\u382?aduje, aby sp\u250?\u353?\u357?an\u225? in\u353?tancia (pod\u318?a svojho s\u250?boru .INI) mala povolen\u250? mo\u382?nos\u357? \b Povoli\u357?\f4  \f0 len\f4  \f0 jednu\f4  \f0 in\u353?tanciu\b0  (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<88|0|0"}}{\fldrslt{V\u353?eobecn\u233? nastavenia}}}}\f0\fs20 ). Upozor\u328?ujeme tie\u382?, \u382?e t\u225?to mo\u382?nos\u357? je predvolene zak\u225?zan\u225? (aby sa zabr\u225?nilo tomu, \u382?e za\u269?\u237?naj\u250?ci pou\u382?\u237?vatelia by mohli otvori\u357? a upravi\u357? ten ist\u253? s\u250?bor .knt z nieko\u318?k\u253?ch in\u353?tanci\u237? s\u250?\u269?asne)\par


\pard\li360\sb80 Ke\u271? in\u353?tancia s touto mo\u382?nos\u357?ou zak\u225?zanou zist\u237?, \u382?e je u\u382? otvoren\u225? in\u225? in\u353?tancia KeyNote, zobraz\u237? upozornenie, zavrie sa a aktivuje druh\u250? in\u353?tanciu.\par


\pard\par

\par

\par

\cf3\b\v\fs24\'11B3\'12\v0 Ukladanie s\u250?boru KeyNote\b0\par

\cf0\fs20\par

Aktu\u225?lne otvoren\u253? s\u250?bor KeyNote mo\u382?no \b ulo\u382?i\u357?\b0  r\u244?znymi sp\u244?sobmi:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Aktu\u225?lny s\u250?bor KeyNote m\u244?\u382?ete kedyko\u318?vek manu\u225?lne ulo\u382?i\u357? na disk pomocou {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|1742|0|3"}}{\fldrslt{S\u250?bor | Ulo\u382?i\u357?...}}}}\f0\fs20 , tla\u269?idla na paneli n\u225?strojov \v\'11I3\'12\v0\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:3,18,18"}}{\fldrslt {3_Main_03.png}}}}\lang1033  alebo stla\u269?en\u237?m \cf4\b\fs18 Ctrl+S\cf0\b0\fs20 .\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120 S\u250?bor sa ulo\u382?\u237? automaticky, ak je povolen\u225? {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|3021|0|9"}}{\fldrslt{Automatick\u233? ukladanie}}}}\f0\fs20 mo\u382?nos\u357?, s\u250?bor obsahuje zmeny a..\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li720 Od posledn\u233?ho ulo\u382?enia uplynulo viac ako [n] min\u250?t a je povolen\u225? mo\u382?nos\u357? \cf6\b Ka\u382?d\u253?ch [n] min\u250?t\cf0\b0 \par

{\pntext\f5\'B7\tab}Prepli ste do inej aplik\u225?cie a je povolen\u225? mo\u382?nos\u357? \cf6\b Pri prepnut\u237? do inej aplik\u225?cie\cf0\b0 \par

{\pntext\f5\'B7\tab}S\u250?bor zatv\u225?rate explicitne (napr. \cf4\b\fs18 Ctrl+Q\cf0\b0\fs20 ) alebo z d\u244?vodu otvorenia in\u233?ho s\u250?boru .knt.\par


\pard\par


\pard\fi-760\li1120\b *\b0  Pozn\u225?mka: Ak je zak\u225?zan\u225? mo\u382?nos\u357? \ul Automatick\u233? ukladanie\ulnone  a s\u250?bor obsahuje zmeny, KeyNote v\u382?dy, ke\u271? vyvol\u225?te pr\u237?kaz, ktor\u253? by pri neulo\u382?en\u237? s\u250?boru sp\u244?sobil stratu \u250?dajov, vyzve na ulo\u382?enie zmien. \par


\pard\li360\sb120 Pozrite tie\u382? {\ul{\field{\*\fldinst{HYPERLINK "file:///<92|0|0"}}{\fldrslt{Mo\u382?nosti: S\u250?bory KeyNote}}}}\f0\fs20\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Aktu\u225?lny s\u250?bor KeyNote m\u244?\u382?ete tie\u382? manu\u225?lne ulo\u382?i\u357? na disk pod nov\u253?m n\u225?zvom pomocou {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|1909|0|4"}}{\fldrslt{S\u250?bor | Ulo\u382?i\u357? ako...}}}}\f0\fs20\par


\pard\li360\sb40 Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li720 M\u244?\u382?ete zmeni\u357? n\u225?zov s\u250?boru aj jeho umiestnenie (disk a/alebo prie\u269?inok).\par

{\pntext\f5\'B7\tab}Aktu\u225?lny s\u250?bor zostane nezmenen\u253?. Na\u269?\u237?ta sa novovytvoren\u253? s\u250?bor, tak\u382?e v \u250?prav\u225?ch m\u244?\u382?ete pokra\u269?ova\u357?.\par

{\pntext\f5\'B7\tab}\ul D\u244?le\u382?it\u233?\ulnone : ak s\u250?bor \b obsahoval zmeny predt\u253?m\b0 , ako ste spustili \ul Ulo\u382?i\u357? ako\ulnone , novovytvoren\u253? s\u250?bor tieto zmeny bude obsahova\u357?, ale p\u244?vodn\u253? s\u250?bor nie.\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Aktu\u225?lny s\u250?bor KeyNote m\u244?\u382?ete tie\u382? ulo\u382?i\u357? na disk ako k\u243?piu so zachovan\u237?m jeho n\u225?zvu a do in\u233?ho prie\u269?inka pomocou {\ul{\field{\*\fldinst{HYPERLINK "file:///<109|5817|0|14"}}{\fldrslt{S\u250?bor | Kop\u237?rova\u357? do...}}}}\f0\fs20\par


\pard\li360\sb80 Na rozdiel od \ul Ulo\u382?i\u357? ako...\ulnone , ak s\u250?bor \b obsahoval zmeny predt\u253?m\b0 , ako ste spustili \ul Kop\u237?rova\u357? do...\ulnone , novovytvoren\u253? s\u250?bor (z\u225?loha) tieto zmeny bude obsahova\u357?, ale p\u244?vodn\u253? s\u250?bor, ktor\u253? zostane na\u269?\u237?tan\u253?, bude st\u225?le v upravenom stave so zmenami, ktor\u233? treba ulo\u382?i\u357?.\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb200 Pam\u228?tajte, \u382?e kedyko\u318?vek m\u244?\u382?ete vytvori\u357? k\u243?piu aktu\u225?lneho s\u250?boru pomocou \b Export...\b0  Tento mechanizmus v\u225?m umo\u382?\u328?uje ulo\u382?i\u357? cel\u253? s\u250?bor .knt, v\u253?ber prie\u269?inkov alebo len v\u253?ber uzlov.\par


\pard\li360\sb40 Pozrite {\ul{\field{\*\fldinst{HYPERLINK "file:///<57|3327|0|3"}}{\fldrslt{Export pozn\u225?mok do KNT (KeyNote NF)}}}}\f0\fs20\par

\par

\par


\pard Pozrite tie\u382?: {\ul{\field{\*\fldinst{HYPERLINK "file:///<53|0|0"}}{\fldrslt{Z\u225?lohovanie v pravideln\u253?ch intervaloch}}}}\f0\fs20\par


\pard\sb40\par


\pard\par

\par

\cf3\b\v\fs22\'11B5\'12\v0 \u270?al\u353?ie pozn\u225?mky\cf0\b0\fs20\par

\par

V {\ul{\field{\*\fldinst{HYPERLINK "file:///<54|0|0"}}{\fldrslt{Form\u225?ty s\u250?borov v KeyNote}}}}\f0\fs20  m\u244?\u382?ete vidie\u357? niektor\u233? merania, ktor\u233? som urobil pri porovn\u225?van\u237? ve\u318?kost\u237? a \u269?asov (pri ukladan\u237? a na\u269?\u237?tavan\u237?) medzi r\u244?znymi form\u225?tmi s\u250?borov v KeyNote NF, aby ste sa mohli rozhodn\u250?\u357?, ktor\u253? form\u225?t m\u244?\u382?e by\u357? v z\u225?vislosti od okolnost\u237? najvhodnej\u353?\u237?.\par

\par

V {\ul{\field{\*\fldinst{HYPERLINK "file:///<55|0|0"}}{\fldrslt{fileformat.txt}}}}\f0\fs20  m\u244?\u382?ete vidie\u357?, ako s\u250? \u250?daje ulo\u382?en\u233? v s\u250?boroch KeyNote NF.\par

\par

}
