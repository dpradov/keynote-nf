\pard\keepn\sb100\sa100\qc\kerning36\b\f1\fs40\lang3082 Mozilla Public License\line Verzia 2.0\par


\pard\keepn\li120\sb120\sa100\kerning0\fs30 1. Defin\u237?cie\par


\pard\li120\sb100\sa100\b0\fs20 1.1. \ldblquote Prispievate\u318?\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? ka\u382?d\u250? fyzick\u250? osobu alebo pr\u225?vnick\u250? osobu, ktor\u225? vytv\u225?ra, prispieva k vytv\u225?raniu alebo vlastn\u237? Chr\u225?nen\u253? softv\u233?r.\par


\pard\li120\sb100\sa100 1.2. \ldblquote Verzia prispievate\u318?a\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? kombin\u225?ciu Pr\u237?spevkov in\u253?ch (ak existuj\u250?) pou\u382?it\u253?ch prispievate\u318?om a Pr\u237?spevku dan\u233?ho prispievate\u318?a\rquote .\par


\pard\li120\sb100\sa100 1.3. \ldblquote Pr\u237?spevok\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? Chr\u225?nen\u253? softv\u233?r konkr\u233?tneho prispievate\u318?a.\par


\pard\li120\sb100\sa100 1.4. \ldblquote Chr\u225?nen\u253? softv\u233?r\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? Formu zdrojov\u233?ho k\u243?du, ku ktorej po\u269?iato\u269?n\u253? prispievate\u318? pripojil ozn\u225?menie v Pr\u237?lohe A, Spustite\u318?n\u250? formu takejto Formy zdrojov\u233?ho k\u243?du a \u218?pravy takejto Formy zdrojov\u233?ho k\u243?du, v ka\u382?dom pr\u237?pade vr\u225?tane ich \u269?ast\u237?.\par


\pard\li120\sb100\sa100 1.5. \ldblquote Nekompatibiln\u253? so Sekund\u225?rnymi licenciami\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225?\par


\pard 
{\pntext\f1 1.\tab}{\*\pn\pnlvlbody\pnf1\pnindent0\pnstart1\pndec{\pntxta.}}
\fi-360\li1200\sb100\sa100 \u382?e po\u269?iato\u269?n\u253? prispievate\u318? pripojil k Chr\u225?nen\u233?mu softv\u233?ru ozn\u225?menie op\u237?san\u233? v Pr\u237?lohe B; alebo\par

{\pntext\f1 2.\tab}\u382?e Chr\u225?nen\u253? softv\u233?r bol spr\u237?stupnen\u253? za podmienok verzie 1.1 alebo skor\u353?ej verzie licencie, ale nie aj za podmienok Sekund\u225?rnej licencie.\par


\pard\fi-360\li360\sb100\sa100 1.6. \ldblquote Spustite\u318?n\u225? forma\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? ak\u250?ko\u318?vek formu diela okrem Formy zdrojov\u233?ho k\u243?du.\par


\pard\li120\sb100\sa100 1.7. \ldblquote V\u228?\u269?\u353?ie dielo\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? dielo, ktor\u233? kombinuje Chr\u225?nen\u253? softv\u233?r s in\u253?m materi\u225?lom v samostatnom s\u250?bore alebo s\u250?boroch, ktor\u253? nie je Chr\u225?nen\u253?m softv\u233?rom.\par


\pard\li120\sb100\sa100 1.8. \ldblquote Licencia\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? tento dokument.\par


\pard\li120\sb100\sa100 1.9. \ldblquote Licencovate\u318?n\u253?\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? ma\u357? pr\u225?vo udeli\u357? v maxim\u225?lnom mo\u382?nom rozsahu, \u269?i u\u382? v \u269?ase p\u244?vodn\u233?ho udelenia alebo n\u225?sledne, ak\u233?ko\u318?vek a v\u353?etky pr\u225?va vypl\u253?vaj\u250?ce z tejto licencie.\par


\pard\li120\sb100\sa100 1.10. \ldblquote \u218?pravy\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? ktor\u250?ko\u318?vek z nasleduj\u250?cich mo\u382?nost\u237?:\par


\pard 
{\pntext\f1 1.\tab}{\*\pn\pnlvlbody\pnf1\pnindent0\pnstart1\pndec{\pntxta.}}
\fi-360\li1200\sb100\sa100 ak\u253?ko\u318?vek s\u250?bor vo Forme zdrojov\u233?ho k\u243?du, ktor\u253? vznikne pridan\u237?m k obsahu Chr\u225?nen\u233?ho softv\u233?ru, odstr\u225?nen\u237?m z neho alebo jeho \u250?pravou; alebo\par

{\pntext\f1 2.\tab}ak\u253?ko\u318?vek nov\u253? s\u250?bor vo Forme zdrojov\u233?ho k\u243?du, ktor\u253? obsahuje ak\u253?ko\u318?vek Chr\u225?nen\u253? softv\u233?r.\par


\pard\fi-360\li360\sb100\sa100 1.11. \ldblquote Patentov\u233? n\u225?roky\rdblquote  prispievate\u318?a \par


\pard\li480\sb100\sa100 znamen\u225? ak\u253?ko\u318?vek patentov\u253? n\u225?rok (n\u225?roky), vr\u225?tane bez obmedzenia n\u225?rokov na sp\u244?sob, postup a zariadenie, v akomko\u318?vek patente, ktor\u253? tento prispievate\u318? m\u244?\u382?e licencova\u357? a ktor\u253? by bez udelenia licencie poru\u353?ila v\u253?roba, pou\u382?\u237?vanie, predaj, pon\u250?kanie na predaj, d\u225?va\u357? vyr\u225?ba\u357?, dovoz alebo prevod bu\u271? jeho Pr\u237?spevkov, alebo jeho Verzie prispievate\u318?a.\par


\pard\li120\sb100\sa100 1.12. \ldblquote Sekund\u225?rna licencia\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? bu\u271? GNU General Public License verzie 2.0, GNU Lesser General Public License verzie 2.1, GNU Affero General Public License verzie 3.0, alebo ak\u233?ko\u318?vek neskor\u353?ie verzie t\u253?chto licenci\u237?.\par


\pard\li120\sb100\sa100 1.13. \ldblquote Forma zdrojov\u233?ho k\u243?du\rdblquote  \par


\pard\li480\sb100\sa100 znamen\u225? formu diela uprednost\u328?ovan\u250? na vykon\u225?vanie \u250?prav.\par


\pard\li120\sb100\sa100 1.14. \ldblquote Vy\rdblquote  (alebo \ldblquote V\u225?\u353?\rdblquote ) \par


\pard\li480\sb100\sa100 znamen\u225? fyzick\u250? osobu alebo pr\u225?vnick\u250? osobu vykon\u225?vaj\u250?cu pr\u225?va pod\u318?a tejto licencie. Pri pr\u225?vnick\u253?ch osob\u225?ch \ldblquote Vy\rdblquote  zah\u341?\u328?a ka\u382?d\u250? osobu, ktor\u225? kontroluje V\u225?s, je kontrolovan\u225? Vami alebo je pod spolo\u269?nou kontrolou s Vami. Na \u250?\u269?ely tejto defin\u237?cie \ldblquote kontrola\rdblquote  znamen\u225? (a) pr\u225?vomoc priamo alebo nepriamo ur\u269?ova\u357? smerovanie alebo riadenie takejto osoby, \u269?i u\u382? na z\u225?klade zmluvy alebo inak, alebo (b) vlastn\u237?ctvo viac ako p\u228?\u357?desiatich percent (50 %) vydan\u253?ch akci\u237? alebo majetkov\u233?ho podielu v takejto osobe.\par


\pard\keepn\li120\sb120\sa100\b\fs30 2. Udelenie licencie a podmienky\par


\pard\keepn\li120\sb100\fs24 2.1. Udelenie pr\u225?v\par


\pard\li120\sb100\sa100\b0\fs20 Ka\u382?d\u253? prispievate\u318? t\u253?mto ude\u318?uje V\u225?m celosvetov\u250?, bezodplatn\u250? a nev\u253?hradn\u250? licenciu:\par


\pard 
{\pntext\f1 1.\tab}{\*\pn\pnlvlbody\pnf1\pnindent360\pnstart1\pndec{\pntxta.}}
\fi-360\li840\sb100\sa100 na z\u225?klade pr\u225?v du\u353?evn\u233?ho vlastn\u237?ctva (in\u253?ch ako patentov\u233? pr\u225?va alebo pr\u225?va k ochrann\u253?m zn\u225?mkam), ktor\u233? tento prispievate\u318? m\u244?\u382?e licencova\u357?, u\u382?\u237?va\u357?, reprodukova\u357?, spr\u237?stup\u328?ova\u357?, upravova\u357?, zobrazova\u357?, predv\u225?dza\u357?, distribuova\u357? a inak vyu\u382?\u237?va\u357? svoje Pr\u237?spevky, \u269?i u\u382? v nezmenenej podobe, s \u218?pravami alebo ako s\u250?\u269?as\u357? V\u228?\u269?\u353?ieho diela; a\par

{\pntext\f1 2.\tab}na z\u225?klade Patentov\u253?ch n\u225?rokov tohto prispievate\u318?a vyr\u225?ba\u357?, pou\u382?\u237?va\u357?, pred\u225?va\u357?, pon\u250?ka\u357? na predaj, d\u225?va\u357? vyr\u225?ba\u357?, dov\u225?\u382?a\u357? a inak prev\u225?dza\u357? bu\u271? jeho Pr\u237?spevky, alebo jeho Verziu prispievate\u318?a.\par


\pard\keepn\li120\sb100\b\fs24 2.2. D\u225?tum \u250?\u269?innosti\par


\pard\li120\sb100\sa100\b0\fs20 Licencie udelen\u233? v \u269?l\u225?nku 2.1 sa vo vz\u357?ahu k ak\u233?muko\u318?vek Pr\u237?spevku st\u225?vaj\u250? \u250?\u269?inn\u253?mi pre ka\u382?d\u253? Pr\u237?spevok d\u328?om, ke\u271? prispievate\u318? tak\u253?to Pr\u237?spevok prv\u253?kr\u225?t distribuuje.\par


\pard\keepn\li120\sb100\b\fs24 2.3. Obmedzenia rozsahu udelenia\par


\pard\li120\sb100\sa100\b0\fs20 Licencie udelen\u233? v tomto \u269?l\u225?nku 2 s\u250? jedin\u253?mi pr\u225?vami udelen\u253?mi pod\u318?a tejto licencie. Z distrib\u250?cie alebo licencovania Chr\u225?nen\u233?ho softv\u233?ru pod\u318?a tejto licencie sa nevyvodzuj\u250? \u382?iadne \u271?al\u353?ie pr\u225?va ani licencie. Bez oh\u318?adu na vy\u353?\u353?ie uveden\u253? \u269?l\u225?nok 2.1(b) prispievate\u318? neude\u318?uje \u382?iadnu patentov\u250? licenciu:\par


\pard 
{\pntext\f1 1.\tab}{\*\pn\pnlvlbody\pnf1\pnindent360\pnstart1\pndec{\pntxta.}}
\fi-360\li840\sb100\sa100 na ak\u253?ko\u318?vek k\u243?d, ktor\u253? prispievate\u318? odstr\u225?nil z Chr\u225?nen\u233?ho softv\u233?ru; alebo\par

{\pntext\f1 2.\tab}na poru\u353?enia sp\u244?soben\u233?: (i) \u250?pravami Chr\u225?nen\u233?ho softv\u233?ru Vami a akouko\u318?vek inou tre\u357?ou stranou\rquote , alebo (ii) kombin\u225?ciou jeho Pr\u237?spevkov s in\u253?m softv\u233?rom (okrem pr\u237?padu, ke\u271? ide o s\u250?\u269?as\u357? jeho Verzie prispievate\u318?a); alebo\par

{\pntext\f1 3.\tab}na z\u225?klade Patentov\u253?ch n\u225?rokov poru\u353?en\u253?ch Chr\u225?nen\u253?m softv\u233?rom v pr\u237?pade neexistencie jeho Pr\u237?spevkov.\par


\pard\fi-360\li360\sb100\sa100 T\u225?to licencia neude\u318?uje \u382?iadne pr\u225?va k ochrann\u253?m zn\u225?mkam, zn\u225?mkam slu\u382?ieb ani log\u225?m \u382?iadneho prispievate\u318?a (okrem toho, \u269?o m\u244?\u382?e by\u357? nevyhnutn\u233? na splnenie po\u382?iadaviek na ozn\u225?menia pod\u318?a \u269?l\u225?nku 3.4).\par


\pard\keepn\li120\sb100\b\fs24 2.4. N\u225?sledn\u233? licencie\par


\pard\li120\sb100\sa100\b0\fs20 \u381?iadny prispievate\u318? neude\u318?uje \u271?al\u353?ie pr\u225?va na z\u225?klade Va\u353?ej vo\u318?by distribuova\u357? Chr\u225?nen\u253? softv\u233?r pod\u318?a neskor\u353?ej verzie tejto licencie (pozri \u269?l\u225?nok 10.2) alebo pod\u318?a podmienok Sekund\u225?rnej licencie (ak to podmienky \u269?l\u225?nku 3.3 umo\u382?\u328?uj\u250?).\par


\pard\keepn\li120\sb100\b\fs24 2.5. Vyhl\u225?senie\par


\pard\li120\sb100\sa100\b0\fs20 Ka\u382?d\u253? prispievate\u318? vyhlasuje, \u382?e sa domnieva, \u382?e jeho Pr\u237?spevky s\u250? jeho p\u244?vodn\u253?m vytvoren\u253?m dielom, alebo \u382?e m\u225? dostato\u269?n\u233? pr\u225?va na udelenie pr\u225?v k svojim Pr\u237?spevkom pod\u318?a tejto licencie.\par


\pard\keepn\li120\sb100\b\fs24 2.6. Primeran\u233? pou\u382?itie\par


\pard\li120\sb100\sa100\b0\fs20 T\u225?to licencia nem\u225? za cie\u318? obmedzi\u357? \u382?iadne pr\u225?va, ktor\u233? m\u225?te pod\u318?a platn\u253?ch doktr\u237?n autorsk\u233?ho pr\u225?va o primeranom pou\u382?it\u237?, primeranom zaobch\u225?dzan\u237? alebo in\u253?ch ekvivalentoch.\par


\pard\keepn\li120\sb100\b\fs24 2.7. Podmienky\par


\pard\li120\sb100\sa100\b0\fs20 \u268?l\u225?nky 3.1, 3.2, 3.3 a 3.4 s\u250? podmienkami licenci\u237? udelen\u253?ch v \u269?l\u225?nku 2.1.\par


\pard\keepn\li120\sb120\sa100\b\fs30 3. Zodpovednosti\par


\pard\keepn\li120\sb100\fs24 3.1. Distrib\u250?cia Formy zdrojov\u233?ho k\u243?du\par


\pard\li120\sb100\sa100\b0\fs20 V\u353?etka distrib\u250?cia Chr\u225?nen\u233?ho softv\u233?ru vo Forme zdrojov\u233?ho k\u243?du, vr\u225?tane ak\u253?chko\u318?vek \u218?prav, ktor\u233? vytvor\u237?te alebo ku ktor\u253?m prispejete, mus\u237? prebieha\u357? pod\u318?a podmienok tejto licencie. Pr\u237?jemcov mus\u237?te informova\u357? o tom, \u382?e Forma zdrojov\u233?ho k\u243?du Chr\u225?nen\u233?ho softv\u233?ru sa riadi podmienkami tejto licencie, a o tom, ako m\u244?\u382?u z\u237?ska\u357? k\u243?piu tejto licencie. Nesmiete sa pok\u250?\u353?a\u357? meni\u357? ani obmedzova\u357? pr\u225?va pr\u237?jemcov\rquote  k Forme zdrojov\u233?ho k\u243?du.\par


\pard\keepn\li120\sb100\b\fs24 3.2. Distrib\u250?cia Spustite\u318?nej formy\par


\pard\li120\sb100\sa100\b0\fs20 Ak distribuujete Chr\u225?nen\u253? softv\u233?r v Spustite\u318?nej forme, potom:\par


\pard 
{\pntext\f1 1.\tab}{\*\pn\pnlvlbody\pnf1\pnindent360\pnstart1\pndec{\pntxta.}}
\fi-360\li840\sb100\sa100 tento Chr\u225?nen\u253? softv\u233?r mus\u237? by\u357? dostupn\u253? aj vo Forme zdrojov\u233?ho k\u243?du, ako je op\u237?san\u233? v \u269?l\u225?nku 3.1, a pr\u237?jemcov Spustite\u318?nej formy mus\u237?te informova\u357? o tom, ako m\u244?\u382?u z\u237?ska\u357? k\u243?piu takejto Formy zdrojov\u233?ho k\u243?du primeran\u253?mi prostriedkami a v primeranom \u269?ase, za poplatok neprevy\u353?uj\u250?ci n\u225?klady na distrib\u250?ciu pr\u237?jemcovi; a\par

{\pntext\f1 2.\tab}t\u250?to Spustite\u318?n\u250? formu m\u244?\u382?ete distribuova\u357? pod\u318?a podmienok tejto licencie alebo ju sublicencova\u357? za odli\u353?n\u253?ch podmienok, za predpokladu, \u382?e licencia pre Spustite\u318?n\u250? formu sa nepok\u250?\u353?a obmedzi\u357? ani zmeni\u357? pr\u225?va pr\u237?jemcov\rquote  k Forme zdrojov\u233?ho k\u243?du pod\u318?a tejto licencie.\par


\pard\keepn\li120\sb100\b\fs24 3.3. Distrib\u250?cia V\u228?\u269?\u353?ieho diela\par


\pard\li120\sb100\sa100\b0\fs20 V\u228?\u269?\u353?ie dielo m\u244?\u382?ete vytv\u225?ra\u357? a distribuova\u357? za podmienok pod\u318?a vlastn\u233?ho v\u253?beru, za predpokladu, \u382?e tie\u382? spln\u237?te po\u382?iadavky tejto licencie t\u253?kaj\u250?ce sa Chr\u225?nen\u233?ho softv\u233?ru. Ak je V\u228?\u269?\u353?ie dielo kombin\u225?ciou Chr\u225?nen\u233?ho softv\u233?ru s dielom riaden\u253?m jednou alebo viacer\u253?mi Sekund\u225?rnymi licenciami a Chr\u225?nen\u253? softv\u233?r nie je Nekompatibiln\u253? so Sekund\u225?rnymi licenciami, t\u225?to licencia V\u225?m umo\u382?\u328?uje dodato\u269?ne distribuova\u357? tak\u253?to Chr\u225?nen\u253? softv\u233?r pod\u318?a podmienok takejto Sekund\u225?rnej licencie (licenci\u237?), tak\u382?e pr\u237?jemca V\u228?\u269?\u353?ieho diela m\u244?\u382?e pod\u318?a svojej vo\u318?by \u271?alej distribuova\u357? Chr\u225?nen\u253? softv\u233?r pod\u318?a podmienok tejto licencie alebo takejto Sekund\u225?rnej licencie (licenci\u237?).\par


\pard\keepn\li120\sb100\b\fs24 3.4. Upozornenia\par


\pard\li120\sb100\sa100\b0\fs20 Nesmiete odstr\u225?ni\u357? ani zmeni\u357? podstatu \u382?iadnych licen\u269?n\u253?ch upozornen\u237? (vr\u225?tane upozornen\u237? o autorsk\u253?ch pr\u225?vach, patentov\u253?ch upozornen\u237?, vyl\u250?\u269?en\u237? z\u225?ruk alebo obmedzen\u237? zodpovednosti) obsiahnut\u253?ch vo Forme zdrojov\u233?ho k\u243?du pokryt\u233?ho softv\u233?ru, s v\u253?nimkou, \u382?e m\u244?\u382?ete upravi\u357? ak\u233?ko\u318?vek licen\u269?n\u233? upozornenia v rozsahu potrebnom na odstr\u225?nenie zn\u225?mych vecn\u253?ch nepresnost\u237?.\par


\pard\keepn\li120\sb100\b\fs24 3.5. Uplat\u328?ovanie dodato\u269?n\u253?ch podmienok\par


\pard\li120\sb100\sa100\b0\fs20 M\u244?\u382?ete sa rozhodn\u250?\u357? pon\u250?knu\u357? a \u250?\u269?tova\u357? poplatok za z\u225?ru\u269?n\u233?, podporn\u233?, od\u353?kod\u328?ovacie alebo zodpovednostn\u233? z\u225?v\u228?zky jedn\u233?mu alebo viacer\u253?m pr\u237?jemcom pokryt\u233?ho softv\u233?ru. M\u244?\u382?ete tak v\u353?ak urobi\u357? iba vo vlastnom mene, a nie v mene ak\u233?hoko\u318?vek prispievate\u318?a. Mus\u237?te celkom jasne uvies\u357?, \u382?e ak\u233?ko\u318?vek tak\u233?to z\u225?ru\u269?n\u233?, podporn\u233?, od\u353?kod\u328?ovacie alebo zodpovednostn\u233? z\u225?v\u228?zky pon\u250?kate v\u253?lu\u269?ne vy, a t\u253?mto s\u250?hlas\u237?te, \u382?e od\u353?kodn\u237?te ka\u382?d\u233?ho prispievate\u318?a za ak\u250?ko\u318?vek zodpovednos\u357?, ktor\u225? tak\u233?muto prispievate\u318?ovi vznikne v d\u244?sledku z\u225?ru\u269?n\u253?ch, podporn\u253?ch, od\u353?kod\u328?ovac\u237?ch alebo zodpovednostn\u253?ch podmienok, ktor\u233? pon\u250?kate. M\u244?\u382?ete zahrn\u250?\u357? dodato\u269?n\u233? vyl\u250?\u269?enia z\u225?ruk a obmedzenia zodpovednosti \u353?pecifick\u233? pre jednotliv\u233? jurisdikcie.\par


\pard\keepn\li120\sb120\sa100\b\fs30 4. Nemo\u382?nos\u357? dodr\u382?ania z d\u244?vodu z\u225?kona alebo nariadenia\par


\pard\li120\sb100\sa100\b0\fs20 Ak v\u225?m z\u225?kon, s\u250?dny pr\u237?kaz alebo nariadenie znemo\u382?\u328?uje dodr\u382?a\u357? niektor\u250? z podmienok tejto licencie vzh\u318?adom na \u269?as\u357? alebo cel\u253? pokryt\u253? softv\u233?r, potom mus\u237?te: (a) dodr\u382?a\u357? podmienky tejto licencie v maxim\u225?lnej mo\u382?nej miere; a (b) op\u237?sa\u357? obmedzenia a k\u243?d, na ktor\u253? sa vz\u357?ahuj\u250?. Tak\u253?to opis mus\u237? by\u357? umiestnen\u253? v textovom s\u250?bore prilo\u382?enom ku v\u353?etk\u253?m distrib\u250?ci\u225?m pokryt\u233?ho softv\u233?ru pod\u318?a tejto licencie. S v\u253?nimkou rozsahu zak\u225?zan\u233?ho z\u225?konom alebo nariaden\u237?m mus\u237? by\u357? tak\u253?to opis dostato\u269?ne podrobn\u253?, aby mu pr\u237?jemca s be\u382?n\u253?mi znalos\u357?ami dok\u225?zal porozumie\u357?.\par


\pard\keepn\li120\sb120\sa100\b\fs30 5. Ukon\u269?enie\par


\pard\li120\sb100\sa100\b0\fs20 5.1. Pr\u225?va udelen\u233? pod\u318?a tejto licencie automaticky zanikn\u250?, ak nebudete dodr\u382?iava\u357? niektor\u250? z jej podmienok. Ak v\u353?ak za\u269?nete podmienky dodr\u382?iava\u357?, pr\u225?va udelen\u233? pod\u318?a tejto licencie konkr\u233?tnym prispievate\u318?om sa obnovia (a) predbe\u382?ne, pokia\u318? a dok\u253?m tak\u253?to prispievate\u318? v\u253?slovne a definit\u237?vne neukon\u269?\u237? va\u353?e udelenia, a (b) trvalo, ak tak\u253?to prispievate\u318? neozn\u225?mi va\u353?e nedodr\u382?anie nejak\u253?m primeran\u253?m sp\u244?sobom do 60 dn\u237? po tom, \u269?o ste podmienky za\u269?ali op\u228?\u357? dodr\u382?iava\u357?. Navy\u353?e sa va\u353?e udelenia od konkr\u233?tneho prispievate\u318?a obnovia trvalo, ak v\u225?s tak\u253?to prispievate\u318? upozorn\u237? na nedodr\u382?anie nejak\u253?m primeran\u253?m sp\u244?sobom, ak ide o prv\u233? ozn\u225?menie o nedodr\u382?an\u237? tejto licencie, ktor\u233? ste od tak\u233?hoto prispievate\u318?a dostali, a ak za\u269?nete podmienky dodr\u382?iava\u357? do 30 dn\u237? po doru\u269?en\u237? ozn\u225?menia.\par

5.2. Ak za\u269?nete s\u250?dny spor proti ak\u233?muko\u318?vek subjektu uplatnen\u237?m n\u225?roku na poru\u353?enie patentu (s v\u253?nimkou \u382?al\u244?b o ur\u269?enie pr\u225?va, vz\u225?jomn\u253?ch \u382?al\u244?b a kr\u237?\u382?ov\u253?ch \u382?al\u244?b) s tvrden\u237?m, \u382?e verzia od prispievate\u318?a priamo alebo nepriamo poru\u353?uje ak\u253?ko\u318?vek patent, potom pr\u225?va udelen\u233? v\u225?m v\u353?etk\u253?mi a ak\u253?miko\u318?vek prispievate\u318?mi na pokryt\u253? softv\u233?r pod\u318?a \u269?asti 2.1 tejto licencie zanikn\u250?.\par

5.3. V pr\u237?pade ukon\u269?enia pod\u318?a vy\u353?\u353?ie uveden\u253?ch \u269?ast\u237? 5.1 alebo 5.2 zost\u225?vaj\u250? v platnosti v\u353?etky licen\u269?n\u233? zmluvy s koncov\u253?mi pou\u382?\u237?vate\u318?mi (s v\u253?nimkou distrib\u250?torov a predajcov), ktor\u233? vy alebo va\u353?i distrib\u250?tori platne udelili pod\u318?a tejto licencie pred ukon\u269?en\u237?m.\par


\pard\keepn\li120\sb120\sa100\b\v\fs30\'11B1\'12\v0 6. Vyl\u250?\u269?enie z\u225?ruky\par


\pard\li120\sb100\sa100\b0\i\fs20 Pokryt\u253? softv\u233?r sa pod\u318?a tejto licencie poskytuje na z\u225?klade \ldblquote tak ako je\rdblquote , bez akejko\u318?vek z\u225?ruky, \u269?i u\u382? v\u253?slovnej, implicitnej alebo z\u225?konnej, vr\u225?tane, bez obmedzenia, z\u225?ruk, \u382?e pokryt\u253? softv\u233?r je bez ch\u253?b, obchodovate\u318?n\u253?, vhodn\u253? na konkr\u233?tny \u250?\u269?el alebo neporu\u353?uje pr\u225?va. Cel\u233? riziko t\u253?kaj\u250?ce sa kvality a v\u253?konu pokryt\u233?ho softv\u233?ru nesiete vy. Ak sa uk\u225?\u382?e, \u382?e ktor\u253?ko\u318?vek pokryt\u253? softv\u233?r je v akomko\u318?vek oh\u318?ade chybn\u253?, vy (nie \u382?iadny prispievate\u318?) zn\u225?\u353?ate n\u225?klady na ak\u253?ko\u318?vek potrebn\u253? servis, opravu alebo n\u225?pravu. Toto vyl\u250?\u269?enie z\u225?ruky predstavuje podstatn\u250? s\u250?\u269?as\u357? tejto licencie. \u381?iadne pou\u382?itie ak\u233?hoko\u318?vek pokryt\u233?ho softv\u233?ru nie je pod\u318?a tejto licencie povolen\u233? okrem pou\u382?itia pod\u318?a tohto vyl\u250?\u269?enia z\u225?ruky.\i0\par


\pard\keepn\li120\sb120\sa100\b\fs30 7. Obmedzenie zodpovednosti\par


\pard\li120\sb100\sa100\b0\i\fs20 Za \u382?iadnych okolnost\u237? a pod\u318?a \u382?iadnej pr\u225?vnej te\u243?rie, \u269?i u\u382? ide o delikt (vr\u225?tane nedbanlivosti), zmluvu alebo inak, nebude \u382?iadny prispievate\u318? ani ktoko\u318?vek, kto distribuuje pokryt\u253? softv\u233?r, ako je povolen\u233? vy\u353?\u353?ie, vo\u269?i v\u225?m zodpovedn\u253? za ak\u233?ko\u318?vek priame, nepriame, \u353?peci\u225?lne, n\u225?hodn\u233? alebo n\u225?sledn\u233? \u353?kody akejko\u318?vek povahy vr\u225?tane, bez obmedzenia, \u353?k\u244?d za u\u353?l\u253? zisk, stratu dobr\u233?ho mena, preru\u353?enie pr\u225?ce, zlyhanie alebo poruchu po\u269?\u237?ta\u269?a alebo ak\u253?chko\u318?vek a v\u353?etk\u253?ch in\u253?ch obchodn\u253?ch \u353?k\u244?d \u269?i str\u225?t, a to aj v pr\u237?pade, ak bol tak\u253?to subjekt informovan\u253? o mo\u382?nosti tak\u253?chto \u353?k\u244?d. Toto obmedzenie zodpovednosti sa nevz\u357?ahuje na zodpovednos\u357? za smr\u357? alebo osobn\u250? ujmu vypl\u253?vaj\u250?cu z nedbanlivosti tak\u233?hoto subjektu\rquote  v rozsahu, v akom uplatnite\u318?n\u253? z\u225?kon tak\u233?to obmedzenie zakazuje. Niektor\u233? jurisdikcie neumo\u382?\u328?uj\u250? vyl\u250?\u269?enie alebo obmedzenie n\u225?hodn\u253?ch alebo n\u225?sledn\u253?ch \u353?k\u244?d, tak\u382?e toto vyl\u250?\u269?enie a obmedzenie sa na v\u225?s nemus\u237? vz\u357?ahova\u357?.\i0\par


\pard\keepn\li120\sb120\sa100\b\fs30 8. S\u250?dne spory\par


\pard\li120\sb100\sa100\b0\fs20 Ak\u253?ko\u318?vek s\u250?dny spor t\u253?kaj\u250?ci sa tejto licencie mo\u382?no vies\u357? len na s\u250?doch jurisdikcie, kde odporca m\u225? svoje hlavn\u233? miesto podnikania, a tak\u253?to spor sa riadi pr\u225?vom tejto jurisdikcie bez oh\u318?adu na jej ustanovenia o kol\u237?zii pr\u225?vnych predpisov. Ni\u269? v tejto \u269?asti nebr\u225?ni schopnosti strany\rquote  vznies\u357? kr\u237?\u382?ov\u233? \u382?aloby alebo vz\u225?jomn\u233? \u382?aloby.\par


\pard\keepn\li120\sb120\sa100\b\fs30 9. R\u244?zne ustanovenia\par


\pard\li120\sb100\sa100\b0\fs20 T\u225?to licencia predstavuje \u250?pln\u250? dohodu t\u253?kaj\u250?cu sa predmetu \u250?pravy. Ak sa niektor\u233? ustanovenie tejto licencie pova\u382?uje za nevym\u225?hate\u318?n\u233?, tak\u233?to ustanovenie sa uprav\u237? len v rozsahu potrebnom na to, aby bolo vym\u225?hate\u318?n\u233?. \u381?iadny z\u225?kon ani nariadenie, ktor\u233? ustanovuje, \u382?e znenie zmluvy sa m\u225? vyklada\u357? v neprospech toho, kto ju zostavil, sa nesmie pou\u382?i\u357? na v\u253?klad tejto licencie v neprospech prispievate\u318?a.\par


\pard\keepn\li120\sb120\sa100\b\fs30 10. Verzie licencie\par


\pard\keepn\li120\sb100\fs24 10.1. Nov\u233? verzie\par


\pard\li120\sb100\sa100\b0\fs20 Mozilla Foundation je spr\u225?vcom tejto licencie. S v\u253?nimkou ustanoven\u237? \u269?asti 10.3 nem\u225? nikto in\u253? ako spr\u225?vca licencie pr\u225?vo upravova\u357? alebo zverej\u328?ova\u357? nov\u233? verzie tejto licencie. Ka\u382?dej verzii bude pridelen\u233? rozli\u353?uj\u250?ce \u269?\u237?slo verzie.\par


\pard\keepn\li120\sb100\b\fs24 10.2. \u218?\u269?inok nov\u253?ch verzi\u237?\par


\pard\li120\sb100\sa100\b0\fs20 Pokryt\u253? softv\u233?r m\u244?\u382?ete distribuova\u357? pod\u318?a podmienok verzie licencie, pod\u318?a ktorej ste pokryt\u253? softv\u233?r p\u244?vodne dostali, alebo pod\u318?a podmienok ktorejko\u318?vek nasleduj\u250?cej verzie zverejnenej spr\u225?vcom licencie.\par


\pard\keepn\li120\sb100\b\fs24 10.3. Upraven\u233? verzie\par


\pard\li120\sb100\sa100\b0\fs20 Ak vytvor\u237?te softv\u233?r, na ktor\u253? sa t\u225?to licencia nevz\u357?ahuje, a chcete pre tak\u253?to softv\u233?r vytvori\u357? nov\u250? licenciu, m\u244?\u382?ete vytvori\u357? a pou\u382?\u237?va\u357? upraven\u250? verziu tejto licencie, ak premenujete licenciu a odstr\u225?nite v\u353?etky odkazy na n\u225?zov spr\u225?vcu licencie (okrem pozn\u225?mky, \u382?e tak\u225?to upraven\u225? licencia sa l\u237?\u353?i od tejto licencie).\par


\pard\keepn\li120\sb100\b\fs24 10.4. Distrib\u250?cia Formy zdrojov\u233?ho k\u243?du, ktor\u225? je nekompatibiln\u225? so sekund\u225?rnymi licenciami\par


\pard\li120\sb100\sa100\b0\fs20 Ak sa rozhodnete distribuova\u357? Formu zdrojov\u233?ho k\u243?du, ktor\u225? je nekompatibiln\u225? so sekund\u225?rnymi licenciami, pod\u318?a podmienok tejto verzie licencie, mus\u237? by\u357? prilo\u382?en\u233? upozornenie op\u237?san\u233? v pr\u237?lohe B tejto licencie.\par


\pard\keepn\li120\sb120\sa100\b\fs30 Pr\u237?loha A - Licen\u269?n\u233? upozornenie pre Formu zdrojov\u233?ho k\u243?du\par


\pard\li480\ri360\sb100\sa100\b0\fs20 T\u225?to Forma zdrojov\u233?ho k\u243?du podlieha podmienkam licencie Mozilla Public License, v. 2.0. Ak k\u243?pia licencie MPL nebola distribuovan\u225? s t\u253?mto s\u250?borom, m\u244?\u382?ete ju z\u237?ska\u357? na adrese {{\cf0\ul{\field{\*\fldinst{HYPERLINK https://mozilla.org/MPL/2.0/ }}{\fldrslt{https://mozilla.org/MPL/2.0/}}}}}\f1\fs20 .\par


\pard\li120\sb100\sa100 Ak nie je mo\u382?n\u233? alebo \u382?iaduce umiestni\u357? upozornenie do konkr\u233?tneho s\u250?boru, m\u244?\u382?ete upozornenie uvies\u357? na mieste (napr\u237?klad v s\u250?bore LICENSE v pr\u237?slu\u353?nom adres\u225?ri), kde by pr\u237?jemca pravdepodobne tak\u233?to upozornenie h\u318?adal.\par

M\u244?\u382?ete prida\u357? \u271?al\u353?ie presn\u233? upozornenia o vlastn\u237?ctve autorsk\u253?ch pr\u225?v.\par


\pard\keepn\li120\sb120\sa100\b\fs30 Pr\u237?loha B - Upozornenie \ldblquote nekompatibiln\u225? so sekund\u225?rnymi licenciami\rdblquote \par


\pard\li480\ri360\sb100\sa100\b0\fs20 T\u225?to Forma zdrojov\u233?ho k\u243?du je \ldblquote nekompatibiln\u225? so sekund\u225?rnymi licenciami\rdblquote , ako ich definuje licencia Mozilla Public License, v. 2.0.\par


