\cf1\b\fs36\lang3082 Skladanie a rozkladanie\cf2\lang1033\par

\cf0\b0\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<123|46|0|1"}}{\fldrslt{V\u353?eobecn\u233? inform\u225?cie}}}}\f0\fs20\par

