\pard\fi-2160\li2160\sb160\cf3\b Alt+Backspace\cf0\b0\tab\b Sp\u228?\u357?\b0  \i (Podporuje sa viacn\u225?sobn\u233? vr\u225?tenie sp\u228?\u357?. Zmeny nemo\u382?no vr\u225?ti\u357? sp\u228?\u357? po ulo\u382?en\u237? s\u250?boru)\i0  \par


\pard\cf3\b Ctrl+Enter\cf0\b0\tab\tab Znova \i (t. j.: vr\u225?ti\u357? posledn\u250? oper\u225?ciu \ldblquote Sp\u228?\u357?\rdblquote )\i0  \par


