{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset0 Cambria Math;}{\f3\fnil Tahoma;}{\f4\froman\fcharset0 Tahoma;}{\f5\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red0\green0\blue128;\red64\green64\blue64;}
{\*\generator Riched20 10.0.22621}{\*\mmathPr\mmathFont2\mwrapIndent1440 }\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Import s\u250?borov v KeyNote\cf2\f0\fs32\lang1033\par

\cf0\b0\fs20\par

\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|197|0|1"}}{\fldrslt{\u268?o mo\u382?no robi\u357? s extern\u253?mi s\u250?bormi}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|1571|0|2"}}{\fldrslt{S\u250?bory, ktor\u233? mo\u382?no importova\u357?}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|4827|0|3"}}{\fldrslt{Sp\u244?soby importu s\u250?borov}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|7413|0|4"}}{\fldrslt{Zl\u250?\u269?enie s\u250?borov KNT}}}}}\f0\fs20\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|8852|0|5"}}{\fldrslt{Import dokumentov HTML}}}}}\f0\fs20\par


\pard\sb80 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|12086|0|6"}}{\fldrslt{Pou\u382?\u237?vanie konvertora KNT}}}}}\f0\fs20\par


\pard\par

\par

KeyNote umo\u382?\u328?uje pou\u382?\u237?va\u357? extern\u233? s\u250?bory nieko\u318?k\u253?mi r\u244?znymi sp\u244?sobmi. V z\u225?vislosti od ich typu bude povolen\u253? jeden alebo viac z nich\par

\par

\cf3\b\v\fs24\'11B1\'12\v0 \u268?o m\u244?\u382?ete robi\u357? s extern\u253?mi s\u250?bormi?\b0\par

\cf0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 V texte pozn\u225?mky je mo\u382?n\u233? \b vytvori\u357? odkaz\b0  na ak\u253?ko\u318?vek typ s\u250?boru. \par


\pard\li360\sb40 P\u244?vodn\u253? s\u250?bor mo\u382?no otvori\u357? v jeho predvolenom editore (ako je zaregistrovan\u253? v syst\u233?me) aktivovan\u237?m odkazu. M\u244?\u382?ete\f2  \f0 prepoji\u357?\f2  \f0 \f2  \f0 dokumenty, obr\u225?zky, programy alebo dokonca skratky Windows (.lnk), ktor\u233? sa potom m\u244?\u382?u otvori\u357? alebo spusti\u357?.\par


\pard\li360\sb80 Pozri tie\u382? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|11553|0|9"}}{\fldrslt{Vkladanie odkazov na lok\u225?lne s\u250?bory}}}}}\f0\fs20\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 M\u244?\u382?ete definova\u357? \b virtu\u225?lny\b0  odkaz na s\u250?bor.\par


\pard\li360\sb40 Umo\u382?\u328?uje v\u225?m to zobrazi\u357? a upravi\u357? s\u250?bor, akoby i\u353?lo o in\u253? uzol KeyNote. Pri ukladan\u237? zmien sa v\u353?ak ulo\u382?ia do p\u244?vodn\u233?ho s\u250?boru, a nie do KeyNote, ktor\u253? bude uchov\u225?va\u357? iba odkaz na s\u250?bor.\par


\pard\li360\sb80 Pou\u382?i\u357? ho mo\u382?no len so s\u250?bormi RTF alebo s \u269?ist\u253?m textom. Je mo\u382?n\u233? prepoji\u357? s\u250?bor HTML, ale zobraz\u237? sa ako \u269?ist\u253? text.\par

Viac inform\u225?ci\u237? v {\lang3082{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<28|0|0"}}{\fldrslt{Virtu\u225?lne uzly}}}}}\f0\fs20\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 S\u250?bor mo\u382?no \b vlo\u382?i\u357?\b0  do s\u250?boru KeyNote ako s\u250?\u269?as\u357? jeho obsahu\par


\pard\li360\sb40 Obsah s\u250?boru je mo\u382?n\u233? vlo\u382?i\u357? na aktu\u225?lnu poz\u237?ciu kurzora v akt\u237?vnom editore (Vlo\u382?i\u357? obsah na poz\u237?ciu kurzora) alebo do novej pozn\u225?mky (uzla) \u269?i prie\u269?inka vytvoren\u233?ho na tento \u250?\u269?el. P\u244?vodn\u233? s\u250?bory zostan\u250? na disku nedotknut\u233?.\par

V tomto procese ich m\u244?\u382?e by\u357? potrebn\u233? previes\u357? do form\u225?tu RTF alebo TXT (\u269?ist\u253? text) v z\u225?vislosti od typu s\u250?boru a cie\u318?ovej pozn\u225?mky.\par


\pard\par


\pard\sb80 Pozri tie\u382? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|23459|0|2"}}{\fldrslt{Ako pou\u382?\u237?va\u357? prehliada\u269? obr\u225?zkov}}}}}\f0\fs20\par


\pard\par

\par

\cf3\b\v\fs24\'11B2\'12\v0 S\u250?bory, ktor\u233? mo\u382?no importova\u357?\cf0\b0\fs20\par

\par

KeyNote rozpozn\u225?va tieto typy s\u250?borov:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 \u268?ist\u253? text (.txt) \par

{\pntext\f5\'B7\tab}Form\u225?t RTF (.rtf)\par

{\pntext\f5\'B7\tab}HTML (.htm, .html)\par

{\pntext\f5\'B7\tab}Obr\u225?zky (.gif, .png, .jpg, .bmp, .tif, .wmf, .emf a .ico)\par

{\pntext\f5\'B7\tab}S\u250?bory KeyNote (.knt, .kne, .knm)\par

{\pntext\f5\'B7\tab}TreePad (.hjt)\par


\pard\par

\par

Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 V {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<102|0|0"}}{\fldrslt{Mo\u382?nosti konfigur\u225?cie | Pokro\u269?il\u233? | Typy s\u250?borov}}}}}\f0\fs20  m\u244?\u382?ete nastavi\u357? zoznam \b pr\u237?pon s\u250?borov\b0 , ktor\u233? m\u225? KeyNote pri importe pova\u382?ova\u357? za \b ekvivalentn\u233? s\u250?borom s \u269?ist\u253?m textom\b0  (.txt).\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Rozpozn\u225?van\u253? form\u225?t \b TreePad\b0  zodpoved\u225? ve\u318?mi starej verzii. Ur\u269?ite bud\u250? existova\u357? funkcie z nov\u353?\u237?ch verzi\u237?, ktor\u233? sa bud\u250? ignorova\u357?.\par

{\pntext\f5\'B7\tab}Ke\u271? sa s\u250?bory \b HTML\b0  importuj\u250? ako \b virtu\u225?lne uzly\b0 , spravuj\u250? sa ako s\u250?bory s \u269?ist\u253?m textom a zobraz\u237? sa zdrojov\u253? k\u243?d HTML.\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Obsah HTML m\u244?\u382?ete \b vlo\u382?i\u357?\b0  so zachovan\u237?m jeho form\u225?tu. Na to je potrebn\u233? \b previes\u357?\b0  s\u250?bor \b do RTF\b0 . KeyNote nem\u225? vlastn\u253? konvertor HTML na RTF. Namiesto toho m\u244?\u382?e pou\u382?i\u357? jeden z nieko\u318?k\u253?ch konvertorov pr\u237?tomn\u253?ch v syst\u233?me.\par


\pard\li360\sb40 Viac v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|8852|0|5"}}{\fldrslt{Import dokumentov HTML}}}}}\f0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Okrem vlo\u382?enia, ako je to pri in\u253?ch form\u225?toch, \b obr\u225?zky\b0  umo\u382?\u328?uj\u250? \u353?peci\u225?lny typ odkazu, preto\u382?e ich mo\u382?no za\u269?leni\u357? ako v\u353?eobecn\u253? hypertextov\u253? odkaz, ale aj ako odkaz, ktor\u253? umo\u382?\u328?uje ich zobrazenie a pou\u382?itie podobne ako pri akomko\u318?vek vlo\u382?enom obr\u225?zku. Pri tomto type odkazov KeyNote prist\u250?pi k p\u244?vodn\u233?mu s\u250?boru, aby v pr\u237?pade potreby na\u269?\u237?tal a zobrazil obsah obr\u225?zka, a to zobrazen\u237?m uzla alebo pozn\u225?mky, ktor\u225? ho obsahuje.\par


\pard\li360\sb40 Viac v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|10885|0|4"}}{\fldrslt{Vkladanie obr\u225?zkov}}}}}\f0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Ke\u271? importujete \b .knt\b0  alebo \b .kne \b0  \b s\u250?bor KeyNote\b0 , m\u244?\u382?ete s\u250?bor otvori\u357? v KeyNote, vytvori\u357? na\u328? hypertextov\u253? odkaz alebo vlo\u382?i\u357? jeho obsah do aktu\u225?lneho s\u250?boru. V druhom pr\u237?pade sa vyvol\u225? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<117|4328|0|11"}}{\fldrslt{Zl\u250?\u269?i\u357? prie\u269?inky...}}}}}\f0\fs20  pr\u237?kaz. \par


\pard\li360\sb40 Viac v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|7413|0|4"}}{\fldrslt{Zl\u250?\u269?enie s\u250?borov KNT}}}}}\f0\fs20\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb200 Ak importujete s\u250?bor \b .knm\b0  (makro KeyNote), makro sa vykon\u225?. V\u353?imnite si, \u382?e odkaz na s\u250?bor .knm nem\u244?\u382?ete vlo\u382?i\u357? pomocou {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<109|4356|0|12"}}{\fldrslt{S\u250?bor | Importova\u357?...}}}}}\f0\fs20  ani pomocou pretiahnutia a pustenia. Namiesto toho m\u244?\u382?ete pou\u382?i\u357? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|2442|0|8"}}{\fldrslt{Vlo\u382?i\u357? | Odkaz na s\u250?bor...}}}}}\f0\fs20 . Aby ste ho v\u353?ak mohli vykona\u357? priamo v aktu\u225?lnom .knt, mali by ste ho zahrn\u250?\u357? do prie\u269?inka makier (pozri {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<86|0|0"}}{\fldrslt{Profily}}}}}\f0\fs20 ).\par


\pard\li360\sb40 * V\u353?imnite si, \u382?e ak vyberiete nieko\u318?ko s\u250?borov .knm, vykon\u225? sa iba jeden z nich\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb160 Pri importe virtu\u225?lnych pozn\u225?mok zostan\u250? zachovan\u233? ako virtu\u225?lne pozn\u225?mky (alebo sa stan\u250? prepojen\u253?mi uzlami, ak u\u382? existuje uzol prepojen\u253? s rovnak\u253?m s\u250?borom)\par


\pard\par

\par

\cf3\b\v\fs24\'11B3\'12\v0 Sp\u244?soby importu s\u250?borov\b0\par

\cf0\fs20\par

S\u250?bory m\u244?\u382?ete importova\u357? r\u244?znymi pr\u237?kazmi alebo akciami. Prv\u233? dva s\u250? v\u353?eobecn\u233? a budete vyzvan\u237?, aby ste ur\u269?ili, ktor\u250? akciu importu vykona\u357?, a ostatn\u233? s\u250? \u353?pecifick\u233? a vykonaj\u250? iba konkr\u233?tnu akciu importu:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 pretiahnutie a pustenie\par

{\pntext\f5\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<109|4356|0|12"}}{\fldrslt{S\u250?bor | Importova\u357?...}}}}}\f0\fs20\par

{\pntext\f5\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|2442|0|8"}}{\fldrslt{Vlo\u382?i\u357? | Odkaz na s\u250?bor...}}}}}\f0\fs20\par

{\pntext\f5\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|1758|0|6"}}{\fldrslt{Vlo\u382?i\u357? | Obsah s\u250?boru...}}}}}\f0\fs20  (iba \u269?ist\u253? txt (registrovan\u233?) alebo RTF) (s\u250?bory .html sa vlo\u382?ia ako \u269?ist\u253? text)\par

{\pntext\f5\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|2952|0|9"}}{\fldrslt{Vlo\u382?i\u357? | Obr\u225?zok...}}}}}\f0\fs20   \par

{\pntext\f5\'B7\tab}{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<117|4328|0|11"}}{\fldrslt{N\u225?stroje | Zl\u250?\u269?i\u357? prie\u269?inky...}}}}}\f0\fs20\par


\pard\sa80\b\par


\pard\b0 Najjednoduch\u353?\u237? sp\u244?sob, ako importova\u357? \b jeden alebo viac\b0  s\u250?borov, je \b pretiahnu\u357?\b0  ich z Prieskumn\u237?ka Windows (alebo z ak\u233?hoko\u318?vek kompatibiln\u233?ho programu, napr\u237?klad \u8222?Everything\u8220? \f3\emdash\f0 voidtools.com) a pusti\u357? ich do panela Editora na konkr\u233?tne miesto alebo do panela Strom \u269?i in\u253?ch \u269?ast\u237? hlavn\u233?ho okna.\par

Pri p\u250?\u353?\u357?an\u237? do Editora m\u244?\u382?ete dynamicky meni\u357? poz\u237?ciu kurzora, na ktor\u250? sa obsah vlo\u382?\u237?.\par


\pard\sb40 T\u225?to akcia zobraz\u237? \cf4\b okno importu\cf0\b0 . (V\u353?imnite si, \u382?e v z\u225?vislosti od \u357?ahan\u233?ho prvku m\u244?\u382?e vytvori\u357? odkaz alebo vykona\u357? akciu bez zobrazenia tohto okna).\par


\pard\sb160 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<109|4356|0|12"}}{\fldrslt{S\u250?bor | Importova\u357?...}}}}}\f0\fs20  je (takmer) ekvivalentn\u253? pretiahnutiu a pusteniu. Jedin\u253? rozdiel je v tom, \u382?e t\u253?mto pr\u237?kazom nem\u244?\u382?ete vybra\u357? prie\u269?inok, ale pretiahnut\u237?m a pusten\u237?m to m\u244?\u382?ete urobi\u357?.\par


\pard\sb200 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|2442|0|8"}}{\fldrslt{Vlo\u382?i\u357? | Odkaz na s\u250?bor...}}}}}\f0\fs20  umo\u382?\u328?uje konkr\u233?tne vlo\u382?i\u357? odkazy (alebo hypertextov\u233? odkazy) na \ul jeden\ulnone  s\u250?bor, ktor\u253? m\u244?\u382?ete vybra\u357? v mod\u225?lnom okne preh\u318?ad\u225?van\u237?m svojho s\u250?borov\u233?ho syst\u233?mu.\par


\pard\sb80 {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|1758|0|6"}}{\fldrslt{Vlo\u382?i\u357? | Obsah s\u250?boru...}}}}}\f0\fs20  v\u225?m pom\u225?ha vlo\u382?i\u357? obsah \ul jedn\u233?ho\ulnone  s\u250?boru, RTF alebo \u269?ist\u233?ho textu. Vlo\u382?i\u357? m\u244?\u382?ete iba registrovan\u233? s\u250?bory s \u269?ist\u253?m textom;  HTML sa automaticky vlo\u382?\u237? ako \u269?ist\u253? text, hoci ako tak\u253? nie je registrovan\u253?. (Pozri {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<102|0|0"}}{\fldrslt{Typy s\u250?borov}}}}}\f0\fs20 )\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<112|2952|0|9"}}{\fldrslt{Vlo\u382?i\u357? | Obr\u225?zok...}}}}}\f0\fs20  umo\u382?\u328?uje vlo\u382?i\u357? \ul jeden\ulnone  obr\u225?zkov\u253? s\u250?bor. V\u353?imnite si, \u382?e obr\u225?zok bude vlo\u382?en\u253? alebo prepojen\u253? v z\u225?vislosti od {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|10885|0|4"}}{\fldrslt{Predvolene odkazova\u357? na s\u250?bory (bez k\u243?pi\u237?)}}}}}\f0\fs20  v\u353?eobecnej mo\u382?nosti. Pomocou \cf4\b okna importu\cf0\b0  a mo\u382?nosti \u8222?Vlo\u382?i\u357? obsah na poz\u237?ciu kurzora\u8220? m\u244?\u382?ete toto predvolen\u233? nastavenie zmeni\u357? pre jednotliv\u233? s\u250?bory.\par

\par

\cf3\b\v\fs22\'11B7\'12\v0 Okno importu\b0\fs20\par


\pard\cf0\par

Pri {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<109|4356|0|12"}}{\fldrslt{S\u250?bor | Importova\u357?...}}}}}\f0\fs20   a pri pretiahnut\u237? a pusten\u237? sa zobraz\u237? \cf4\b okno importu\cf0\b0 . Umo\u382?\u328?uje v\u225?m vytvori\u357? odkaz (alebo hypertextov\u253? odkaz) na s\u250?bor (s\u250?bory) a tie\u382? importova\u357? tieto s\u250?bory r\u244?znymi sp\u244?sobmi v z\u225?vislosti od v\u253?beru.\par

\par

Dostupn\u233? met\u243?dy importu bud\u250? z\u225?visie\u357? od vybran\u253?ch s\u250?borov. Nasleduj\u250?ca sn\u237?mka obrazovky zobrazuje v\u353?etky existuj\u250?ce dostupn\u233? met\u243?dy:\par


\pard\li360\sb80\par


\pard\li720\sb80\v\'11I125\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:125,359,245"}}{\fldrslt {125_Clipb_12ene.png}}}}\par


\pard\li360\sb80\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 V\u253?ber jednotliv\u253?ch (alebo viacer\u253?ch rovnak\u233?ho typu) s\u250?borov s \u269?ist\u253?m textom, RTF alebo HTML v\u225?m umo\u382?n\u237? pou\u382?i\u357? v\u353?etky tieto mo\u382?nosti.\par


\pard\li360\sb40 Pri importe s\u250?borov HTML sa predvolene pou\u382?ije posledn\u225? konfigur\u225?cia vybran\u225? v \u8222?Mo\u382?nostiach HTML\u8220?. (Viac o {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<56|8852|0|5"}}{\fldrslt{Import dokumentov HTML}}}}}\f0\fs20 )\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80 Import obr\u225?zkov pon\u250?ka v\u353?etky tieto mo\u382?nosti okrem \ul Importova\u357? ako virtu\u225?lny uzol\ulnone .\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Import jedn\u233?ho alebo viacer\u253?ch s\u250?borov .knt (alebo .kne) pon\u250?kne tri mo\u382?nosti: \ul Otvori\u357? s\u250?bor v KeyNote\ulnone , \ul Zl\u250?\u269?i\u357? prie\u269?inky do aktu\u225?lneho s\u250?boru\ulnone  a \ul Vytvori\u357? hypertextov\u253? odkaz na s\u250?bor\ulnone .\par


\pard\li360\sb80\par


\pard\par

S\u250?\u269?asn\u253? import s\u250?borov r\u244?znych typov m\u244?\u382?e zn\u237?\u382?i\u357? po\u269?et dostupn\u253?ch met\u243?d importu. V t\u253?chto pr\u237?padoch v\u353?ak:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\ul Mo\u382?nosti Vytvori\u357? hypertextov\u253? odkaz na s\u250?bor\ulnone  a \ul Vlo\u382?i\u357? obsah na poz\u237?ciu kurzora\ulnone\f4\lang3082  sa pon\u250?knu v\u382?dy\f0\lang1033\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80 Ak s\u250? zahrnut\u233? nejak\u233? s\u250?bory RTF, TXT (vo v\u353?eobecnosti \u269?ist\u253? text, tu vr\u225?tane HTML), ktor\u233? podporuj\u250? mo\u382?nosti \ul Importova\u357? ako nov\u253? prie\u269?inok\ulnone  a \ul Importova\u357? ako uzol stromu\ulnone , tieto dve mo\u382?nosti sa bud\u250? na\u271?alej pon\u250?ka\u357?, aj ke\u271? boli vybran\u233? in\u233? nerozpoznan\u233? pr\u237?pony.\par


\pard\li360\sb40 Tieto ostatn\u233? s\u250?bory m\u244?\u382?u by\u357? jednotlivo na z\u225?klade \u382?iadosti o potvrdenie ignorovan\u233? alebo interpretovan\u233? ako s\u250?bory s \u269?ist\u253?m textom.\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 S\u250?\u269?asne m\u244?\u382?ete importova\u357? s\u250?bory RTF, \u269?ist\u253? text (vr\u225?tane HTML) a obr\u225?zky. Ka\u382?d\u253? sa spracuje spr\u225?vne. Ak v\u353?ak vyberiete mo\u382?nos\u357? \ul Vlo\u382?i\u357? obsah na poz\u237?ciu kurzora\ulnone\f4\lang3082 , obr\u225?zok vlo\u382?\u237?te alebo prepoj\u237?te v\u253?lu\u269?ne v z\u225?vislosti od v\u353?eobecnej mo\u382?nosti \u8222?Prepoji\u357? so s\u250?bormi ako predvolen\u233? (bez k\u243?pi\u237?)\u8220?. V tom okamihu nebudete m\u244?c\u357? toto nastavenie zmeni\u357?  (ako to m\u244?\u382?ete pri importe iba obr\u225?zkov) ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|10885|0|4"}}{\fldrslt{Viac}}}}}\f4\fs20 )\f0\lang1033\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 S v\u253?nimkou importu s\u250?borov .knm budete vo v\u353?etk\u253?ch pr\u237?padoch ma\u357? mo\u382?nos\u357? \ul Vytvori\u357? hypertextov\u253? odkaz na s\u250?bor\ulnone , ktor\u225? bude aj predvolenou, predvybranou mo\u382?nos\u357?ou, okrem pr\u237?padov:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li720 S\u250?bory .knt alebo .kne: predvolene \ul Otvori\u357? s\u250?bor v KeyNote\ulnone\par

{\pntext\f5\'B7\tab}Obr\u225?zkov\u233? s\u250?bory: predvolene \ul Vlo\u382?i\u357? obsah na poz\u237?ciu kurzora\ulnone  ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|12491|0|19"}}{\fldrslt{Viac}}}}}\f0\fs20 )\par


\pard\par

Viac podrobnost\u237? o procese vkladania odkazov na s\u250?bory (a prie\u269?inky) n\u225?jdete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<38|11553|0|9"}}{\fldrslt{Vkladanie odkazov na lok\u225?lne s\u250?bory}}}}}\f0\fs20 \par

\par

\par

\par

\cf3\b\v\fs24\'11B4\'12\v0 Zlu\u269?ovanie s\u250?borov KNT\par

\cf0\b0\fs20\par


\pard\sb120 Pomocou pr\u237?kazu {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<117|4328|0|11"}}{\fldrslt{N\u225?stroje | Zl\u250?\u269?i\u357? prie\u269?inky...}}}}}\f0\fs20  alebo pretiahnut\u237?m a pusten\u237?m m\u244?\u382?ete importova\u357? obsah s\u250?boru KeyNote (.knt alebo .kne) do aktu\u225?lne otvoren\u233?ho s\u250?boru.\par

\par


\pard\li360\sb120\v\'11I181\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:181,335,279"}}{\fldrslt {181_Clipb_31mar.png}}}}\par


\pard\sb120 V dial\u243?govom okne pr\u237?kazu Zl\u250?\u269?i\u357? sa zobrazia v\u353?etky prie\u269?inky v s\u250?bore. M\u244?\u382?ete vlo\u382?i\u357? obsah jedn\u233?ho alebo viacer\u253?ch prie\u269?inkov importovan\u233?ho s\u250?boru. Vybran\u233? prie\u269?inky sa za\u269?lenia do aktu\u225?lneho s\u250?boru .knt ako samostatn\u233? prie\u269?inky.\par

V\u353?etky existuj\u250?ce obr\u225?zky zahrnut\u233? vo vybran\u253?ch prie\u269?inkoch sa prisp\u244?sobia sp\u244?sobu ukladania aktu\u225?lneho s\u250?boru a v pr\u237?pade potreby sa preved\u250? do in\u233?ho form\u225?tu. (Viac v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<41|9684|0|15"}}{\fldrslt{Export a import obr\u225?zkov.}}}}}\f0\fs20 )\par

V\u353?imnite si, \u382?e t\u253?mto sp\u244?sobom zahrniete \b cel\u233? prie\u269?inky\b0  so v\u353?etk\u253?mi ich pozn\u225?mkami (uzlami). Ak by ste chceli \b zahrn\u250?\u357? len niektor\u233? pozn\u225?mky\b0  alebo podstrom prie\u269?inka, mohli by ste zv\u225?\u382?i\u357? nasleduj\u250?ce \b alternat\u237?vy\b0 :\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80 Najjednoduch\u353?ie by bolo prida\u357? cel\u253? prie\u269?inok a potom odstr\u225?ni\u357? v\u353?etky nepotrebn\u233? uzly...\par

{\pntext\f5\'B7\tab}Namiesto importovania s\u250?boru .knt (pomocou Zl\u250?\u269?i\u357? prie\u269?inky...) m\u244?\u382?ete skop\u237?rova\u357? (prenies\u357?) podstrom uzlov z tohto s\u250?boru a potom ho vlo\u382?i\u357? do aktu\u225?lneho s\u250?boru. (Viac o {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|7821|0|1"}}{\fldrslt{Kop\u237?rovanie alebo pres\u250?vanie podstromov}}}}}\f0\fs20 )\par

{\pntext\f5\'B7\tab}M\u244?\u382?ete vygenerova\u357? jeden (alebo nieko\u318?ko) nov\u253?ch s\u250?borov .knt obsahuj\u250?cich iba uzly, ktor\u233? chcete zahrn\u250?\u357?. Pozri {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<57|0|0"}}{\fldrslt{Export pozn\u225?mok do KNT (KeyNote NF)}}}}}\f0\fs20 . Ke\u271? m\u225?te tento s\u250?bor (tieto s\u250?bory) .knt, m\u244?\u382?ete prida\u357? cel\u233? ich prie\u269?inky.\par


\pard\par


\pard\sb160 Ak potrebujete zahrn\u250?\u357? obsah s\u250?boru .KNT do existuj\u250?ceho prie\u269?inka a nie do samostatn\u253?ch prie\u269?inkov, m\u244?\u382?ete to jednoducho urobi\u357? vystrihnut\u237?m a vlo\u382?en\u237?m textu alebo {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<27|7821|0|1"}}{\fldrslt{pres\u250?vanie podstromov}}}}}\f0\fs20 .\par


\pard\par

\b Tip\b0 : Aktu\u225?lny s\u250?bor je mo\u382?n\u233? zl\u250?\u269?i\u357?\b  \b0  s\u225?m so sebou. Je to jednoduch\u253? sp\u244?sob, ako vytvori\u357? k\u243?piu prie\u269?inka v tom istom s\u250?bore.\par

\par

\par

\par

\cf3\b\v\fs24\'11B5\'12\v0 Import dokumentov HTML\b0\fs20\par

\cf0\par

S\u250?bory HTML m\u244?\u382?ete importova\u357? \b ako oby\u269?ajn\u253? text\b0 , pri\u269?om sa vlo\u382?\u237? zdrojov\u253? k\u243?d HTML, alebo \b ako RTF\b0  so zachovan\u237?m jeho form\u225?tu. Na to druh\u233? je potrebn\u233? \b previes\u357?\b0  s\u250?bor do RTF. KeyNote nem\u225? vlastn\u253? \ul konvertor HTML na RTF\ulnone . Namiesto toho m\u244?\u382?e pou\u382?i\u357? jeden z nieko\u318?k\u253?ch konvertorov dostupn\u253?ch v syst\u233?me.\par

\par

R\u244?zne mo\u382?nosti m\u244?\u382?ete vybra\u357? kliknut\u237?m na tla\u269?idlo \b Mo\u382?nosti HTML\b0  v okne \cf4\b Import\cf0\b0 .\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Upozor\u328?ujeme, \u382?e toto tla\u269?idlo bude vidite\u318?n\u233? iba pri importe jedn\u233?ho alebo viacer\u253?ch dokumentov HTML, v\u353?etk\u253?ch rovnak\u233?ho typu. Ak importujete jeden alebo viac s\u250?borov HTML spolu s in\u253?mi typmi, importuj\u250? sa ako oby\u269?ajn\u253? text (zdrojov\u253? k\u243?d HTML).\par


\pard\par

\par


\pard\li360\v\'11I159\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:159,360,246"}}{\fldrslt {159_Clipb_22ene.png}}}}\par


\pard\par

\par

Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80 Met\u243?da \u8222?Pou\u382?i\u357? konvertor MS Word\u8220? pravdepodobne poskytne presnej\u353?iu konverziu, ale budete potrebova\u357? nain\u353?talovan\u253? Microsoft Word.\par

{\pntext\f5\'B7\tab}Met\u243?da \u8222?Pou\u382?i\u357? Internet Explorer\u8220? by mala fungova\u357? vo v\u353?etk\u253?ch situ\u225?ci\u225?ch a poskytn\u250?\u357? prijate\u318?n\u250? konverziu.\par

{\pntext\f5\'B7\tab}Naopak, mo\u382?nos\u357? \u8222?Pou\u382?i\u357? zdie\u318?an\u253? konvertor textu HTML (html32.cnv + msconv97.dll)\u8220? pravdepodobne nebude fungova\u357?, pokia\u318? nepou\u382?\u237?vate KeyNote v syst\u233?me Windows 95.\par


\pard\li360\sb40 Viac inform\u225?ci\u237? o obmedzeniach tejto mo\u382?nosti n\u225?jdete v {{\cf0\ul{\field{\*\fldinst{HYPERLINK "https://github.com/dpradov/keynote-nf/issues/298"}}{\fldrslt{probl\u233?m 298}}}}}\f0\fs20  na GitHube\par


\pard\par

\par

\cf3\b\v\fs24\'11B6\'12\v0 Pou\u382?\u237?vanie konvertora KNT\par

\cf0\b0\fs20\lang3082\par

\lang1033 Konvertor KeyNote (kntconvert.exe) je star\u353?ia sprievodn\u225? aplik\u225?cia ku KeyNote. Jeho \u250?\u269?elom je konvertova\u357? textov\u233? s\u250?bory r\u244?znych form\u225?tov na s\u250?bory KeyNote.\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<73|0|0"}}{\fldrslt{Tu}}}}}\f0\fs20  m\u244?\u382?ete si pozrie\u357? s\u250?bor n\u225?povedy a inform\u225?cie o tom, ako ho stiahnu\u357?.\par

\par

}
