\pard\li360\v\'11I247\'12\v0\fs20\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:247,379,365"}}{\fldrslt {247_Clipb_05mar.png}}}}\lang1033\par


\pard\sa100\par

\cf1\b\fs22 Z\u225?lohova\u357? v pravideln\u253?ch intervaloch\cf0\fs20\tab\tab\tab\tab\tab\b0 Predvolen\u233?: \u193?NO\par


\pard Ak je povolen\u225?, KeyNote pri ukladan\u237? vytv\u225?ra z\u225?lohy v\u225?\u353?ho s\u250?boru pod\u318?a z\u225?sady, ktor\u225? zachov\u225?va k\u243?pie, ktor\u233? KeyNote neprep\u237?\u353?e. K\u243?piu budete ma\u357? za ka\u382?d\u253? mesiac, jednu za ka\u382?d\u253? z posledn\u253?ch t\u253?\u382?d\u328?ov at\u271?.\par


\pard\sb40 Podrobn\u253? opis fungovania tohto mechanizmu n\u225?jdete v {\ul{\field{\*\fldinst{HYPERLINK "file:///<53|0|0"}}{\fldrslt{Z\u225?lohovanie v pravideln\u253?ch intervaloch}}}}\f0\fs20\par


\pard\sa100\par


\pard\sa80\cf1\b\fs22 Maxim\u225?lna denn\u225? \u250?rove\u328? z\u225?lohovania\cf0\fs20\tab\tab\tab\tab\tab\tab\b0 Predvolen\u233?: 5\par


\pard Pri prvom ulo\u382?en\u237? v novom dni sa vytvor\u237? z\u225?loha s\u250?boru \i pred\i0  ulo\u382?en\u237?m (ak nie je k dispoz\u237?cii ako t\u253?\u382?denn\u225? alebo mesa\u269?n\u225? z\u225?loha) ako samostatn\u253? s\u250?bor. \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\lang3082 Ak je t\u225?to mo\u382?nos\u357? nastaven\u225? na 1, k\u243?pia pre dan\u253? de\u328? \f1 file_BAK_Day.knt\f0  bude nahraden\u225? k\u243?piou zodpovedaj\u250?cou nov\u233?mu d\u328?u. \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Ak je t\u225?to mo\u382?nos\u357? nastaven\u225? na hodnotu 2 a\u382? 7, namiesto vytvorenia s\u250?boru \f1 file_BAK_Day.knt\f0  sa vytvor\u237? s\u250?bor v tvare \f1 file_BAK_@D1.knt\f0  a u\u382? vytvoren\u233? s\u250?bory sa automaticky posun\u250? na ..\f1 @D2, \f0 ..\f1 @D3\f0  at\u271?., pri\u269?om sa automaticky vyma\u382?\u250? najstar\u353?ie, ktor\u233? prekro\u269?ia nastaven\u250? maxim\u225?lnu \u250?rove\u328?.\lang1033\par


\pard\sb160 T\u225?to mo\u382?nos\u357? s\u250?vis\u237? s {\ul{\field{\*\fldinst{HYPERLINK "file:///<53|0|0"}}{\fldrslt{Z\u225?lohovanie v pravideln\u253?ch intervaloch}}}}\f0\fs20 . Neovplyv\u328?uje mo\u382?nos\u357? \cf3\b Z\u225?lohova\u357? p\u244?vodn\u253? s\u250?bor pri ukladan\u237? zmien\cf0\b0 .\par


\pard\sa100\par

\par

\cf1\b\fs22 Z\u225?lohova\u357? p\u244?vodn\u253? s\u250?bor pri ukladan\u237? zmien\cf0\fs20\tab\tab\tab\b0 Predvolen\u233?: \u193?NO\par


\pard Ak je povolen\u225?, KeyNote pri ukladan\u237? vytvor\u237? z\u225?lohu v\u225?\u353?ho s\u250?boru.\par

\par

\par


\pard\sa100\cf1\b\fs22 Pripoji\u357? pr\u237?ponu k p\u244?vodn\u233?mu n\u225?zvu s\u250?boru\cf0\fs20\tab\tab\tab\b0 Predvolen\u233?: \u193?NO\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak je povolen\u225?, KeyNote prid\u225? z\u225?lohov\u250? pr\u237?ponu (.BAK, predvolene) k n\u225?zvu p\u244?vodn\u233?ho s\u250?boru (myfile.knt sa zmen\u237? na myfile.knt.bak).\par

{\pntext\f2\'B7\tab}Ak je zak\u225?zan\u225?, z\u225?lohov\u225? pr\u237?pona nahrad\u237? p\u244?vodn\u250? pr\u237?ponu s\u250?boru (myfile.knt sa zmen\u237? na myfile.bak).\par


\pard\par

\par


\pard\sa100\cf1\b\fs22 Pr\u237?pona z\u225?lohovan\u253?ch s\u250?borov\cf0\fs20\tab\tab\tab\tab\tab\tab\b0 Predvolen\u233?: .BAK\par


\pard Zadajte pr\u237?ponu, ktor\u225? sa bude pou\u382?\u237?va\u357? pri vytv\u225?ran\u237? z\u225?loh.\par


\pard\li240\sb100\ul Pozn\u225?mka\ulnone\b :  \b0 Nieko\u318?ko \u353?tandardn\u253?ch pr\u237?pon KeyNote je vyhraden\u253?ch a nemo\u382?no ich pou\u382?i\u357? pre z\u225?lo\u382?n\u233? s\u250?bory. Napr\u237?klad \u8222?.KNT\u8220?, \u8222?.KNE\u8220? a \u8222?.n_text\u8220? nemo\u382?no pou\u382?i\u357? ako pr\u237?pony z\u225?lo\u382?n\u253?ch s\u250?borov.\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Z\u225?lohova\u357? aj s\u250?bory virtu\u225?lnych uzlov\cf0\fs20\tab\tab\tab\tab\tab\b0 Predvolen\u233?: \u193?NO\par


\pard\fi-240\li240 Ak je povolen\u225?, KeyNote vytvor\u237? z\u225?lo\u382?n\u250? k\u243?piu aj pre ka\u382?d\u253? s\u250?bor prepojen\u253? ako virtu\u225?lny uzol, pri\u269?om pou\u382?ije rovnak\u250? pr\u237?ponu z\u225?lohy ako pre s\u250?bor KeyNote.\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Maxim\u225?lna \u250?rove\u328? z\u225?lohovania\cf0\fs20\tab\tab\tab\tab\tab\tab\tab\b0 Predvolen\u233?: 1\par


\pard Zadajte po\u269?et z\u225?lo\u382?n\u253?ch s\u250?borov, ktor\u233? KeyNote uchov\u225?va pre ka\u382?d\u253? s\u250?bor KeyNote\par


\pard\sb80 T\u225?to mo\u382?nos\u357? ovplyv\u328?uje po\u269?et s\u250?borov vytvoren\u253?ch cyklick\u253?m mechanizmom aktivovan\u253?m mo\u382?nos\u357?ou \cf3\b Z\u225?lohova\u357? p\u244?vodn\u253? s\u250?bor pri ukladan\u237? zmien\cf0\b0 . Neovplyv\u328?uje mo\u382?nos\u357? \cf3\b Z\u225?lohova\u357? v pravideln\u253?ch intervaloch\cf0\b0\par


\pard\par


\pard\li360\b Pozn\u225?mka\b0 : V ur\u269?it\u253?ch s\u250?boroch je mo\u382?n\u233? t\u250?to mo\u382?nos\u357? ignorova\u357? povolen\u237?m mo\u382?nosti \b Nezachov\u225?va\u357? viacero z\u225?loh tohto s\u250?boru\b0  (z {\ul{\field{\*\fldinst{HYPERLINK "file:///<47|0|0"}}{\fldrslt{S\u250?bor | Vlastnosti}}}}\f0\fs20 , karta Nastavenia)\par


\pard\par

\par


\pard\sa80\cf1\b\fs22 Prie\u269?inok pre z\u225?lo\u382?n\u233? s\u250?bory\cf0\b0\fs20\par


\pard Vyberte bu\u271? \b prie\u269?inok p\u244?vodn\u233?ho\rquote  s\u250?boru\b0 , alebo \b samostatn\u253? prie\u269?inok\b0  (a zvo\u318?te prie\u269?inok) na ukladanie z\u225?lo\u382?n\u253?ch s\u250?borov KeyNote.\par


\pard\li240\sb100\ul Pozn\u225?mka\ulnone\b : "\b0 Mus\u237? by\u357? povolen\u225? mo\u382?nos\u357? \u8222?Z\u225?lohova\u357? p\u244?vodn\u253? s\u250?bor pri ukladan\u237? zmien\u8220?.\par


\pard\par

\par

}
