{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset0 Tahoma;}{\f1\fnil\fcharset238 Tahoma;}{\f2\fnil\fcharset2 Symbol;}}
{\colortbl ;\red0\green0\blue160;\red0\green0\blue255;\red128\green0\blue0;}
{\*\generator Riched20 10.0.22621}\viewkind4\uc1 
\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Mechanizmus hist\u243?rie navig\u225?cie\cf2\f0\lang1033\par

\cf0\b0\fs20\par

KeyNote umo\u382?\u328?uje pohybova\u357? sa sp\u228?\u357? a vpred v hist\u243?rii nav\u353?t\u237?ven\u253?ch uzlov alebo miest, na ktor\u233? sa sko\u269?ilo z odkazov KNT a z\u225?lo\u382?iek, a pon\u250?ka dvojit\u250? hist\u243?riu navig\u225?cie: \b glob\u225?lnu\b0  a \b lok\u225?lnu\b0  (pohyb iba v hist\u243?rii jedn\u233?ho prie\u269?inka).\par

\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Predvolen\u225? navig\u225?cia je glob\u225?lna\b0 , tak\u382?e sa m\u244?\u382?eme pohybova\u357? medzi pozn\u225?mkami (uzlami) prie\u269?inka, ale aj medzi prie\u269?inkami. M\u244?\u382?ete \cf3\b klikn\u250?\u357?\cf0\b0  na tla\u269?idl\u225? panela n\u225?strojov (\v\'11I54\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:54,16,16"}}{\fldrslt {54_Main_54.png}}}}  \v\'11I55\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:55,16,16"}}{\fldrslt {55_Main_55.png}}}} alebo \v\'11I39\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:39,16,16"}}{\fldrslt {39_Main_39.png}}}} alebo \v\'11I40\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:40,16,16"}}{\fldrslt {40_Main_40.png}}}}) alebo pou\u382?i\u357? kl\u225?vesov\u233? skratky (\cf3\b Alt+Left\cf0\b0  alebo \cf3\b Alt+Right\cf0\b0 ).\par

{\pntext\f2\'B7\tab}\b Lok\u225?lna navig\u225?cia\b0  je tie\u382? mo\u382?n\u225?: \cf3\b Ctrl+Click \cf0\b0 na tla\u269?idl\u225? panela n\u225?strojov.\par


\pard\li360 (* Lok\u225?lna navig\u225?cia sa v s\u250?\u269?asnosti mus\u237? vykon\u225?va\u357? pomocou tla\u269?idiel panela n\u225?strojov)\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb60 Ka\u382?d\u253? \b skok z odkazu KNT\b0  (intern\u233?ho hypertextov\u233?ho odkazu KeyNote) vytvor\u237? hist\u243?riu, nielen tie, ktor\u233? ved\u250? do in\u233?ho uzla v tom istom prie\u269?inku.\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Skoky na z\u225?lo\u382?ky\b0  tie\u382? vytvoria hist\u243?riu\par

{\pntext\f2\'B7\tab}Ka\u382?d\u253? prie\u269?inok (karta) bude ma\u357? vlastn\u250? hist\u243?riu navig\u225?cie\par

{\pntext\f2\'B7\tab}S\u250?visiace \b tla\u269?idl\u225?\b0  s\u250? k dispoz\u237?cii v hlavnom paneli n\u225?strojov. Ich \b farba a bublina n\u225?povedy\b0  ozna\u269?uj\u250?, \u269?i je v danom smere dostupn\u225? glob\u225?lna a/alebo lok\u225?lna hist\u243?ria\par


\pard\par

\par

Ke\u271? sa pohybujeme v \b glob\u225?lnej hist\u243?rii\b0 , \b lok\u225?lna hist\u243?ria\b0  v akt\u237?vnom prie\u269?inku sa bude pod\u318?a toho navigova\u357?, \b synchronizovan\u253?m sp\u244?sobom\b0 , ak je to mo\u382?n\u233?, a bude h\u318?ada\u357? rovnak\u250? alebo ekvivalentn\u250? (ten ist\u253? uzol) polo\u382?ku. To ist\u233? nastane, ak hist\u243?riu navig\u225?cie vedie lok\u225?lna hist\u243?ria: glob\u225?lna hist\u243?ria sa synchronizuje, ale v tomto pr\u237?pade obmedzene, iba ak sa d\u225? dosta\u357? na t\u250? ist\u250? polo\u382?ku v tom istom smere a v jednom kroku.\par

\par

Ako obvykle, \b ak sa v hist\u243?rii posunieme dozadu a potom vytvor\u237?me nov\u250? hist\u243?riu\b0  (sko\u269?\u237?me alebo vyberieme in\u233? miesto, nie sa znova posunieme dopredu), hist\u243?ria od tohto bodu dopredu sa skr\u225?ti a nahrad\u237? sa novou hist\u243?riou. V glob\u225?lnej hist\u243?rii sa to stane v\u382?dy, ale v lok\u225?lnej hist\u243?rii (prie\u269?inka (karty)) iba vtedy, ak sko\u269?\u237?me na in\u233? miesto v tom istom prie\u269?inku.\par

Ak sme sa v lok\u225?lnej hist\u243?rii posunuli dozadu a potom vyberieme in\u253? prie\u269?inok, glob\u225?lna hist\u243?ria sa pod\u318?a toho skr\u225?ti, ale hist\u243?ria vo v\u253?chodiskovom prie\u269?inku zostane nedotknut\u225?. Ke\u271? sa do toho prie\u269?inka op\u228?\u357? vr\u225?time (\u269?i u\u382? v\u271?aka navig\u225?cii v hist\u243?rii alebo nie), m\u244?\u382?eme sa, ak chceme, pohybova\u357? iba v tej lok\u225?lnej hist\u243?rii. M\u244?\u382?eme sa pohybova\u357? vn\u250?tri prie\u269?inka (vytv\u225?raj\u250?c nov\u250? hist\u243?riu), vybra\u357? in\u253? prie\u269?inok a pohybova\u357? sa tam, \u269?\u237?m tie\u382? vytvor\u237?me nov\u250? hist\u243?riu. Ak sa z tohto bodu posunieme dozadu, skon\u269?\u237?me vo v\u253?chodiskovom prie\u269?inku, ale m\u244?\u382?eme tie\u382? priamo vybra\u357? ten po\u269?iato\u269?n\u253? prie\u269?inok a priamo navigova\u357? jeho hist\u243?riu (pomocou \cf3\b Ctrl+Click\cf0\b0 ).\par

\par

\b Farba \u353?\u237?pok\b0  na tla\u269?idl\u225?ch panela n\u225?strojov ozna\u269?uje, \u269?i sa navig\u225?cia dopredu alebo dozadu (predvolene v glob\u225?lnej hist\u243?rii) \b skon\u269?\u237? v inom prie\u269?inku\b0  (s\u253?to modr\u225?: \v\'11I39\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:39,16,16"}}{\fldrslt {39_Main_39.png}}}} alebo \v\'11I40\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:40,16,16"}}{\fldrslt {40_Main_40.png}}}}) \b alebo v tom istom prie\u269?inku\b0  (svetlo modr\u225?: \v\'11I54\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:54,16,16"}}{\fldrslt {54_Main_54.png}}}} alebo \v\'11I55\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:55,16,16"}}{\fldrslt {55_Main_55.png}}}}). Aj ke\u271? je farba s\u253?to modr\u225?, pri kliknut\u237? so stla\u269?enou kl\u225?vesou \cf3\b Ctrl\cf0\b0  by sme sa v tomto smere mohli dosta\u357? na polo\u382?ku v tom istom prie\u269?inku, ak to lok\u225?lna hist\u243?ria umo\u382?\u328?uje. \par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak dosiahneme jeden koniec navig\u225?cie v glob\u225?lnej hist\u243?rii, ale v tomto smere existuje lok\u225?lna hist\u243?ria, farba tla\u269?idla bude svetlo modr\u225? a kliknutie na toto tla\u269?idlo sa bude spracov\u225?va\u357?, ako keby sme stla\u269?ili \cf3\b Ctrl+Click\cf0\b0 . \par

{\pntext\f2\'B7\tab}Bublina n\u225?povedy na tla\u269?idl\u225?ch bude ozna\u269?ova\u357?, ak\u253? druh navig\u225?cie v hist\u243?rii je dostupn\u253? v ka\u382?dom smere (glob\u225?lna, lok\u225?lna alebo obe)   \par


\pard\par


\pard\sa120 V nasleduj\u250?com pr\u237?klade sa m\u244?\u382?ete pohybova\u357? v glob\u225?lnej hist\u243?rii dopredu aj dozadu, ale aj dopredu v lok\u225?lnej hist\u243?rii:\par


\pard\li360\v\'11I178\'12\v0{\cf0\ul{\field{\*\fldinst{HYPERLINK "img:178,402,46"}}{\fldrslt {178_Clipb_31mar.png}}}}\par


\pard\par

(Ak som v jednom prie\u269?inku vybral nieko\u318?ko uzlov, posunul som sa v hist\u243?rii dozadu a potom som vybral in\u253? prie\u269?inok. Po \u271?al\u353?om posune dozadu v hist\u243?rii a n\u225?vrate do po\u269?iato\u269?n\u233?ho prie\u269?inka som sa mohol znova posun\u250?\u357? dopredu v hist\u243?rii (vo v\u353?etk\u253?ch pr\u237?padoch glob\u225?lna hist\u243?ria), vr\u225?tiac sa do druh\u233?ho prie\u269?inka, alebo sa posun\u250?\u357? dopredu v lok\u225?lnej hist\u243?rii, prech\u225?dzaj\u250?c v cykle uzlami, ktor\u233? som vybral na za\u269?iatku)\par

\par

}
%*
GI=40
ND=Používanie hľadania a funkcie Hľadať všetko
LM=2003262045
