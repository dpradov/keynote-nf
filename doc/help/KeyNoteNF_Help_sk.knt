{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3323|0|3"}}{\fldrslt{Znovu}}}}}\f0\fs20\tab Zru\u353?\u237? posledn\u253? pr\u237?kaz Sp\u228?\u357?\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3478|0|4"}}{\fldrslt{Opakova\u357? posledn\u233?}}}}}\f0\fs20\tab Zopakuje posledn\u253? pr\u237?kaz \u250?pravy.\par

{{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<110|3941|0|5"}}{\fldrslt{Vystrihn\u250?\u357?}}}}}\f0\fs20\tab Vystrihne vybran\u253? text a umiestni ho do schr\u225?nky\par

