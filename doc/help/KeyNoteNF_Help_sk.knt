\pard\f0\fs20\lang1033\par

\cf1\b\f1\fs36\lang1045 Na \u269?o je KeyNote \f0\lang3082 NF \f1\lang1045 u\u382?ito\u269?n\u253??\cf0\b0\par

\fs26\par

\fs20 Vo v\u353?eobecnosti \b\f0 ak\u233?ko\u318?vek \u353?trukt\u250?rovan\u233? alebo vo\u318?ne formovan\u233? inform\u225?cie,\b0\f1  najm\u228? tak\u253? druh inform\u225?ci\u237?, ktor\u253? sa hod\u237? na \b\f0 hierarchick\u233? zobrazenie, ako s\u250? zoznamy alebo osnovy.\b0\f1  V\u253?konn\u225? \b\f0 funkcia vyh\u318?ad\u225?vania\b0\f1  v KeyNote r\u253?chlo n\u225?jde inform\u225?cie, ktor\u233? h\u318?ad\u225?te.\par

\par

\f0\lang3082 Mo\u382?nos\u357? \b vklada\u357? obr\u225?zky v r\u244?znych form\u225?toch\b0 , prepojen\u233? alebo vlo\u382?en\u233?, ktor\u233? mo\u382?no ulo\u382?i\u357? bin\u225?rne, tak v s\u250?bore .knt, ako aj v extern\u253?ch s\u250?boroch, u\u318?ah\u269?uje jeho pou\u382?\u237?vanie ako \b n\u225?stroja na dokument\u225?ciu\b0  alebo alternat\u237?vy k form\u225?tu \cf2 .\b chm\cf0\b0 .\par

\f1\lang1045\par

Mo\u382?nos\u357? \b\f0 ulo\u382?i\u357? mnoho pozn\u225?mok v jedinom s\u250?bore \b0\f1 znamen\u225?, \u382?e u\u382? nemus\u237?te p\u225?tra\u357? po s\u250?boroch roztr\u250?sen\u253?ch po celom po\u269?\u237?ta\u269?i. Mnoh\u253?m pou\u382?\u237?vate\u318?om bude sta\u269?i\u357? vytvori\u357? len jeden s\u250?bor KeyNote a prida\u357? do\u328? \b\f0\lang3082 prie\u269?inky\b0\f1\lang1045 , pri\u269?om ka\u382?d\u253? \f0\lang3082 prie\u269?inok\f1\lang1045  pokryje samostatn\u250? t\u233?mu (napr. \u8222?\u218?lohy\u8220?, \u8222?Adresy\u8220?, \u8222?Z\u225?lo\u382?ky\u8220?, \u8222?Financie\u8220? at\u271?.)\par

\par

Vstavan\u233? \b\f0 siln\u233? \u353?ifrovanie \b0\f1 v\u225?m umo\u382?\u328?uje zabezpe\u269?i\u357? s\u250?bory proti neopr\u225?vnen\u233?mu pr\u237?stupu alebo \u250?prav\u225?m.\par

\par

\f0 Funkcia \u8222?\b virtu\u225?lny uzol\b0 "\b \u8220? \b0\f1 navy\u353?e umo\u382?\u328?uje spoji\u357? mnoho s\u250?borov a upravova\u357? ich v\u353?etky v r\u225?mci jedin\u233?ho s\u250?boru KeyNote, pri\u269?om p\u244?vodn\u233? s\u250?bory zost\u225?vaj\u250? na disku (tak\u382?e nie je potrebn\u233? vykon\u225?va\u357? \u382?iadnu konverziu).\par

\par

\f0\lang3082 Pozri tie\u382?: {\f1{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<15|0|0"}}{\fldrslt{S\u250?bory KeyNote}}}}}\f0\fs20  (KeyNote nie je \u8222?norm\u225?lny\u8220? editor textov\u253?ch s\u250?borov ani s\u250?borov form\u225?tu RTF.)\par

\f1\lang1045\par

\par

\cf1\b\fs26 Pr\u237?klady pou\u382?itia:\cf0\b0\par

\fs20\par


\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li360\f0\lang3082 O\f1\lang1045 sobn\u233? \b\f0 riadenie inform\u225?ci\u237?\b0\f1\par

{\pntext\f2\'B7\tab}\f0\lang3082 O\f1\lang1045 sobn\u253? \b\f0 denn\u237?k \b0\f1 alebo \u382?urn\u225?l \par

{\pntext\f2\'B7\tab}\b\f0 Zapisovanie pozn\u225?mok na \u353?koleniach\b0 , s jednoduch\u253?m vkladan\u237?m obr\u225?zkov po\u269?as nich.\par

{\pntext\f2\'B7\tab}\b Dokument\u225?cia\b0  in\u353?tala\u269?n\u253?ch postupov, mo\u382?no s automatick\u253?m vkladan\u237?m obr\u225?zkov.\par

{\pntext\f2\'B7\tab}\b S\u250?bor n\u225?povedy\b0  pou\u382?\u237?van\u253? z in\u253?ch aplik\u225?ci\u237?, ako alternat\u237?va ku kompilovan\u233?mu form\u225?tu \b .chm\b0  ({{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<77|0|0"}}{\fldrslt{Viac}}}}}\f0\fs20 )\lang1033\par

{\pntext\f2\'B7\tab}\lang3082 D\f1\lang1045 okument\u225?cia projektu \par

{\pntext\f2\'B7\tab}\b\f0 Polo\u382?ky \b0\f1 \u250?loh \par

{\pntext\f2\'B7\tab}\b\f0 Pozn\u225?mkov\u253? blok \b0\f1 na r\u253?chle pozn\u225?mky a n\u225?pady \par

{\pntext\f2\'B7\tab}\f0\lang3082 P\f1\lang1045 \u237?sanie a \u353?trukt\u250?rovanie mal\u253?ch \u269?l\u225?nkov alebo v\u228?\u269?\u353?\u237?ch dokumentov \par

{\pntext\f2\'B7\tab}Vytv\u225?ranie a ukladanie \b\f0 elektronick\u253?ch textov \b0\f1 (jednoduch\u233? \u353?trukt\u250?rovanie kapitol alebo oddielov) \par

{\pntext\f2\'B7\tab}\b\f0 Osnovy\b0\f1 , projekty\par

{\pntext\f2\'B7\tab}\f0\lang3082 S\f1\lang1045 pr\u225?vy \par

{\pntext\f2\'B7\tab}\f0\lang3082 Re\f1\lang1045 cepty \par

{\pntext\f2\'B7\tab}\b\f0 Osobn\u233? kontakty \b0\f1 (adresy, telef\u243?nne \u269?\u237?sla) \par

{\pntext\f2\'B7\tab}\b\f0 \u218?\u269?ty, hesl\u225?,\b0\f1  PIN k\u243?dy (nezabudnite s\u250?bor za\u353?ifrova\u357?!) \par

{\pntext\f2\'B7\tab}Internetov\u233? z\u225?lo\u382?ky (klikate\u318?n\u233? hypertextov\u233? odkazy) \par

{\pntext\f2\'B7\tab}\b\f0 V\u353?etky druhy zoznamov! \b0\f1 Ak zbierate knihy, CD, DVD alebo len svoje ob\u318?\u250?ben\u233? cit\u225?ty \u269?i vtipy, KeyNote v\u225?m umo\u382?n\u237? jednoducho ich ulo\u382?i\u357? na jednom mieste a r\u253?chlo v nich vyh\u318?ad\u225?va\u357?. \par

{\pntext\f2\'B7\tab}\b\f0 Arch\u237?vy e-mailov \b0\f1 (na import va\u353?ich e-mailov\u253?ch arch\u237?vov do s\u250?boru KeyNote m\u244?\u382?ete pou\u382?i\u357? samostatn\u253? bezplatn\u253? {{\cf0\ul{\field{\*\fldinst{HYPERLINK "file:///<73|0|0"}}{\fldrslt{KNTConvert}}}}}\f1\fs20  n\u225?stroj) \par

{\pntext\f2\'B7\tab}\b\f0 \u352?abl\u243?ny \b0\f1 na vytv\u225?ranie dokumentov so \u353?tandardn\u253?m form\u225?tom \par

{\pntext\f2\'B7\tab}\f0\lang3082 V\u253?pisy a\f1\lang1045 dres\u225?rov (napr. arch\u237?vy CDR) \par

{\pntext\f2\'B7\tab}\f0\lang3082 Z\f1\lang1045 obrazovanie \b\f0 s\u250?borov protokolov \b0\f1 (pou\u382?ite virtu\u225?lne uzly na zobrazenie s\u250?borov protokolov bez toho, aby ste museli ka\u382?d\u253? s\u250?bor otv\u225?ra\u357? samostatne) \par

{\pntext\f2\'B7\tab}\b\f0 Pre u\u269?ite\u318?ov: \b0\f1 pozn\u225?mky z vyu\u269?ovania, pozn\u225?mky o doch\u225?dzke a hodnoten\u237? \u353?tudentov \par

{\pntext\f2\'B7\tab}\b\f0 Pre program\u225?torov: \b0\f1 KeyNote je skvel\u253? na ukladanie arch\u237?vov zdrojov\u233?ho k\u243?du a vyh\u318?ad\u225?vanie v nich \par


\pard\par

}
