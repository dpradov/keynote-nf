\pard\f0\fs20\lang1033\par

\cf1\b\fs36\lang3082 Pou\u382?\u237?vanie pr\u237?kazov N\u225?js\u357? a N\u225?js\u357? v\u353?etko\cf2\lang1033\par

\cf0\b0\fs26\par

{\ul\f1\fs20\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|319|0|2"}}{\fldrslt{N\u225?js\u357?}}}}\f1\fs20\lang3082\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|1409|0|3"}}{\fldrslt{H\u318?adanie uzlov}}}}\f1\fs20\par


\pard\sb80 {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|2226|0|4"}}{\fldrslt{Nahradi\u357?}}}}\f1\fs20\par

{\ul{\field{\*\fldinst{HYPERLINK "file:///<40|3096|0|5"}}{\fldrslt{N\u225?js\u357? v\u353?etko}}}}\f1\fs20\par


\pard    {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|10113|0|13"}}{\fldrslt{Zbalen\u233? bloky}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|10051|0|12"}}{\fldrslt{Pou\u382?\u237?vanie zna\u269?iek s pr\u237?kazom N\u225?js\u357? v\u353?etko}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9159|0|6"}}{\fldrslt{Syntax doplnkov\u233?ho/pokro\u269?il\u233?ho h\u318?adania}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9385|0|7"}}{\fldrslt{H\u318?adanie pod\u318?a d\u225?tumu poslednej zmeny}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|17398|0|16"}}{\fldrslt{H\u318?adanie pod\u318?a chr\u225?nen\u233?ho stavu}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9852|0|8"}}{\fldrslt{Slov\u225? v tom istom odseku alebo vete}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|11754|0|9"}}{\fldrslt{Zv\u253?raznen\u233? slov\u225?}}}}\f1\fs20\par

      {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|20992|0|15"}}{\fldrslt{Kombinovanie tokenov pokro\u269?il\u233?ho h\u318?adania (a typu h\u318?adania)}}}}\f1\fs20\par


\pard\sb40    {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|7583|0|1"}}{\fldrslt{Filtrovanie uzlov stromu}}}}\f1\fs20\par

   {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|15353|0|10"}}{\fldrslt{Zmena spr\u225?vania typu h\u318?adania \u8222?V\u353?etky slov\u225?\u8220?}}}}\f1\fs20\par


\pard\par

\par


\pard\sb100\sa100 KeyNote pon\u250?ka dva sp\u244?soby h\u318?adania textu:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent360{\pntxtb\'B7}}\fi-360\li360 Inkrement\u225?lne h\u318?adanie pomocou \b N\u225?js\u357?\b0  (pr\u237?kaz H\u318?ada\u357?|N\u225?js\u357?...) a \b N\u225?js\u357? uzol\b0  (H\u318?ada\u357?|N\u225?js\u357? uzol...). \fs24\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent360{\pntxtb\'B7}}\fi-360\li360\sb20\fs20 \u218?pln\u233? h\u318?adanie, ktor\u233? zobraz\u237? zoznam v\u253?sledkov, pomocou \b N\u225?js\u357? v\u353?etko\b0  (karta N\u225?js\u357? v paneli zdrojov)\fs24\par


\pard\highlight3\f0\fs20\lang1033\par


\pard\sb100\sa100\cf4\highlight0\b\v\f1\fs24\lang3082\'11B2\'12\v0 N\u225?js\u357?\par


\pard\cf0\b0\fs20 Dial\u243?gov\u233? okno N\u225?js\u357? m\u244?\u382?ete otvori\u357? na inkrement\u225?lne h\u318?adanie pomocou \cf5\b\f0\lang1033 Ctrl+F\cf0\b0\f1\lang3082  (alebo pr\u237?kazom H\u318?ada\u357?|\b N\u225?js\u357?... \b0 ). Pri ka\u382?dom stla\u269?en\u237? tla\u269?idla \u8222?N\u225?js\u357? \u271?alej\u8220? sa vyh\u318?ad\u225? a zv\u253?razn\u237? nov\u253? v\u253?sledok, ak sa n\u225?jde.\par


\pard\sb120\f0\lang1033 Nasleduj\u250?ci text m\u244?\u382?ete n\u225?js\u357? a vybra\u357? pomocou \cf5\b F3 \cf0\b0  (alebo v\u253?berom H\u318?ada\u357?|\b N\u225?js\u357? \u271?alej\b0 ). Ak e\u353?te nebol zadan\u253? \u382?iadny text na h\u318?adanie, zobraz\u237? sa dial\u243?gov\u233? okno, ako pri \b Ctrl+F\b0 .\f1\lang3082\par


\pard\sb100\sa100\par


\pard\li360\sb100\sa100\v\'11I148\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:148,510,262"}}{\fldrslt {148_Clipb_20ene.png}}}}\f1\par


\pard\sb100\sa100\f0\lang1033 M\u244?\u382?ete ur\u269?i\u357?, aby sa h\u318?adanie za\u269?alo od prv\u233?ho znaku uzla/pozn\u225?mky (ak je zapnut\u225? mo\u382?nos\u357? \b Od za\u269?iatku textu \b0 ). V opa\u269?nom pr\u237?pade sa zhody bud\u250? h\u318?ada\u357? od poz\u237?cie kurzora.\par

H\u318?adanie mo\u382?no obmedzi\u357? na aktu\u225?lny editor alebo zahrn\u250?\u357? v\u353?etky uzly (\b H\u318?ada\u357? vo v\u353?etk\u253?ch uzloch stromu\b0 ) alebo dokonca v\u353?etky prie\u269?inky (\b H\u318?ada\u357? vo v\u353?etk\u253?ch prie\u269?inkoch\b0 ). Pri h\u318?adan\u237? vo v\u353?etk\u253?ch uzloch stromu m\u244?\u382?ete skryt\u233? uzly ignorova\u357? alebo zahrn\u250?\u357? (\b H\u318?ada\u357? v skryt\u253?ch uzloch\b0 ).\par

\f1\lang3082 S mo\u382?nos\u357?ou \b Zalamova\u357? v prie\u269?inku\b0  KeyNote n\u225?jde h\u318?adan\u253? text od za\u269?iatku, ke\u271? dosiahne posledn\u250? zhodu.\par

\b Rozli\u353?ova\u357? ve\u318?k\u233? a mal\u233? p\u237?smen\u225?\b0  a \b Iba cel\u233? slov\u225?\b0  umo\u382?\u328?uj\u250? ur\u269?i\u357?, \u269?i m\u225? by\u357? h\u318?adanie citliv\u233? na ve\u318?kos\u357? p\u237?smen a bra\u357? do \u250?vahy iba cel\u233? slov\u225?, ohrani\u269?en\u233? medzerami, tabul\u225?tormi a podobn\u253?mi znakmi.\par

\par

\cf4\b\v\'11B3\'12\v0 H\u318?adanie uzlov\par


\pard\cf0\b0 Uzly m\u244?\u382?ete h\u318?ada\u357? inkrement\u225?lne pod\u318?a nejak\u233?ho textu v n\u225?zve pomocou \cf5\b\f0\lang1033 Shift+Ctrl+F\cf0\b0\f1\lang3082  (alebo pr\u237?kazom H\u318?ada\u357?|\b N\u225?js\u357? uzol...\b0 ). Zobraz\u237? sa dial\u243?gov\u233? okno s n\u225?zvom \u8222?N\u225?js\u357? uzol stromu\u8220? s v\u253?zvou \u8222?N\u225?js\u357? uzol obsahuj\u250?ci text:\u8220?.\par


\pard\sb80 M\u244?\u382?ete tie\u382? pou\u382?i\u357? H\u318?ada\u357?|\b N\u225?js\u357? \u271?al\u353?\u237? uzol...\b0  na v\u253?ber nasleduj\u250?ceho uzla, ktor\u253? obsahuje h\u318?adan\u253? text. Ak e\u353?te nebol zadan\u253? \u382?iadny text, zobraz\u237? sa dial\u243?gov\u233? okno, ako pri \b\f0\lang1033 Shift+Ctrl+F\cf5 .\cf0\b0\f1\lang3082\par


\pard\par

Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Ak m\u225?te \ul zameranie na paneli stromu\ulnone , m\u244?\u382?ete pou\u382?i\u357? rovnak\u233? kl\u225?vesov\u233? skratky ako pri be\u382?nom h\u318?adan\u237?: \cf5\b\f0\lang1033 Ctrl+F \cf0\b0\f1\lang3082 a \cf5\b\f0\lang1033 F3\cf0\b0\f1\lang3082  (alebo aktu\u225?lne prisp\u244?soben\u233? kl\u225?vesov\u233? skratky).\par

{\pntext\f5\'B7\tab}Pr\u237?kaz \b N\u225?js\u357? \u271?al\u353?\u237? uzol\b0  bude h\u318?ada\u357? vo v\u353?etk\u253?ch prie\u269?inkoch a/alebo vo v\u353?etk\u253?ch skryt\u253?ch uzloch v z\u225?vislosti od mo\u382?nost\u237? vybrat\u253?ch na karte N\u225?js\u357? v paneli zdrojov (\ul H\u318?ada\u357? vo v\u353?etk\u253?ch prie\u269?inkoch\ulnone  a \ul H\u318?ada\u357? v skryt\u253?ch uzloch\ulnone )\par


\pard\sb100\sa100\par

\cf4\b\v\fs24\'11B4\'12\v0 Nahradi\u357?\par

\cf0\b0\fs20 Pomocou rovnak\u233?ho mechanizmu op\u237?san\u233?ho v {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|258|0|2"}}{\fldrslt{N\u225?js\u357?}}}}\f1\fs20  dial\u243?govom okne m\u244?\u382?ete ka\u382?d\u253? n\u225?jden\u253? v\u253?skyt nahradi\u357? nov\u253?m textom.\par


\pard\sa100 Pr\u237?kaz H\u318?ada\u357?|\b Nahradi\u357?\b0  (tie\u382? \cf5\b\f0\lang1033 Ctrl+F3 \cf0\b0\f1\lang3082 )\b  \b0 ) sa najprv pok\u250?si nahradi\u357? text na poz\u237?cii kurzora, a ak kurzor nie je umiestnen\u253? v texte, ktor\u253? sa m\u225? nahradi\u357?, presunie sa na nasleduj\u250?ci zodpovedaj\u250?ci text a po\u269?k\u225? na potvrdenie nahradenia kliknut\u237?m na tla\u269?idlo \ul Nahradi\u357?\ulnone .\par


\pard\par


\pard\li360\sb100\sa100\v\'11I149\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:149,510,263"}}{\fldrslt {149_Clipb_20ene.png}}}}\f1\par


\pard\sb100\sa100 Text m\u244?\u382?ete nahradi\u357? po jednom, alebo naraz pomocou tla\u269?idla \ul Nahradi\u357? v\u353?etko\ulnone . Pri hromadnom nahraden\u237? m\u244?\u382?ete obmedzi\u357? na \b Vybran\u253? text\b0  (neakt\u237?vne, ak nie je vybran\u253? text) alebo prin\u250?ti\u357? KeyNote, aby si pri v\u353?etk\u253?ch n\u225?jden\u253?ch v\u253?skytoch vy\u382?iadal potvrdenie (\b Potvrdi\u357? nahradenie\b0 ).\par

Okrem tla\u269?idiel v uvedenom dial\u243?gu m\u244?\u382?ete pou\u382?i\u357? Search|\b Nahradi\u357? \u271?al\u353?ie \b0 na zopakovanie posledn\u233?ho pr\u237?kazu nahradenia a vyh\u318?adanie \u271?al\u353?ieho textu na nahradenie.\par

\par


\pard\b Tip:\b0\par


\pard\li360 Zv\u225?\u382?te mo\u382?nos\u357? \u8222?Reset Find Next after\u8220? (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<103|0|0"}}{\fldrslt{Pokro\u269?il\u233? | In\u233?}}}}\f1\fs20 ). Ak ju nastav\u237?te, m\u244?\u382?ete be\u382?ne pou\u382?\u237?va\u357? \ul N\u225?js\u357? \u271?al\u353?ie\ulnone  (\cf5\b\f0\lang1033 F3\cf0\b0\f1\lang3082 ) namiesto \ul N\u225?js\u357?...\ulnone , \u269?\u237?m je mo\u382?n\u233? priradi\u357? obvykl\u250? skratku \cf5\b\f0\lang1033 Ctrl+F\cf0\b0\f1\lang3082  k \ul N\u225?js\u357? v\u353?etko...\ulnone  \par


\pard\par


\pard\sb100\sa100\par

\cf4\b\v\fs24\'11B5\'12\v0 N\u225?js\u357? v\u353?etko\cf0\par


\pard\b0\fs20 M\u244?\u382?ete n\u225?js\u357? a zobrazi\u357? v\u353?etky v\u253?skyty dan\u233?ho textu vo v\u353?etk\u253?ch prie\u269?inkoch alebo vo v\u353?etk\u253?ch uzloch aktu\u225?lneho prie\u269?inka. Rozsah h\u318?adania m\u244?\u382?ete tie\u382? z\u250?\u382?i\u357? \u271?al\u353?\u237?mi mo\u382?nos\u357?ami.\par

Vo v\u353?etk\u253?ch pr\u237?padoch sa zobrazia \b\f0\lang1033 v\u253?\u328?atky\b0  z pozn\u225?mky n\u225?jden\u253?ch \b v\u253?skytov\b0 , pri\u269?om \b h\u318?adan\u233? slov\u225?\b0  s\u250? \b zv\u253?raznen\u233?\b0 .\par

\par

V\u253?skyty v paneli V\u253?sledky s\u250? zoskupen\u233? (^) pod\u318?a pozn\u225?mky (uzla), v ktorej sa na\u353?li. V paneli v\u253?sledkov h\u318?adania m\u244?\u382?ete zobrazi\u357? n\u225?zov uzla alebo jeho \u250?pln\u250? cestu v z\u225?vislosti od glob\u225?lnej mo\u382?nosti \b Zobrazi\u357? \u250?pln\u250? cestu uzla vo v\u253?sledkoch h\u318?adania \b0  (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<91|0|0"}}{\fldrslt{Mo\u382?nosti: panel stromu}}}}\f0\fs20 ). N\u225?zov uzla je v ceste zv\u253?raznen\u253?.\par


\pard\li360\sb80\f1\lang3082 Glob\u225?lna mo\u382?nos\u357? \b Obr\u225?ten\u233? poradie\b0  (v {\ul{\field{\*\fldinst{HYPERLINK "file:///<91|0|0"}}{\fldrslt{Mo\u382?nosti: panel stromu}}}}\f1\fs20 ) sa pou\u382?\u237?va len s mo\u382?nos\u357?ou \ul Zobrazi\u357? \u250?pln\u250? cestu uzla v stavovom riadku\ulnone . Cesta uzla vo v\u253?sledkoch h\u318?adania sa v\u382?dy zobrazuje zhora nadol.\par

\f0\lang1033 (^) Ak sa nevy\u382?aduje h\u318?adanie v obsahu pozn\u225?mok a v\u253?sledky bud\u250? obsahova\u357? len n\u225?zvy/cesty uzlov, zobraz\u237? sa len jeden riadok na v\u253?sledok (uzol), bez \u271?al\u353?\u237?ch zoskupuj\u250?cich riadkov.\par


\pard\sb200 Ve\u318?kos\u357? p\u237?sma pou\u382?it\u233?ho na karte V\u253?sledky m\u244?\u382?ete zmeni\u357? aj pomocou glob\u225?lnej mo\u382?nosti: \b Ve\u318?kos\u357? p\u237?sma vo v\u253?sledkoch N\u225?js\u357? v\u353?etko \b0 (na karte {\ul{\field{\*\fldinst{HYPERLINK "file:///<103|0|0"}}{\fldrslt{Pokro\u269?il\u233? | In\u233?}}}}\f0\fs20  )\par


\pard\par

Tento panel karty H\u318?ada\u357? v\u225?m umo\u382?n\u237? {\ul\f1\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|5597|0|1"}}{\fldrslt{filtrovanie uzlov stromu}}}}\f1\fs20\lang3082  na z\u225?klade v\u253?sledku h\u318?adania skry\u357? alebo zobrazi\u357? uzly.\par

\par

Upozor\u328?ujeme, \u382?e stla\u269?enie \cf5\b\f0\lang1033 Esc\cf0\b0\f1\lang3082  na ktorejko\u318?vek karte panela Zdroje (*) presunie fokus do panela Editor (alebo panela Strom). Ak je fokus v ovl\u225?dacom prvku \u8222?H\u318?ada\u357? text\u8220?, prv\u233? \cf5\b\f0\lang1033 Esc\cf0\b0\f1\lang3082  vyma\u382?e vzor h\u318?adania a \u271?al\u353?ie presunie fokus do Editora.\par


\pard\li360\sb80 (*) Ak je fokus nastaven\u253? na Scratch editor a mo\u382?nos\u357? \u8222?On Escape key\u8220? je nastaven\u225? na \u8222?Minimize KeyNote\u8220?, Esc minimalizuje aplik\u225?ciu; inak prepne fokus do editora.\par


\pard\par

\b Tip\b0 : Vo v\u253?sledkoch h\u318?adania sa m\u244?\u382?ete pohybova\u357? kl\u225?vesmi \cf5\b\f0 Up \cf0\b0\f1 a \cf5\b\f0 Down\cf0\b0\f1  (tie\u382? \cf5\b\f0 Home\cf0\b0\f1 , \cf5\b\f0 End\cf0\b0\f1 , \cf5\b\f0 Prior\cf0\b0\f1  a \cf5\b\f0 Next\cf0\b0\f1 ) a \cf5\b\f0 Enter\cf0\b0\f1 . V\u253?ber v\u253?sledku ho lokalizuje a zobraz\u237? v kontexte, ale okno v\u253?sledkov h\u318?adania zostane akt\u237?vne. Ak chcete presun\u250?\u357? fokus do editora, m\u244?\u382?ete stla\u269?i\u357? \cf5\f0 Enter\cf0\f1 .\par

\par

\b Tip\b0 : Kliknut\u237?m na v\u253?sledok h\u318?adania postupne prech\u225?dzate jednotliv\u233? slov\u225? v\u253?skytu. Ka\u382?d\u253?m \u271?al\u353?\u237?m kliknut\u237?m sa vyberie \u271?al\u353?ie zo slov, ktor\u233? sa brali do \u250?vahy pri pridan\u237? v\u253?skytu do zoznamu v\u253?sledkov.\par

\b   \par

Tip\b0 : \f0\lang1033 Po pou\u382?it\u237? pr\u237?kazu \u8222?N\u225?js\u357? v\u353?etko\u8220? kliknite prav\u253?m tla\u269?idlom na zoznam v\u253?sledkov h\u318?adania a otvor\u237? sa kontextov\u233? menu. Menu obsahuje pr\u237?kazy na vlo\u382?enie v\u253?sledkov h\u318?adania ako klikate\u318?n\u253?ch hypertextov\u253?ch odkazov do aktu\u225?lnej pozn\u225?mky.\par

\par

\b\f1\lang3082 Tip\b0 : H\u318?adanie m\u244?\u382?ete \u271?alej z\u250?\u382?i\u357? pou\u382?it\u237?m {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|9159|0|6"}}{\fldrslt{syntax doplnkov\u233?ho/pokro\u269?il\u233?ho h\u318?adania}}}}\f0\fs20\lang1033 .\par

\f1\lang3082\par

\par


\pard\li360\v\'11I217\'12\v0\f0{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:217,203,734"}}{\fldrslt {217_Clipb_13abr.png}}}}\lang1033      \v\'11I216\'12\v0\lang3082{\cf0\b0\highlight0\ul{\field{\*\fldinst{HYPERLINK "img:216,312,600"}}{\fldrslt {216_Clipb_20ene.png}}}}\f1\par


\pard\f0\lang1033\par

\par

H\u318?adanie m\u244?\u382?ete \ul z\u250?\u382?i\u357?\ulnone  kombinovan\u237?m nasleduj\u250?cich dostupn\u253?ch \b mo\u382?nost\u237?\b0 :\par

\par

\b Rozli\u353?ova\u357? ve\u318?kos\u357? p\u237?smen\b0\par

H\u318?adanie bude rozli\u353?ova\u357? ve\u318?kos\u357? p\u237?smen. Napr\u237?klad \u8222?KeyNote\u8220? je in\u233? ako \u8222?keynote\u8220?.\par

\par


\pard\sb80\b Len cel\u233? slov\u225?\par


\pard\b0 Ak je zapnut\u233? a h\u318?ad\u225?te napr\u237?klad \u8222?Note\u8220?, \u8222?KeyNote\u8220? sa nebude pova\u382?ova\u357? za v\u253?skyt.\par

\par


\pard\sb80\b Preh\u318?ada\u357? v\u353?etky prie\u269?inky\par


\pard\b0 Ak je zapnut\u233?, text sa bude h\u318?ada\u357? vo v\u353?etk\u253?ch prie\u269?inkoch [keynote]. Inak sa bude bra\u357? do \u250?vahy len aktu\u225?lne akt\u237?vny prie\u269?inok.\par


\pard\li360\sb80 Pozn\u225?mka: Za\u269?iarkavacie pol\u237?\u269?ka \ul Preh\u318?ada\u357? v\u353?etky prie\u269?inky\ulnone  v dial\u243?gu H\u318?ada\u357? a v paneli N\u225?js\u357? v\u353?etko s\u250? nez\u225?visl\u233?. KeyNote si tieto mo\u382?nosti pam\u228?t\u225? samostatne.\par


\pard\par


\pard\sb80\b Aktu\u225?lny uzol a podstrom\b0\par


\pard Ak je t\u225?to mo\u382?nos\u357? vybran\u225?, KeyNote bude h\u318?ada\u357? len vo vybranom uzle a jeho podraden\u253?ch uzloch.\par

\ul Pozn\u225?mka\ulnone : Vybran\u253? uzol sa bude bra\u357? do \u250?vahy pri vykonan\u237? pr\u237?kazu \u8222?N\u225?js\u357? v\u353?etko\u8220?.\par

\par

\par

\b H\u318?ada\u357? v skryt\u253?ch uzloch\b0\par

Ako je uveden\u233? {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|18325|0|11"}}{\fldrslt{tu}}}}\f0\fs20 , uzly stromu mo\u382?no skry\u357? nieko\u318?k\u253?mi sp\u244?sobmi (napr\u237?klad ako v\u253?sledok h\u318?adania N\u225?js\u357? v\u353?etko so zapnutou mo\u382?nos\u357?ou \ul Filtrova\u357? prie\u269?inok\ulnone , pozri ni\u382?\u353?ie). Ak je t\u225?to mo\u382?nos\u357? zapnut\u225?, KeyNote bude pri h\u318?adan\u237? bra\u357? do \u250?vahy aj skryt\u233? uzly.\par


\pard\sb80\par


\pard\b\v\'11B14\'12\v0 Typ h\u318?adania\b0\par


\pard\sb80 Pr\u237?kaz \u8222?N\u225?js\u357? v\u353?etko\u8220? mo\u382?no pou\u382?i\u357? na jednoduch\u233? booleovsk\u233? h\u318?adanie (AND / OR):\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Presn\u225? fr\u225?za\b0\par


\pard\li360\sb80 KeyNote bude h\u318?ada\u357? presne zadan\u253? text.\par

\ul Pozn\u225?mka\ulnone : Vonkaj\u353?ie medzery sa ignoruj\u250? (odstr\u225?nia sa). Preto h\u318?adanie \u8222?text entered\u8220? bude rovnak\u233? ako h\u318?adanie \u8222? text entered \u8220?. Av\u353?ak \u8222?text entered\u8220? bude in\u233? ako \u8222?text  entered\u8220?.\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b V\u353?etky slov\u225?  \b0\fs18 (AND)\fs20\par


\pard\li360\sb80 KeyNote bude h\u318?ada\u357? zadan\u233? slov\u225?, pri\u269?om medzery pou\u382?ije ako odde\u318?ova\u269?e slov.\par

Ak je t\u225?to mo\u382?nos\u357? vybran\u225?, KeyNote zahrnie do v\u253?sledkov v\u353?etky po sebe nasleduj\u250?ce v\u253?skyty, v ktor\u253?ch s\u250? pr\u237?tomn\u233? \ul v\u353?etky\ulnone  slov\u225?.\par

Zv\u253?razn\u237? sa prv\u233? n\u225?jden\u233? slovo z poskytnut\u233?ho zoznamu, ako aj ostatn\u233? slov\u225?, ktor\u233? sa vyskytuj\u250? vo v\u253?\u328?atku napravo od neho. Ak posledn\u233? slovo n\u225?jden\u233? v identifikovanom v\u253?skyte nie je zobrazen\u233? vo v\u253?\u328?atku z\u237?skanom pre prv\u233? n\u225?jden\u233? slovo, prid\u225? sa dodato\u269?n\u253? v\u253?\u328?atok pre posledn\u233? slovo (oddelen\u253? znakom \u8222?\cf6\b\f2 . . //. .\cf0\b0\f0 \u8220?), v ktorom s\u250? zv\u253?raznen\u233? v\u353?etky h\u318?adan\u233? slov\u225?.\par

\ul Pozn\u225?mka\ulnone : Od verzie 2.0 bol prepracovan\u253? sp\u244?sob fungovania typu h\u318?adania \u8222?V\u353?etky slov\u225?\u8220?. Pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<40|15353|0|10"}}{\fldrslt{viac}}}}\f0\fs20 .\par


\pard\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Ktor\u233?ko\u318?vek zo slov  \b0\fs18 (OR)\fs20\par


\pard\li360\sb80 KeyNote bude h\u318?ada\u357? zadan\u233? slov\u225?, pri\u269?om medzery pou\u382?ije ako odde\u318?ova\u269?e slov.\par

Ak je t\u225?to mo\u382?nos\u357? vybran\u225?, KeyNote zahrnie do v\u253?sledkov v\u353?etky po sebe nasleduj\u250?ce v\u253?skyty, v ktor\u253?ch je pr\u237?tomn\u233? \ul ktor\u233?ko\u318?vek\ulnone  zo slov.\par

Vytvoria sa v\u253?sledky, ktor\u233? obsahuj\u250? a zv\u253?raz\u328?uj\u250? v\u353?etky v\u253?skyty ka\u382?d\u233?ho slova z h\u318?adan\u233?ho v\u253?razu. Nov\u233? v\u253?sledky sa pridaj\u250? len pre tie slov\u225?, ktor\u233? nie s\u250? vidite\u318?n\u233? v predch\u225?dzaj\u250?com v\u253?\u328?atku.\par


\pard\par


\pard\sb80 Pozn\u225?mka. Pri \ul V\u353?etky slov\u225?\ulnone  alebo \ul Ktor\u233?ko\u318?vek zo slov\ulnone :\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Na jednu pozn\u225?mku (uzol) m\u244?\u382?e pripada\u357? viac ako jeden v\u253?sledok/v\u253?skyt\par

{\pntext\f5\'B7\tab}Poradie v\u253?skytu slov nie je podstatn\u233?.\par

{\pntext\f5\'B7\tab}V\u253?ber\f3  \f0 \u8222?V\u353?etky\f3  \f0 \f3  \f0 slov\u225?\u8220?\f3  \f0 alebo\f3  \f0 \u8222?Ktor\u233?ko\u318?vek\f3  \f0 zo\f3  \f0 \f3  \f0 slov\u8220?\f3  \f0 pri\f3  \f0 h\u318?adan\u237?\f3  \f0 len\f3  \f0 jedn\u233?ho\f3  \f0 slova\f3  \f0 je\f3  \f0 ekvivalentn\u253?\f3  \f0 \f3  \f0 pou\u382?itiu\f3  \f0 \u8222?Presn\u225?\f3  \f0 fr\u225?za\u8220?.\par

{\pntext\f5\'B7\tab}Pozri tie\u382? {\ul\f1\lang3082{\field{\*\fldinst{HYPERLINK "file:///<40|20992|0|15"}}{\fldrslt{Kombinovanie tokenov pokro\u269?il\u233?ho h\u318?adania (a typu h\u318?adania)}}}}\f0\fs20\par


\pard\par

\par


\pard\sb80\b D\u225?tum vytvorenia. D\u225?tum poslednej zmeny   (Od / Do)\b0\par

KeyNote bude bra\u357? do \u250?vahy len uzly vytvoren\u233? a/alebo zmenen\u233? v uveden\u253?ch intervaloch.\par


\pard Uzly bez d\u225?tumu vytvorenia alebo poslednej zmeny sa ignoruj\u250?. Upozor\u328?ujeme, \u382?e KeyNote dok\u225?\u382?e odvodi\u357? d\u225?tumy z n\u225?zvu a obsahu existuj\u250?cich pozn\u225?mok vytvoren\u253?ch star\u353?\u237?mi verziami. Pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|31373|0|20"}}{\fldrslt{Odvodi\u357? ch\u253?baj\u250?ce inform\u225?cie o d\u225?tume}}}}\f0\fs20\par


\pard\sb160\b Tip\b0 : Spustenie N\u225?js\u357? v\u353?etko bez zadania textu je povolen\u233?, ak je nastaven\u233? niektor\u233? krit\u233?rium d\u225?tumu\par


\pard\par

\par

\b Rozsah h\u318?adania\b0\par


\pard\sb80 Touto mo\u382?nos\u357?ou m\u244?\u382?ete obmedzi\u357? h\u318?adanie na n\u225?zvy uzlov alebo obsah pozn\u225?mok, pri\u269?om sa berie do \u250?vahy:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\sa40\b Len n\u225?zvy uzlov\b0\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40\b Len obsah pozn\u225?mok\b0\par

{\pntext\f5\'B7\tab}\b V\u353?etko\b0\par


\pard\sb160 Pozn\u225?mka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 Ostatn\u233? vybran\u233? mo\u382?nosti, ako \ul Typ h\u318?adania\ulnone  (Presn\u225? fr\u225?za, V\u353?etky slov\u225?, Ktor\u233?ko\u318?vek zo slov) alebo \ul Len cel\u233? slov\u225?\ulnone , sa bud\u250? bra\u357? do \u250?vahy aj pri h\u318?adan\u237? v n\u225?zvoch uzlov.\par

{\pntext\f5\'B7\tab}V\u253?skyty v n\u225?zvoch uzlov s\u250? v zozname v\u253?sledkov \cf6\highlight7 zv\u253?raznen\u233?\cf0\highlight0  farbou pozadia \highlight7\lang3082 svetlo\u382?lt\u225?\highlight8\lang1033  \highlight0 \par


\pard\par

\par

\b Pou\u382?i\u357? cestu uzla\b0\par


\pard\sb80 Predvolene sa pri h\u318?adan\u237? v n\u225?zvoch uzlov berie do \u250?vahy len samotn\u253? uzol. Ak je zapnut\u225? mo\u382?nos\u357? \u8222?Pou\u382?i\u357? cestu uzlov\u8220?, pou\u382?ije sa \u250?pln\u225? cesta, teda vr\u225?tane n\u225?zvov nadraden\u253?ch uzlov.\par

Vysvetlenie a pr\u237?klad jej mo\u382?n\u233?ho pou\u382?itia n\u225?jdete v \u269?asti Folders as note trees / Tree Filtering / {\ul{\field{\*\fldinst{HYPERLINK "file:///<27|26525|0|18"}}{\fldrslt{Filtrovanie pod\u318?a n\u225?zvu}}}}\f0\fs20\par


\pard\par

\par

\b Za\u269?iarknut\u233? uzly\b0\par


\pard\sb80\f1\lang3082 T\u225?to mo\u382?nos\u357? v\u225?m umo\u382?\u328?uje obmedzi\u357? h\u318?adanie pod\u318?a stavu za\u269?iarknutia uzlov, pri\u269?om sa berie do \u250?vahy:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb120\sa40\b\f0\lang1033 Len neza\u269?iarknut\u233? uzly\b0\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sa40\b Len za\u269?iarknut\u233? uzly\b0\par

{\pntext\f5\'B7\tab}\b V\u353?etko\b0\par


\pard\par

\par

\cf4\b\v\f1\fs24\'11B13\'12\v0 Zbalen\u233? bloky\par

\cf0\b0\f0\fs20\par

Ak do pozn\u225?mok zara\u271?ujete zbalen\u253? text, m\u244?\u382?ete pou\u382?i\u357? rozba\u318?ovac\u237? zoznam \u8222?\b Re\u382?im zbalenia\b0 \u8220? s jednou z t\u253?chto mo\u382?nost\u237?:\par

\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 V\u353?etko\par

{\pntext\f5\'B7\tab}Vyl\u250?\u269?i\u357? zbalen\u233?\par

{\pntext\f5\'B7\tab}Vyl\u250?\u269?i\u357? ozna\u269?en\u233? zbalen\u233?\par

{\pntext\f5\'B7\tab}Len zbalen\u233?\par


\pard\par

Prv\u225? mo\u382?nos\u357?, vybran\u225? predvolene, nerozli\u353?uje pod\u318?a stavu textu a umo\u382?\u328?uje n\u225?js\u357? slov\u225? bez oh\u318?adu na to, \u269?i sa nach\u225?dzaj\u250? v zbalen\u253?ch (skryt\u253?ch) blokoch alebo nie.\par


\pard\sb40 Posledn\u225? mo\u382?nos\u357? obmedz\u237? h\u318?adanie v\u253?hradne na zbalen\u233? bloky. V kombin\u225?cii s krit\u233?riom zna\u269?ky je mo\u382?n\u233? \u271?alej obmedzi\u357?, ktor\u233? bloky sa maj\u250? bra\u357? do \u250?vahy.\par


\pard\par

Dve stredn\u233? mo\u382?nosti umo\u382?\u328?uj\u250? ignorova\u357? zbalen\u253? text, pri\u269?om tretia je obmedzuj\u250?cej\u353?ia a vylu\u269?uje len tie zbalen\u233? bloky, ktor\u233? za\u269?\u237?naj\u250? zna\u269?kou. \par


\pard\sb40 T\u225?to mo\u382?nos\u357? ({\ul{\field{\*\fldinst{HYPERLINK "file:///<122|23127|0|11"}}{\fldrslt{zbalen\u253? blok s \u8222?zna\u269?kou\u8220?}}}}\f0\fs20 ) existuje vzh\u318?adom na mo\u382?nos\u357? kombinovan\u233?ho pou\u382?itia zna\u269?iek a zba\u318?ovania, ktor\u233? m\u244?\u382?ete vyu\u382?i\u357? na jednoduch\u233? ozna\u269?enie textu, ktor\u253? sa m\u225? pri h\u318?adan\u237? ignorova\u357?, napr\u237?klad archivovan\u233? inform\u225?cie, pomocn\u253? obsah, dokon\u269?en\u233? \u250?lohy, ktor\u233? nechcete bra\u357? do \u250?vahy at\u271?. Naopak, in\u233? zbalen\u233? bloky m\u244?\u382?u obsahova\u357? text, ktor\u253? jednoducho chcete ponecha\u357? skryt\u253? kv\u244?li \u269?itate\u318?nosti alebo preh\u318?adnosti, ke\u271?\u382?e ide o podrobnosti, ktor\u233? chcete ma\u357? vidite\u318?n\u233? len v pr\u237?pade potreby.\par


\pard\sb80 Samozrejme, ka\u382?d\u253? pou\u382?\u237?vate\u318? m\u244?\u382?e sklopen\u233? bloky pou\u382?\u237?va\u357? inak.\par


\pard\par

\b Pozn\u225?mka\b0 :\par

Pri kliknut\u237? na v\u253?sledok h\u318?adania nach\u225?dzaj\u250?ci sa v sklopenom textovom bloku sa sko\u269?\u237? na tento blok a vyberie sa \u8222?+\u8220? zodpovedaj\u250?ci za\u269?iatku bloku.\par

\par

\par

\cf4\b\v\f1\fs24\'11B12\'12\v0 Pou\u382?\u237?vanie zna\u269?iek s funkciou N\u225?js\u357? v\u353?etko\par

\cf0\b0\f0\fs20\par

Pomocou krit\u233?ri\u237? h\u318?adania zalo\u382?en\u253?ch na zna\u269?k\u225?ch je tie\u382? mo\u382?n\u233? ur\u269?i\u357?, ktor\u233? uzly sa maj\u250? bra\u357? do \u250?vahy.\par


\pard\sb40 Je v\u353?ak tie\u382? mo\u382?n\u233? vyu\u382?i\u357? ozna\u269?ovanie zahrnut\u233? priamo v texte na obmedzenie v\u253?sledkov h\u318?adania na tie odstavce alebo textov\u233? fragmenty, ktor\u233? sp\u314?\u328?aj\u250? konkr\u233?tne krit\u233?ri\u225? ozna\u269?ovania.\par


\pard\par

\ul Zoh\u318?adnen\u233? uzly\ulnone  mo\u382?no obmedzi\u357? na z\u225?klade v\u253?beru zna\u269?iek:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40\b So\b0  [V\u352?ETK\u221?MI alebo NIEKTOR\u221?MI] uveden\u253?mi zna\u269?kami \par


\pard\li360 (mo\u382?no pou\u382?i\u357? jednotliv\u233? zna\u269?ky alebo viacero \u8211? napr. Err*)\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb80\b Bez\b0  ktorejko\u318?vek z uveden\u253?ch zna\u269?iek\par


\pard\par

S\u250?visiace za\u353?krt\u225?vacie pol\u237?\u269?ka:\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\b Zoh\u318?adni\u357? metad\u225?ta pozn\u225?mok\b0\par

{\pntext\f5\'B7\tab}\b Zoh\u318?adni\u357? text pozn\u225?mok\b0\par

{\pntext\f5\'B7\tab}\b Zdeden\u233? zna\u269?ky (metad\u225?ta)\b0\par


\pard\par

Zad\u225?vanie zna\u269?iek na pou\u382?itie v poliach So a Bez sa vykon\u225?va pomocou v\u253?beru zna\u269?iek (pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|7939|0|5"}}{\fldrslt{Pou\u382?\u237?vanie v\u253?beru zna\u269?iek}}}}\f0\fs20 ) \par


\pard\li360\sb80\b Tip\b0 : Obsah ovl\u225?dac\u237?ch prvkov So alebo Bez m\u244?\u382?ete vymaza\u357? pomocou \cf5 Ctrl+kliknutia\cf0  v jeho texte.\par


\pard\par

\b Pozn\u225?mka\b0 : Zna\u269?ky zadan\u233? v ovl\u225?dac\u237?ch prvkoch So a/alebo Bez sa ignoruj\u250?, ak nie s\u250? za\u353?krtnut\u233? obe mo\u382?nosti \u8222?Zoh\u318?adni\u357? metad\u225?ta pozn\u225?mok\u8220? a \u8222?Zoh\u318?adni\u357? text pozn\u225?mok\u8220?\par

\par

M\u244?\u382?eme \ul obmedzi\u357? h\u318?adanie na textov\u233? fragmenty\ulnone , ktor\u233? neobsahuj\u250? \u382?iadnu z ur\u269?it\u253?ch vybran\u253?ch zna\u269?iek:\par


\pard\sb80 Mus\u237? by\u357? za\u353?krtnut\u225? mo\u382?nos\u357? \u8222?Zoh\u318?adni\u357? text pozn\u225?mok\u8220?.\par


\pard Mo\u382?nos\u357? \u8222?Zoh\u318?adni\u357? metad\u225?ta pozn\u225?mok\u8220? m\u244?\u382?e by\u357? za\u353?krtnut\u225?. Ak je za\u353?krtnut\u225?, zna\u269?ky pou\u382?it\u233? na cel\u250? pozn\u225?mku ako metad\u225?ta sa zoh\u318?adnia spolu so zna\u269?kami zadan\u253?mi v texte\par


\pard\li360 Ak uvedieme zna\u269?ky v klauzule So a m\u225?me za\u353?krtnut\u250? mo\u382?nos\u357? \u8222?Zoh\u318?adni\u357? metad\u225?ta pozn\u225?mok\u8220?, Keynote pri h\u318?adan\u237? v texte ignoruje tie zna\u269?ky, ktor\u233? sa nach\u225?dzaj\u250? v metad\u225?tach pozn\u225?mky.\par


\pard\par

\b Pozn\u225?mky\b0 :\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360 Pri overovan\u237?, \u269?i textov\u253? fragment sp\u314?\u328?a podmienky zna\u269?iek, je d\u244?le\u382?it\u233? ma\u357? na pam\u228?ti, \u382?e ka\u382?d\u225? zna\u269?ka definuje rozsah (interval s dolnou a hornou hranicou pre text, na ktor\u253? p\u244?sob\u237?) a \u382?e to z\u225?vis\u237? aj od toho, \u269?i bola zna\u269?ka definovan\u225? \u8222?otvorene\u8220? (napr. #Critical: ) alebo nie, pri\u269?om v tomto poslednom pr\u237?pade ovplyv\u328?uje iba odsek, v ktorom sa nach\u225?dza (pozri {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|4425|0|3"}}{\fldrslt{Rozsah alebo p\u244?sobnos\u357? zna\u269?iek}}}}\f0\fs20 )\par


\pard{\pntext\f5\'B7\tab}{\*\pn\pnlvlblt\pnf5\pnindent0{\pntxtb\'B7}}\fi-360\li360\sb40 H\u318?adanie je mo\u382?n\u233? obmedzi\u357? pomocou {\ul{\field{\*\fldinst{HYPERLINK "file:///<122|6396|0|4"}}{\fldrslt{neregistrovan\u233? zna\u269?ky}}}}\f0\fs20\par

{\pntext\f5\'B7\tab}Ak je pri h\u318?adan\u237? obsahu pomocou zna\u269?iek text na n\u225?jdenie "", vr\u225?ti sa zhoda pre ka\u382?d\u253? textov\u253? \u250?sek, ktor\u253? sp\u314?\u328?a krit\u233?ri\u225?\par


\pard\par

